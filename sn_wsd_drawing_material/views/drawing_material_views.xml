<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_drawing_material_list" model="ir.ui.view">
        <field name="name">sn.wsd.drawing.material.list</field>
        <field name="model">sn.wsd.drawing.material</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_drawing_no"/>
                <field name="product_name" optional="show"/>
                <field name="operation_id"/>
                <field name="x_side"/>
                <field name="workshop_id" groups="base.group_multi_company"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_drawing_material_search" model="ir.ui.view">
        <field name="name">sn.wsd.drawing.material.search</field>
        <field name="model">sn.wsd.drawing.material</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_drawing_no" string="Drawing No."/>
                <field name="operation_id"/>
                <field name="workshop_id"/>
                <filter name="filter_side_top" string="Top (T)"
                        domain="[('x_side', '=', 'top')]"/>
                <filter name="filter_side_bottom" string="Bottom (B)"
                        domain="[('x_side', '=', 'bottom')]"/>
                <group>
                    <filter name="group_by_drawing" string="Drawing No."
                            domain="[]" context="{'group_by': 'x_drawing_no'}"/>
                    <filter name="group_by_operation" string="Operation"
                            domain="[]" context="{'group_by': 'operation_id'}"/>
                    <filter name="group_by_workshop" string="Workshop"
                            domain="[]" context="{'group_by': 'workshop_id'}"/>
                    <filter name="group_by_side" string="Production Side"
                            domain="[]" context="{'group_by': 'x_side'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_drawing_material_form" model="ir.ui.view">
        <field name="name">sn.wsd.drawing.material.form</field>
        <field name="model">sn.wsd.drawing.material</field>
        <field name="arch" type="xml">
            <form string="Drawing Material Relation">
                <sheet>
                    <group>
                        <group name="dimension" string="Dimension">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="workshop_id"/>
                            <field name="x_drawing_no" default_focus="1"/>
                            <field name="operation_id"/>
                            <field name="x_side"/>
                        </group>
                        <group name="product_info" string="Product Info">
                            <field name="product_id" readonly="1"/>
                            <field name="product_name" readonly="1"/>
                            <field name="product_specification" readonly="1"/>
                            <field name="product_board_side" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Material Lines" name="material_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="material_type" readonly="1"/>
                                    <field name="material_ref"/>
                                    <field name="material_name" readonly="1"/>
                                    <field name="material_spec" readonly="1"/>
                                    <field name="qty"/>
                                    <field name="usage_times"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_drawing_material" model="ir.actions.act_window">
        <field name="name">Drawing Material Relations</field>
        <field name="res_model">sn.wsd.drawing.material</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a drawing material relation
            </p>
            <p>Maintain the tooling, consumable and material list used when a drawing number runs through one operation on one production side.</p>
        </field>
    </record>
</odoo>
