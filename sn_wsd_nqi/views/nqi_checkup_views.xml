<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nqi_checkup_form" model="ir.ui.view">
        <field name="name">nqi.checkup.form</field>
        <field name="model">sn.wsd.nqi.checkup</field>
        <field name="arch" type="xml">
            <form string="SN Data Checkup">
                <group>
                    <group>
                        <field name="sn" placeholder="SN / PCB code"/>
                        <field name="state" invisible="1"/>
                    </group>
                    <group>
                        <field name="summary" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="sequence" column_invisible="1"/>
                        <field name="table_label"/>
                        <field name="row_count"/>
                        <field name="state" widget="badge"
                               decoration-success="state == 'ok'"
                               decoration-warning="state == 'warn'"
                               decoration-muted="state == 'none'"/>
                        <field name="missing_note"/>
                    </list>
                </field>
                <footer>
                    <button name="action_run" type="object"
                            string="Run Checkup" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nqi_checkup" model="ir.actions.act_window">
        <field name="name">SN Data Checkup</field>
        <field name="res_model">sn.wsd.nqi.checkup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_nqi_completion_workbench" model="ir.actions.act_window">
        <field name="name">Completion Workbench (Assets)</field>
        <field name="res_model">sn.wsd.nqi.fit.meter.info</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_missing': 1}</field>
    </record>

    <menuitem id="menu_nqi_checkup_entry"
              name="SN Data Checkup"
              parent="menu_nqi_push_center"
              action="action_nqi_checkup"
              sequence="10"/>
    <menuitem id="menu_nqi_workbench_entry"
              name="Completion Workbench"
              parent="menu_nqi_push_center"
              action="action_nqi_completion_workbench"
              sequence="20"/>
</odoo>
