<odoo>
    <record id="view_nqi_et_device_list" model="ir.ui.view">
        <field name="name">nqi.et.device.list</field>
        <field name="model">sn.wsd.nqi.et.device</field>
        <field name="arch" type="xml">
            <list decoration-warning="missing_count &gt; 0">
                <field name="equipment_id"/>
                <field name="device_code"/>
                <field name="device_make_code"/>
                <field name="device_name"/>
                <field name="device_type"/>
                <field name="property_right_type"/>
                <field name="missing_count" optional="hide"/>
                <field name="push_state" widget="badge" decoration-info="push_state == 'to_push'" decoration-success="push_state == 'pushed'"/>
            </list>
        </field>
    </record>
    <record id="view_nqi_et_device_form" model="ir.ui.view">
        <field name="name">nqi.et.device.form</field>
        <field name="model">sn.wsd.nqi.et.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="push_state" widget="statusbar" statusbar_visible="draft,to_push,pushed"/>
                    <button name="action_mark_to_push" type="object" string="Mark to Push" class="oe_highlight" invisible="push_state != 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group string="Bring-in Anchor">
                            <field name="equipment_id"/>
                        </group>
                        <group string="NQI Columns">
                            <field name="device_code"/>
                            <field name="device_make_code"/>
                            <field name="device_name"/>
                            <field name="device_type"/>
                            <field name="type_id"/>
                            <field name="property_right_type"/>
                            <field name="file_url"/>
                            <field name="device_status"/>
                            <field name="test_date"/>
                            <field name="test_valid_date"/>
                            <field name="used_years"/>
                            <field name="buy_date"/>
                            <field name="device_maker"/>
                            <field name="test_num"/>
                        </group>
                        <group string="Envelope">
                            <field name="enterprise_code"/>
                            <field name="nqi_write_date"/>
                            <field name="handle_flag"/>
                            <field name="handle_date"/>
                            <field name="notice_no"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_nqi_et_device_search" model="ir.ui.view">
        <field name="name">nqi.et.device.search</field>
        <field name="model">sn.wsd.nqi.et.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="device_code"/>
                <filter name="filter_missing" string="Missing Data" domain="[('missing_count', '>', 0)]"/>
                <group>
                    <filter name="group_by_state" string="Push State" context="{'group_by': 'push_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_nqi_et_device" model="ir.actions.act_window">
        <field name="name">ET_DEVICE_INFO</field>
        <field name="res_model">sn.wsd.nqi.et.device</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_nqi_et_device_entry"
              name="ET_DEVICE_INFO"
              parent="menu_nqi_cert"
              action="action_nqi_et_device"
              sequence="10"/>

