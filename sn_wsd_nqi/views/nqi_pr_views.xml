<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nqi_pr_bidding_info_list" model="ir.ui.view">
        <field name="name">nqi.pr.bidding.info.list</field>
        <field name="model">sn.wsd.nqi.pr.bidding.info</field>
        <field name="arch" type="xml">
            <list decoration-warning="missing_count &gt; 0">
                <field name="business_contract_code"/>
                <field name="bidding_batch"/>
                <field name="bidding_position"/>
                <field name="bidding_time"/>
                <field name="bidding_count"/>
                <field name="uaser_nature"/>
                <field name="missing_count" optional="hide"/>
                <field name="push_state" widget="badge" decoration-info="push_state == 'to_push'" decoration-success="push_state == 'pushed'"/>
            </list>
        </field>
    </record>
    <record id="view_nqi_pr_bidding_info_form" model="ir.ui.view">
        <field name="name">nqi.pr.bidding.info.form</field>
        <field name="model">sn.wsd.nqi.pr.bidding.info</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="push_state" widget="statusbar" statusbar_visible="draft,to_push,pushed"/>
                    <button name="action_mark_to_push" type="object" string="Mark to Push" class="oe_highlight" invisible="push_state != 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group string="NQI Columns">
                            <field name="business_contract_code"/>
                            <field name="bidding_batch"/>
                            <field name="bidding_position"/>
                            <field name="bidding_party_a_id"/>
                            <field name="bidding_party_a"/>
                            <field name="bidding_time"/>
                            <field name="bidding_count"/>
                            <field name="uaser_nature"/>
                            <field name="development_project_no"/>
                            <field name="software_version"/>
                            <field name="hardware_version"/>
                            <field name="product_detail_code"/>
                            <field name="internal_control_code"/>
                        </group>
                        <group string="Envelope">
                            <field name="missing_fields" readonly="1"/>
                            <field name="enterprise_code"/>
                            <field name="nqi_write_date"/>
                            <field name="handle_flag"/>
                            <field name="handle_date"/>
                            <field name="notice_no"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_nqi_pr_bidding_info_search" model="ir.ui.view">
        <field name="name">nqi.pr.bidding.info.search</field>
        <field name="model">sn.wsd.nqi.pr.bidding.info</field>
        <field name="arch" type="xml">
            <search>
                <field name="business_contract_code"/>
                <filter name="to_push" string="To Push" domain="[('push_state', '=', 'to_push')]"/>
                <filter name="filter_missing" string="Missing Data" domain="[('missing_count', '>', 0)]"/>
                <group>
                    <filter name="group_by_state" string="Push State" context="{'group_by': 'push_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_nqi_pr_bidding_info" model="ir.actions.act_window">
        <field name="name">PR_BIDDING_INFO</field>
        <field name="res_model">sn.wsd.nqi.pr.bidding.info</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_nqi_pr_bidding_info_entry"
              name="PR_BIDDING_INFO"
              parent="menu_nqi_purchase"
              action="action_nqi_pr_bidding_info"
              sequence="10"/>

