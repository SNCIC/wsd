<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nqi_fit_meter_info_list" model="ir.ui.view">
        <field name="name">nqi.fit.meter.info.list</field>
        <field name="model">sn.wsd.nqi.fit.meter.info</field>
        <field name="arch" type="xml">
            <list decoration-warning="missing_count &gt; 0">
                <field name="serial_identity_id"/>
                <field name="serial_no"/>
                <field name="make_plan_no"/>
                <field name="assets_code"/>
                <field name="barcode"/>
                <field name="meter_no"/>
                <field name="missing_count" optional="hide"/>
                <field name="push_state" widget="badge" decoration-info="push_state == 'to_push'" decoration-success="push_state == 'pushed'"/>
            </list>
        </field>
    </record>
    <record id="view_nqi_fit_meter_info_form" model="ir.ui.view">
        <field name="name">nqi.fit.meter.info.form</field>
        <field name="model">sn.wsd.nqi.fit.meter.info</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="push_state" widget="statusbar" statusbar_visible="draft,to_push,pushed"/>
                    <button name="action_mark_to_push" type="object" string="Mark to Push" class="oe_highlight" invisible="push_state != 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group string="Bring-in Anchor">
                            <field name="serial_identity_id"/>
                        </group>
                        <group string="NQI Columns">
                            <field name="serial_no"/>
                            <field name="make_plan_no"/>
                            <field name="assets_code"/>
                            <field name="barcode"/>
                            <field name="meter_no"/>
                            <field name="software_version"/>
                            <field name="out_factory_supply"/>
                            <field name="conc_code"/>
                            <field name="test_date"/>
                            <field name="status"/>
                        </group>
                        <group string="Envelope">
                            <field name="missing_fields" readonly="1"/>
                            <field name="enterprise_code"/>
                            <field name="nqi_write_date"/>
                            <field name="handle_flag"/>
                            <field name="handle_date"/>
                            <field name="notice_no"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nqi_fit_meter_info_search" model="ir.ui.view">
        <field name="name">nqi.fit.meter.info.search</field>
        <field name="model">sn.wsd.nqi.fit.meter.info</field>
        <field name="arch" type="xml">
            <search>
                <field name="serial_no"/>
                <filter name="to_push" string="To Push" domain="[('push_state', '=', 'to_push')]"/>
                <filter name="filter_missing" string="Missing Data" domain="[('missing_count', '>', 0)]"/>
                <group>
                    <filter name="group_by_state" string="Push State" context="{'group_by': 'push_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_nqi_fit_meter_info" model="ir.actions.act_window">
        <field name="name">FIT_METER_INFO</field>
        <field name="res_model">sn.wsd.nqi.fit.meter.info</field>
        <field name="view_mode">list,form</field>
        <field name='context'>{'search_default_filter_recent': 1}</field>
    </record>
    <menuitem id="menu_nqi_fit_meter_info_entry"
              name="FIT_METER_INFO"
              parent="menu_nqi_process"
              action="action_nqi_fit_meter_info"
              sequence="10"/>

