<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nqi_pt_plan_list" model="ir.ui.view">
        <field name="name">nqi.pt.plan.list</field>
        <field name="model">sn.wsd.nqi.pt.plan</field>
        <field name="arch" type="xml">
            <list decoration-warning="missing_count &gt; 0">
                <field name="sale_order_id"/>
                <field name="plan_code"/>
                <field name="start_time"/>
                <field name="finish_time"/>
                <field name="business_contract_code"/>
                <field name="product_code"/>
                <field name="missing_count" optional="hide"/>
                <field name="push_state" widget="badge" decoration-info="push_state == 'to_push'" decoration-success="push_state == 'pushed'"/>
            </list>
        </field>
    </record>
    <record id="view_nqi_pt_plan_form" model="ir.ui.view">
        <field name="name">nqi.pt.plan.form</field>
        <field name="model">sn.wsd.nqi.pt.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="push_state" widget="statusbar" statusbar_visible="draft,to_push,pushed"/>
                    <button name="action_mark_to_push" type="object" string="Mark to Push" class="oe_highlight" invisible="push_state != 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group string="Bring-in Anchor">
                            <field name="sale_order_id"/>
                        </group>
                        <group string="NQI Columns">
                            <field name="plan_code"/>
                            <field name="start_time"/>
                            <field name="finish_time"/>
                            <field name="business_contract_code"/>
                            <field name="product_code"/>
                        </group>
                        <group string="Envelope">
                            <field name="missing_fields" readonly="1"/>
                            <field name="enterprise_code"/>
                            <field name="nqi_write_date"/>
                            <field name="handle_flag"/>
                            <field name="handle_date"/>
                            <field name="notice_no"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_nqi_pt_plan_search" model="ir.ui.view">
        <field name="name">nqi.pt.plan.search</field>
        <field name="model">sn.wsd.nqi.pt.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_code"/>
                <filter name="to_push" string="To Push" domain="[('push_state', '=', 'to_push')]"/>
                <filter name="filter_missing" string="Missing Data" domain="[('missing_count', '>', 0)]"/>
                <group>
                    <filter name="group_by_state" string="Push State" context="{'group_by': 'push_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_nqi_pt_plan" model="ir.actions.act_window">
        <field name="name">PT_PRODUCTION_PLAN</field>
        <field name="res_model">sn.wsd.nqi.pt.plan</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_nqi_pt_plan_entry"
              name="PT_PRODUCTION_PLAN"
              parent="menu_nqi_plan"
              action="action_nqi_pt_plan"
              sequence="10"/>

