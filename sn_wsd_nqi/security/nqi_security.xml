<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_nqi" model="ir.module.category">
            <field name="name">NQI Integration</field>
            <field name="sequence">65</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_nqi">
            <field name="name">NQI Integration</field>
            <field name="category_id" ref="module_category_nqi"/>
        </record>

        <record id="group_nqi_user" model="res.groups">
            <field name="name">NQI User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_nqi"/>
        </record>

        <record id="group_nqi_manager" model="res.groups">
            <field name="name">NQI Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_nqi_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_nqi"/>
        </record>

        <record id="rule_nqi_config_company" model="ir.rule">
            <field name="name">NQI Config Multi-company</field>
            <field name="model_id" ref="model_sn_wsd_nqi_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
