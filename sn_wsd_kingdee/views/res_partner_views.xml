<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_kingdee" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.sn.wsd.kingdee</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Kingdee" name="kingdee">
                        <group>
                            <group string="Customer">
                                <field name="kingdee_number"
                                       placeholder="Defaults to the reference"/>
                                <field name="kingdee_name"/>
                                <label for="kingdee_currency_number"/>
                                <div class="o_row">
                                    <field name="kingdee_currency_number" nolabel="1"
                                           placeholder="Defaults to the currency from Settings"/>
                                    <field name="kingdee_currency_name"
                                           nolabel="1" readonly="1" class="text-muted"/>
                                </div>
                                <label for="kingdee_salesman_number"/>
                                <div class="o_row">
                                    <field name="kingdee_salesman_number" nolabel="1"
                                           placeholder="Defaults to the salesman from Settings"/>
                                    <field name="kingdee_salesman_name"
                                           nolabel="1" readonly="1" class="text-muted"/>
                                </div>
                                <label for="kingdee_sales_dept_number"/>
                                <div class="o_row">
                                    <field name="kingdee_sales_dept_number" nolabel="1"
                                           placeholder="Defaults to the department from Settings"/>
                                    <field name="kingdee_sales_dept_name"
                                           nolabel="1" readonly="1" class="text-muted"/>
                                </div>
                            </group>
                            <group string="Synchronization">
                                <field name="kingdee_sync_state"/>
                                <field name="kingdee_master_id"/>
                                <field name="kingdee_last_sync_at"/>
                            </group>
                        </group>
                        <div class="mt16">
                            <button name="action_kingdee_save"
                                    type="object"
                                    string="Save to Kingdee"
                                    class="btn-primary"/>
                            <button name="action_kingdee_submit"
                                    type="object"
                                    string="Submit"
                                    class="btn-secondary"/>
                            <button name="action_kingdee_audit"
                                    type="object"
                                    string="Audit"
                                    class="btn-secondary"/>
                            <button name="action_kingdee_unaudit"
                                    type="object"
                                    string="Un-audit"
                                    class="btn-secondary"/>
                            <button name="action_kingdee_pull"
                                    type="object"
                                    string="Refresh from Kingdee"
                                    class="btn-secondary"/>
                            <button name="action_kingdee_delete"
                                    type="object"
                                    string="Delete in Kingdee"
                                    class="btn-link text-danger"
                                    confirm="The customer is deleted in Kingdee. Continue?"/>
                        </div>
                        <field name="kingdee_sync_message" readonly="1" class="mt16"/>
                        <field name="kingdee_log_ids" readonly="1">
                            <list create="false" delete="false" default_order="id desc">
                                <field name="create_date"/>
                                <field name="api_name"/>
                                <field name="direction"/>
                                <field name="state"
                                       decoration-danger="state == 'error'"
                                       decoration-success="state == 'success'"/>
                                <field name="duration_ms"/>
                                <field name="error_message" optional="show"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- The partner form of the list view (res.partner "simple" form) also
             shows the page: the same mixin fields are used, no extra record. -->
        <record id="view_partner_kingdee_search" model="ir.ui.view">
            <field name="name">res.partner.search.inherit.sn.wsd.kingdee</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter name="kingdee_linked"
                            string="Linked to Kingdee"
                            domain="[('kingdee_number', '!=', False)]"/>
                    <filter name="kingdee_error"
                            string="Kingdee Errors"
                            domain="[('kingdee_sync_state', '=', 'error')]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
