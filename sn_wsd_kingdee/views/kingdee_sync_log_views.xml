<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kingdee_sync_log_list" model="ir.ui.view">
            <field name="name">sn.wsd.kingdee.sync.log.list</field>
            <field name="model">sn.wsd.kingdee.sync.log</field>
            <field name="arch" type="xml">
                <list string="Kingdee Sync Log" create="false" edit="false"
                      decoration-danger="state == 'error'"
                      decoration-success="state == 'success'">
                    <field name="create_date"/>
                    <field name="api_name"/>
                    <field name="form_id"/>
                    <field name="direction"/>
                    <field name="state"/>
                    <field name="res_name"/>
                    <field name="duration_ms"/>
                    <field name="user_id" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <button name="action_open_related_record"
                            type="object"
                            string="Open"
                            class="btn-link"
                            invisible="not res_model or not res_id"/>
                </list>
            </field>
        </record>

        <record id="view_kingdee_sync_log_form" model="ir.ui.view">
            <field name="name">sn.wsd.kingdee.sync.log.form</field>
            <field name="model">sn.wsd.kingdee.sync.log</field>
            <field name="arch" type="xml">
                <form string="Kingdee Sync Log" create="false" edit="false">
                    <header>
                        <button name="action_open_related_record"
                                type="object"
                                string="Open Related Record"
                                class="btn-secondary"
                                invisible="not res_model or not res_id"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="api_name"/>
                                <field name="form_id"/>
                                <field name="direction"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="res_name"/>
                                <field name="duration_ms"/>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="create_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Error" invisible="not error_message">
                                <field name="error_message" readonly="1"/>
                            </page>
                            <page string="Request">
                                <field name="request_payload" readonly="1"/>
                            </page>
                            <page string="Response">
                                <field name="response_payload" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_kingdee_sync_log_search" model="ir.ui.view">
            <field name="name">sn.wsd.kingdee.sync.log.search</field>
            <field name="model">sn.wsd.kingdee.sync.log</field>
            <field name="arch" type="xml">
                <search string="Kingdee Sync Log">
                    <field name="api_name"/>
                    <field name="form_id"/>
                    <field name="res_name"/>
                    <field name="user_id"/>
                    <filter name="filter_error" string="Errors" domain="[('state', '=', 'error')]"/>
                    <separator/>
                    <filter name="filter_direction_out" string="Odoo to Kingdee"
                            domain="[('direction', '=', 'out')]"/>
                    <filter name="filter_direction_in" string="Kingdee to Odoo"
                            domain="[('direction', '=', 'in')]"/>
                    <group>
                        <filter name="group_api_name" string="API" context="{'group_by': 'api_name'}"/>
                        <filter name="group_form_id" string="Form ID" context="{'group_by': 'form_id'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_kingdee_sync_log" model="ir.actions.act_window">
            <field name="name">Kingdee Sync Logs</field>
            <field name="res_model">sn.wsd.kingdee.sync.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_kingdee_sync_log_search"/>
        </record>
    </data>
</odoo>
