<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kingdee_push_daily_list" model="ir.ui.view">
        <field name="name">sn.wsd.kingdee.push.daily.list</field>
        <field name="model">sn.wsd.kingdee.push.daily</field>
        <field name="arch" type="xml">
            <list create="0">
                <header>
                    <button name="action_generate_today" type="object"
                            string="Build Today" class="btn-primary"/>
                </header>
                <field name="date"/>
                <field name="pushed"/>
                <field name="failed" decoration-danger="failed &gt; 0"/>
                <field name="success_rate" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_kingdee_push_daily_form" model="ir.ui.view">
        <field name="name">sn.wsd.kingdee.push.daily.form</field>
        <field name="model">sn.wsd.kingdee.push.daily</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="date"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pushed"/>
                            <field name="failed"/>
                        </group>
                        <group>
                            <field name="success_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list create="0" editable="bottom">
                            <field name="module"/>
                            <field name="kind"/>
                            <field name="form_id"/>
                            <field name="pushed"/>
                            <field name="failed" decoration-danger="failed &gt; 0"/>
                            <field name="success_rate" widget="progressbar"/>
                        </list>
                    </field>
                    <field name="note" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kingdee_push_daily" model="ir.actions.act_window">
        <field name="name">Push Report</field>
        <field name="res_model">sn.wsd.kingdee.push.daily</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No push report yet</p>
            <p>
                The report is built every night from the synchronization log. Use
                <b>Kingdee &gt; Push Report &gt; New</b> to build the report of a day by
                hand: one line per document kind, grouped by department.
            </p>
        </field>
    </record>
</odoo>
