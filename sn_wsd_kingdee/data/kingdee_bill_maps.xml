            <field name="bill_type_number">XSCKD01_SYS</field>
            <field name="note_field">FNote</field>
        </record>

        <record id="bill_map_sale_return" model="sn.wsd.kingdee.bill.map">
            <field name="sequence">60</field>
            <field name="name">Sales Return</field>
            <field name="model_name">stock.picking</field>
