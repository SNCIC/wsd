<odoo>
    <!--
        The document kinds this account receives, one row per kind.

        The bill types are the ones read on the account's own BOS_BillType on
        2026-11-25: CGDD01_SYS standard purchase order, RKD01_SYS standard purchase
        receipt, TLD01_SYS standard return, XSDD01_SYS standard sales order,
        XSCKD01_SYS standard sales delivery, XSTHD01_SYS standard sales return,
        QTRKD01_SYS standard other receipt, QTCKD01_SYS standard other delivery,
        ZJDB01_SYS standard direct transfer, SCDD03_SYS production order booked on
        direct receipt, SCLLD01_SYS standard material issue, SCTLD01_SYS standard
        material return and SCRKD02_SYS production receipt.

        noupdate: a bill type, a switch or a filter changed by the implementation
        team must survive an upgrade - the account numbers its documents, not the
        module.
    -->
    <data noupdate="1">
        <record id="bill_map_purchase_order" model="sn.wsd.kingdee.bill.map">
            <field name="sequence">10</field>
            <field name="name">Purchase Order</field>
            <field name="model_name">purchase.order</field>
            <field name="kind">purchase_order</field>
            <field name="form_id">PUR_PurchaseOrder</field>
            <field name="bill_type_number">CGDD01_SYS</field>
            <field name="business_type">CG</field>
            <field name="note_field"></field>
        </record>

        <record id="bill_map_receipt" model="sn.wsd.kingdee.bill.map">
            <field name="sequence">20</field>
            <field name="name">Purchase Receipt</field>
            <field name="model_name">stock.picking</field>
            <field name="kind">receipt</field>
            <field name="picking_type_field">store_type_id</field>
            <field name="form_id">STK_InStock</field>
            <field name="bill_type_number">RKD01_SYS</field>
            <field name="business_type">CG</field>
            <field name="note_field"></field>
        </record>

        <record id="bill_map_vendor_return" model="sn.wsd.kingdee.bill.map">
            <field name="sequence">30</field>
            <field name="name">Purchase Return</field>
            <field name="model_name">stock.picking</field>
            <field name="kind">vendor_return</field>
            <field name="picking_type_field">sn_unstored_return_type_id</field>
            <field name="form_id">PUR_MRB</field>
            <field name="bill_type_number">TLD01_SYS</field>
            <field name="business_type">CG</field>
            <field name="note_field">FDESCRIPTION</field>
        </record>

        <record id="bill_map_sale_order" model="sn.wsd.kingdee.bill.map">
            <field name="sequence">40</field>
            <field name="name">Sales Order</field>
            <field name="model_name">sale.order</field>
            <field name="kind">sale_order</field>
            <field name="form_id">SAL_SaleOrder</field>
            <field name="bill_type_number">XSDD01_SYS</field>
            <field name="note_field">FNote</field>
        </record>

        <record id="bill_map_delivery" model="sn.wsd.kingdee.bill.map">
            <field name="sequence">50</field>
            <field name="name">Sales Delivery</field>
