            <field name="picking_type_field">picking_type_receipt_id</field>
            <field name="form_id">PRD_INSTOCK</field>
            <field name="bill_type_number">SCRKD02_SYS</field>
            <field name="note_field">FDescription</field>
        </record>
    </data>
</odoo>
