<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_workcenter_form_sn_wsd_workorder" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.sn.wsd.workorder</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='costs_hour']" position="after">
                <field name="sn_shop_floor_enabled"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Equipment" name="sn_equipment">
                    <field name="sn_equipment_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="equipment_id"/>
                            <field name="equipment_code"/>
                            <field name="equipment_name"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
