<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_form_sn_wsd_workorder" model="ir.ui.view">
        <field name="name">mrp.workorder.form.sn.wsd.workorder</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_sn_shop_floor" type="object" string="Open Shop Floor" icon="oi-view-kanban" class="btn-secondary" invisible="state in ['done', 'cancel']"/>
            </xpath>
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="sn_employee_assigned_ids" widget="many2many_tags" readonly="state == 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>
