<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_sn_wsd_workorder" model="ir.ui.view">
        <field name="name">mrp.production.form.sn.wsd.workorder</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_sn_shop_floor" type="object" icon="oi-view-kanban" string="Shop Floor" invisible="state in ['draft', 'done', 'cancel']"/>
            </xpath>
        </field>
    </record>
</odoo>
