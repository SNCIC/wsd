<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_operations_picklight" model="ir.ui.view">
        <field name="name">stock.move.operations.picklight</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_print_material_labels']" position="after">
                <button name="action_auto_fill_large_rack_locations"
                        string="Large Rack Locations"
                        type="object"
                        class="btn btn-link"
                        groups="stock.group_stock_user"
                        invisible="picking_code != 'incoming' or state in ['done', 'cancel']"/>
                <button name="action_auto_fill_small_rack_locations"
                        string="Small Rack Locations"
                        type="object"
                        class="btn btn-link"
                        groups="stock.group_stock_user"
                        invisible="picking_code != 'incoming' or state in ['done', 'cancel']"/>
                <button name="action_light_receipt_destination_locations"
                        string="Light On"
                        type="object"
                        class="btn btn-link"
                        icon="fa-lightbulb-o"
                        groups="stock.group_stock_user"
                        invisible="picking_code != 'incoming' or state in ['done', 'cancel']"/>
                <button name="action_turn_off_receipt_destination_locations"
                        string="Light Off"
                        type="object"
                        class="btn btn-link"
                        icon="fa-toggle-off"
                        groups="stock.group_stock_user"
                        invisible="picking_code != 'incoming' or state in ['done', 'cancel']"/>
            </xpath>
        </field>
    </record>
</odoo>
