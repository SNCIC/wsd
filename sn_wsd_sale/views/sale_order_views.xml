<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Note of the order lines: it follows the amounts so the remark of a
         line is read next to what it is about. -->
    <record id="view_sale_order_form_line_note" model="ir.ui.view">
        <field name="name">sale.order.form.line.note</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list/field[@name='price_subtotal'][last()]" position="after">
                <field name="note" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='name']" position="after">
                <field name="note"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list/field[@name='note']" position="after">
                <field name="sn_delivery_date" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='note']" position="after">
                <field name="sn_delivery_date"/>
            </xpath>
        </field>
    </record>

    <!-- Dot-matrix sheet of the order: the single button of the header opens
         the preview of the 241 x 140 mm form, and the Print button of that
         preview renders the same report as a PDF. The ESC/P stream of the
         printer bridge is handed out from the list, where a whole selection is
         printed in one job. -->
    <record id="view_sale_order_form_prn_buttons" model="ir.ui.view">
        <field name="name">sale.order.form.prn.buttons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">92</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sale_order_prn_preview" type="object"
                        string="Preview Order Sheet" invisible="state == 'cancel'"/>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="sn_summary"/>
            </xpath>
        </field>
    </record>

    <!-- Batch printing from the list: the buttons of the list header hand the
         selection to the two sheets of the order, the PDF rendering and the
         ESC/P stream of the printer bridge. The action of the ESC/P stream is
         a server action, so the selection is what the bridge receives.

         No `display` attribute on purpose: the value defaults to "selection"
         (web/static/src/views/utils.js, processButton), so the control panel
         places the buttons in the selection box and they appear only once rows
         are selected, the same behaviour as the "Create Invoices" button of
         the standard order list. `display="always"` would leave them on the
         bar with nothing to print. -->
    <record id="action_print_sale_order_prn" model="ir.actions.server">
        <field name="name">Print Order Sheets (ESC/P)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_sale_order_prn()</field>
    </record>

    <record id="view_sale_order_list_prn_buttons" model="ir.ui.view">
        <field name="name">sale.order.list.prn.buttons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="priority">92</field>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="%(sn_wsd_sale.action_report_sale_order_prn)d"
                        type="action" string="Print Order Sheets"/>
                <button name="%(sn_wsd_sale.action_print_sale_order_prn)d"
                        type="action" string="Print Order Sheets (ESC/P)"/>
            </xpath>
        </field>
    </record>

    <!-- Delivery date in the order header, next to the order date: the date is
         read while the order is written, not on the other information page.
         The field kept on that page is only hidden, so that the fields the
         delivery modules added to the same group stay where they belong. -->
    <record id="view_sale_order_form_delivery_date" model="ir.ui.view">
        <field name="name">sale.order.form.delivery.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']//label[@for='commitment_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_shipping']//field[@name='commitment_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_shipping']//span[@name='expected_date_span' or not(@name)]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <label for="commitment_date"/>
                <div name="sn_commitment_date_div" class="o_row">
                    <field name="commitment_date" readonly="state == 'cancel' or locked"/>
                    <span name="sn_expected_date_span" class="text-muted" invisible="not expected_date">Expected: <field name="expected_date" class="oe_inline"/></span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
