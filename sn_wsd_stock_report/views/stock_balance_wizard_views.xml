<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_stock_balance_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.stock.balance.wizard.form</field>
        <field name="model">sn.wsd.stock.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="收发汇总表">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="生成报表"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="取消" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_stock_balance_wizard" model="ir.actions.act_window">
        <field name="name">收发汇总表</field>
        <field name="res_model">sn.wsd.stock.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
