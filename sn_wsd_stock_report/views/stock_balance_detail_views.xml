<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_stock_balance_detail_list" model="ir.ui.view">
        <field name="name">sn.wsd.stock.balance.detail.list</field>
        <field name="model">sn.wsd.stock.balance.detail</field>
        <field name="arch" type="xml">
            <!-- action/type：点行即打开来源单据（同库存流水的列表行为） -->
            <list create="false" edit="false" delete="false"
                  action="action_open_document" type="object"
                  decoration-success="direction == 'in'"
                  decoration-danger="direction == 'out'">
                <field name="date"/>
                <field name="direction" widget="badge"/>
                <field name="reference"/>
                <field name="product_id" optional="hide"/>
                <field name="default_code" optional="hide"/>
                <field name="product_name" optional="hide"/>
                <field name="material_specification" optional="hide"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="lot_id" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="quantity" sum="数量合计"/>
                <field name="uom_id" optional="show"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="picking_id" optional="hide"/>
                <field name="move_line_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_stock_balance_detail_search" model="ir.ui.view">
        <field name="name">sn.wsd.stock.balance.detail.search</field>
        <field name="model">sn.wsd.stock.balance.detail</field>
        <field name="arch" type="xml">
            <search string="收发明细">
                <field name="default_code" string="物料编码" filter_domain="[('default_code', 'ilike', self)]"/>
                <field name="product_name" string="物料名称" filter_domain="[('product_name', 'ilike', self)]"/>
                <field name="reference" string="单据" filter_domain="[('reference', 'ilike', self)]"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="filter_direction_in" string="只看收入" domain="[('direction', '=', 'in')]"/>
                <filter name="filter_direction_out" string="只看发出" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <group>
                    <filter name="group_product" string="物料" context="{'group_by': 'product_id'}"/>
                    <filter name="group_direction" string="方向" context="{'group_by': 'direction'}"/>
                    <filter name="group_date" string="日期" context="{'group_by': 'date'}"/>
                    <filter name="group_reference" string="单据" context="{'group_by': 'reference'}"/>
                    <filter name="group_warehouse" string="仓库" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_stock_balance_detail" model="ir.actions.act_window">
        <field name="name">收发明细</field>
        <field name="res_model">sn.wsd.stock.balance.detail</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_sn_wsd_stock_balance_detail_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">该物料在所选区间内没有跨越库存区的收发流水</p>
            <p>明细与收发汇总表同源：跨库存区边界的已完成流水在目标仓库记收入、在来源仓库记发出，
               库内调拨不在此列出。</p>
        </field>
    </record>
</odoo>
