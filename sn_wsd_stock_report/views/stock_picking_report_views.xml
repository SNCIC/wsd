<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Goods receipt details (Inventory > Reporting): one row per receipt, the
         operation that brings the vendor goods in. Read-only, and a row opens
         the transfer it reports. -->
    <record id="view_sn_wsd_goods_receipt_detail_list" model="ir.ui.view">
        <field name="name">stock.picking.goods.receipt.detail.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Goods Receipt Details" create="false" edit="false" delete="false"
                  decoration-muted="state == 'cancel'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="picking_type_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="origin"/>
                <field name="scheduled_date"/>
                <field name="date_done"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
                <field name="x_reception_step" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Putaway details (Inventory > Reporting): one row per storage, the
         operation that brings the inspected goods into the warehouse stock on a
         three-step reception. -->
    <record id="view_sn_wsd_putaway_detail_list" model="ir.ui.view">
        <field name="name">stock.picking.putaway.detail.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Putaway Details" create="false" edit="false" delete="false"
                  decoration-muted="state == 'cancel'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="origin"/>
                <field name="location_id" groups="stock.group_stock_multi_locations"/>
                <field name="location_dest_id" groups="stock.group_stock_multi_locations"/>
                <field name="scheduled_date"/>
                <field name="date_done"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
                <field name="x_reception_step" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Shared search: both lists report one step of the same operation, so a
         single search carries the filters and the groupings they share. -->
    <record id="view_sn_wsd_reception_detail_search" model="ir.ui.view">
        <field name="name">stock.picking.reception.detail.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Reception Details">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="origin"/>
                <field name="picking_type_id"/>
                <separator/>
                <filter name="filter_to_process" string="To Process"
                        domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="filter_done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_date_done" string="Done Date" date="date_done"/>
                <separator/>
                <group>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_origin" string="Source Document" context="{'group_by': 'origin'}"/>
                    <filter name="group_picking_type" string="Operation Type" context="{'group_by': 'picking_type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date_done" string="Done Date" context="{'group_by': 'date_done'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_goods_receipt_detail" model="ir.actions.act_window">
        <field name="name">Goods Receipt Details</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sn_wsd_goods_receipt_detail_list"/>
        <field name="search_view_id" ref="view_sn_wsd_reception_detail_search"/>
        <field name="domain">[('x_reception_step', '=', 'receipt')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No goods receipt yet</p>
            <p>Every receipt of the warehouses is listed here, with the vendor,
                the source document it comes from and the day it was completed.</p>
        </field>
    </record>

    <record id="action_sn_wsd_putaway_detail" model="ir.actions.act_window">
        <field name="name">Putaway Details</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sn_wsd_putaway_detail_list"/>
        <field name="search_view_id" ref="view_sn_wsd_reception_detail_search"/>
        <field name="domain">[('x_reception_step', '=', 'storage')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No putaway yet</p>
            <p>Every storage of the warehouses is listed here: the operation
                that brings the inspected goods into the stock on a three-step
                reception.</p>
        </field>
    </record>
</odoo>
