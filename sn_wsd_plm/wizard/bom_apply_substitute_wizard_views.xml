<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bom_apply_substitute_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.bom.apply.substitute.wizard.form</field>
        <field name="model">sn.wsd.bom.apply.substitute.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Substitute">
                <sheet>
                    <group>
                        <group>
                            <field name="bom_id"/>
                            <field name="bom_line_id"/>
                            <field name="original_product_id"/>
                            <field name="original_qty"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                        </group>
                        <group>
                            <field name="available_substitute_ids" invisible="1"/>
                            <field name="substitute_product_id"/>
                            <field name="substitute_qty"/>
                            <field name="substitute_product_uom_id" groups="uom.group_uom"/>
                            <field name="operation_id" groups="mrp.group_mrp_routings"/>
                            <field name="substitution_mode" readonly="1" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
