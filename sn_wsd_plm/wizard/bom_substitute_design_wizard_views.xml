<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bom_substitute_design_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.bom.substitute.design.wizard.form</field>
        <field name="model">sn.wsd.bom.substitute.design.wizard</field>
        <field name="arch" type="xml">
            <form string="Substitute Design">
                <sheet>
                    <group>
                        <field name="bom_id"/>
                        <field name="bom_line_id"/>
                        <field name="product_id"/>
                    </group>
                    <group string="Allowed Substitutes">
                        <field name="substitute_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
