<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bom_version_compare_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.bom.version.compare.wizard.form</field>
        <field name="model">sn.wsd.bom.version.compare.wizard</field>
        <field name="arch" type="xml">
            <form string="BoM Version Comparison" class="o_sn_wsd_bom_version_compare">
                <sheet>
                    <field name="available_bom_ids" invisible="1"/>
                    <field name="available_route_ids" invisible="1"/>
                    <field name="comparison_mode" invisible="1"/>
                    <group string="Comparison Scope">
                        <group>
                            <field name="base_bom_id"
                                   options="{'no_create': true, 'no_open': true}"
                                   context="{'sn_wsd_revision_display': True}"
                                   required="comparison_mode == 'bom'"
                                   invisible="comparison_mode != 'bom'"/>
                            <field name="base_route_id"
                                   options="{'no_create': true, 'no_open': true}"
                                   context="{'sn_wsd_revision_display': True}"
                                   required="comparison_mode == 'route'"
                                   invisible="comparison_mode != 'route'"/>
                        </group>
                        <group>
                            <field name="target_bom_id"
                                   options="{'no_create': true, 'no_open': true}"
                                   context="{'sn_wsd_revision_display': True}"
                                   required="comparison_mode == 'bom'"
                                   invisible="comparison_mode != 'bom'"/>
                            <field name="target_route_id"
                                   options="{'no_create': true, 'no_open': true}"
                                   context="{'sn_wsd_revision_display': True}"
                                   required="comparison_mode == 'route'"
                                   invisible="comparison_mode != 'route'"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <group>
                            <field name="total_change_count"/>
                            <field name="added_count"/>
                            <field name="updated_count"/>
                        </group>
                        <group>
                            <field name="removed_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Component Differences" name="components" invisible="comparison_mode != 'bom'">
                            <field name="component_line_ids" nolabel="1" readonly="1">
                                <list create="false" delete="false" no_open="true"
                                      decoration-success="change_type == 'add'"
                                      decoration-danger="change_type == 'remove'"
                                      decoration-warning="change_type == 'update'"
                                      decoration-muted="change_type == 'unchanged'">
                                    <field name="change_type"/>
                                    <field name="product_code"/>
                                    <field name="product_id"/>
                                    <field name="old_qty"/>
                                    <field name="old_uom_id"/>
                                    <field name="new_qty"/>
                                    <field name="new_uom_id"/>
                                    <field name="old_sequence" optional="hide"/>
                                    <field name="new_sequence" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Process Route Operation Differences" name="route_operations" invisible="comparison_mode != 'route'">
                            <field name="route_operation_line_ids" nolabel="1" readonly="1">
                                <list create="false" delete="false" no_open="true"
                                      decoration-success="change_type == 'add'"
                                      decoration-danger="change_type == 'remove'"
                                      decoration-warning="change_type == 'update'"
                                      decoration-muted="change_type == 'unchanged'">
                                    <field name="change_type"/>
                                    <field name="operation_code"/>
                                    <field name="item_name" string="Operation"/>
                                    <field name="old_sequence"/>
                                    <field name="new_sequence"/>
                                    <field name="old_workcenter"/>
                                    <field name="new_workcenter"/>
                                    <field name="old_duration" optional="show"/>
                                    <field name="new_duration" optional="show"/>
                                    <field name="old_dependency" optional="show"/>
                                    <field name="new_dependency" optional="show"/>
                                    <field name="old_value" optional="hide"/>
                                    <field name="new_value" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_compare" type="object" string="Compare" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
