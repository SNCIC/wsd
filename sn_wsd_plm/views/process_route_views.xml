<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_process_route_form_plm_compare" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.form.plm.compare</field>
        <field name="model">sn.wsd.process.route</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_process_route_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_create_new_revision']" position="after">
                <button name="action_compare_revisions"
                        type="object"
                        string="Compare Versions"
                        invisible="x_revision_count &lt; 2"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_compare_revisions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-code-fork"
                            invisible="x_revision_count &lt; 2">
                        <field name="x_revision_count" widget="statinfo" string="Versions"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
