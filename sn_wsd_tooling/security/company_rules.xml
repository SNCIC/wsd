<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_sn_tooling_company" model="ir.rule">
            <field name="name">Tooling Multi-company</field>
            <field name="model_id" ref="model_sn_tooling"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sn_tooling_record_company" model="ir.rule">
            <field name="name">Tooling Record Multi-company</field>
            <field name="model_id" ref="model_sn_tooling_record"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sn_tooling_template_company" model="ir.rule">
            <field name="name">Tooling Template Multi-company</field>
            <field name="model_id" ref="model_sn_tooling_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sn_tooling_type_company" model="ir.rule">
            <field name="name">Tooling Type Multi-company</field>
            <field name="model_id" ref="model_sn_tooling_type"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
