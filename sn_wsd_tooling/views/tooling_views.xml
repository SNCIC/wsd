<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tooling type -->
        <record id="view_sn_tooling_type_list" model="ir.ui.view">
            <field name="name">sn.tooling.type.list</field>
            <field name="model">sn.tooling.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="has_tension" optional="show"/>
                    <field name="has_thickness" optional="show"/>
                    <field name="has_flatness" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_sn_tooling_type_form" model="ir.ui.view">
            <field name="name">sn.tooling.type.form</field>
            <field name="model">sn.tooling.type</field>
            <field name="arch" type="xml">
                <form string="Tooling Type">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="has_tension"/>
                                <field name="has_thickness"/>
                                <field name="has_flatness"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Tooling template -->
        <record id="view_sn_tooling_template_list" model="ir.ui.view">
            <field name="name">sn.tooling.template.list</field>
            <field name="model">sn.tooling.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="spec"/>
                    <field name="type_id"/>
                    <field name="supplier_id" optional="show"/>
                    <field name="tooling_count" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_sn_tooling_template_form" model="ir.ui.view">
            <field name="name">sn.tooling.template.form</field>
            <field name="model">sn.tooling.template</field>
            <field name="arch" type="xml">
                <form string="Tooling Template">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_tooling" icon="fa-wrench">
                                <field name="tooling_count" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="spec"/>
                                <field name="type_id"/>
                                <field name="supplier_id"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group string="Parameter Defaults">
                                <field name="default_tension" invisible="not type_id.has_tension"/>
                                <field name="default_thickness" invisible="not type_id.has_thickness"/>
                                <field name="default_flatness" invisible="not type_id.has_flatness"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Maintenance Rules" name="maintenance_rules">
                                <group>
                                    <group string="By Count">
                                        <field name="maintenance_by_count"/>
                                        <field name="maintenance_count_limit" invisible="not maintenance_by_count"/>
                                        <field name="maintenance_count_reminder" invisible="not maintenance_by_count"/>
                                    </group>
                                    <group string="By Cycle">
                                        <field name="maintenance_by_cycle"/>
                                        <field name="maintenance_cycle_days" invisible="not maintenance_by_cycle"/>
                                        <field name="maintenance_cycle_reminder_days" invisible="not maintenance_by_cycle"/>
                                    </group>
                                </group>
                                <separator string="Maintenance Items"/>
                                <field name="maintenance_item_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="default_result"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_sn_tooling_template_search" model="ir.ui.view">
            <field name="name">sn.tooling.template.search</field>
            <field name="model">sn.tooling.template</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="type_id"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Tooling -->
        <record id="view_sn_tooling_list" model="ir.ui.view">
            <field name="name">sn.tooling.list</field>
            <field name="model">sn.tooling</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sn"/>
                    <field name="template_id"/>
                    <field name="spec" optional="show"/>
                    <field name="type_id" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-info="state in ('idle', 'issued')"
                           decoration-success="state == 'online'"
                           decoration-warning="state in ('maintaining', 'repairing')"
                           decoration-muted="state in ('disabled', 'scrapped')"/>
                    <field name="maintenance_status" widget="badge"
                           decoration-success="maintenance_status == 'normal'"
                           decoration-warning="maintenance_status == 'due'"
                           decoration-danger="maintenance_status == 'expired'"/>
                    <field name="location_id" optional="show"/>
                    <field name="issued_user_id" optional="show"/>
                    <field name="issued_date" optional="hide"/>
                    <field name="total_usage_count" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_sn_tooling_form" model="ir.ui.view">
            <field name="name">sn.tooling.form</field>
            <field name="model">sn.tooling</field>
            <field name="arch" type="xml">
                <form string="Tooling">
                    <header>
                        <button name="action_issue" type="object" string="Issue"
                                class="btn-primary" invisible="state != 'idle'"/>
                        <button name="action_online" type="object" string="Put Online"
                                class="btn-primary" invisible="state != 'issued'"/>
                        <button name="action_offline" type="object" string="Take Offline"
                                invisible="state != 'online'"/>
                        <button name="action_return" type="object" string="Return"
                                class="btn-primary" invisible="state != 'issued'"/>
                        <button name="action_maintain_start" type="object" string="Start Maintenance"
                                invisible="state != 'idle'"/>
                        <button name="action_open_maintain_done" type="object" string="Finish Maintenance"
                                class="btn-primary" invisible="state != 'maintaining'"/>
                        <button name="action_open_repair_start" type="object" string="Start Repair"
                                invisible="state != 'idle'"/>
                        <button name="action_open_repair_done" type="object" string="Finish Repair"
                                class="btn-primary" invisible="state != 'repairing'"/>
                        <button name="action_open_disable" type="object" string="Disable"
                                invisible="state != 'idle'"/>
                        <button name="action_enable" type="object" string="Enable"
                                invisible="state != 'disabled'"/>
                        <button name="action_open_scrap" type="object" string="Scrap"
                                invisible="state not in ('idle', 'disabled')" groups="mrp.group_mrp_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="idle,issued,online"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_records" icon="fa-history">
                                <field name="record_count" widget="statinfo" string="History"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="sn"/>
                                <field name="template_id"/>
                                <field name="type_id"/>
                                <field name="spec"/>
                                <field name="location_id"/>
                                <field name="manufacture_date"/>
                            </group>
                            <group string="Measured Parameters">
                                <field name="tension" invisible="not type_id.has_tension"/>
                                <field name="thickness" invisible="not type_id.has_thickness"/>
                                <field name="flatness" invisible="not type_id.has_flatness"/>
                            </group>
                            <group string="Usage &amp; Maintenance">
                                <field name="total_usage_count"/>
                                <field name="cycle_usage_count"/>
                                <field name="last_maintenance_date"/>
                                <field name="maintenance_status"/>
                            </group>
                            <group string="Issue Info">
                                <field name="issued_user_id"/>
                                <field name="issued_date"/>
                                <field name="disable_reason" invisible="state != 'disabled'"/>
                                <field name="scrap_reason" invisible="state != 'scrapped'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="History" name="history">
                                <field name="record_ids" readonly="1">
                                    <list>
                                        <field name="occurred_at"/>
                                        <field name="action"/>
                                        <field name="user_id"/>
                                        <field name="qty" optional="show"/>
                                        <field name="fault" optional="show"/>
                                        <field name="reason" optional="show"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_sn_tooling_search" model="ir.ui.view">
            <field name="name">sn.tooling.search</field>
            <field name="model">sn.tooling</field>
            <field name="arch" type="xml">
                <search>
                    <field name="sn"/>
                    <field name="template_id"/>
                    <field name="type_id"/>
                    <field name="location_id"/>
                    <filter name="my_issued" string="Issued By Me" domain="[('issued_user_id', '=', uid)]"/>
                    <separator/>
                    <filter name="state_idle" string="Idle" domain="[('state', '=', 'idle')]"/>
                    <filter name="state_issued" string="Issued" domain="[('state', '=', 'issued')]"/>
                    <filter name="state_online" string="Online" domain="[('state', '=', 'online')]"/>
                    <separator/>
                    <filter name="maint_due" string="Maintenance Due" domain="[('maintenance_status', '=', 'due')]"/>
                    <filter name="maint_expired" string="Maintenance Expired" domain="[('maintenance_status', '=', 'expired')]"/>
                    <group>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_type" string="Tooling Type" context="{'group_by': 'type_id'}"/>
                        <filter name="group_template" string="Tooling Template" context="{'group_by': 'template_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Tooling record -->
        <record id="view_sn_tooling_record_list" model="ir.ui.view">
            <field name="name">sn.tooling.record.list</field>
            <field name="model">sn.tooling.record</field>
            <field name="arch" type="xml">
                <list>
                    <field name="occurred_at"/>
                    <field name="tooling_id"/>
                    <field name="template_id" optional="show"/>
                    <field name="action"/>
                    <field name="user_id"/>
                    <field name="qty" optional="show"/>
                    <field name="fault" optional="show"/>
                    <field name="reason" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_sn_tooling_record_form" model="ir.ui.view">
            <field name="name">sn.tooling.record.form</field>
            <field name="model">sn.tooling.record</field>
            <field name="arch" type="xml">
                <form string="Tooling Record">
                    <sheet>
                        <group>
                            <group>
                                <field name="tooling_id"/>
                                <field name="action"/>
                                <field name="user_id"/>
                                <field name="occurred_at"/>
                            </group>
                            <group>
                                <field name="qty"/>
                                <field name="fault"/>
                                <field name="reason"/>
                            </group>
                        </group>
                        <separator string="Check Items"/>
                        <field name="line_ids" readonly="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="result"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sn_tooling_record_search" model="ir.ui.view">
            <field name="name">sn.tooling.record.search</field>
            <field name="model">sn.tooling.record</field>
            <field name="arch" type="xml">
                <search>
                    <field name="tooling_id"/>
                    <field name="template_id"/>
                    <separator/>
                    <filter name="action_issue" string="Issue" domain="[('action', '=', 'issue')]"/>
                    <filter name="action_return" string="Return" domain="[('action', '=', 'return')]"/>
                    <filter name="action_online" string="Online" domain="[('action', '=', 'online')]"/>
                    <filter name="action_offline" string="Offline" domain="[('action', '=', 'offline')]"/>
                    <filter name="action_usage" string="Usage" domain="[('action', '=', 'usage')]"/>
                    <filter name="action_maintain" string="Maintain" domain="[('action', '=', 'maintain')]"/>
                    <filter name="action_repair" string="Repair" domain="[('action', '=', 'repair')]"/>
                    <filter name="action_scrap" string="Scrap" domain="[('action', '=', 'scrap')]"/>
                    <group>
                        <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                        <filter name="group_tooling" string="Tooling SN" context="{'group_by': 'tooling_id'}"/>
                        <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Wizards -->
        <record id="view_sn_tooling_maintain_wizard_form" model="ir.ui.view">
            <field name="name">sn.tooling.maintain.wizard.form</field>
            <field name="model">sn.tooling.maintain.wizard</field>
            <field name="arch" type="xml">
                <form string="Finish Maintenance">
                    <field name="tooling_id" invisible="1"/>
                    <group>
                        <group string="Measured Parameters">
                            <field name="tension"/>
                            <field name="thickness"/>
                            <field name="flatness"/>
                        </group>
                    </group>
                    <separator string="Check Items"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="result"/>
                            <field name="note"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" data-special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sn_tooling_maintain_wizard" model="ir.actions.act_window">
            <field name="name">Finish Maintenance</field>
            <field name="res_model">sn.tooling.maintain.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_sn_tooling_repair_start_wizard_form" model="ir.ui.view">
            <field name="name">sn.tooling.repair.start.wizard.form</field>
            <field name="model">sn.tooling.repair.start.wizard</field>
            <field name="arch" type="xml">
                <form string="Start Repair">
                    <field name="tooling_id" invisible="1"/>
                    <group>
                        <field name="fault"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" data-special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sn_tooling_repair_start_wizard" model="ir.actions.act_window">
            <field name="name">Start Repair</field>
            <field name="res_model">sn.tooling.repair.start.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_sn_tooling_repair_done_wizard_form" model="ir.ui.view">
            <field name="name">sn.tooling.repair.done.wizard.form</field>
            <field name="model">sn.tooling.repair.done.wizard</field>
            <field name="arch" type="xml">
                <form string="Finish Repair">
                    <field name="tooling_id" invisible="1"/>
                    <group>
                        <field name="outcome" widget="radio"/>
                        <field name="reason" invisible="outcome != 'scrap'" required="outcome == 'scrap'"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" data-special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sn_tooling_repair_done_wizard" model="ir.actions.act_window">
            <field name="name">Finish Repair</field>
            <field name="res_model">sn.tooling.repair.done.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_sn_tooling_disable_wizard_form" model="ir.ui.view">
            <field name="name">sn.tooling.disable.wizard.form</field>
            <field name="model">sn.tooling.disable.wizard</field>
            <field name="arch" type="xml">
                <form string="Disable Tooling">
                    <field name="tooling_id" invisible="1"/>
                    <group>
                        <field name="reason"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" data-special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sn_tooling_disable_wizard" model="ir.actions.act_window">
            <field name="name">Disable Tooling</field>
            <field name="res_model">sn.tooling.disable.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_sn_tooling_scrap_wizard_form" model="ir.ui.view">
            <field name="name">sn.tooling.scrap.wizard.form</field>
            <field name="model">sn.tooling.scrap.wizard</field>
            <field name="arch" type="xml">
                <form string="Scrap Tooling">
                    <field name="tooling_id" invisible="1"/>
                    <group>
                        <field name="reason"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" data-special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sn_tooling_scrap_wizard" model="ir.actions.act_window">
            <field name="name">Scrap Tooling</field>
            <field name="res_model">sn.tooling.scrap.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Actions -->
        <record id="action_sn_tooling_type" model="ir.actions.act_window">
            <field name="name">Tooling Types</field>
            <field name="res_model">sn.tooling.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_sn_tooling_template" model="ir.actions.act_window">
            <field name="name">Tooling Templates</field>
            <field name="res_model">sn.tooling.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_sn_tooling" model="ir.actions.act_window">
            <field name="name">Tooling</field>
            <field name="res_model">sn.tooling</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_sn_tooling_record" model="ir.actions.act_window">
            <field name="name">Tooling Records</field>
            <field name="res_model">sn.tooling.record</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_sn_tooling_root" name="Tooling Management" parent="mrp.menu_mrp_root" sequence="46" groups="mrp.group_mrp_user"/>
        <menuitem id="menu_sn_tooling_type" name="Tooling Types" parent="menu_sn_tooling_root" action="action_sn_tooling_type" sequence="5"/>
        <menuitem id="menu_sn_tooling_template" name="Tooling Templates" parent="menu_sn_tooling_root" action="action_sn_tooling_template" sequence="10"/>
        <menuitem id="menu_sn_tooling" name="Tooling" parent="menu_sn_tooling_root" action="action_sn_tooling" sequence="20"/>
        <menuitem id="menu_sn_tooling_record" name="Tooling Records" parent="menu_sn_tooling_root" action="action_sn_tooling_record" sequence="30"/>
    </data>
</odoo>
