<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_request_form_tooling" model="ir.ui.view">
        <field name="name">maintenance.request.form.tooling</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="x_tooling_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
