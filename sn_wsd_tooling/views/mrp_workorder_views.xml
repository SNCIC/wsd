<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_form_tooling" model="ir.ui.view">
        <field name="name">mrp.workorder.form.tooling</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//group[group/field[@name='product_id']]" position="after">
                <group string="Tooling" invisible="not x_tooling_required">
                    <field name="x_tooling_required" invisible="1"/>
                    <field name="x_available_tooling_ids" invisible="1"/>
                    <group>
                        <field name="x_tooling_id" options="{'no_create_edit': True}"/>
                        <button name="action_open_tooling_pda_wizard" type="object" string="PDA Operation" class="btn-secondary"/>
                    </group>
                    <group>
                        <field name="x_tooling_usage_count" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Tooling Usage Logs" invisible="not x_tooling_required or x_tooling_usage_count == 0">
                    <field name="x_tooling_usage_log_ids" nolabel="1">
                        <list create="0">
                            <field name="tooling_id"/>
                            <field name="operator_id"/>
                            <field name="operation_time"/>
                            <field name="pass_qty"/>
                            <field name="panel_count"/>
                            <field name="usage_qty"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_workorder_tree_tooling" model="ir.ui.view">
        <field name="name">mrp.workorder.list.tooling</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
        <field name="arch" type="xml">
            <field name="workcenter_id" position="after">
                <field name="x_tooling_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
