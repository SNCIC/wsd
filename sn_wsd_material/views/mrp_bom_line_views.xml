<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_form_material_specification" model="ir.ui.view">
        <field name="name">mrp.bom.form.material.specification</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <!-- Specification of the product the BOM is built for. The xpath is
                 restricted to the header group: the components list also holds
                 a product_tmpl_id column. -->
            <xpath expr="//group/group/field[@name='product_tmpl_id']" position="after">
                <field name="material_specification" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']//list/field[@name='product_id']" position="after">
                <field name="material_specification" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
