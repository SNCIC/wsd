<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_material_specification" model="ir.ui.view">
        <field name="name">stock.picking.form.material.specification</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']//list/field[@name='product_id']" position="after">
                <field name="material_specification" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_operations_material_specification" model="ir.ui.view">
        <field name="name">stock.move.operations.material.specification</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="material_specification"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_material_specification" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.material.specification</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="material_specification" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_material_specification" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.material.specification</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="material_specification" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_form_material_specification" model="ir.ui.view">
        <field name="name">mrp.production.form.material.specification</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']//list/field[@name='product_id']" position="after">
                <field name="material_specification" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='move_byproduct_ids']//list/field[@name='product_id']" position="after">
                <field name="material_specification" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
