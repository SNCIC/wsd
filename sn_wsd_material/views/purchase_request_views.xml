<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_material_specification" model="ir.ui.view">
        <field name="name">purchase.request.form.material.specification</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']//list/field[@name='product_id']" position="after">
                <field name="material_specification" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
