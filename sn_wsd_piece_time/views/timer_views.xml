<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_work_timer_list" model="ir.ui.view">
        <field name="name">sn.wsd.work.timer.list</field>
        <field name="model">sn.wsd.work.timer</field>
        <field name="arch" type="xml">
            <list string="工位计时" create="false">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="participant_ids" widget="many2many_tags"/>
                <field name="mes_order_id"/>
                <field name="route_operation_id"/>
                <field name="workcenter_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="pause_count"/>
                <field name="hours" sum="合计"/>
                <field name="qty_ok"/>
                <field name="report_id" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'running'"
                       decoration-warning="state == 'paused'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <record id="view_work_timer_form" model="ir.ui.view">
        <field name="name">sn.wsd.work.timer.form</field>
        <field name="model">sn.wsd.work.timer</field>
        <field name="arch" type="xml">
            <form string="工位计时" create="false">
                <header>
                    <button name="action_pause" type="object" string="暂停" invisible="state != 'running'"/>
                    <button name="action_resume" type="object" string="继续" class="btn-primary"
                            invisible="state != 'paused'"/>
                    <button name="action_finish_station" type="object" string="完工" class="btn-primary"
                            invisible="state not in ('running', 'paused') or manage_mode != 'station'"/>
                    <button name="action_cancel" type="object" string="取消"
                            invisible="state not in ('running', 'paused')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="participant_ids" widget="many2many_tags" readonly="1"/>
                            <field name="mes_order_id" readonly="1"/>
                            <field name="route_operation_id" readonly="1"/>
                            <field name="workcenter_id" readonly="1"/>
                            <field name="manage_mode"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="elapsed_display"/>
                            <field name="pause_count"/>
                            <field name="hours"/>
                            <field name="qty_ok"/>
                            <field name="report_id"/>
                        </group>
                    </group>
                    <field name="time_entry_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="hours"/>
                            <field name="qty_ok"/>
                            <field name="source"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_work_timer" model="ir.actions.act_window">
        <field name="name">工位计时</field>
        <field name="res_model">sn.wsd.work.timer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
