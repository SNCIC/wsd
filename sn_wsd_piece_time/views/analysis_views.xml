<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_labor_analysis_list" model="ir.ui.view">
        <field name="name">sn.wsd.labor.analysis.list</field>
        <field name="model">sn.wsd.labor.analysis</field>
        <field name="arch" type="xml">
            <list string="工时分析" create="false" edit="false" delete="false"
                  decoration-danger="efficiency &gt; 0 and efficiency &lt; 85">
                <field name="mes_order_id"/>
                <field name="route_operation_id"/>
                <field name="product_id" optional="hide"/>
                <field name="rate_type"/>
                <field name="qty_ok" sum="合计"/>
                <field name="headcount"/>
                <field name="std_seconds"/>
                <field name="std_hours" sum="合计"/>
                <field name="man_hours" sum="合计"/>
                <field name="diff_hours" sum="合计"/>
                <field name="rework_hours" sum="合计" optional="show"/>
                <field name="efficiency"/>
                <field name="uph"/>
                <field name="piece_amount" sum="合计"/>
                <field name="hour_amount" sum="合计"/>
                <field name="labor_amount" sum="合计"/>
                <button name="action_view_entries" type="object" string="工时" icon="fa-search"/>
            </list>
        </field>
    </record>
    <record id="view_labor_analysis_pivot" model="ir.ui.view">
        <field name="name">sn.wsd.labor.analysis.pivot</field>
        <field name="model">sn.wsd.labor.analysis</field>
        <field name="arch" type="xml">
            <pivot string="工时分析">
                <field name="product_id" type="row"/>
                <field name="qty_ok" type="measure"/>
                <field name="std_hours" type="measure"/>
                <field name="man_hours" type="measure"/>
                <field name="labor_amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_labor_analysis_graph" model="ir.ui.view">
        <field name="name">sn.wsd.labor.analysis.graph</field>
        <field name="model">sn.wsd.labor.analysis</field>
        <field name="arch" type="xml">
            <graph string="实际工时与标准工时" type="bar">
                <field name="route_operation_id"/>
                <field name="std_hours" type="measure"/>
                <field name="man_hours" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_labor_analysis_search" model="ir.ui.view">
        <field name="name">sn.wsd.labor.analysis.search</field>
        <field name="model">sn.wsd.labor.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="mes_order_id"/>
                <field name="product_id"/>
                <group>
                    <filter name="g_order" string="制令单" context="{'group_by': 'mes_order_id'}"/>
                    <filter name="g_product" string="产品" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_labor_analysis" model="ir.actions.act_window">
        <field name="name">工时分析</field>
        <field name="res_model">sn.wsd.labor.analysis</field>
        <field name="view_mode">list,graph,pivot</field>
    </record>

    <record id="view_labor_cost_list" model="ir.ui.view">
        <field name="name">sn.wsd.labor.cost.list</field>
        <field name="model">sn.wsd.labor.cost</field>
        <field name="arch" type="xml">
            <list string="制令单人工成本" create="false" edit="false" delete="false">
                <field name="mes_order_id"/>
                <field name="product_id"/>
                <field name="production_line_id" optional="hide"/>
                <field name="completed_qty"/>
                <field name="man_hours" sum="合计"/>
                <field name="std_hours" sum="合计"/>
                <field name="efficiency"/>
                <field name="rework_hours" sum="合计"/>
                <field name="unit_hours"/>
                <field name="piece_amount" sum="合计"/>
                <field name="hour_amount" sum="合计"/>
                <field name="labor_amount" sum="合计"/>
                <field name="unit_cost"/>
                <field name="downtime_hours" sum="合计"/>
                <button name="action_view_analysis" type="object" string="按工序" icon="fa-bar-chart"/>
            </list>
        </field>
    </record>
    <record id="view_labor_cost_search" model="ir.ui.view">
        <field name="name">sn.wsd.labor.cost.search</field>
        <field name="model">sn.wsd.labor.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="mes_order_id"/>
                <field name="product_id"/>
                <group>
                    <filter name="g_product" string="产品" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_labor_cost" model="ir.actions.act_window">
        <field name="name">制令单人工成本</field>
        <field name="res_model">sn.wsd.labor.cost</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
