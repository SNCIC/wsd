<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         Print Label entry points (label-center design decision 1/6):
         a form button per model (opens the wizard on the current record;
         res_ids is the JSON id array the wizard parses) and a list header
         button (wizard default_get reads active_ids). Both call the
         sn_wsd_label wizard action; no business code here.
         ================================================================== -->

    <!-- ======================= sn.tooling ======================= -->
    <record id="view_sn_tooling_form_print_label" model="ir.ui.view">
        <field name="name">sn.tooling.form.print.label</field>
        <field name="model">sn.tooling</field>
        <field name="inherit_id" ref="sn_wsd_tooling.view_sn_tooling_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="sn_wsd_label.action_sn_label_print_wizard" type="action"
                        string="Print Label"
                        context="{'default_res_model': 'sn.tooling', 'default_res_ids': str([id])}"/>
            </xpath>
        </field>
    </record>

    <record id="view_sn_tooling_list_print_label" model="ir.ui.view">
        <field name="name">sn.tooling.list.print.label</field>
        <field name="model">sn.tooling</field>
        <field name="inherit_id" ref="sn_wsd_tooling.view_sn_tooling_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="sn_wsd_label.action_sn_label_print_wizard" type="action"
                            string="Print Label"
                            context="{'default_res_model': 'sn.tooling'}"/>
                </header>
            </xpath>
        </field>
    </record>

