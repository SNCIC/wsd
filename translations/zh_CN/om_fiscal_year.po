#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_fiscal_year.py:0
msgid "The ending date must not be prior to the starting date."
msgstr "结束日期不能早于开始日期。"

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_fiscal_year.py:0
msgid ""
"You can not have an overlap between two fiscal years, please correct the "
"start and/or end dates of your fiscal years."
msgstr "两个财年之间不能重叠，请修正财年的开始和/或结束日期。"

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/res_company.py:0
msgid ""
"There are still unposted entries in the period you want to lock. You should "
"either post or delete them."
msgstr "您要锁定的期间内仍有未过账的分录。您应将其过账或删除。"

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/res_company.py:0
msgid "Show unposted entries"
msgstr "显示未过账分录"

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/res_company.py:0
msgid ""
"There are still unreconciled bank statement lines in the period you want to "
"lock.You should either reconcile or delete them."
msgstr "您要锁定的期间内仍有未核对的银行对账单行。您应将其核对或删除。"

#. module: om_fiscal_year
#. odoo-python
