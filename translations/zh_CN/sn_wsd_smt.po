#. module: sn_wsd_smt
#. odoo-python
#: code:addons/sn_wsd_smt/models/sn_smt_material_table.py:0
msgid ""
"TABLE_NO must store the table name only (e.g. T1), not the whole "
"DEVICE.TABLE barcode (e.g. 1.T1); the device sequence belongs in DEVICE_SEQ."
msgstr ""
"TABLE_NO 只能存表名（例如 T1），不能存整个 DEVICE.TABLE 条码（例如 1.T1）；设备序号应放在 DEVICE_SEQ。"

#. module: sn_wsd_smt
