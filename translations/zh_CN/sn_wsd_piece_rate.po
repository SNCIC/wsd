#. module: sn_wsd_piece_rate
#. odoo-python
#: code:addons/sn_wsd_piece_rate/models/piece_close.py:0
msgid "Monthly Closing"
msgstr "月度结账"

#. module: sn_wsd_piece_rate
#: model:ir.model.fields,help:sn_wsd_piece_rate.field_sn_wsd_piece_rate__price
msgid ""
"Amount paid to the crew for one OK unit of this product at this operation. "
"Settlements store a snapshot: later changes only affect newly created "
"settlements."
msgstr "本工序该产品每 OK 一件付给班组的金额。结算会保存快照：之后的修改只影响新建的结算单。"

#. module: sn_wsd_piece_rate
#: model:ir.model.fields,help:sn_wsd_piece_rate.field_sn_wsd_piece_close_log__period
msgid "Business-date month (YYYY-MM) the close applies to."
msgstr "本次结账适用的业务日期月份（YYYY-MM）。"

#. module: sn_wsd_piece_rate
#: model:ir.model.fields,help:sn_wsd_piece_rate.field_sn_wsd_piece_close_wizard__period
msgid "Business-date month to close, formatted YYYY-MM."
msgstr "要结账的业务日期月份，格式为 YYYY-MM。"

#. module: sn_wsd_piece_rate
#: model:ir.model.fields,help:sn_wsd_piece_rate.field_sn_wsd_piece_close_wizard__acknowledge_drafts
msgid ""
"Check to confirm you are aware unsettled drafts stay in the closed period."
msgstr "勾选以确认您知悉未结算的草稿会留在已结账期间内。"

#. module: sn_wsd_piece_rate
#. from po: d:\odoo\odoo19wsd\addons\account\i18n\zh_CN.po
#: model:ir.model.fields,field_description:sn_wsd_piece_rate.field_sn_wsd_piece_close_wizard__company_id
msgid "Company"
msgstr "公司"

#. module: sn_wsd_piece_rate
#. from po: d:\odoo\odoo19wsd\addons\account\i18n\zh_CN.po
#: model:ir.model.fields,field_description:sn_wsd_piece_rate.field_sn_wsd_piece_close_wizard__create_uid
#: model:ir.model.fields,field_description:sn_wsd_piece_rate.field_sn_wsd_piece_settlement_generate_wizard__create_uid
msgid "Created by"
msgstr "创建人"

#. module: sn_wsd_piece_rate
#. from po: d:\odoo\odoo19wsd\addons\account\i18n\zh_CN.po
#: model:ir.model.fields,field_description:sn_wsd_piece_rate.field_sn_wsd_piece_close_wizard__create_date
#: model:ir.model.fields,field_description:sn_wsd_piece_rate.field_sn_wsd_piece_settlement_generate_wizard__create_date
