msgid "Automatic rack allocation is only available for storage operations."
msgstr "自动货架分配仅适用于入库作业。"

#. module: sn_wsd_picklight
#. odoo-python
#: code:addons/sn_wsd_picklight/models/stock_move_line.py:0
