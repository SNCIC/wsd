#. module: sn_wsd_purchase
#: model:ir.model.fields,help:sn_wsd_purchase.field_purchase_request_line__qc_qty
msgid "Quantity that has completed the quality control step of the reception."
msgstr "已完成来料质检环节的数量。"

#. module: sn_wsd_purchase
#: model:ir.model.fields,field_description:sn_wsd_purchase.field_purchase_request_line__stocked_qty
