msgid "Approved quantity can only be changed before the request is approved."
msgstr "已批准数量只能在申请批准前修改。"

#. module: sn_wsd_purchase
#: model:ir.model.fields,help:sn_wsd_purchase.field_purchase_order__contract_number
msgid "Contract number printed on the purchase contract."
msgstr "打印在采购合同上的合同编号。"

#. module: sn_wsd_purchase
#: model:ir.model.fields,help:sn_wsd_purchase.field_purchase_order__signing_date
msgid "Date printed as the contract signing date."
msgstr "打印为合同签订日期的日期。"

