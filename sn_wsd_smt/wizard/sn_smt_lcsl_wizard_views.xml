<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_smt_lcsl_wizard_form" model="ir.ui.view">
        <field name="name">sn.smt.lcsl.wizard.form</field>
        <field name="model">sn.smt.lcsl.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="workcenter_id"/>
                            <field name="device_table_input"/>
                        </group>
                        <group>
                            <field name="cart_input"/>
                            <field name="cart_id" readonly="1"/>
                            <field name="message" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_load" type="object" string="Load Cart" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
