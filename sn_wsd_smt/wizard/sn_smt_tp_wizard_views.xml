<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_smt_tp_wizard_form" model="ir.ui.view">
        <field name="name">sn.smt.tp.wizard.form</field>
        <field name="model">sn.smt.tp.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="workcenter_id"/>
                            <field name="device_table_input"/>
                            <field name="loadpoint_input"/>
                        </group>
                        <group>
                            <field name="feeder_input"/>
                            <field name="material_sn_input"/>
                            <field name="online_material_id" readonly="1"/>
                            <field name="message" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_validate" type="object" string="Validate" class="btn-secondary"/>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
