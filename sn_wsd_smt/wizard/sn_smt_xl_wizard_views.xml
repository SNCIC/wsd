<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_smt_xl_wizard_form" model="ir.ui.view">
        <field name="name">sn.smt.xl.wizard.form</field>
        <field name="model">sn.smt.xl.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="workcenter_id"/>
                            <field name="unload_scope"/>
                            <field name="device_table_input" invisible="unload_scope in ['line', 'cart', 'material']"/>
                            <field name="loadpoint_input" invisible="unload_scope != 'station'"/>
                            <field name="cart_input" invisible="unload_scope != 'cart'"/>
                        </group>
                        <group>
                            <field name="material_sn_input" invisible="unload_scope != 'material'"/>
                            <field name="message" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_unload" type="object" string="Unload" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
