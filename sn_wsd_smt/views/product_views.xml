<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_purchase_packaging" model="ir.ui.view">
        <field name="name">product.template.form.purchase.packaging</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="attributes">
                <attribute name="invisible">not (sale_ok or purchase_ok)</attribute>
            </xpath>
            <xpath expr="//field[@name='uom_ids']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="string">Packagings</attribute>
            </xpath>
            <xpath expr="//field[@name='uom_ids']/ancestor::group[2]" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
