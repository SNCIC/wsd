<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_smt_material_table_search" model="ir.ui.view">
        <field name="name">sn.smt.material.table.search</field>
        <field name="model">sn.smt.material.table</field>
        <field name="arch" type="xml">
            <search>
                <field name="table_name"/>
                <field name="model_code"/>
                <field name="product_side"/>
                <field name="line_link_ids"/>
                <filter string="Valid" name="valid_only" domain="[('is_valid', '=', 'Y')]"/>
                <filter string="Invalid" name="invalid_only" domain="[('is_valid', '=', 'N')]"/>
                <group>
                    <filter string="Product" name="group_product" context="{'group_by': 'model_code'}"/>
                    <filter string="Side" name="group_side" context="{'group_by': 'product_side'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_smt_material_table_list" model="ir.ui.view">
        <field name="name">sn.smt.material.table.list</field>
        <field name="model">sn.smt.material.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="table_name"/>
                <field name="table_type"/>
                <field name="model_code"/>
                <field name="model_ver"/>
                <field name="product_side"/>
                <field name="track_type"/>
                <field name="item_count"/>
                <field name="detail_count"/>
                <field name="is_valid"/>
            </list>
        </field>
    </record>

    <record id="view_sn_smt_material_table_form" model="ir.ui.view">
        <field name="name">sn.smt.material.table.form</field>
        <field name="model">sn.smt.material.table</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_sn_smt_table_import_wizard)d"
                            type="action"
                            string="Import Details"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="table_name"/>
                            <field name="table_type"/>
                            <field name="model_code"/>
                            <field name="model_ver"/>
                        </group>
                        <group>
                            <field name="product_side"/>
                            <field name="track_type"/>
                            <field name="item_count"/>
                            <field name="is_valid"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Production Lines">
                            <field name="line_link_ids" nolabel="1" context="{'default_table_id': id}">
                                <list editable="bottom">
                                    <field name="production_line_id"/>
                                    <field name="line_code"/>
                                </list>
                            </field>
                        </page>
                        <page string="Details">
                            <field name="detail_ids" nolabel="1" context="{'default_mt_id': id}">
                                <list editable="bottom">
                                    <field name="device_seq"/>
                                    <field name="table_no"/>
                                    <field name="loadpoint"/>
                                    <field name="chanel_sn"/>
                                    <field name="item_code"/>
                                    <field name="feeder_spec"/>
                                    <field name="point_qty"/>
                                    <field name="is_skip"/>
                                    <field name="is_tray"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sn_smt_material_table" model="ir.actions.act_window">
        <field name="name">SMT Material Tables</field>
        <field name="res_model">sn.smt.material.table</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_smt_material_table_search"/>
        <field name="context">{'search_default_valid_only': 1}</field>
    </record>

    <record id="view_sn_smt_online_material_list" model="ir.ui.view">
        <field name="name">sn.smt.online.material.list</field>
        <field name="model">sn.smt.online.material</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="mo_number"/>
                <field name="manufacturing_batch_id" optional="show"/>
                <field name="production_line_id"/>
                <field name="process_face"/>
                <field name="device_seq"/>
                <field name="table_no"/>
                <field name="loadpoint"/>
                <field name="chanel_sn"/>
                <field name="loaded_material_lot_id" string="Material SN" optional="show"/>
                <field name="item_code"/>
                <field name="required_item_code" string="Main Item Code" optional="show"/>
                <field name="loaded_product_id" string="Actual Material" optional="show"/>
                <field name="point_qty"/>
                <field name="loaded_qty" optional="show"/>
                <field name="consumed_qty" optional="show"/>
                <field name="remaining_qty" optional="show"/>
                <field name="last_operation_type" optional="show"/>
                <field name="is_skip"/>
                <field name="is_load"/>
            </list>
        </field>
    </record>

    <record id="view_sn_smt_online_material_form" model="ir.ui.view">
        <field name="name">sn.smt.online.material.form</field>
        <field name="model">sn.smt.online.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="manufacturing_batch_id" readonly="1"/>
                            <field name="mo_number" readonly="1"/>
                            <field name="production_line_id" readonly="1"/>
                            <field name="process_face" readonly="1"/>
                            <field name="mt_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="device_seq"/>
                            <field name="table_no"/>
                            <field name="loadpoint"/>
                            <field name="chanel_sn"/>
                            <field name="is_load"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="loaded_material_lot_id" readonly="1"/>
                            <field name="required_item_code" readonly="1"/>
                            <field name="loaded_product_id" readonly="1"/>
                            <field name="item_code"/>
                            <field name="feeder_spec"/>
                        </group>
                        <group>
                        <field name="point_qty"/>
                        <field name="loaded_qty"/>
                        <field name="consumed_qty"/>
                        <field name="remaining_qty"/>
                        <field name="last_operation_type"/>
                        <field name="last_consumed_serial_id"/>
                        <field name="last_consumed_at"/>
                            <field name="is_skip"/>
                            <field name="is_tray"/>
                            <field name="is_qc_test"/>
                        </group>
                    </group>
                    <group>
                        <field name="point_location" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_smt_online_material" model="ir.actions.act_window">
        <field name="name">SMT Online Materials</field>
        <field name="res_model">sn.smt.online.material</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sn_smt_feeder_list" model="ir.ui.view">
        <field name="name">sn.smt.feeder.list</field>
        <field name="model">sn.smt.feeder</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="channel_sn"/>
                <field name="feeder_spec"/>
                <field name="status"/>
                <field name="maintenance_ok"/>
                <field name="bound_production_id"/>
            </list>
        </field>
    </record>

    <record id="view_sn_smt_feeder_form" model="ir.ui.view">
        <field name="name">sn.smt.feeder.form</field>
        <field name="model">sn.smt.feeder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="channel_sn"/>
                            <field name="feeder_spec"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="maintenance_ok"/>
                            <field name="usage_count"/>
                            <field name="bound_production_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_smt_feeder" model="ir.actions.act_window">
        <field name="name">SMT Feeders</field>
        <field name="res_model">sn.smt.feeder</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sn_smt_cart_list" model="ir.ui.view">
        <field name="name">sn.smt.cart.list</field>
        <field name="model">sn.smt.cart</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_sn_smt_cart_form" model="ir.ui.view">
        <field name="name">sn.smt.cart.form</field>
        <field name="model">sn.smt.cart</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Offline Materials">
                        <field name="offline_material_ids" readonly="1">
                            <list create="0" delete="0">
                                <field name="production_id"/>
                                <field name="manufacturing_batch_id" optional="show"/>
                                <field name="device_seq"/>
                                <field name="table_no"/>
                                <field name="loadpoint"/>
                                <field name="material_lot_id"/>
                                <field name="feeder_id"/>
                                <field name="is_online"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_smt_cart" model="ir.actions.act_window">
        <field name="name">SMT Carts</field>
        <field name="res_model">sn.smt.cart</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_sn_smt_table_import_wizard" model="ir.actions.act_window">
        <field name="name">Import SMT Details</field>
        <field name="res_model">sn.smt.table.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_table_id': active_id}</field>
    </record>

</odoo>
