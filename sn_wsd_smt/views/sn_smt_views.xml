<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_smt_material_table_search" model="ir.ui.view">
        <field name="name">sn.smt.material.table.search</field>
        <field name="model">sn.smt.material.table</field>
        <field name="arch" type="xml">
            <search>
                <field name="table_name"/>
                <field name="model_code"/>
                <field name="product_side"/>
                <field name="line_link_ids"/>
                <filter string="Valid" name="valid_only" domain="[('is_valid', '=', 'Y')]"/>
                <filter string="Invalid" name="invalid_only" domain="[('is_valid', '=', 'N')]"/>
                <group>
                    <filter string="Product" name="group_product" context="{'group_by': 'model_code'}"/>
                    <filter string="Side" name="group_side" context="{'group_by': 'product_side'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_smt_material_table_list" model="ir.ui.view">
        <field name="name">sn.smt.material.table.list</field>
        <field name="model">sn.smt.material.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="table_name"/>
                <field name="table_type"/>
                <field name="model_code"/>
                <field name="product_side"/>
                <field name="track_type"/>
                <field name="item_count"/>
                <field name="total_point_qty"/>
                <field name="detail_count"/>
                <field name="is_valid"/>
            </list>
        </field>
    </record>

    <record id="view_sn_smt_material_table_form" model="ir.ui.view">
        <field name="name">sn.smt.material.table.form</field>
        <field name="model">sn.smt.material.table</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_sn_smt_table_import_wizard)d"
                            type="action"
                            string="Import Details"
                            class="btn-secondary"/>
                </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="table_name"/>
                                <field name="table_type"/>
                                <field name="model_code"/>
                            </group>
                            <group>
                                <field name="product_side"/>
                                <field name="track_type"/>
                                <field name="item_count"/>
                                <field name="total_point_qty"/>
                                <field name="is_valid"/>
                            </group>
                        </group>
                    <notebook>
                        <page string="Production Lines">
                            <field name="line_link_ids" nolabel="1" context="{'default_table_id': id}">
                                <list editable="bottom">
                                    <field name="production_line_id"/>
                                    <field name="line_code"/>
                                </list>
                            </field>
                        </page>
                        <page string="Details">
                            <field name="detail_ids" nolabel="1" context="{'default_mt_id': id}">
                                <list editable="bottom">
                                    <field name="device_seq"/>
                                    <field name="table_no"/>
                                    <field name="loadpoint"/>
                                    <field name="chanel_sn"/>
                                    <field name="item_code"/>
                                    <field name="feeder_spec"/>
                                    <field name="point_qty"/>
                                    <field name="is_skip"/>
                                    <field name="is_tray"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sn_smt_material_table" model="ir.actions.act_window">
        <field name="name">SMT Material Tables</field>
        <field name="res_model">sn.smt.material.table</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_smt_material_table_search"/>
        <field name="context">{'search_default_valid_only': 1}</field>
    </record>

    <record id="view_sn_smt_online_material_list" model="ir.ui.view">
        <field name="name">sn.smt.online.material.list</field>
        <field name="model">sn.smt.online.material</field>
        <field name="arch" type="xml">
            <list open_form_view="false">
                <field name="mes_order_id"/>
                <field name="model_code"/>
                <field name="process_face"/>
                <field name="production_line_id"/>
                <field name="workcenter_id" optional="show"/>
                <field name="device_seq"/>
                <field name="table_no"/>
                <field name="loadpoint"/>
                <field name="track_type"/>
                <field name="chanel_sn"/>
                <field name="required_item_code"/>
                <field name="required_product_name"/>
                <field name="required_product_spec"/>
                <field name="loaded_material_lot_id" optional="show"/>
                <field name="loaded_feeder_id" optional="show"/>
                <field name="cart_id" optional="show"/>
                <field name="point_qty"/>
                <field name="loaded_qty" optional="show"/>
                <field name="remaining_qty"/>
                <field name="last_operation_type" optional="show"/>
                <field name="point_location"/>
                <field name="is_load"/>
                <field name="is_skip"/>
                <field name="is_tray"/>
                <field name="replace_count" optional="hide"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <field name="write_uid"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>


    <record id="action_sn_smt_online_material" model="ir.actions.act_window">
        <field name="name">SMT Online Materials</field>
        <field name="res_model">sn.smt.online.material</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_sn_smt_feeder_list" model="ir.ui.view">
        <field name="name">sn.smt.feeder.list</field>
        <field name="model">sn.smt.feeder</field>
        <field name="arch" type="xml">
            <list decoration-warning="care_state == 'remind'"
                  decoration-danger="care_state in ('maintain_due', 'usage_expired')"
                  decoration-muted="status == 'scrapped'">
                <field name="feeder_sn"/>
                <field name="feeder_spec"/>
                <field name="channel_type" widget="badge"
                       decoration-info="channel_type == 'single'"
                       decoration-warning="channel_type == 'dual'"
                       decoration-danger="channel_type == 'triple'"/>
                <field name="channel_sn_summary"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('normal', 'in_use')"
                       decoration-warning="status == 'in_repair'"
                       decoration-danger="status == 'scrapped'"/>
                <field name="care_state" widget="badge"
                       decoration-success="care_state == 'ok'"
                       decoration-warning="care_state == 'remind'"
                       decoration-danger="care_state in ('maintain_due', 'usage_expired')"/>
                <field name="usage_count" optional="show"/>
                <field name="maintenance_ok" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sn_smt_feeder_search" model="ir.ui.view">
        <field name="name">sn.smt.feeder.search</field>
        <field name="model">sn.smt.feeder</field>
        <field name="arch" type="xml">
            <search>
                <field name="feeder_sn"/>
                <field name="feeder_spec"/>
                <filter name="filter_maintain_due" string="Maintenance Due" domain="[('care_state', '=', 'maintain_due')]"/>
                <filter name="filter_remind" string="Remind" domain="[('care_state', '=', 'remind')]"/>
                <filter name="filter_usage_expired" string="Usage Expired" domain="[('care_state', '=', 'usage_expired')]"/>
                <filter name="filter_pending_care" string="Pending Care" domain="[('care_state', '!=', 'ok')]"/>
                <separator/>
                <filter name="filter_scrapped" string="Scrapped" domain="[('status', '=', 'scrapped')]"/>
                <filter name="filter_in_repair" string="In Repair" domain="[('status', '=', 'in_repair')]"/>
                <filter name="filter_disabled" string="Disabled" domain="[('status', '=', 'disabled')]"/>
                <group>
                    <filter name="group_by_status" string="Status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter name="group_by_care_state" string="Care State" domain="[]" context="{'group_by': 'care_state'}"/>
                    <filter name="group_by_channel_type" string="Channel Type" domain="[]" context="{'group_by': 'channel_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_smt_feeder_form" model="ir.ui.view">
        <field name="name">sn.smt.feeder.form</field>
        <field name="model">sn.smt.feeder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_disable" type="object" string="Disable" confirm="Disable this feeder?" invisible="status != 'normal'"/>
                    <button name="action_enable" type="object" string="Enable" invisible="status != 'disabled'"/>
                    <button name="action_open_report_repair" type="object" string="Report Repair" invisible="status != 'normal'"/>
                    <button name="action_open_complete_repair" type="object" string="Complete Repair" invisible="status != 'in_repair'"/>
                    <button name="action_open_scrap" type="object" string="Scrap" invisible="status == 'scrapped'"/>
                    <button name="action_maintenance" type="object" string="Perform Maintenance" confirm="Perform maintenance on this feeder? Usage count will be reset." invisible="status == 'scrapped'" class="btn-secondary"/>
                    <field name="status" widget="statusbar" statusbar_visible="normal,in_use,in_repair,disabled,scrapped"/>
                    <field name="care_state" widget="badge"
                           decoration-success="care_state == 'ok'"
                           decoration-warning="care_state == 'remind'"
                           decoration-danger="care_state in ('maintain_due', 'usage_expired')"/>
                </header>
                <sheet>
                    <group>
                        <group name="identity">
                            <field name="feeder_sn"/>
                            <field name="feeder_spec"/>
                            <field name="channel_type"/>
                            <field name="production_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="lifecycle">
                            <field name="status"/>
                            <field name="care_state"/>
                            <field name="cart_id" readonly="1"/>
                            <field name="usage_count"/>
                            <field name="maintenance_ok"/>
                            <field name="last_maintenance_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Channel SN">
                            <field name="channel_ids">
                                <list editable="bottom">
                                    <field name="channel_no"/>
                                    <field name="channel_sn"/>
                                </list>
                            </field>
                        </page>
                        <page string="Care Thresholds">
                            <group>
                                <group string="Count Thresholds">
                                    <field name="usage_count_limit"/>
                                    <field name="maintenance_count"/>
                                    <field name="remind_count"/>
                                </group>
                                <group string="Period Thresholds (Days)">
                                    <field name="usage_days_limit"/>
                                    <field name="maintenance_days"/>
                                    <field name="remind_days"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_smt_feeder" model="ir.actions.act_window">
        <field name="name">SMT Feeders</field>
        <field name="res_model">sn.smt.feeder</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sn_smt_cart_list" model="ir.ui.view">
        <field name="name">sn.smt.cart.list</field>
        <field name="model">sn.smt.cart</field>
        <field name="arch" type="xml">
            <list decoration-muted="status in ('idle', 'disabled', 'scrapped')">
                <field name="cart_sn"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'mounted'"
                       decoration-info="status == 'loaded'"
                       decoration-muted="status in ('idle', 'disabled', 'scrapped')"/>
                <field name="mounted_workcenter_id" optional="show"/>
                <field name="mounted_at" optional="hide"/>
                <field name="unmounted_at" optional="hide"/>
                <field name="feeder_count" string="Feeders"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sn_smt_cart_form" model="ir.ui.view">
        <field name="name">sn.smt.cart.form</field>
        <field name="model">sn.smt.cart</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_mount" type="object" string="Mount"
                            invisible="status not in ('idle', 'loaded')"
                            confirm="Mount this cart on a workcenter?"/>
                    <button name="action_unmount" type="object" string="Unmount"
                            invisible="status != 'mounted'"
                            confirm="Unmount this cart from the workcenter?"/>
                    <button name="action_clear_lines" type="object" string="Clear Feeders"
                            invisible="status != 'loaded' or feeder_count == 0"
                            confirm="Unbind all feeders from this cart?"/>
                    <button name="action_disable" type="object" string="Disable"
                            invisible="status not in ('idle', 'loaded')"
                            confirm="Disable this cart?"/>
                    <button name="action_enable" type="object" string="Enable"
                            invisible="status != 'disabled'"/>
                    <button name="action_scrap" type="object" string="Scrap"
                            invisible="status == 'scrapped'"
                            confirm="Scrap this cart? This cannot be undone."/>
                    <field name="status" widget="statusbar" statusbar_visible="idle,loaded,mounted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="cart_sn" readonly="status == 'scrapped'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="mounted_workcenter_id" readonly="1"/>
                            <field name="mounted_at" readonly="1"/>
                            <field name="unmounted_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Feeders">
                            <field name="active_line_ids">
                                <list editable="bottom">
                                    <field name="slot_no"/>
                                    <field name="feeder_id" domain="[('status', '=', 'normal')]"/>
                                    <field name="material_lot_id"/>
                                    <field name="mes_order_id"/>
                                    <field name="installed_at" readonly="1" optional="hide"/>
                                    <button name="action_unbind" type="object" string="Unbind" icon="fa-chain-broken"/>
                                </list>
                            </field>
                        </page>
                        <page string="History">
                            <field name="line_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="slot_no"/>
                                    <field name="feeder_id"/>
                                    <field name="material_lot_id"/>
                                    <field name="mes_order_id"/>
                                    <field name="installed_at"/>
                                    <field name="removed_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_smt_cart_search" model="ir.ui.view">
        <field name="name">sn.smt.cart.search</field>
        <field name="model">sn.smt.cart</field>
        <field name="arch" type="xml">
            <search>
                <field name="cart_sn"/>
                <field name="mounted_workcenter_id"/>
                <filter name="filter_idle" string="Idle" domain="[('status', '=', 'idle')]"/>
                <filter name="filter_loaded" string="Loaded" domain="[('status', '=', 'loaded')]"/>
                <filter name="filter_mounted" string="Mounted" domain="[('status', '=', 'mounted')]"/>
                <filter name="filter_disabled" string="Disabled" domain="[('status', '=', 'disabled')]"/>
                <filter name="filter_scrapped" string="Scrapped" domain="[('status', '=', 'scrapped')]"/>
                <group>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_workcenter" string="Mounted Workcenter" context="{'group_by': 'mounted_workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_smt_cart" model="ir.actions.act_window">
        <field name="name">SMT Cart</field>
        <field name="res_model">sn.smt.cart</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_smt_cart_search"/>
    </record>

    <record id="view_sn_smt_cart_mount_wizard_form" model="ir.ui.view">
        <field name="name">sn.smt.cart.mount.wizard.form</field>
        <field name="model">sn.smt.cart.mount.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="cart_id" readonly="1"/>
                    <field name="workcenter_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sn_smt_cart_mount_wizard" model="ir.actions.act_window">
        <field name="name">Mount Cart</field>
        <field name="res_model">sn.smt.cart.mount.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_sn_smt_table_import_wizard" model="ir.actions.act_window">
        <field name="name">Import SMT Details</field>
        <field name="res_model">sn.smt.table.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_table_id': active_id}</field>
    </record>

</odoo>
