<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_inherit_smt_consumption" model="ir.ui.view">
        <field name="name">stock.lot.form.smt.consumption</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SMT Product Usage">
                    <field name="smt_consumption_count" readonly="1"/>
                    <field name="smt_consumption_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="serial_no"/>
                            <field name="production_id"/>
                            <field name="required_item_code"/>
                            <field name="consumed_qty"/>
                            <field name="consumed_at"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
