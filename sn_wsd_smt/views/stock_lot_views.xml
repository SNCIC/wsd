<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_inherit_smt_consumption" model="ir.ui.view">
        <field name="name">stock.lot.form.smt.consumption</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <!-- 单账本：卷档案只展示来料标签身份字段（sn_wsd_stock 出生
                     建档）与在手数量，点数账本已删除；批次号由 sn_wsd_stock
                     的视图在产品字段后展示，此处不重复。 -->
                <group string="SMT Reel" name="smt_reel">
                    <field name="supplier_name" readonly="1"/>
                    <field name="initial_quantity" readonly="1"/>
                    <field name="x_smt_available_qty" readonly="1"/>
                </group>
                <group string="Lot Product Usage">
                    <field name="smt_consumption_count" readonly="1"/>
                    <field name="smt_consumption_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="serial_no"/>
                            <field name="mes_order_id"/>
                            <field name="required_item_code"/>
                            <field name="consumed_qty"/>
                            <field name="consumed_at"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
