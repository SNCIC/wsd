<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_internal_serial_form_inherit_smt" model="ir.ui.view">
        <field name="name">sn.wsd.internal.serial.form.smt</field>
        <field name="model">sn.wsd.internal.serial</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_internal_serial_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="smt_consumption" string="SMT Material Consumption">
                    <field name="smt_consumption_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="workorder_id"/>
                            <field name="required_item_code"/>
                            <field name="actual_item_code"/>
                            <field name="material_sn"/>
                            <field name="device_seq"/>
                            <field name="table_no"/>
                            <field name="loadpoint"/>
                            <field name="consumed_qty"/>
                            <field name="consumed_at"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
