<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PCB Panel List View -->
    <record id="view_sn_smt_pcb_panel_list" model="ir.ui.view">
        <field name="name">sn.smt.pcb.panel.list</field>
        <field name="model">sn.smt.pcb.panel</field>
        <field name="arch" type="xml">
            <list create="1" edit="1" delete="1">
                <field name="create_date"/>
                <field name="product_no"/>
                <field name="quantity"/>
                <field name="pcb_item_sn" string="PCB Item Code"/>
                <field name="pcb_item_spec" optional="show"/>
                <field name="board_count"/>
                <field name="state"/>
                <field name="production_name"/>
                <field name="mes_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- PCB Panel Form View -->
    <record id="view_sn_smt_pcb_panel_form" model="ir.ui.view">
        <field name="name">sn.smt.pcb.panel.form</field>
        <field name="model">sn.smt.pcb.panel</field>
        <field name="arch" type="xml">
            <form create="1" edit="1" delete="1">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_no" placeholder="Order Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="quantity"/>
                            <field name="pcb_item_sn" string="PCB Item Code"/>
                            <field name="pcb_item_spec"/>
                        </group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="mes_order_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group string="Board Information">
                        <field name="board_ids" nolabel="1" context="{'default_panel_id': id}">
                            <list editable="bottom" create="1">
                                <field name="board_no"/>
                                <field name="pro_sn"/>
                                <field name="state"/>
                                <field name="lot_id" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                        <group>
                            <field name="write_date" readonly="1"/>
                            <field name="write_uid" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- PCB Panel Search View -->
    <record id="view_sn_smt_pcb_panel_search" model="ir.ui.view">
        <field name="name">sn.smt.pcb.panel.search</field>
        <field name="model">sn.smt.pcb.panel</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_no"/>
                <field name="mes_order_id"/>
                <field name="production_id"/>
                <field name="pcb_item_sn"/>
                <field name="board_ids" string="Board SN" filter_domain="[('board_ids.pro_sn', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_state_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_state_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_created_today" string="Today" domain="[('create_date', '&gt;=', 'today'), ('create_date', '&lt;', 'today +1d')]"/>
                <filter name="filter_created_this_week" string="This Week" domain="[('create_date', '&gt;=', '=week_start'), ('create_date', '&lt;', '=week_start +1w')]"/>
                <group>
                    <filter name="group_by_mes_order" string="MES Order" context="{'group_by': 'mes_order_id'}"/>
                    <filter name="group_by_production" string="Manufacturing Order" context="{'group_by': 'production_id'}"/>
                    <filter name="group_by_product_no" string="Product No" context="{'group_by': 'product_no'}"/>
                    <filter name="group_by_created_day" string="Created Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- PCB Panel Action -->
    <record id="action_sn_smt_pcb_panel" model="ir.actions.act_window">
        <field name="name">PCB Panel Records</field>
        <field name="res_model">sn.smt.pcb.panel</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_smt_pcb_panel_search"/>
        <field name="context">{}</field>
    </record>

    <!-- PCB Board List View -->
    <record id="view_sn_smt_pcb_board_list" model="ir.ui.view">
        <field name="name">sn.smt.pcb.board.list</field>
        <field name="model">sn.smt.pcb.board</field>
        <field name="arch" type="xml">
            <list create="0" edit="1" delete="1">
                <field name="create_date"/>
                <field name="panel_id"/>
                <field name="board_no"/>
                <field name="pro_sn"/>
                <field name="state"/>
                <field name="lot_id"/>
            </list>
        </field>
    </record>

    <!-- PCB Board Form View -->
    <record id="view_sn_smt_pcb_board_form" model="ir.ui.view">
        <field name="name">sn.smt.pcb.board.form</field>
        <field name="model">sn.smt.pcb.board</field>
        <field name="arch" type="xml">
            <form create="0" edit="1" delete="1">
                <sheet>
                    <group>
                        <group>
                            <field name="panel_id" readonly="1"/>
                            <field name="board_no"/>
                        </group>
                        <group>
                            <field name="pro_sn"/>
                            <field name="state"/>
                            <field name="lot_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- PCB Board Search View -->
    <record id="view_sn_smt_pcb_board_search" model="ir.ui.view">
        <field name="name">sn.smt.pcb.board.search</field>
        <field name="model">sn.smt.pcb.board</field>
        <field name="arch" type="xml">
            <search>
                <field name="pro_sn"/>
                <field name="lot_id"/>
                <field name="panel_id" string="Product No" filter_domain="[('panel_id.product_no', 'ilike', self)]"/>
                <field name="panel_id" string="MO Number" filter_domain="[('panel_id.production_name', 'ilike', self)]"/>
                <field name="panel_id" string="MES Order" filter_domain="[('panel_id.mes_order_id', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_state_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_state_scrapped" string="Scrapped" domain="[('state', '=', 'scrapped')]"/>
                <filter name="filter_state_voided" string="Voided" domain="[('state', '=', 'voided')]"/>
                <filter name="filter_state_replaced" string="Replaced" domain="[('state', '=', 'replaced')]"/>
                <separator/>
                <filter name="filter_created_today" string="Today" domain="[('create_date', '&gt;=', 'today'), ('create_date', '&lt;', 'today +1d')]"/>
                <filter name="filter_created_this_week" string="This Week" domain="[('create_date', '&gt;=', '=week_start'), ('create_date', '&lt;', '=week_start +1w')]"/>
                <group>
                    <filter name="group_by_panel" string="Panel" context="{'group_by': 'panel_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_created_day" string="Created Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- PCB Board Action -->
    <record id="action_sn_smt_pcb_board" model="ir.actions.act_window">
        <field name="name">PCB Board Records</field>
        <field name="res_model">sn.smt.pcb.board</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_smt_pcb_board_search"/>
    </record>
</odoo>
