<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance Item Views -->
    <record id="view_sn_wsd_maintenance_item_search" model="ir.ui.view">
        <field name="name">sn.wsd.maintenance.item.search</field>
        <field name="model">sn.wsd.maintenance.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="item_type"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Item Type" name="group_item_type" context="{'group_by': 'item_type'}"/>
                    <filter string="Check Method" name="group_check_method" context="{'group_by': 'check_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_maintenance_item_list" model="ir.ui.view">
        <field name="name">sn.wsd.maintenance.item.list</field>
        <field name="model">sn.wsd.maintenance.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="item_type"/>
                <field name="check_method"/>
                <field name="required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_maintenance_item_form" model="ir.ui.view">
        <field name="name">sn.wsd.maintenance.item.form</field>
        <field name="model">sn.wsd.maintenance.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="item_type"/>
                            <field name="check_method"/>
                        </group>
                        <group>
                            <field name="required"/>
                            <field name="uom"/>
                            <field name="lower_limit"/>
                            <field name="upper_limit"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="category_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="check_content"/>
                        </page>
                        <page string="Standard">
                            <field name="standard"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_maintenance_item" model="ir.actions.act_window">
        <field name="name">Maintenance Items</field>
        <field name="res_model">sn.wsd.maintenance.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_maintenance_item_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Maintenance Plan Views -->
    <record id="view_sn_wsd_maintenance_plan_search" model="ir.ui.view">
        <field name="name">sn.wsd.maintenance.plan.search</field>
        <field name="model">sn.wsd.maintenance.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="category_id"/>
                <field name="plan_type"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Maintenance" name="maintenance" domain="[('plan_type', '=', 'maintenance')]"/>
                <filter string="Inspection" name="inspection" domain="[('plan_type', '=', 'inspection')]"/>
                <filter string="Calibration" name="calibration" domain="[('plan_type', '=', 'calibration')]"/>
                <group>
                    <filter string="Plan Type" name="group_plan_type" context="{'group_by': 'plan_type'}"/>
                    <filter string="Equipment" name="group_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'responsible_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_maintenance_plan_list" model="ir.ui.view">
        <field name="name">sn.wsd.maintenance.plan.list</field>
        <field name="model">sn.wsd.maintenance.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan_type"/>
                <field name="equipment_id"/>
                <field name="category_id"/>
                <field name="cycle_days"/>
                <field name="reminder_days"/>
                <field name="next_date"/>
                <field name="responsible_user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_maintenance_plan_form" model="ir.ui.view">
        <field name="name">sn.wsd.maintenance.plan.form</field>
        <field name="model">sn.wsd.maintenance.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_execution" type="object" string="Generate Execution" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="plan_type"/>
                            <field name="equipment_id"/>
                            <field name="category_id"/>
                            <field name="maintenance_category" invisible="plan_type != 'maintenance'" required="plan_type == 'maintenance'"/>
                            <field name="inspection_frequency" invisible="plan_type != 'inspection'" required="plan_type == 'inspection'"/>
                            <field name="shift_code" invisible="plan_type != 'inspection'"/>
                        </group>
                        <group>
                            <field name="cycle_days"/>
                            <field name="reminder_days"/>
                            <field name="baseline_hours"/>
                            <field name="next_date"/>
                            <field name="last_execution_date" readonly="1"/>
                            <field name="responsible_user_id"/>
                            <field name="responsible_department_id"/>
                            <field name="standard_equipment_id" invisible="plan_type != 'calibration'"/>
                            <field name="calibration_basis" invisible="plan_type != 'calibration'" required="plan_type == 'calibration'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_id"/>
                                    <field name="required"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_maintenance_plan" model="ir.actions.act_window">
        <field name="name">Maintenance Plans</field>
        <field name="res_model">sn.wsd.maintenance.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_maintenance_plan_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_sn_wsd_maintenance_plan_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Plans</field>
        <field name="res_model">sn.wsd.maintenance.plan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('plan_type', '=', 'maintenance')]</field>
        <field name="context">{'default_plan_type': 'maintenance', 'search_default_active': 1}</field>
        <field name="search_view_id" ref="view_sn_wsd_maintenance_plan_search"/>
    </record>

    <record id="action_sn_wsd_maintenance_plan_inspection" model="ir.actions.act_window">
        <field name="name">Inspection Plans</field>
        <field name="res_model">sn.wsd.maintenance.plan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('plan_type', '=', 'inspection')]</field>
        <field name="context">{'default_plan_type': 'inspection', 'search_default_active': 1}</field>
        <field name="search_view_id" ref="view_sn_wsd_maintenance_plan_search"/>
    </record>

    <record id="action_sn_wsd_maintenance_plan_calibration" model="ir.actions.act_window">
        <field name="name">Calibration Plans</field>
        <field name="res_model">sn.wsd.maintenance.plan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('plan_type', '=', 'calibration')]</field>
        <field name="context">{'default_plan_type': 'calibration', 'search_default_active': 1}</field>
        <field name="search_view_id" ref="view_sn_wsd_maintenance_plan_search"/>
    </record>
</odoo>
