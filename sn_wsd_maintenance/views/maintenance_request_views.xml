<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_request_form_wsd" model="ir.ui.view">
        <field name="name">maintenance.request.form.wsd</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_wsd_accept_repair" type="object" string="Accept Repair" class="btn-primary" invisible="done or maintenance_type != 'corrective'"/>
                <button name="action_wsd_finish_repair" type="object" string="Finish Repair" class="btn-secondary" invisible="done or not x_repair_start or close_date"/>
                <button name="action_wsd_verify_ok" type="object" string="Verify OK" class="btn-primary" invisible="done or not close_date"/>
                <button name="action_wsd_verify_ng" type="object" string="Verify NG" class="btn-secondary" invisible="done or not close_date"/>
            </xpath>
            <xpath expr="//field[@name='maintenance_type']" position="after">
                <field name="x_failure_code" required="maintenance_type == 'corrective'"/>
                <field name="x_failure_time"/>
                <field name="x_impact_level"/>
                <field name="x_urgency"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Repair Execution" name="wsd_repair_execution" invisible="maintenance_type != 'corrective'">
                    <group>
                        <group>
                            <field name="x_root_cause_code"/>
                            <field name="x_repair_start"/>
                            <field name="close_date" readonly="1"/>
                            <field name="x_repair_hours" readonly="1"/>
                            <field name="x_verification_result"/>
                        </group>
                        <group>
                            <field name="x_downtime_id" readonly="1"/>
                            <field name="x_spare_part_note"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_repair_action"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_maintenance_request_list_wsd" model="ir.ui.view">
        <field name="name">maintenance.request.list.wsd</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="x_failure_code" optional="show"/>
                <field name="x_impact_level" optional="show"/>
                <field name="x_urgency" optional="show"/>
                <field name="x_repair_hours" optional="show" sum="Total"/>
                <field name="x_verification_result" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_maintenance_request_search_wsd" model="ir.ui.view">
        <field name="name">maintenance.request.search.wsd</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='maintenance_team_id']" position="after">
                <field name="x_failure_code"/>
                <field name="x_impact_level"/>
                <field name="x_urgency"/>
            </xpath>
            <xpath expr="//filter[@name='done']" position="after">
                <filter string="Line Stop" name="line_stop" domain="[('x_impact_level', '=', 'line_stop')]"/>
                <filter string="Reduced Output" name="reduced_output" domain="[('x_impact_level', '=', 'reduced_output')]"/>
            </xpath>
            <xpath expr="//group[last()]" position="inside">
                <filter string="Impact Level" name="group_impact_level" context="{'group_by': 'x_impact_level'}"/>
                <filter string="Urgency" name="group_urgency" context="{'group_by': 'x_urgency'}"/>
            </xpath>
        </field>
    </record>
</odoo>
