<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Equipment Search View -->
    <record id="view_maintenance_equipment_search_wsd" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.wsd</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='owner_user_id']" position="after">
                <field name="x_wsd_equipment_code"/>
                <field name="x_equipment_state"/>
                <field name="x_criticality"/>
                <field name="x_production_line_id"/>
                <field name="x_mes_workcenter_id"/>
            </xpath>
            <xpath expr="//filter[@name='under_maintenance']" position="after">
                <filter string="Requires Calibration" name="requires_calibration" domain="[('x_requires_calibration', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Equipment State" name="group_wsd_state" context="{'group_by': 'x_equipment_state'}"/>
                <filter string="Criticality" name="group_wsd_criticality" context="{'group_by': 'x_criticality'}"/>
                <filter string="Production Line" name="group_wsd_line" context="{'group_by': 'x_production_line_id'}"/>
                <filter string="Work Center" name="group_wsd_workcenter" context="{'group_by': 'x_mes_workcenter_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Equipment List View -->
    <record id="view_maintenance_equipment_list_wsd" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.wsd</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="x_wsd_equipment_code"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="x_equipment_state" widget="badge"
                       decoration-success="x_equipment_state == 'running'"
                       decoration-info="x_equipment_state == 'standby'"
                       decoration-warning="x_equipment_state in ['stopped', 'inspection_due', 'calibration_overdue']"
                       decoration-danger="x_equipment_state in ['repairing', 'scrapped']"/>
                <field name="x_criticality"/>
                <field name="x_production_line_id" optional="show"/>
                <field name="x_mes_workcenter_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Equipment Form View -->
    <record id="view_maintenance_equipment_form_wsd" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.wsd</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_wsd_executions" icon="fa-check-square-o">
                    <field name="x_execution_count" widget="statinfo" string="Executions"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_open_wsd_downtime" icon="fa-clock-o">
                    <field name="x_open_downtime_count" widget="statinfo" string="Downtime"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="x_wsd_equipment_code"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="x_equipment_state"/>
                <field name="x_criticality"/>
                <field name="x_department_id"/>
            </xpath>
            <xpath expr="//field[@name='maintenance_team_id']" position="after">
                <field name="x_production_line_id"/>
                <field name="x_mes_workcenter_id" domain="[('x_production_line_id', '=', x_production_line_id)]"/>
            </xpath>
            <xpath expr="//page[@name='product_information']//field[@name='partner_id']" position="after">
                <field name="x_manufacturer_id"/>
                <field name="x_factory_serial_no"/>
                <field name="x_manufacture_date"/>
                <field name="x_commission_date"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="MES Equipment" name="wsd_mes_equipment">
                    <group>
                        <group>
                            <field name="x_image" widget="image"/>
                            <field name="x_technical_document" filename="x_technical_document_filename"/>
                            <field name="x_technical_document_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="SMT Loadpoints">
                        <field name="x_smt_device_loadpoint_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="table_no"/>
                                <field name="loadpoint"/>
                                <field name="track_type"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="Calibration" name="wsd_calibration">
                    <group>
                        <group>
                            <field name="x_requires_calibration"/>
                            <field name="x_calibration_type" invisible="not x_requires_calibration" required="x_requires_calibration"/>
                            <field name="x_calibration_cycle_days" invisible="not x_requires_calibration"/>
                        </group>
                        <group>
                            <field name="x_calibration_reminder_days" invisible="not x_requires_calibration"/>
                            <field name="x_last_calibration_date" invisible="not x_requires_calibration"/>
                            <field name="x_next_calibration_date" invisible="not x_requires_calibration" readonly="1"/>
                        </group>
                    </group>
                </page>
                <page string="Lifecycle" name="wsd_lifecycle">
                    <field name="x_lifecycle_log_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="event_time"/>
                            <field name="event_type"/>
                            <field name="user_id"/>
                            <field name="source_model"/>
                            <field name="source_id"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Workcenter Form View: 设备信息 tab (设备表格) -->
    <record id="view_mrp_workcenter_form_wsd_maintenance" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.wsd.maintenance</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="设备信息" name="device_info">
                    <field name="x_smt_device_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="device_id" string="设备"/>
                            <field name="device_sn" readonly="1"/>
                            <field name="device_name" readonly="1"/>
                            <field name="device_category_id" readonly="1"/>
                            <field name="device_seq"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Equipment Category Form View -->
    <record id="view_maintenance_equipment_category_form_wsd" model="ir.ui.view">
        <field name="name">maintenance.equipment.category.form.wsd</field>
        <field name="model">maintenance.equipment.category</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='technician_user_id']" position="before">
                <field name="active"/>
                <field name="code"/>
                <field name="parent_id"/>
            </xpath>
            <xpath expr="//field[@name='note']" position="after">
                <field name="default_item_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <!-- Lifecycle Log Views -->
    <record id="view_sn_wsd_maintenance_lifecycle_log_search" model="ir.ui.view">
        <field name="name">sn.wsd.maintenance.lifecycle.log.search</field>
        <field name="model">sn.wsd.maintenance.lifecycle.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="event_type"/>
                <field name="user_id"/>
                <filter string="Active" name="active" domain="[('equipment_id.active', '=', True)]"/>
                <filter name="event_time" date="event_time"/>
                <group>
                    <filter string="Event Type" name="group_event_type" context="{'group_by': 'event_type'}"/>
                    <filter string="Equipment" name="group_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_maintenance_lifecycle_log_list" model="ir.ui.view">
        <field name="name">sn.wsd.maintenance.lifecycle.log.list</field>
        <field name="model">sn.wsd.maintenance.lifecycle.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="event_time"/>
                <field name="event_type"/>
                <field name="equipment_id"/>
                <field name="user_id"/>
                <field name="source_model"/>
                <field name="source_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_maintenance_lifecycle_log" model="ir.actions.act_window">
        <field name="name">Lifecycle Logs</field>
        <field name="res_model">sn.wsd.maintenance.lifecycle.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_maintenance_lifecycle_log_search"/>
    </record>
</odoo>
