         与 workshop_functions_views.xml 解耦，便于并行开发）。 -->

    <record id="sn_wsd_barcode_device_action" model="ir.actions.client">
        <field name="name">Device Operations</field>
        <field name="path">wsd-barcode-device</field>
        <field name="tag">sn_wsd_barcode_device_action</field>
