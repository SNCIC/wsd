<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 车间作业功能宫格：入口由 ir.ui.menu 子树驱动（groups/sequence/
         active 后台可配），点宫格 = doAction 到对应 client action。 -->

    <record id="sn_wsd_barcode_workshop_functions_action" model="ir.actions.client">
        <field name="name">Workshop Operations</field>
        <field name="path">wsd-barcode-workshop</field>
        <field name="tag">sn_wsd_barcode_workshop_functions</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="sn_wsd_barcode_drawing_load_action" model="ir.actions.client">
        <field name="name">Critical Material Loading</field>
        <field name="path">wsd-barcode-drawing-load</field>
        <field name="tag">sn_wsd_barcode_drawing_load</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="sn_wsd_barcode_exception_report_action" model="ir.actions.client">
        <field name="name">Exception Report</field>
        <field name="path">wsd-barcode-exception</field>
        <field name="tag">sn_wsd_barcode_exception_report</field>
        <field name="target">fullscreen</field>
    </record>



    <menuitem id="menu_workshop_functions"
              name="Workshop Operations"
              parent="sn_wsd_barcode_menu"
              action="sn_wsd_barcode_workshop_functions_action"
              sequence="10"/>

    <menuitem id="menu_workshop_fn_smt_loading"
              name="SMT Loading"
              parent="menu_workshop_functions"
              action="sn_wsd_barcode_workshop_client_action"
              sequence="10"
              groups="sn_wsd_mrp.group_mes_smt_operator"/>

    <menuitem id="menu_workshop_fn_drawing_load"
              name="Critical Material Loading"
              parent="menu_workshop_functions"
              action="sn_wsd_barcode_drawing_load_action"
              sequence="20"
              groups="sn_wsd_mrp.group_mes_shop"/>





    <menuitem id="menu_workshop_fn_pallet"
              name="Pallet Binding"
              parent="menu_workshop_functions"
              action="sn_wsd_barcode_pallet_binding_action"
              sequence="50"
              groups="sn_wsd_mrp.group_mes_shop,sn_wsd_mrp.group_mes_warehouse"/>

    <menuitem id="menu_workshop_fn_exception"
              name="Exception Report"
              parent="menu_workshop_functions"
              action="sn_wsd_barcode_exception_report_action"
              sequence="60"
              groups="base.group_user"/>

</odoo>
