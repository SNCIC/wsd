<odoo>
    <!-- Reload the web client before opening the barcode action so its assets are available. -->
    <record id="sn_wsd_barcode_install_url" model="ir.actions.act_url">
        <field name="name">Open WSD Barcode</field>
        <field name="url">/odoo/wsd-barcode</field>
        <field name="target">self</field>
    </record>

    <!-- The todo is consumed once by Odoo after module installation. -->
    <record id="sn_wsd_barcode_install_todo" model="ir.actions.todo">
        <field name="name">Open WSD Barcode</field>
        <field name="action_id" ref="sn_wsd_barcode.sn_wsd_barcode_install_url"/>
        <field name="sequence">1</field>
    </record>

    <record id="sn_wsd_barcode_picking_client_action" model="ir.actions.client">
        <field name="name">Barcode Picking Client Action</field>
        <field name="tag">sn_wsd_barcode_client_action</field>
        <field name="res_model">stock.picking</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="sn_wsd_barcode_inventory_client_action" model="ir.actions.client">
        <field name="name">Barcode Inventory Client Action</field>
        <field name="tag">sn_wsd_barcode_client_action</field>
        <field name="res_model">stock.quant</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="sn_wsd_barcode_workshop_client_action" model="ir.actions.client">
        <field name="name">Workshop Operations</field>
        <field name="path">barcode-production-scan</field>
        <field name="tag">sn_wsd_barcode_workshop_action</field>
        <field name="target">fullscreen</field>
    </record>

    <record model="ir.config_parameter" id="barcode_separator_regex" forcecreate="False">
        <field name="key">sn_wsd_barcode.barcode_separator_regex</field>
        <field name="value">[;,]</field>
    </record>

    <record model="ir.config_parameter" id="barcode_rfid_batch_time" forcecreate="False">
        <field name="key">sn_wsd_barcode.barcode_rfid_batch_time</field>
        <field name="value">1000</field>
    </record>

    <data noupdate="1">
        <!-- Incoming receipts use the warehouse stock location directly. -->
        <function model="stock.picking.type" name="write">
            <value model="stock.picking.type" search="[('code', '=', 'incoming')]"/>
            <value eval="{
                'restrict_scan_product': True,
                'restrict_scan_tracking_number': 'mandatory',
                'restrict_scan_dest_location': 'mandatory',
            }"/>
        </function>

        <!-- Set `restrict_scan_source_location` on True for outgoing picking types. -->
        <function model="stock.picking.type" name="write">
            <value model="stock.picking.type" search="[('code', '=', 'outgoing')]"/>
            <value eval="{
                'restrict_scan_source_location': 'mandatory',
                'restrict_scan_dest_location': 'no',
            }"/>
        </function>

        <record id="scale_up_alias_1" model="barcode.rule">
            <field name="name">Scale Up Receipt</field>
            <field name="type">alias</field>
            <field name="pattern">WH-RECEIPTS</field>
            <field name="alias">WHIN</field>
            <field name="barcode_nomenclature_id" ref="barcodes.default_barcode_nomenclature"/>
            <field name="sequence">0</field>
        </record>
        <record id="scale_up_alias_2" model="barcode.rule">
            <field name="name">Scale Up Validate</field>
            <field name="type">alias</field>
            <field name="pattern">O-BTN.validate</field>
            <field name="alias">OBTVALI</field>
            <field name="barcode_nomenclature_id" ref="barcodes.default_barcode_nomenclature"/>
            <field name="sequence">0</field>
        </record>
        <record id="scale_up_alias_3" model="barcode.rule">
            <field name="name">Scale Up Pack</field>
            <field name="type">alias</field>
            <field name="pattern">O-BTN.pack</field>
            <field name="alias">OBTPACK</field>
            <field name="barcode_nomenclature_id" ref="barcodes.default_barcode_nomenclature"/>
            <field name="sequence">0</field>
        </record>
        <record id="scale_up_alias_4" model="barcode.rule">
            <field name="name">Scale Up Location</field>
            <field name="type">alias</field>
            <field name="pattern">WH-STOCK</field>
            <field name="alias">WHSTOCK</field>
            <field name="barcode_nomenclature_id" ref="barcodes.default_barcode_nomenclature"/>
            <field name="sequence">0</field>
        </record>
        <record model="ir.sequence" id="epc_serial">
            <field name="name">EPC Fake Serial</field>
            <field name="code">sn_wsd_barcode.epc.serial</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
