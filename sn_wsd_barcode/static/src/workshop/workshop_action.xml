<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sn_wsd_barcode.WorkshopOperationAction">
        <div class="o_content o_barcode_client_action o_sn_wsd_workshop_action h-100 flex-column">

            <!-- ❶ 上下文带：返回 / 屏名 / 产线工位选择器 / 相机 -->
            <header class="o_sn_wsd_pda_contextbar">
                <div class="o_sn_wsd_pda_contextbar_top">
                    <button t-on-click="goBack" class="btn" t-att-aria-label="backLabel">
                        <i class="oi oi-chevron-left"/>
                    </button>
                    <div class="o_sn_wsd_pda_title" t-out="workshopOperationsLabel"/>
                    <div t-if="state.userName" class="o_sn_wsd_pda_user">
                        <i class="fa fa-user-circle-o me-1"/>
                        <t t-out="state.userName"/>
                    </div>
                    <button t-if="cameraScannerSupported"
                            class="btn"
                            t-att-class="cameraScannerClassState"
                            t-att-disabled="state.cameraScannerEnabled &amp;&amp; !state.readyToToggleCamera"
                            t-on-click="toggleCameraScanner">
                        <i class="fa fa-barcode" role="img"/>
                    </button>
                </div>
                <div class="o_sn_wsd_pda_contextbar_selectors">
                    <button type="button" class="btn" t-on-click="() => this.openSelector('line')">
                        <span class="text-center">
                            <small t-out="productionLineLabel"/>
                            <t t-out="selectedLine?.display_name || selectedLine?.name || productionLineLabel"/>
                        </span>
                        <i class="oi oi-chevron-bottom"/>
                    </button>
                    <button type="button" class="btn" t-on-click="() => this.openSelector('station')">
                        <span class="text-center">
                            <small t-out="workCenterLabel"/>
                            <t t-out="selectedStation?.display_name || selectedStation?.name || workCenterLabel"/>
                        </span>
                        <i class="oi oi-chevron-bottom"/>
                    </button>
                </div>
                <div t-if="state.cameraScannerEnabled">
                    <BarcodeVideoScanner t-props="barcodeVideoScannerProps"/>
                </div>
            </header>


            <!-- 扫码输入：紧贴上下文带，置顶防略过 -->
            <div class="o_sn_wsd_pda_dock">
                <form t-on-submit="submitCommand">
                    <input class="o_sn_wsd_workshop_command form-control"
                           t-model="state.command"
                           t-ref="commandInput"
                           t-att-placeholder="enterCommandLabel"
                           t-att-disabled="state.smtLoading ? 'disabled' : null"/>
                    <button t-if="isSmtOperation" type="button"
                            class="btn btn-secondary"
                            t-att-aria-label="cancelOperationLabel"
                            t-on-click="cancelSmtOperation">
                        <i class="fa fa-times"/>
                    </button>
                </form>
            </div>

            <!-- ❷ 反馈区：进度 + 大色块 + 域动作 -->
            <main class="o_sn_wsd_workshop_body o_barcode_lines flex-grow-1 overflow-auto text-bg-200">
                <div t-if="state.smtLoading" class="o_sn_wsd_workshop_loading">
                    <i class="fa fa-spinner fa-spin me-2"/>
                    <t t-out="loadingLabel"/>
                </div>

                <div t-if="state.productionName" class="o_sn_wsd_pda_progress">
                    <div class="o_sn_wsd_pda_progress_bar">
                        <div t-att-style="'width:' + progressPercent + '%'"/>
                    </div>
                    <div t-if="hasSmtMaterialStatus" class="o_sn_wsd_pda_progress_nums">
                        <div class="o_sn_wsd_pda_num">
                            <strong t-out="state.smtMaterialSummary.required_qty"/>
                            <span t-out="requiredQtyLabel"/>
                        </div>
                        <div class="o_sn_wsd_pda_num is-loaded">
                            <strong t-out="state.smtMaterialSummary.loaded_qty"/>
                            <span t-out="loadedQtyLabel"/>
                        </div>
                        <div class="o_sn_wsd_pda_num is-unloaded">
                            <strong t-out="state.smtMaterialSummary.unloaded_qty"/>
                            <span t-out="unloadedQtyLabel"/>
                        </div>
                    </div>
                    <div class="o_sn_wsd_pda_order">
                        <t t-out="state.productionName"/>
                        <small t-if="state.materialTableName" class="ms-1" t-out="state.materialTableName"/>
                    </div>
                </div>

                <div t-if="state.result"
                     class="o_sn_wsd_pda_feedback"
                     t-attf-class="o_sn_wsd_pda_feedback is-{{state.resultType || 'info'}}">
                    <t t-out="state.result"/>
                    <small t-if="state.rawValue" t-out="state.rawValue"/>
                </div>
                <div t-if="!state.result" class="o_sn_wsd_pda_feedback is-empty">
                    <t t-out="scanMessage"/>
                </div>

                <div t-if="isSmtOperation &amp;&amp; smtScanSummary"
                     class="o_sn_wsd_pda_feedback is-info" style="font-size:15px;">
                    <t t-out="smtScanSummary"/>
                </div>

                <!-- 域 Tab + 当前域动作胶囊 -->
                <div class="o_sn_wsd_pda_tabs">
                    <t t-foreach="smtOperationButtons" t-as="opBtn" t-key="opBtn.key">
                        <button type="button"
                                class="o_sn_wsd_pda_tab"
                                t-att-class="state.selectedOperation === opBtn.key ? 'is-active' : ''"
                                t-on-click="() => this.runOperation(opBtn)">
                            <t t-out="opBtn.label"/>
                        </button>
                    </t>
                </div>
                <section t-if="equipmentModeDef" class="o_sn_wsd_pda_pills">
                    <button t-foreach="equipmentModeDef.actions" t-as="act" t-key="act.key"
                            type="button"
                            t-attf-class="btn {{state.equipmentAction === act.key ? 'btn-primary' : 'btn-outline-primary'}}"
                            t-on-click="() => this.pickEquipmentAction(act.key)">
                        <t t-out="act.label"/>
                    </button>
                </section>
            </main>

            <div t-if="state.selector" class="o_sn_wsd_workshop_modal_backdrop" t-on-click="closeSelector">
                <div class="o_sn_wsd_workshop_modal" t-on-click.stop="">
                    <h2 t-out="selectorTitle"/>
                    <div class="o_sn_wsd_workshop_search">
                        <i class="fa fa-search"/>
                        <input t-model="state.selectorQuery" t-att-placeholder="enterKeywordLabel"/>
                    </div>
                    <div class="o_sn_wsd_workshop_records">
                        <t t-foreach="selectorRecords" t-as="record" t-key="record.id">
                            <button type="button" t-on-click="() => this.selectRecord(record)">
                                <span t-out="record.display_name || record.name"/>
                                <small t-if="record.code" t-out="record.code"/>
                            </button>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
