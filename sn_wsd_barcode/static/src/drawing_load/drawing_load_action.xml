<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sn_wsd_barcode.DrawingLoadAction">
        <div class="o_sn_wsd_drawing_load o_sn_wsd_workshop d-flex flex-column h-100">

            <!-- ❶ 上下文带：返回 / 屏名 / 产线工位选择器 -->
            <header class="o_sn_wsd_pda_contextbar">
                <div class="o_sn_wsd_pda_contextbar_top">
                    <button type="button" class="btn" t-on-click="goBack" t-att-aria-label="backLabel">
                        <i class="oi oi-chevron-left"/>
                    </button>
                    <div class="o_sn_wsd_pda_title" t-out="title"/>
                    <span class="o_sn_wsd_pda_user" style="visibility: hidden;">
                        <t t-out="backLabel"/>
                    </span>
                </div>
                <div class="o_sn_wsd_pda_contextbar_selectors">
                    <button type="button" class="btn" t-on-click="() => this.openSelector('line')">
                        <span class="text-center">
                            <small t-out="lineLabel"/>
                            <t t-out="selectedLineName"/>
                        </span>
                        <i class="oi oi-chevron-bottom"/>
                    </button>
                    <button type="button" class="btn" t-on-click="() => this.openSelector('station')">
                        <span class="text-center">
                            <small t-out="workCenterLabel"/>
                            <t t-out="selectedStationName"/>
                        </span>
                        <i class="oi oi-chevron-bottom"/>
                    </button>
                </div>
            </header>


            <!-- 扫码输入：紧贴上下文带，置顶防略过 -->
            <div class="o_sn_wsd_pda_dock">
                <form t-on-submit="onSubmit">
                    <input class="o_sn_wsd_drawing_command form-control"
                           t-model="state.command"
                           t-att-placeholder="scanHint"
                           t-att-disabled="state.loading ? 'disabled' : null"/>
                </form>
            </div>

            <!-- ❷ 反馈区：进度 + 大色块 + 清单 -->
            <main class="flex-grow-1 overflow-auto">
                <div class="o_sn_wsd_pda_progress">
                    <div class="o_sn_wsd_pda_progress_bar">
                        <div t-att-style="'width:' + progressPercent + '%'"/>
                    </div>
                    <div class="o_sn_wsd_pda_progress_nums">
                        <div class="o_sn_wsd_pda_num">
                            <strong t-out="state.summary.required_qty"/>
                            <span t-out="requiredLabel"/>
                        </div>
                        <div class="o_sn_wsd_pda_num is-loaded">
                            <strong t-out="state.summary.loaded_qty"/>
                            <span t-out="loadedLabel"/>
                        </div>
                        <div class="o_sn_wsd_pda_num is-unloaded">
                            <strong t-out="state.summary.unloaded_qty"/>
                            <span t-out="unloadedLabel"/>
                        </div>
                    </div>
                    <div class="o_sn_wsd_pda_order">
                        <t t-out="state.orderName"/>
                    </div>
                </div>

                <div t-if="state.result"
                     class="o_sn_wsd_pda_feedback"
                     t-attf-class="o_sn_wsd_pda_feedback is-{{state.resultType || 'info'}}">
                    <t t-out="state.result"/>
                </div>

                <div t-if="state.productionId &amp;&amp; state.summary.line_complete"
                     class="o_sn_wsd_pda_feedback is-success">
                    <t t-out="completeLabel"/>
                </div>

                <div t-if="state.rows.length" class="o_sn_wsd_pda_rows">
                    <div class="d-flex align-items-center justify-content-between px-3 py-1">
                        <small class="text-muted" t-out="rowsLabel"/>
                        <button t-if="state.summary.loaded_qty > 0" type="button"
                                class="btn btn-sm"
                                t-attf-class="{{state.confirmUnload ? 'btn-danger' : 'btn-outline-danger'}}"
                                t-on-click="unloadAll">
                            <t t-out="state.confirmUnload ? confirmUnloadLabel : unloadAllLabel"/>
                        </button>
                    </div>
                    <div t-foreach="state.rows" t-as="row" t-key="row.online_material_id"
                         class="o_sn_wsd_pda_row"
                         t-att-class="row.load_status === 'Y' ? 'is-loaded' : 'is-unloaded'">
                        <span class="badge bg-secondary" t-out="typeLabel(row.material_type)"/>
                        <span class="o_sn_wsd_pda_row_name" t-out="row.item_code"/>
                        <span class="o_sn_wsd_pda_row_op" t-out="row.operation"/>
                        <span class="o_sn_wsd_pda_row_val" t-out="row.loaded_name or '—'"/>
                    </div>
                </div>
            </main>

            <div t-if="state.selector" class="o_sn_wsd_workshop_modal_backdrop" t-on-click="closeSelector">
                <div class="o_sn_wsd_workshop_modal" t-on-click.stop="">
                    <h2 t-out="selectorTitle"/>
                    <div class="o_sn_wsd_workshop_search">
                        <i class="fa fa-search"/>
                        <input t-model="state.selectorQuery"/>
                    </div>
                    <div class="o_sn_wsd_workshop_records">
                        <t t-foreach="selectorRecords" t-as="record" t-key="record.id">
                            <button type="button"
                                    t-on-click="state.selector === 'line' ? () => this.selectLine(record) : () => this.selectStation(record)">
                                <span t-out="record.display_name || record.name"/>
                            </button>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
