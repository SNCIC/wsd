<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sn_wsd_barcode.PalletBindingAction">
        <div class="o_content o_sn_wsd_pallet_binding h-100 d-flex flex-column">

            <!-- ❶ 上下文带 -->
            <header class="o_sn_wsd_pda_contextbar">
                <div class="o_sn_wsd_pda_contextbar_top">
                    <button type="button" class="btn" t-on-click="goBack" t-att-aria-label="backLabel">
                        <i class="oi oi-chevron-left"/>
                    </button>
                    <div class="o_sn_wsd_pda_title" t-out="title"/>
                    <span class="o_sn_wsd_pda_user" style="visibility: hidden;">
                        <t t-out="backLabel"/>
                    </span>
                </div>
            </header>

            <!-- 置顶扫码 -->
            <div class="o_sn_wsd_pda_dock">
                <form t-on-submit="submitCommand">
                    <input t-ref="scanInput" t-model="state.command"
                           class="o_sn_wsd_workshop_command form-control"
                           t-att-placeholder="scanHint"
                           t-att-disabled="state.loading ? 'disabled' : null"/>
                </form>
            </div>

            <!-- 模式 Tab -->
            <div class="o_sn_wsd_pda_tabs">
                <button type="button" class="o_sn_wsd_pda_tab"
                        t-att-class="state.mode === 'bind' ? 'is-active' : ''"
                        t-on-click="() => this.switchMode('bind')">
                    <t t-out="bindTabLabel"/>
                </button>
                <button type="button" class="o_sn_wsd_pda_tab"
                        t-att-class="state.mode === 'receive' ? 'is-active' : ''"
                        t-on-click="() => this.switchMode('receive')">
                    <t t-out="receiveTabLabel"/>
                </button>
            </div>

            <main class="flex-grow-1 overflow-auto">
                <div t-if="state.message"
                     class="o_sn_wsd_pda_feedback"
                     t-attf-class="o_sn_wsd_pda_feedback is-{{state.messageType || 'info'}}">
                    <t t-out="state.message"/>
                </div>

                <!-- 绑定模式 -->
                <div t-if="state.mode === 'bind'">
                    <div class="o_sn_wsd_pda_progress">
                        <div class="o_sn_wsd_pda_progress_nums">
                            <div class="o_sn_wsd_pda_num">
                                <strong t-out="state.cartonCount"/>
                                <span t-out="cartonLabel"/>
                            </div>
                            <div class="o_sn_wsd_pda_num is-loaded">
                                <strong t-out="state.meterCount"/>
                                <span t-out="meterLabel"/>
                            </div>
                        </div>
                        <div class="o_sn_wsd_pda_order">
                            <t t-out="currentPalletLabel"/>:
                            <strong t-out="state.palletNo || '—'"/>
                        </div>
                    </div>
                    <div class="o_sn_wsd_pda_pills">
                        <button t-if="state.palletNo" type="button"
                                class="btn btn-outline-primary"
                                t-on-click="resetPallet" t-out="switchPalletLabel"/>
                        <button t-if="state.palletNo" type="button"
                                class="btn btn-primary"
                                t-on-click="closePallet" t-out="closePalletLabel"/>
                    </div>
                </div>

                <!-- 入库模式 -->
                <div t-if="state.mode === 'receive'">
                    <div class="o_sn_wsd_pda_rows">
                        <t t-if="state.receiveList.length">
                            <div t-foreach="state.receiveList" t-as="item" t-key="item.pallet_no"
                                 class="o_sn_wsd_pda_row is-loaded">
                                <span class="badge bg-secondary" t-out="item.carton_count"/>
                                <span class="o_sn_wsd_pda_row_name" t-out="item.pallet_no"/>
                                <span class="o_sn_wsd_pda_row_val" t-out="item.meter_count"/>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        t-on-click="() => this.removePallet(item.pallet_no)">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </t>
                        <div t-if="!state.receiveList.length" class="o_sn_wsd_pda_row is-unloaded">
                            <span class="o_sn_wsd_pda_row_name" t-out="emptyReceiveLabel"/>
                        </div>
                    </div>
                    <div class="o_sn_wsd_pda_progress" t-if="state.receiveList.length">
                        <div class="o_sn_wsd_pda_progress_nums">
                            <div class="o_sn_wsd_pda_num">
                                <strong t-out="receiveTotals.pallets"/>
                                <span t-out="palletLabel"/>
                            </div>
                            <div class="o_sn_wsd_pda_num">
                                <strong t-out="receiveTotals.cartons"/>
                                <span t-out="cartonLabel"/>
                            </div>
                            <div class="o_sn_wsd_pda_num is-loaded">
                                <strong t-out="receiveTotals.meters"/>
                                <span t-out="meterLabel"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_sn_wsd_pda_pills">
                        <button t-if="state.receiveList.length" type="button"
                                class="btn btn-outline-primary"
                                t-on-click="() => { this.state.receiveList = []; }"
                                t-out="clearLabel"/>
                        <button t-if="state.receiveList.length" type="button"
                                class="btn btn-primary"
                                t-on-click="confirmReceive" t-out="receiveConfirmLabel"/>
                    </div>
                </div>
            </main>
        </div>
    </t>

</templates>
