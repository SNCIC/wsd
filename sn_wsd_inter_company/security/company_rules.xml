<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Group rules are combined with OR: users see the agreements of the
             companies they work in, while the inter-company managers see
             every agreement of the database. -->
        <record id="rule_sn_intercompany_agreement_company" model="ir.rule">
            <field name="name">Inter-company agreement: companies of the user</field>
            <field name="model_id" ref="model_sn_intercompany_agreement"/>
            <field name="domain_force">['|', ('company_a_id', 'in', company_ids), ('company_b_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_sn_intercompany_agreement_manager" model="ir.rule">
            <field name="name">Inter-company agreement: managers see all</field>
            <field name="model_id" ref="model_sn_intercompany_agreement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sn_intercompany_manager'))]"/>
        </record>
    </data>
</odoo>
