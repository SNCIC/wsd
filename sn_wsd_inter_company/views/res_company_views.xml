<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inter_company" model="ir.ui.view">
        <field name="name">res.company.form.inter.company</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Inter-Company Transactions" name="inter_company_transactions" groups="base.group_no_one">
                    <group>
                        <group string="Documents">
                            <label for="intercompany_generate_sales_orders" class="text-nowrap col-lg-6 o_light_label"/>
                            <field name="intercompany_generate_sales_orders" nolabel="1"/>
                            <label for="intercompany_generate_purchase_orders" class="text-nowrap col-lg-6 o_light_label"/>
                            <field name="intercompany_generate_purchase_orders" nolabel="1"/>
                            <label for="intercompany_generate_bills_refund" class="text-nowrap col-lg-6 o_light_label"/>
                            <field name="intercompany_generate_bills_refund" nolabel="1"/>
                        </group>
                        <group string="Automation">
                            <field name="intercompany_user_id" options="{'no_create_edit': True}"/>
                            <field name="intercompany_document_state" widget="radio"/>
                            <field name="intercompany_purchase_journal_id"
                                   options="{'no_create_edit': True}"
                                   invisible="not intercompany_generate_bills_refund"
                                   required="intercompany_generate_bills_refund"/>
                            <field name="intercompany_warehouse_id"
                                   options="{'no_create_edit': True}"
                                   domain="[('company_id', '=', id)]"
                                   invisible="not intercompany_generate_sales_orders and not intercompany_generate_purchase_orders"/>
                            <field name="intercompany_receipt_type_id"
                                   domain="[('company_id', '=', id), ('code', '=', 'incoming')]"
                                   invisible="not intercompany_generate_purchase_orders"/>
                            <field name="intercompany_sync_delivery_receipt"
                                   invisible="not intercompany_generate_sales_orders and not intercompany_generate_purchase_orders"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
