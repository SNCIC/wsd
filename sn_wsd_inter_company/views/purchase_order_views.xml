<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_intercompany" model="ir.ui.view">
        <field name="name">purchase.order.form.intercompany</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sn_generate_counterpart"
                        string="Generate Inter-Company Document"
                        type="object" invisible="auto_generated"
                        groups="sn_wsd_inter_company.group_sn_intercompany_manager"
                        help="Create the sales order of the vendor company when it is missing, for example after the vendor was linked to that company."/>
            </xpath>
            <xpath expr="//page[@name='products']" position="after">
                <page string="Inter-Company" name="intercompany"
                      groups="sn_wsd_inter_company.group_sn_intercompany_manager">
                    <group>
                        <group string="Agreement">
                            <field name="intercompany_agreement_id" readonly="1"/>
                            <field name="intercompany_direction" readonly="1"/>
                            <field name="intercompany_sync_state" readonly="1"/>
                            <field name="intercompany_version" readonly="1"/>
                        </group>
                        <group string="Traceability">
                            <field name="auto_generated" readonly="1"/>
                            <field name="auto_sale_order_id" readonly="1"/>
                            <field name="intercompany_source_ref" readonly="1"/>
                            <field name="intercompany_root_ref" readonly="1"/>
                            <field name="intercompany_skip_reason" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
