<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_msd_level_list" model="ir.ui.view">
        <field name="name">sn.msd.level.list</field>
        <field name="model">sn.msd.level</field>
        <field name="arch" type="xml">
            <list string="MSL Levels" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="standard_exposure_minutes"/>
                <field name="warning_exposure_minutes"/>
                <field name="cumulative_exposure_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sn_msd_level_form" model="ir.ui.view">
        <field name="name">sn.msd.level.form</field>
        <field name="model">sn.msd.level</field>
        <field name="arch" type="xml">
            <form string="MSL Level">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="standard_exposure_minutes"/>
                            <field name="warning_exposure_minutes"/>
                            <field name="cumulative_exposure_minutes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_msd_level_search" model="ir.ui.view">
        <field name="name">sn.msd.level.search</field>
        <field name="model">sn.msd.level</field>
        <field name="arch" type="xml">
            <search string="MSL Levels">
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_sn_msd_level" model="ir.actions.act_window">
        <field name="name">MSL Levels</field>
        <field name="res_model">sn.msd.level</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_msd_level_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
