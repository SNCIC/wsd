<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_quality_inspection_measure_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.quality.inspection.measure.wizard.form</field>
        <field name="model">sn.wsd.quality.inspection.measure.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="line_id" readonly="1"/>
                            <field name="product_categ_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="model_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="lot_qty" readonly="1"/>
                            <field name="inspect_qty" readonly="1"/>
                            <field name="nominal_value" readonly="1"/>
                            <field name="upper_limit" readonly="1"/>
                            <field name="lower_limit" readonly="1"/>
                            <field name="unit" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_report_filename" invisible="1"/>
                        <field name="x_report_file"
                               string="Inspection Report"
                               filename="x_report_filename"
                               widget="binary"/>
                        <field name="result_qty" readonly="1"/>
                    </group>
                    <field name="value_ids">
                        <list editable="bottom"
                              decoration-danger="result == 'fail'"
                              decoration-success="result == 'pass'">
                            <field name="sequence" widget="handle"/>
                            <field name="item_type" column_invisible="1"/>
                            <field name="sample_id" readonly="1"/>
                            <field name="measured_value"
                                   invisible="item_type != 'numeric'"/>
                            <field name="text_value"
                                   invisible="item_type == 'numeric'"/>
                            <field name="manual_result"
                                   invisible="item_type == 'numeric'"/>
                            <field name="result" readonly="1"/>
                            <field name="error_value" readonly="1"
                                   invisible="item_type != 'numeric'"/>
                            <field name="measured_at" readonly="1"/>
                            <field name="defect_code_id"
                                   invisible="result != 'fail'"/>
                            <field name="note"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_generate_values"
                            type="object"
                            string="Generate Values"
                            class="btn-secondary"/>
                    <button name="action_apply"
                            type="object"
                            string="Save"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
