<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_quality_oqc_concession_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.quality.oqc.concession.wizard.form</field>
        <field name="model">sn.wsd.quality.oqc.concession.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="expected_versions" invisible="1"/>
                <sheet>
                    <group>
                        <group>
                            <field name="inspection_id" readonly="1" options="{'no_open': True}"/>
                        </group>
                        <group>
                            <field name="hard_block_reasons" readonly="1" nolabel="1" placeholder="No blocking condition: the concession can be confirmed."/>
                        </group>
                    </group>
                    <group string="Concession Scope">
                        <field name="scope_serial_ids" widget="many2many_tags" readonly="1" options="{'no_create': True}"/>
                    </group>
                    <group string="Reason">
                        <field name="reason" required="1" placeholder="Why the batch is accepted with the known defects..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Accept by Concession" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
