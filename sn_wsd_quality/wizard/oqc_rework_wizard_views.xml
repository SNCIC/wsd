<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oqc_rework_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.quality.oqc.rework.wizard.form</field>
        <field name="model">sn.wsd.quality.oqc.rework.wizard</field>
        <field name="arch" type="xml">
            <form string="Rework Decision">
                <field name="inspection_id"/>
                <field name="serial_candidate_ids" invisible="1"/>
                <field name="route_operation_candidate_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="serial_ids" widget="many2many_tags" options="{'no_create': 1}"/>
                        <field name="route_operation_id" options="{'no_create': 1}"/>
                    </group>
                    <group>
                        <field name="reason" placeholder="Why does this board go back?"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Send Back"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_oqc_rework_wizard" model="ir.actions.act_window">
        <field name="name">Rework Decision</field>
        <field name="res_model">sn.wsd.quality.oqc.rework.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- OQC inspection form: disposition buttons -->
    <record id="view_sn_wsd_quality_inspection_form_oqc_disposition" model="ir.ui.view">
        <field name="name">sn.wsd.quality.inspection.form.oqc.disposition</field>
        <field name="model">sn.wsd.quality.inspection</field>
        <field name="inherit_id" ref="sn_wsd_quality.view_sn_wsd_quality_inspection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_oqc_rework_wizard)d" type="action"
                        string="Rework" class="btn-secondary"
                        context="{'default_inspection_id': id}"
                        invisible="inspection_type != 'oqc'"/>
                <button name="action_start_full_inspection" type="object"
                        string="Full Lot Inspection" class="btn-secondary"
                        invisible="inspection_type != 'oqc' or x_full_inspection or result != 'reject'"/>
                <field name="x_full_inspection" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
