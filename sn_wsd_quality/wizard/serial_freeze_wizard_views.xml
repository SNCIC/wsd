<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_serial_freeze_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.serial.freeze.wizard.form</field>
        <field name="model">sn.wsd.serial.freeze.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="mode" widget="radio"/>
                    </group>
                    <group invisible="mode == 'release'">
                        <group>
                            <field name="serial_no" invisible="mode != 'single'" required="mode == 'single' and not serial_id"/>
                            <field name="serial_id" invisible="mode != 'single'" required="mode == 'single' and not serial_no"/>
                            <field name="production_id" readonly="mode == 'single'"/>
                            <field name="route_operation_id" required="mode == 'route_operation'"/>
                        </group>
                        <group>
                            <field name="freeze_reason" required="mode != 'release'"/>
                        </group>
                    </group>
                    <group invisible="mode != 'release'">
                        <field name="freeze_record_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="serial_id"/>
                                <field name="production_id"/>
                                <field name="route_operation_id"/>
                                <field name="freeze_reason"/>
                                <field name="freeze_time"/>
                            </list>
                        </field>
                        <field name="release_reason" placeholder="Optional release reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
