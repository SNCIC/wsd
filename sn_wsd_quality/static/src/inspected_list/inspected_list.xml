<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="sn_wsd_quality.OqcInspectedList">
    <div class="o_oqc_inspected_list d-flex flex-column gap-2">
        <div class="d-flex gap-2 align-items-center">
            <input type="text" class="form-control form-control-sm"
                   style="max-width: 260px"
                   t-att-value="state.search"
                   t-att-placeholder="labels.searchPlaceholder"
                   t-on-keydown="onSearch"
                   t-on-input="onSearchInput"/>
            <select class="form-select form-select-sm" style="max-width: 140px"
                    t-att-value="state.verdict"
                    t-on-change="onVerdictChange">
                <option value="all" t-esc="labels.all"/>
                <option value="ok" t-esc="labels.ok"/>
                <option value="ng" t-esc="labels.ng"/>
                <option value="scrap" t-esc="labels.scrap"/>
            </select>
            <span class="small text-muted ms-auto" t-if="!state.loading">
                <t t-out="countsLabel"/> · <t t-out="totalLabel"/>
            </span>
        </div>

        <div t-if="state.loading" class="text-muted p-3" t-esc="labels.loading"/>

        <div t-if="!state.loading and !state.rows.length" class="text-muted p-3"
             t-esc="labels.empty"/>

        <div t-if="!state.loading and state.rows.length" class="table-responsive">
            <table class="table table-sm o_list_table">
                <thead>
                    <tr class="text-start">
                        <th t-esc="labels.sn"/>
                        <th t-esc="labels.result"/>
                        <th t-esc="labels.disposition"/>
                        <th t-esc="labels.inspectedAt"/>
                        <th t-esc="labels.operator"/>
                        <th t-esc="labels.defectCode"/>
                        <th/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="state.rows" t-as="row" t-key="row.serial_id">
                        <td t-out="row.serial_name or ''"/>
                        <td>
                            <span t-attf-class="badge {{ verdictClass(row.verdict) }}"
                                  t-out="verdictLabel(row.verdict)"/>
                        </td>
                        <td>
                            <span t-if="row.disposition_state"
                                  class="badge text-bg-info"
                                  t-out="dispositionLabel(row.disposition_state)"/>
                        </td>
                        <td t-out="row.out_date or ''"/>
                        <td t-out="row.operator_code or ''"/>
                        <td t-out="defectCode(row)"/>
                        <td>
                            <button class="btn btn-sm btn-link py-0"
                                    t-on-click="() => this.openStationHistory(row)"
                                    t-esc="labels.passes"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div t-if="!state.loading and state.total > 0"
             class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-secondary" t-on-click="prev"
                    t-att-disabled="state.page &lt;= 1">&#8249;</button>
            <span class="small">
                <t t-out="state.page"/> / <t t-out="state.pageCount"/>
            </span>
            <button class="btn btn-sm btn-secondary" t-on-click="next"
                    t-att-disabled="state.page >= state.pageCount">&#8250;</button>
        </div>
    </div>
</t>

</templates>
