<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_iqc" model="ir.ui.view">
        <field name="name">stock.picking.form.iqc.sn.wsd.quality</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='button_validate'][1]" position="before">
                <button name="action_create_iqc_inspections"
                        type="object"
                        string="Quality Inspection"
                        class="oe_highlight"
                        invisible="not x_is_iqc_control_picking or state in ('done', 'cancel')"
                        groups="stock.group_stock_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_iqc_inspections"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-square-o"
                        invisible="x_iqc_inspection_count == 0">
                    <field name="x_iqc_inspection_count"
                           string="IQC"
                           widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="after">
                <!-- The incoming control only speaks about the operation it
                     gates: on any other transfer its columns are dropped as a
                     whole. Hiding the button alone would leave its column
                     behind as an empty strip between Demand and Quantity. -->
                <field name="x_iqc_inspect_qty"
                       string="Qty to Inspect"
                       optional="show"
                       column_invisible="not parent.x_is_iqc_control_picking"/>
                <field name="x_quality_inspection_count"
                       string="IQC"
                       optional="hide"
                       column_invisible="not parent.x_is_iqc_control_picking"/>
                <button name="action_create_iqc_inspection"
                        type="object"
                        string="IQC"
                        icon="fa-flask"
                        column_invisible="not parent.x_is_iqc_control_picking"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="x_iqc_inspection_count" invisible="1"/>
                <field name="x_is_iqc_control_picking" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
