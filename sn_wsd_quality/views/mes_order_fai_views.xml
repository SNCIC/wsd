<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 制令单表单：首件状态徽标 + 轮次 + 首件检验入口（add-mes-fai） -->
    <record id="view_sn_wsd_mes_order_form_fai" model="ir.ui.view">
        <field name="name">sn.wsd.mes.order.form.fai.sn.wsd.quality</field>
        <field name="model">sn.wsd.mes.order</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_mes_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='x_manage_mode']" position="after">
                <field name="x_fai_state" widget="badge"
                       invisible="x_fai_state == 'none'"
                       decoration-success="x_fai_state == 'passed'"
                       decoration-warning="x_fai_state == 'in_progress'"/>
                <field name="x_fai_round" invisible="x_fai_state == 'none'"/>
                <field name="x_fai_sample_count" invisible="x_fai_state != 'in_progress'"/>
                <field name="x_fai_sample_done" invisible="x_fai_state != 'in_progress'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_fai_inspections" type="object"
                        class="oe_stat_button" icon="fa-flag-checkered"
                        invisible="x_fai_inspection_count == 0">
                    <field name="x_fai_inspection_count" widget="statinfo"
                           string="First Article"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- 检验单表单：FAI 样本清单（已到/未到） -->
    <record id="view_sn_wsd_quality_inspection_form_fai" model="ir.ui.view">
        <field name="name">sn.wsd.quality.inspection.form.fai.sn.wsd.quality</field>
        <field name="model">sn.wsd.quality.inspection</field>
        <field name="inherit_id" ref="view_sn_wsd_quality_inspection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='scope']" position="after">
                <!-- ipqc 无页签区段式表单：范围/抽检结果/检验项/备注 以标题分区，
                     notebook 对 ipqc 整体隐藏 -->
                <page name="fai_samples" string="First Article Samples"
                      invisible="inspection_type != 'fai'">
                    <group>
                        <group string="Reported Qty"
                               invisible="not mes_order_id or mes_order_id.x_manage_mode != 'report'">
                            <field name="x_fai_reported_qty" nolabel="1"
                                   readonly="state == 'done'"/>
                        </group>
                        <group string="Arrived Samples"
                               invisible="not mes_order_id or mes_order_id.x_manage_mode == 'report'">
                            <field name="x_fai_arrived_serial_ids" nolabel="1"
                                   widget="many2many_tags"
                                   readonly="state == 'done'"/>
                        </group>
                        <group string="Fed Samples"
                               invisible="not mes_order_id or mes_order_id.x_manage_mode == 'report'">
                            <field name="x_fai_serial_ids" nolabel="1"
                                   widget="many2many_tags"
                                   readonly="state == 'done'"/>
                        </group>
                    </group>
                </page>
            </xpath>
                <xpath expr="//notebook" position="before">
                    <div name="ipqc_sections" invisible="inspection_type != 'ipqc'">
                        <separator string="Scope"/>
                        <group>
                            <group>
                                <field name="mes_order_id" readonly="state == 'done'"/>
                                <field name="production_line_id"/>
                                <field name="x_patrol_operation_id"/>
                            </group>
                        </group>
                        <separator string="Patrol Results"/>
                        <group>
                            <group string="Statistics">
                                <field name="sample_size" readonly="state != 'open'"/>
                                <field name="sample_checked_qty"/>
                                <field name="sample_defect_qty"/>
                            </group>
                            <group string="Picked Qty (no SN)">
                                <field name="x_ipqc_quick_ok" readonly="state == 'done'"/>
                                <field name="x_ipqc_quick_ng" readonly="state == 'done'"/>
                                <field name="x_ipqc_quick_line_id"
                                       invisible="x_ipqc_quick_ng &lt;= 0"
                                       domain="[('inspection_id', '=', parent.id)]"
                                       options="{'no_create': 1}" readonly="state == 'done'"/>
                                <field name="x_ipqc_quick_defect_id"
                                       invisible="x_ipqc_quick_ng &lt;= 0"
                                       options="{'no_create': 1}" readonly="state == 'done'"/>
                                <field name="x_ipqc_quick_note"
                                       invisible="x_ipqc_quick_ng &lt;= 0"
                                       readonly="state == 'done'"
                                       placeholder="e.g. solder bridge after reflow"/>
                            </group>
                        </group>
                        <!-- 逐台判定（过站模式）：行内选SN（可扫码）+判结果；
                             fail 行可挂 检验项目+缺陷代码（不良归属，供统计/SPC） -->
                        <field name="sample_ids" nolabel="1"
                               readonly="state == 'done'">
                            <list editable="bottom" decoration-danger="result == 'fail'" decoration-success="result == 'pass'">
                                <field name="sequence" widget="handle"/>
                                <field name="serial_identity_id" options="{'no_create': 1}"/>
                                <field name="result"/>
                                <field name="x_line_id" invisible="result != 'fail'"
                                       domain="[('inspection_id', '=', parent.id)]"
                                       options="{'no_create': 1}"/>
                                <field name="defect_code_id" invisible="result != 'fail'" options="{'no_create': 1}"/>
                                <field name="note" placeholder="optional"/>
                            </list>
                        </field>
                        <separator string="Inspection Items"/>
                        <field name="line_ids" nolabel="1" readonly="state == 'done'">
                            <list editable="bottom" decoration-danger="result == 'fail'" decoration-success="result == 'pass'">
                                <field name="sequence" widget="handle"/>
                                <field name="item_code"/>
                                <field name="name"/>
                                <field name="item_type"/>
                                <field name="required"/>
                                <field name="lower_limit" invisible="item_type != 'numeric'"/>
                                <field name="upper_limit" invisible="item_type != 'numeric'"/>
                                <field name="measured_value" invisible="item_type != 'numeric'"/>
                                <field name="text_value" invisible="item_type == 'numeric'"/>
                                <field name="manual_result" invisible="item_type == 'numeric'"/>
                                <field name="is_checked"/>
                                <field name="result"/>
                                <field name="unit"/>
                                <field name="note"/>
                            </list>
                        </field>
                        <separator string="Notes"/>
                        <field name="note" nolabel="1" readonly="state == 'done'"
                               placeholder="Patrol remarks..."/>
                    </div>
                </xpath>
                <xpath expr="//notebook" position="attributes">
                    <attribute name="invisible">inspection_type == 'ipqc'</attribute>
                </xpath>
        </field>
    </record>
</odoo>
