<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_form_quality_inspection" model="ir.ui.view">
        <field name="name">mrp.workorder.form.quality.inspection</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="sn_wsd_quality.view_mrp_workorder_form_sn_wsd_quality"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_quality_inspections" icon="fa-check-square-o">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="x_quality_inspection_count"/></span>
                        <span class="o_stat_text">Inspections</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_mes_travel_events" type="object" string="Travel Events" class="btn-secondary"/>
            </xpath>
            <xpath expr="//field[@name='x_quality_issue_ids']/ancestor::group[1]" position="after">
                <group string="Quality Inspections">
                    <field name="x_quality_inspection_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="inspection_type"/>
                            <field name="scheme_id"/>
                            <field name="state"/>
                            <field name="result"/>
                            <field name="scheduled_time"/>
                            <field name="finish_time"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_quality_inspection" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.quality.inspection</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="x_quality_inspection_count" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_quality_inspection" model="ir.ui.view">
        <field name="name">stock.move.line.operations.detailed.list.quality.inspection</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="x_quality_inspection_count" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_iqc_quality_inspection" model="ir.ui.view">
        <field name="name">stock.picking.form.iqc.quality.inspection</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_iqc_quality_inspection" model="ir.ui.view">
        <field name="name">product.template.form.iqc.quality.inspection</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
            </xpath>
        </field>
    </record>
</odoo>
