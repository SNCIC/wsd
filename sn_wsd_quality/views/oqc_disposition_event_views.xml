<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================================================================
         OQC 处置历史（oqc-disposition-closure 决策 5，任务 7.3）：
         只读事件列表——按 SN/动作/前后状态/缺陷码/原因/操作人/时间展示，
         服务端分页（标准 act_window），表单不嵌 one2many 全量加载。
         原始过站记录/报废单跳转按钮按行提供（报废按钮由 sn_wsd_scrap
         的视图扩展追加，quality 不引用未安装的字段）。
         ================================================================== -->
    <record id="view_sn_wsd_quality_oqc_disposition_event_list" model="ir.ui.view">
        <field name="name">sn.wsd.quality.oqc.disposition.event.list</field>
        <field name="model">sn.wsd.quality.oqc.disposition.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-warning="state_after in ('pending', 'reworking', 'awaiting_reinspection')"
                  decoration-success="state_after in ('retest_passed', 'concession')"
                  decoration-danger="state_after == 'scrapped'">
                <field name="event_time"/>
                <field name="serial_identity_id"/>
                <field name="action" widget="badge"/>
                <field name="state_before" optional="hide"/>
                <field name="state_after"/>
                <field name="attempt_no" optional="hide"/>
                <field name="defect_code_id"/>
                <field name="defect_code_raw" optional="hide"/>
                <field name="reason" optional="show"/>
                <field name="operator_id"/>
                <field name="inspection_id" optional="show"/>
                <field name="mes_order_id" optional="hide"/>
                <button name="action_open_station_history" type="object"
                        string="Station Passes" icon="fa-history"
                        invisible="not serial_identity_id"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_quality_oqc_disposition_event_search" model="ir.ui.view">
        <field name="name">sn.wsd.quality.oqc.disposition.event.search</field>
        <field name="model">sn.wsd.quality.oqc.disposition.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="serial_identity_id"/>
                <field name="inspection_id"/>
                <field name="mes_order_id"/>
                <field name="defect_code_id"/>
                <field name="operator_id"/>
                <field name="reason"/>
                <filter name="f_serial_events" string="Board Events"
                        domain="[('serial_identity_id', '!=', False)]"/>
                <filter name="f_batch_events" string="Batch Events"
                        domain="[('serial_identity_id', '=', False)]"/>
                <separator/>
                <filter name="f_open" string="Open After"
                        domain="[('state_after', 'in', ('pending', 'reworking', 'awaiting_reinspection'))]"/>
                <filter name="f_closed" string="Closed After"
                        domain="[('state_after', 'in', ('retest_passed', 'scrapped', 'concession'))]"/>
                <separator string="Group By"/>
                <filter string="SN" name="g_serial"
                        context="{'group_by': 'serial_identity_id'}"/>
                <filter string="Action" name="g_action"
                        context="{'group_by': 'action'}"/>
                <filter string="State After" name="g_state"
                        context="{'group_by': 'state_after'}"/>
                <filter string="Defect Code" name="g_defect"
                        context="{'group_by': 'defect_code_id'}"/>
                <filter string="Operator" name="g_operator"
                        context="{'group_by': 'operator_id'}"/>
                <filter string="Event Time" name="g_time"
                        context="{'group_by': 'event_time:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_quality_oqc_disposition_event" model="ir.actions.act_window">
        <field name="name">OQC Disposition History</field>
        <field name="res_model">sn.wsd.quality.oqc.disposition.event</field>
        <field name="view_mode">list</field>
        <!-- 无业务菜单（决策 1）：入口在 OQC 检验单的 Dispositions 按钮，
             domain 按本单过滤 -->
    </record>
</odoo>
