<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Three-part continuous form: the sheet is 241 mm wide and 279.4 mm
         high, cut into three equal parts, so one part is 241 x 93 mm.

         wkhtmltopdf treats the page width and height options as the portrait
         paper size and swaps them for a landscape orientation: giving it
         241 x 93 with a portrait orientation made it rotate the sheet into a
         93 x 241 strip (the sheet then printed sideways). The part is
         therefore declared as the portrait size 93 x 241 and the landscape
         orientation swaps it back into the 241 x 93 part of the form. -->
    <record id="paperformat_inspection_request" model="report.paperformat">
        <field name="name">Inspection Request (241 x 93 mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">93</field>
        <field name="page_height">241</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="css_margins" eval="True"/>
    </record>

    <!-- Printed from the receipt form only: no binding on the model, so the
         standard print menu of the transfers keeps its own reports. -->
    <record id="action_report_inspection_request" model="ir.actions.report">
        <field name="name">Inspection Request</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sn_wsd_quality.report_inspection_request</field>
        <field name="report_file">sn_wsd_quality.report_inspection_request</field>
        <field name="paperformat_id" ref="sn_wsd_quality.paperformat_inspection_request"/>
        <field name="print_report_name">'Inspection Request - %s' % (object.name)</field>
    </record>
</odoo>
