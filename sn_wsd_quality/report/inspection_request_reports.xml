<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Three-part continuous form: the sheet is 241 mm wide and 279.4 mm
         high, cut into three equal parts, so one part is 241 x 93 mm. The
         portrait orientation keeps the width as given: wkhtmltopdf would swap
         the two dimensions with a landscape orientation. -->
    <record id="paperformat_inspection_request" model="report.paperformat">
        <field name="name">Inspection Request (241 x 93 mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">241</field>
        <field name="page_height">93</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="css_margins" eval="True"/>
    </record>

    <!-- Printed from the receipt form only: no binding on the model, so the
         standard print menu of the transfers keeps its own reports. -->
    <record id="action_report_inspection_request" model="ir.actions.report">
        <field name="name">Inspection Request</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sn_wsd_quality.report_inspection_request</field>
        <field name="report_file">sn_wsd_quality.report_inspection_request</field>
        <field name="paperformat_id" ref="sn_wsd_quality.paperformat_inspection_request"/>
        <field name="print_report_name">'Inspection Request - %s' % (object.name)</field>
    </record>
</odoo>
