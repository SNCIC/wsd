<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_fai_inspection" model="report.paperformat">
        <field name="name">A4 First Article Confirmation Sheet</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="css_margins" eval="True"/>
    </record>

    <!-- Printed from the first-article inspection form only: no binding on the
         model, so IQC/IPQC/OQC keep their own documents. -->
    <record id="action_report_fai_inspection" model="ir.actions.report">
        <field name="name">First Article Confirmation Sheet</field>
        <field name="model">sn.wsd.quality.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sn_wsd_quality.report_fai_inspection</field>
        <field name="report_file">sn_wsd_quality.report_fai_inspection</field>
        <field name="paperformat_id" ref="sn_wsd_quality.paperformat_fai_inspection"/>
        <field name="print_report_name">'First Article Confirmation Sheet - %s' % (object.name)</field>
    </record>
</odoo>
