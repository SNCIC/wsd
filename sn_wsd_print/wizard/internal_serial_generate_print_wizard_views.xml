<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_internal_serial_generate_print_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.internal.serial.generate.print.wizard.form</field>
        <field name="model">sn.wsd.internal.serial.generate.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate and Print Factory Serial Numbers">
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id"/>
                            <field name="product_id"/>
                            <field name="planned_qty"/>
                        </group>
                        <group>
                            <field name="active_internal_serial_count"/>
                            <field name="missing_internal_serial_count"/>
                            <field name="quantity"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Generate and Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_internal_serial_generate_print_wizard" model="ir.actions.act_window">
        <field name="name">Generate and Print Factory Serial Numbers</field>
        <field name="res_model">sn.wsd.internal.serial.generate.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sn_wsd_internal_serial_generate_print_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
