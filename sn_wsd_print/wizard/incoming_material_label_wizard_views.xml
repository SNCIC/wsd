<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incoming_material_label_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.incoming.material.label.wizard.form</field>
        <field name="model">sn.wsd.incoming.material.label.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="picking_id"/>
                    <field name="partner_id"/>
                    <field name="supplier_code"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_id" force_save="1"/>
                        <field name="move_id" column_invisible="1" force_save="1"/>
                        <field name="quantity" force_save="1"/>
                        <field name="quantity_per_label"/>
                        <field name="official_batch_no" force_save="1"/>
                        <field name="existing_lot_id" force_save="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="Generate and Print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
