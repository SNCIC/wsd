        <field name="model">sn.wsd.manufacturing.batch</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_manufacturing_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_generate_missing_internal_serials']" position="attributes">
                <attribute name="name">action_open_generate_internal_serial_print_wizard</attribute>
