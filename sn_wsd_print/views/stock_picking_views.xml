<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_material_label" model="ir.ui.view">
        <field name="name">stock.picking.form.material.label</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_validate'][1]" position="before">
                <field name="can_print_material_labels" invisible="1"/>
                <button name="action_open_material_label_wizard"
                        string="Print Material Labels"
                        type="object"
                        class="btn-secondary"
                        invisible="not can_print_material_labels"
                        groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>
</odoo>
