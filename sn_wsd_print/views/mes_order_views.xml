<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_mes_order_form_print" model="ir.ui.view">
        <field name="name">sn.wsd.mes.order.form.print</field>
        <field name="model">sn.wsd.mes.order</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_mes_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_generate_internal_serials" invisible="1"/>
                <button name="action_open_generate_print_internal_serials"
                        type="object"
                        string="Generate and Print Factory Serial Numbers"
                        class="btn-secondary"
                        invisible="not can_generate_internal_serials"/>
            </xpath>
        </field>
    </record>
</odoo>
