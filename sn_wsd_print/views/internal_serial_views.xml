<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_internal_serial_list_print_inherit" model="ir.ui.view">
        <field name="name">sn.wsd.internal.serial.list.print.inherit</field>
        <field name="model">sn.wsd.internal.serial</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_internal_serial_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pack_date']" position="after">
                <field name="label_print_count" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sn_wsd_internal_serial_form_print_inherit" model="ir.ui.view">
        <field name="name">sn.wsd.internal.serial.form.print.inherit</field>
        <field name="model">sn.wsd.internal.serial</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_internal_serial_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pack_date']" position="after">
                <field name="label_print_count"/>
            </xpath>
        </field>
    </record>
</odoo>
