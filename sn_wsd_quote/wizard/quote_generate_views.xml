<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_quote_generate_form" model="ir.ui.view">
        <field name="name">sn.wsd.quote.generate.form</field>
        <field name="model">sn.wsd.quote.generate</field>
        <field name="arch" type="xml">
            <form string="Generate Cost from Bill of Materials">
                <group>
                    <field name="quote_id" invisible="1"/>
                    <field name="bom_id"/>
                    <field name="route_id"/>
                    <field name="explode_sub_boms"/>
                    <field name="include_operations"/>
                    <field name="clear_existing"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
