<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 groups a res.groups under a res.groups.privilege, itself
         attached to a module category (the groups of the Settings page). -->
    <record id="module_category_sn_quote" model="ir.module.category">
        <field name="name">Quotation Estimate</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_sn_quote" model="res.groups.privilege">
        <field name="name">Quotation Estimate</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_sn_quote"/>
    </record>

    <record id="group_sn_quote_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_sn_quote"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_sn_quote_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_sn_quote"/>
        <field name="implied_ids" eval="[Command.link(ref('group_sn_quote_user'))]"/>
    </record>

    <record id="rule_sn_wsd_quote_company" model="ir.rule">
        <field name="name">Quotation Estimate: multi-company</field>
        <field name="model_id" ref="model_sn_wsd_quote"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_sn_wsd_quote_line_company" model="ir.rule">
        <field name="name">Quotation Estimate Line: multi-company</field>
        <field name="model_id" ref="model_sn_wsd_quote_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_sn_wsd_quote_tier_company" model="ir.rule">
        <field name="name">Quotation Estimate Tier: multi-company</field>
        <field name="model_id" ref="model_sn_wsd_quote_tier"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('quote_id.company_id', '=', False), ('quote_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
