<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MES order (制令单) Gantt: one read-only pill per planned day, one
         row per production line. Scheduling edits go through the wizard
         only (架构设计 3.1), so creating / dragging pills is disabled. -->
    <record id="sn_wsd_mes_order_gantt_view" model="ir.ui.view">
        <field name="name">sn.wsd.mes.order.gantt</field>
        <field name="model">sn.wsd.mes.order</field>
        <field name="type">gantt</field>
        <field name="arch" type="xml">
            <gantt string="MES Order Schedule"
                   date_start="date_plan"
                   date_stop="x_date_plan_end"
                   default_group_by="production_line_id"
                   default_scale="day"
                   color="state"
                   create="0" edit="0" delete="0" disable_drag_drop="1">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="x_side"/>
                <field name="planned_qty"/>
                <field name="picked_qty"/>
                <field name="state"/>
            </gantt>
        </field>
    </record>

    <record id="sn_wsd_mrp.action_sn_wsd_mes_orders" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,gantt,calendar,pivot,graph,form</field>
    </record>
</odoo>
