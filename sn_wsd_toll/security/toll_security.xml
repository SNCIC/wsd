<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_sn_toll_user" model="res.groups">
            <field name="name">Toll Manufacturing User</field>
            <field name="implied_ids" eval="[Command.link(ref('mrp.group_mrp_user'))]"/>
        </record>

        <record id="group_sn_toll_manager" model="res.groups">
            <field name="name">Toll Manufacturing Manager</field>
            <field name="implied_ids" eval="[Command.link(ref('group_sn_toll_user'))]"/>
        </record>

        <!-- Portal customers only see their own toll manufacturing orders. -->
        <record id="sn_toll_order_portal_rule" model="ir.rule">
            <field name="name">Toll manufacturing order: portal customer</field>
            <field name="model_id" ref="model_sn_toll_order"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="sn_toll_material_line_portal_rule" model="ir.rule">
            <field name="name">Toll supplied material: portal customer</field>
            <field name="model_id" ref="model_sn_toll_material_line"/>
            <field name="domain_force">[('order_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="sn_toll_loss_portal_rule" model="ir.rule">
            <field name="name">Toll loss settlement: portal customer</field>
            <field name="model_id" ref="model_sn_toll_loss"/>
            <field name="domain_force">[('order_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="sn_toll_loss_line_portal_rule" model="ir.rule">
            <field name="name">Toll loss line: portal customer</field>
            <field name="model_id" ref="model_sn_toll_loss_line"/>
            <field name="domain_force">[('loss_id.order_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="sn_toll_order_comp_rule" model="ir.rule">
            <field name="name">Toll manufacturing order: multi-company</field>
            <field name="model_id" ref="model_sn_toll_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sn_toll_loss_comp_rule" model="ir.rule">
            <field name="name">Toll loss settlement: multi-company</field>
            <field name="model_id" ref="model_sn_toll_loss"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
