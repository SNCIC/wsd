<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_toll" model="ir.ui.view">
        <field name="name">mrp.production.form.toll</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="sn_is_toll" invisible="1"/>
                <field name="sn_toll_order_id"
                       invisible="not sn_toll_order_id" readonly="1"/>
                <field name="sn_toll_partner_id"
                       invisible="not sn_toll_partner_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_list_toll" model="ir.ui.view">
        <field name="name">mrp.production.list.toll</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sn_toll_order_id" optional="show"/>
                <field name="sn_toll_partner_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_search_toll" model="ir.ui.view">
        <field name="name">mrp.production.search.toll</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sn_toll_order_id"/>
                <field name="sn_toll_partner_id"/>
            </xpath>
            <xpath expr="//filter[@name='todo']" position="before">
                <filter name="filter_sn_toll" string="Toll Manufacturing"
                        domain="[('sn_is_toll', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
