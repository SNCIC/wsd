<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_toll" name="Toll Manufacturing Portal Card"
              inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="o_portal_category row g-2 mt-3" id="portal_toll_category">
                <div class="o_portal_index_card col-md-6 order-2">
                    <a href="/my/toll/orders"
                       class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                        <div>
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1">Toll Manufacturing</div>
                            <div class="opacity-75">Supplied material and production progress</div>
                        </div>
                    </a>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_my_toll_orders" name="My Toll Manufacturing Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="row align-items-center mb-3">
                <div class="col-12">
                    <h3 class="mb-0">Toll Manufacturing Orders</h3>
                </div>
            </div>
            <t t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Order</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Produced</th>
                        <th class="text-end">Delivered</th>
                        <th>Deadline</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="orders" t-as="order">
                        <td>
                            <a t-attf-href="/my/toll/orders/#{order.id}">
                                <t t-out="order.name"/>
                            </a>
                        </td>
                        <td class="text-end"><t t-out="order.product_qty"/></td>
                        <td class="text-end"><t t-out="order.produced_qty"/></td>
                        <td class="text-end"><t t-out="order.delivered_qty"/></td>
                        <td>
                            <span t-if="order.date_deadline" t-out="order.date_deadline"/>
                        </td>
                        <td>
                            <t t-out="dict(order._fields['state'].selection).get(order.state)"/>
                        </td>
                    </tr>
                </tbody>
            </t>
            <div t-if="not orders" class="text-center text-muted mt-3">
                No toll manufacturing order yet.
            </div>
            <div class="d-flex justify-content-center mt-3">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <template id="portal_my_toll_order_detail" name="My Toll Manufacturing Order">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="row mb-3">
                <div class="col-12">
                    <a href="/my/toll/orders" class="btn btn-link ps-0">&lt; Back to orders</a>
                    <h3 class="mb-0"><t t-out="order.name"/></h3>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <table class="table table-sm">
                        <tr>
                            <th>Product</th>
                            <td><t t-out="order.product_id.display_name"/></td>
                        </tr>
                        <tr>
                            <th>Quantity</th>
                            <td><t t-out="order.product_qty"/></td>
                        </tr>
                        <tr>
                            <th>Produced</th>
                            <td><t t-out="order.produced_qty"/></td>
                        </tr>
                        <tr>
                            <th>Delivered</th>
                            <td><t t-out="order.delivered_qty"/></td>
                        </tr>
                        <tr>
                            <th>Deadline</th>
                            <td><t t-out="order.date_deadline"/></td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td><t t-out="dict(order._fields['state'].selection).get(order.state)"/></td>
                        </tr>
                    </table>
                </div>
                <div class="col-lg-6">
                    <div class="progress" style="height: 1.5rem;">
                        <div class="progress-bar" t-attf-style="width: #{order.progress}%">
                            <t t-out="order.progress"/>%
                        </div>
                    </div>
                    <p class="text-muted mt-2">
                        Supplied material in stock:
                        <strong><t t-out="order.material_stock_qty"/></strong>
                    </p>
                </div>
            </div>
            <h4 class="mt-4">Supplied Material</h4>
            <table class="table table-sm">
                <thead>
                    <tr class="active">
                        <th>Material</th>
                        <th class="text-end">Supplied</th>
                        <th class="text-end">Received</th>
                        <th class="text-end">In Stock</th>
                        <th class="text-end">Consumed</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="order.material_line_ids" t-as="line">
                        <td><t t-out="line.product_id.display_name"/></td>
                        <td class="text-end"><t t-out="line.product_uom_qty"/></td>
                        <td class="text-end"><t t-out="line.qty_received"/></td>
                        <td class="text-end"><t t-out="line.qty_on_hand"/></td>
                        <td class="text-end"><t t-out="line.qty_consumed"/></td>
                    </tr>
                </tbody>
            </table>
            <h4 class="mt-4" t-if="order.loss_ids">Loss Settlements</h4>
            <table class="table table-sm" t-if="order.loss_ids">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Date</th>
                        <th>Settlement</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="order.loss_ids" t-as="loss">
                        <td><t t-out="loss.name"/></td>
                        <td><t t-out="loss.date"/></td>
                        <td><t t-out="dict(loss._fields['settlement_type'].selection).get(loss.settlement_type)"/></td>
                        <td class="text-end">
                            <t t-out="loss.amount"/>
                            <t t-out="order.currency_id.symbol"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>
</odoo>
