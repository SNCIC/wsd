<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_toll_loss_form" model="ir.ui.view">
        <field name="name">sn.toll.loss.form</field>
        <field name="model">sn.toll.loss</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_lines" string="Load Loss"
                            type="object" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Settle" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_view_account_move" string="Claim Invoice"
                            type="object" invisible="not account_move_id"/>
                    <button name="action_view_picking" string="Resupply Receipt"
                            type="object" invisible="not picking_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Loss Settlement"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Settlement">
                            <field name="order_id"
                                   options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="settlement_type"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Amount">
                            <field name="amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Loss Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"
                                           options="{'no_create': True}"/>
                                    <field name="product_uom_id"
                                           groups="uom.group_uom"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_toll_loss_list" model="ir.ui.view">
        <field name="name">sn.toll.loss.list</field>
        <field name="model">sn.toll.loss</field>
        <field name="arch" type="xml">
            <list string="Loss Settlements"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="settlement_type"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sn_toll_loss_search" model="ir.ui.view">
        <field name="name">sn.toll.loss.search</field>
        <field name="model">sn.toll.loss</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_done" string="Settled"
                        domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_type" string="Settlement Type"
                            context="{'group_by': 'settlement_type'}"/>
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_toll_loss" model="ir.actions.act_window">
        <field name="name">Loss Settlements</field>
        <field name="res_model">sn.toll.loss</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_toll_loss_search"/>
    </record>
</odoo>
