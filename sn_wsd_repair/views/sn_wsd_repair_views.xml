<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_repair_type_list" model="ir.ui.view">
        <field name="name">sn.wsd.repair.type.list</field>
        <field name="model">sn.wsd.repair.type</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_repair_type_form" model="ir.ui.view">
        <field name="name">sn.wsd.repair.type.form</field>
        <field name="model">sn.wsd.repair.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_repair_type" model="ir.actions.act_window">
        <field name="name">Repair Types</field>
        <field name="res_model">sn.wsd.repair.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sn_wsd_repair_order_search" model="ir.ui.view">
        <field name="name">sn.wsd.repair.order.search</field>
        <field name="model">sn.wsd.repair.order</field>
        <field name="arch" type="xml">
            <search string="Repair Orders">
                <field name="name"/>
                <field name="serial_no"/>
                <field name="serial_id"/>
                <field name="production_id"/>
                <field name="mes_order_id"/>
                <field name="route_operation_id"/>
                <field name="repair_user_id"/>
                <field name="reported_time"/>
                <field name="defect_code_id"/>
                <filter string="SN Repair" name="filter_sn" domain="[('repair_mode', '=', 'sn')]"/>
                <filter string="Quantity Repair" name="filter_qty" domain="[('repair_mode', '=', 'qty')]"/>
                <filter string="Open" name="filter_open" domain="[('state', 'in', ['draft', 'reported', 'repairing'])]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Scrapped" name="filter_scrapped" domain="[('state', '=', 'scrapped')]"/>
                <group>
                    <filter string="Manufacturing Order" name="group_by_production" context="{'group_by': 'production_id'}"/>
                    <filter string="MES Order" name="group_by_mes_order" context="{'group_by': 'mes_order_id'}"/>
                    <filter string="Route Operation" name="group_by_route_operation" context="{'group_by': 'route_operation_id'}"/>
                    <filter string="Defect Code" name="group_by_defect" context="{'group_by': 'defect_code_id'}"/>
                    <filter string="Repair User" name="group_by_user" context="{'group_by': 'repair_user_id'}"/>
                    <filter string="Repair Mode" name="group_by_mode" context="{'group_by': 'repair_mode'}"/>
                    <filter string="Reported Time" name="group_by_reported_time" context="{'group_by': 'reported_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_repair_order_list" model="ir.ui.view">
        <field name="name">sn.wsd.repair.order.list</field>
        <field name="model">sn.wsd.repair.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="repair_type_id"/>
                <field name="repair_mode"/>
                <field name="serial_id"/>
                <field name="defect_code_id"/>
                <field name="production_id"/>
                <field name="mes_order_id"/>
                <field name="route_operation_id"/>
                <field name="repair_qty"/>
                <field name="repair_entry_step_id"/>
                <field name="repair_user_id"/>
                <field name="reported_time"/>
                <field name="state"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_repair_order_form" model="ir.ui.view">
        <field name="name">sn.wsd.repair.order.form</field>
        <field name="model">sn.wsd.repair.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_report_repair" type="object" string="Report Repair" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start_repair" type="object" string="Start Repair" class="btn-secondary" invisible="state != 'reported'"/>
                    <button name="action_repair_ok" type="object" string="Repair OK" class="btn-primary" invisible="state != 'repairing'"/>
                    <button name="action_repair_scrap" type="object" string="Repair Invalid Scrap" class="btn-danger" invisible="state not in ['reported', 'repairing']"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ['draft', 'reported', 'repairing']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reported,repairing,done,scrapped"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="repair_type_id" readonly="state != 'draft'"/>
                            <field name="repair_mode" readonly="1"/>
                            <field name="serial_no" default_focus="1" readonly="state != 'draft' or repair_mode == 'qty'" invisible="repair_mode == 'qty'"/>
                            <field name="serial_id" readonly="state != 'draft' or repair_mode == 'qty'" invisible="repair_mode == 'qty'"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="production_id" readonly="state != 'draft'"/>
                            <field name="mes_order_id" readonly="1"/>
                            <field name="route_operation_id" readonly="state != 'draft'"/>
                            <field name="current_process_step_id" readonly="state != 'draft'"/>
                            <field name="defect_code_id" readonly="state != 'draft'"/>
                            <field name="quality_issue_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Repair Details">
                        <group>
                            <field name="repair_method" readonly="state in ['done', 'scrapped', 'cancel']"/>
                            <field name="replacement_sn" readonly="state in ['done', 'scrapped', 'cancel'] or repair_mode == 'qty'" invisible="repair_mode == 'qty'"/>
                            <field name="board_sn" readonly="state in ['done', 'scrapped', 'cancel'] or repair_mode == 'qty'" invisible="repair_mode == 'qty'"/>
                        </group>
                        <group>
                            <field name="defect_qty" readonly="state != 'draft'"/>
                            <field name="repair_qty" readonly="state != 'draft'"/>
                            <field name="reported_time" readonly="state != 'draft'"/>
                            <field name="reported_user_id" readonly="state != 'draft'"/>
                            <field name="repair_user_id" readonly="state in ['done', 'scrapped', 'cancel']"/>
                            <field name="repair_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="Repair Entry">
                        <group>
                            <field name="repair_process_route_id" invisible="1"/>
                            <field name="repair_entry_step_id" readonly="state not in ['draft', 'reported']"/>
                        </group>
                        <group>
                            <field name="result" readonly="1"/>
                            <field name="scrap_reason_id" readonly="state in ['done', 'scrapped', 'cancel']"/>
                            <field name="scrap_record_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" nolabel="1" readonly="state in ['done', 'scrapped', 'cancel']"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_repair_order_graph" model="ir.ui.view">
        <field name="name">sn.wsd.repair.order.graph</field>
        <field name="model">sn.wsd.repair.order</field>
        <field name="arch" type="xml">
            <graph string="Repair Analysis" type="bar">
                <field name="defect_code_id"/>
                <field name="repair_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sn_wsd_repair_order_pivot" model="ir.ui.view">
        <field name="name">sn.wsd.repair.order.pivot</field>
        <field name="model">sn.wsd.repair.order</field>
        <field name="arch" type="xml">
            <pivot string="Repair Statistics">
                <field name="production_id" type="row"/>
                <field name="defect_code_id" type="col"/>
                <field name="repair_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sn_wsd_repair_order" model="ir.actions.act_window">
        <field name="name">Repair Orders</field>
        <field name="res_model">sn.wsd.repair.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>

</odoo>
