<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_internal_serial_form_sn_wsd_repair" model="ir.ui.view">
        <field name="name">sn.wsd.internal.serial.form.sn.wsd.repair</field>
        <field name="model">sn.wsd.internal.serial</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_internal_serial_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div name="button_box" class="oe_button_box">
                    <button class="oe_stat_button" type="object" name="action_open_repair_orders" icon="fa-wrench">
                        <div class="o_stat_info">
                            <span class="o_stat_value"><field name="repair_order_count"/></span>
                            <span class="o_stat_text">Repairs</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Repairs">
                    <group>
                        <button name="action_create_repair_order" type="object" string="Create Repair Order" class="btn-primary"/>
                    </group>
                    <field name="repair_order_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="defect_code_id"/>
                            <field name="repair_method"/>
                            <field name="replacement_sn"/>
                            <field name="defect_location" optional="hide"/>
                            <field name="failure_cause_id" optional="hide"/>
                            <field name="board_sn"/>
                            <field name="repair_entry_route_operation_id"/>
                            <field name="repair_user_id"/>
                            <field name="repair_time"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
