<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_repair_pending_list" model="ir.ui.view">
        <field name="name">sn.wsd.repair.pending.list</field>
        <field name="model">sn.wsd.repair.pending</field>
        <field name="arch" type="xml">
            <list>
                <field name="serial_name" string="SN"/>
                <field name="operation_name"/>
                <field name="mes_order_id"/>
                <field name="pass_count"/>
                <field name="pass_cap"/>
                <field name="last_result"/>
                <field name="last_pass_time"/>
                <button name="action_create_repair_order" type="object"
                        string="Create Repair Order" class="btn-primary"
                        icon="fa-wrench"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_repair_pending_search" model="ir.ui.view">
        <field name="name">sn.wsd.repair.pending.search</field>
        <field name="model">sn.wsd.repair.pending</field>
        <field name="arch" type="xml">
            <search string="Pending Repair">
                <field name="serial_name"/>
                <field name="mes_order_id"/>
                <field name="route_operation_id"/>
                <field name="operation_name"/>
                <field name="last_pass_time"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('last_pass_time', '&gt;=', 'today'), ('last_pass_time', '&lt;', 'today +1d')]"/>
                <filter string="This Week" name="filter_week"
                        domain="[('last_pass_time', '&gt;=', '=week_start'), ('last_pass_time', '&lt;', '=week_start +1w')]"/>
                <group>
                    <filter string="MES Order" name="group_mes_order" context="{'group_by': 'mes_order_id'}"/>
                    <filter string="Failed Operation" name="group_operation" context="{'group_by': 'route_operation_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_repair_pending" model="ir.actions.act_window">
        <field name="name">Pending Repair</field>
        <field name="res_model">sn.wsd.repair.pending</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No SN is waiting for repair</p>
            <p>SNs appear here once their station passes (OK and NG alike) exhaust the operation pass cap and the latest pass was NG. Create a repair order, fix the board, then feed it back from the re-entry operation.</p>
        </field>
    </record>
</odoo>
