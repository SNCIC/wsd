<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_form_sn_wsd_repair" model="ir.ui.view">
        <field name="name">mrp.workorder.form.sn.wsd.repair</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Repairs">
                    <group>
                        <button name="action_open_repair_orders" type="object" string="Repair Orders" class="btn-secondary"/>
                    </group>
                    <group>
                        <group>
                            <field name="x_repair_order_count" readonly="1"/>
                            <field name="x_repair_qty_total" readonly="1"/>
                        </group>
                    </group>
                    <field name="x_repair_order_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="repair_type_id"/>
                            <field name="repair_mode"/>
                            <field name="serial_id"/>
                            <field name="defect_code_id"/>
                            <field name="repair_qty"/>
                            <field name="repair_entry_step_id"/>
                            <field name="state"/>
                            <field name="result"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
