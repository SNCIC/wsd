<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Document numbers of the pushed documents. One shared sequence
         per document type; a company-specific sequence with the same
         code takes precedence for that company. -->
    <data noupdate="1">
        <record id="seq_eip_sale_order" model="ir.sequence">
            <field name="name">EIP Sale Order</field>
            <field name="code">sn.wsd.eip.sale.order</field>
            <field name="prefix">SO</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_eip_schedule" model="ir.sequence">
            <field name="name">EIP Production Schedule</field>
            <field name="code">sn.wsd.eip.schedule</field>
            <field name="prefix">SC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_eip_supply_note" model="ir.sequence">
            <field name="name">EIP Supply Note</field>
            <field name="code">sn.wsd.eip.supply.note</field>
            <field name="prefix">SN</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
