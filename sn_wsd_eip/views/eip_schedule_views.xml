<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eip_schedule_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.schedule.list</field>
        <field name="model">sn.wsd.eip.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="schedule_code"/>
                <field name="po_item_id"/>
                <field name="push_state" widget="badge"
                       decoration-success="push_state == 'pushed'"
                       decoration-danger="push_state == 'failed'"
                       decoration-info="push_state == 'pushing'"
                       decoration-warning="push_state in ('to_push', 'draft')"/>
                <field name="due_date" optional="show"/>
                <field name="plan_start_date" optional="hide"/>
                <field name="plan_finish_date" optional="hide"/>
                <field name="progress" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_eip_schedule_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.schedule.form</field>
        <field name="model">sn.wsd.eip.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_eip_push" type="object"
                            string="Push" class="btn-primary"/>
                    <button name="action_eip_retry" type="object"
                            string="Retry" invisible="push_state != 'failed'"/>
                    <button name="action_eip_preview" type="object"
                            string="Preview Payload"/>
                    <field name="push_state" widget="statusbar"
                           statusbar_visible="draft,to_push,pushed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_eip_logs" icon="fa-list"
                                invisible="eip_log_count == 0">
                            <field name="eip_log_count" widget="statinfo" string="Push Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="schedule_code" readonly="eip_synced"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="po_item_id" readonly="eip_synced"/>
                            <field name="category_id"/>
                            <field name="subclass_id"/>
                            <field name="due_date"/>
                            <field name="prov_co_code"/>
                            <field name="prov_co_name"/>
                        </group>
                        <group>
                            <field name="plan_period"/>
                            <field name="actual_period"/>
                            <field name="progress"/>
                            <field name="plan_start_date"/>
                            <field name="plan_finish_date"/>
                            <field name="actual_start_date"/>
                            <field name="actual_finish_date"/>
                        </group>
                    </group>
                    <group string="Push">
                        <group>
                            <field name="eip_missing"/>
                            <field name="eip_last_error" invisible="not eip_last_error"/>
                            <field name="eip_last_push_at"/>
                        </group>
                        <group>
                            <field name="remark"/>
                            <field name="owner_code"/>
                            <field name="open_code"/>
                            <field name="eip_synced" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scheduled Work Orders" name="wo">
                            <field name="wo_ids">
                                <list editable="bottom">
                                    <field name="batch_code"/>
                                    <field name="schedule_wo"/>
                                    <field name="mat_code"/>
                                    <field name="mat_desc"/>
                                    <field name="schedule_amount"/>
                                    <field name="schedule_unit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eip_schedule_wo_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.schedule.wo.form</field>
        <field name="model">sn.wsd.eip.schedule.wo</field>
        <field name="arch" type="xml">
            <form string="Scheduled Work Order">
                <group>
                    <group>
                        <field name="batch_code"/>
                        <field name="schedule_wo"/>
                        <field name="mat_code"/>
                    </group>
                    <group>
                        <field name="mat_desc"/>
                        <field name="schedule_amount"/>
                        <field name="schedule_unit"/>
                        <field name="remark"/>
                    </group>
                </group>
                <field name="process_ids">
                    <list editable="bottom">
                        <field name="process_code_id"/>
                        <field name="process_code"/>
                        <field name="process_name"/>
                        <field name="plan_start_date"/>
                        <field name="plan_finish_date"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="view_eip_schedule_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.schedule.search</field>
        <field name="model">sn.wsd.eip.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="schedule_code"/>
                <field name="po_item_id"/>
                <filter string="With Missing Fields" name="filter_missing"
                        domain="[('eip_missing', '!=', False)]"/>
                <group>
                    <filter name="group_by_push_state" string="Push Status"
                            context="{'group_by': 'push_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eip_schedule" model="ir.actions.act_window">
        <field name="name">Production Schedules</field>
        <field name="res_model">sn.wsd.eip.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No production schedule yet
            </p>
            <p>
                The short-term plan of one grid purchase order line,
                with its scheduled work orders and processes below.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_schedule"
              name="Production Schedules"
              parent="menu_eip_order_data"
              action="action_eip_schedule"
              sequence="40"/>

    <record id="action_eip_schedule_queue" model="ir.actions.server">
        <field name="name">Queue Push</field>
        <field name="model_id" ref="model_sn_wsd_eip_schedule"/>
        <field name="binding_model_id" ref="model_sn_wsd_eip_schedule"/>
        <field name="state">code</field>
        <field name="code">records.action_eip_queue_push()</field>
    </record>

</odoo>
