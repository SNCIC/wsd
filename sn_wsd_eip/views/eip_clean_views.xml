<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cleansing configuration: limit rules (the third gate) and the
         batch-correction wizard. -->

    <record id="view_eip_clean_rule_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.clean.rule.list</field>
        <field name="model">sn.wsd.eip.clean.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="info_type_code"/>
                <field name="field_name"/>
                <field name="average_error_type"/>
                <field name="lower_limit"/>
                <field name="upper_limit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eip_clean_rule_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.clean.rule.search</field>
        <field name="model">sn.wsd.eip.clean.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="info_type_code"/>
                <field name="field_name"/>
                <group>
                    <filter name="group_by_code" string="Interface"
                            context="{'group_by': 'info_type_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eip_clean_rule" model="ir.actions.act_window">
        <field name="name">Collection Limit Rules</field>
        <field name="res_model">sn.wsd.eip.clean.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                One limit per interface value field
            </p>
            <p>
                The factory's own process standard: out-of-limit readings
                are rejected, never repaired -- the row stays in the
                ledger with the reason and the process side acts.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_clean_rule"
              name="Collection Limit Rules"
              parent="menu_eip_config"
              action="action_eip_clean_rule"
              sequence="40"/>

    <!-- batch correction wizard -->
    <record id="view_eip_clean_fix_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.clean.fix.wizard.form</field>
        <field name="model">sn.wsd.eip.clean.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Correction">
                <group>
                    <field name="record_ids" invisible="1"/>
                    <field name="field_name"/>
                    <field name="value"/>
                    <field name="basis" placeholder="Where the value comes from (issued list, paper record...)"/>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply and Re-clean" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eip_clean_fix_wizard" model="ir.actions.act_window">
        <field name="name">Batch Correction</field>
        <field name="res_model">sn.wsd.eip.clean.fix.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- re-clean by work order: the single cleansing trigger -->
    <record id="view_eip_clean_order_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.clean.order.wizard.form</field>
        <field name="model">sn.wsd.eip.clean.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Re-clean by Work Order">
                <group>
                    <field name="work_order_no" placeholder="MES work order number"/>
                </group>
                <footer>
                    <button name="action_re_clean" type="object"
                            string="Re-clean" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eip_clean_order_wizard" model="ir.actions.act_window">
        <field name="name">Re-clean by Work Order</field>
        <field name="res_model">sn.wsd.eip.clean.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_eip_reserve_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.reserve.wizard.form</field>
        <field name="model">sn.wsd.eip.reserve.wizard</field>
        <field name="arch" type="xml">
            <form string="Re-serve">
                <group>
                    <group>
                        <field name="work_order_no"/>
                        <field name="info_type_code"/>
                    </group>
                </group>
                <footer>
                    <button name="action_re_serve" type="object"
                            string="Re-serve" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eip_reserve_wizard" model="ir.actions.act_window">
        <field name="name">Re-serve</field>
        <field name="res_model">sn.wsd.eip.reserve.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- collect-outbox list action menu: prefill from the selection -->
    <record id="action_outbox_re_serve" model="ir.actions.server">
        <field name="name">Re-serve</field>
        <field name="model_id" ref="model_sn_wsd_eip_collect_outbox"/>
        <field name="binding_model_id" ref="model_sn_wsd_eip_collect_outbox"/>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
        <field name="state">code</field>
        <field name="code">
action = env["ir.actions.act_window"]._for_xml_id(
    "sn_wsd_eip.action_eip_reserve_wizard")
</field>
    </record>
</odoo>
