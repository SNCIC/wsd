<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu: EIP becomes a standalone app with the order-push
         change; visible to MRP users. -->
    <menuitem id="menu_eip_root"
              name="EIP"
              sequence="70"
              groups="mrp.group_mrp_user"/>

    <!-- Group 0: production-data serving, gateway-facing ledgers
         (outbox / interface registry / fetch log; the raw-data ledger
         joins with the cleansing engine). -->
    <menuitem id="menu_eip_collect"
              name="Data Collection"
              parent="menu_eip_root"
              sequence="5"/>

    <!-- Group 1: pass data collection config; the phase-1 mapping
         menus (operation / value mapping) move under this group. -->
    <menuitem id="menu_eip_pass_config"
              name="Pass Data Collection"
              parent="menu_eip_root"
              sequence="10"/>

    <!-- Group 2: order & business data (documents land in later
         batches of the eip-order-push change). -->
    <menuitem id="menu_eip_order_data"
              name="Order &amp; Business Data"
              parent="menu_eip_root"
              sequence="20"/>

    <!-- Group 3: inventory data, a subsection of the order-data
         menu (user request: one section instead of two). -->
    <menuitem id="menu_eip_inventory"
              name="Inventory Data"
              parent="menu_eip_order_data"
              sequence="80"/>

    <!-- Group 4: push center (later batches). -->
    <menuitem id="menu_eip_push_center"
              name="Push Center"
              parent="menu_eip_root"
              sequence="40"/>

    <!-- Group 5: configuration, manager only. -->
    <menuitem id="menu_eip_config"
              name="Configuration"
              parent="menu_eip_root"
              sequence="50"
              groups="mrp.group_mrp_manager"/>
</odoo>
