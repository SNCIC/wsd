<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categories -->
    <record id="view_eip_category_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.category.list</field>
        <field name="model">sn.wsd.eip.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_eip_category_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.category.form</field>
        <field name="model">sn.wsd.eip.category</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_eip_category_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.category.search</field>
        <field name="model">sn.wsd.eip.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_eip_category" model="ir.actions.act_window">
        <field name="name">EIP Categories</field>
        <field name="res_model">sn.wsd.eip.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No EIP category yet
            </p>
            <p>
                Platform-issued category dictionary (10 preset rows);
                business forms pick their category code from here.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_category"
              name="Categories"
              parent="menu_eip_config"
              action="action_eip_category"
              sequence="30"/>

    <!-- Subclasses -->
    <record id="view_eip_subclass_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.subclass.list</field>
        <field name="model">sn.wsd.eip.subclass</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="view_eip_subclass_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.subclass.form</field>
        <field name="model">sn.wsd.eip.subclass</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="code"/>
                        <field name="category_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_eip_subclass_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.subclass.search</field>
        <field name="model">sn.wsd.eip.subclass</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <group>
                    <filter name="group_by_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eip_subclass" model="ir.actions.act_window">
        <field name="name">EIP Subclasses</field>
        <field name="res_model">sn.wsd.eip.subclass</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No EIP subclass yet
            </p>
            <p>
                Platform-issued subclass dictionary (36 preset rows)
                under its category; business forms pick their subclass
                code from here.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_subclass"
              name="Subclasses"
              parent="menu_eip_config"
              action="action_eip_subclass"
              sequence="40"/>

    <!-- Process codes: the spec ships no dictionary, delivered empty -->
    <record id="view_eip_process_code_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.process.code.list</field>
        <field name="model">sn.wsd.eip.process.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_eip_process_code_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.process.code.form</field>
        <field name="model">sn.wsd.eip.process.code</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_eip_process_code_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.process.code.search</field>
        <field name="model">sn.wsd.eip.process.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_eip_process_code" model="ir.actions.act_window">
        <field name="name">EIP Process Codes</field>
        <field name="res_model">sn.wsd.eip.process.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No EIP process code yet
            </p>
            <p>
                The spec ships no process dictionary: maintain it here;
                work reports and schedule process rows pick their
                process code from this list or free-type it.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_process_code"
              name="Process Codes"
              parent="menu_eip_config"
              action="action_eip_process_code"
              sequence="50"/>
</odoo>
