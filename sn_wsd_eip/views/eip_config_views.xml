<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eip_config_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.config.form</field>
        <field name="model">sn.wsd.eip.config</field>
        <field name="arch" type="xml">
            <form>
                <field name="active" invisible="1"/>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active == False"/>
                    <group>
                        <group string="Identity">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="name" invisible="1"/>
                            <field name="supplier_code"/>
                            <field name="supplier_name"/>
                            <field name="purchaser_hq_code"/>
                        </group>
                        <group string="Connection">
                            <field name="base_url" placeholder="https://host:port"/>
                            <field name="timeout_sec"/>
                        </group>
                        <group string="Push">
                            <field name="push_batch_size"/>
                            <field name="retry_times"/>
                            <field name="retry_interval_min"/>
                        </group>
                        <group string="Pull">
                            <field name="pull_page_size"/>
                            <field name="pull_daily_limit"/>
                            <field name="pull_overlap_hours"/>
                            <field name="pull_start_date"/>
                        </group>
                        <group string="Defaults">
                            <field name="default_category_id"/>
                            <field name="default_subclass_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eip_config_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.config.list</field>
        <field name="model">sn.wsd.eip.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="supplier_code"/>
                <field name="supplier_name"/>
                <field name="base_url"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eip_config_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.config.search</field>
        <field name="model">sn.wsd.eip.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="supplier_code"/>
                <field name="supplier_name"/>
                <field name="company_id"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eip_config" model="ir.actions.act_window">
        <field name="name">EIP Integration Config</field>
        <field name="res_model">sn.wsd.eip.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the EIP integration config for your company
            </p>
            <p>
                One row per company: supplier identity, connection
                parameters and the push / pull tuning used by every
                outbound call.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_config_entry"
              name="Integration Config"
              parent="menu_eip_config"
              action="action_eip_config"
              sequence="10"/>
</odoo>
