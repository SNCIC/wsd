<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pull state: one row per integration config -->
    <record id="view_eip_pull_state_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.pull.state.list</field>
        <field name="model">sn.wsd.eip.pull.state</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <header>
                    <button name="action_pull_wizard" type="object"
                            string="Pull Purchase Orders" class="btn-primary"/>
                </header>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="config_id"/>
                <field name="calls_count" string="Today's Calls"/>
                <field name="watermark"/>
                <field name="pending_end"/>
                <field name="pending_page"/>
                <field name="last_run_at"/>
                <field name="last_run_reason"/>
                <field name="last_run_pages" optional="hide"/>
                <field name="last_run_rows" optional="hide"/>
                <field name="last_run_detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eip_pull_state_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.pull.state.form</field>
        <field name="model">sn.wsd.eip.pull.state</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_pull_wizard" type="object"
                            string="Pull Purchase Orders" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_pull_logs" icon="fa-list">
                            <field name="pull_log_count" widget="statinfo" string="Pull Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h2><field name="config_id"/></h2>
                    </div>
                    <group>
                        <group string="Daily Quota">
                            <field name="calls_count"/>
                            <field name="calls_date"/>
                        </group>
                        <group string="Incremental Window">
                            <field name="watermark"/>
                            <field name="pending_start"/>
                            <field name="pending_end"/>
                            <field name="pending_page"/>
                        </group>
                    </group>
                    <group string="Last Run">
                        <field name="last_run_at"/>
                        <field name="last_run_reason"/>
                        <field name="last_run_pages"/>
                        <field name="last_run_rows"/>
                        <field name="last_run_detail" colspan="2"/>
                    </group>
                    <field name="company_id" groups="base.group_multi_company"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eip_pull_state_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.pull.state.search</field>
        <field name="model">sn.wsd.eip.pull.state</field>
        <field name="arch" type="xml">
            <search>
                <field name="config_id"/>
                <field name="company_id"/>
                <filter string="Unfinished Window" name="filter_pending"
                        domain="[('pending_end', '!=', False)]"/>
                <filter string="Last Run Failed" name="filter_last_failed"
                        domain="[('last_run_reason', 'in', ['quota', 'error'])]"/>
            </search>
        </field>
    </record>

    <record id="action_eip_pull_state" model="ir.actions.act_window">
        <field name="name">Pull State</field>
        <field name="res_model">sn.wsd.eip.pull.state</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_eip_pull_state"
              name="Pull State"
              parent="menu_eip_push_center"
              action="action_eip_pull_state"
              sequence="20"/>

    <!-- Manual pull wizard -->
    <record id="view_eip_pull_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.pull.wizard.form</field>
        <field name="model">sn.wsd.eip.pull.wizard</field>
        <field name="arch" type="xml">
            <form string="Pull Purchase Orders">
                <group>
                    <group>
                        <field name="config_id" options="{'no_create': True}"/>
                        <field name="mode" widget="radio"/>
                    </group>
                </group>
                <group string="Targeted Conditions" invisible="mode != 'targeted'">
                    <group>
                        <field name="po_no"/>
                        <field name="con_code"/>
                        <field name="seller_con_code"/>
                    </group>
                    <group>
                        <field name="seller_sign_start_time"/>
                        <field name="seller_sign_end_time"/>
                        <field name="modify_start_time"/>
                        <field name="modify_end_time"/>
                    </group>
                </group>
                <field name="result_summary" invisible="not result_summary"
                       nolabel="1" class="mt-3"/>
                <footer>
                    <button name="action_pull" type="object" string="Pull"
                            class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eip_pull_wizard" model="ir.actions.act_window">
        <field name="name">Pull Purchase Orders</field>
        <field name="res_model">sn.wsd.eip.pull.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
