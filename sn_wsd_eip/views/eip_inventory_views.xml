<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Raw material inventory -->
    <record id="view_eip_raw_inventory_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.raw.inventory.list</field>
        <field name="model">sn.wsd.eip.raw.inventory</field>
        <field name="arch" type="xml">
            <list>
                <field name="mat_code"/>
                <field name="mat_name"/>
                <field name="mat_num"/>
                <field name="mat_unit" optional="show"/>
                <field name="push_state" widget="badge"
                       decoration-success="push_state == 'pushed'"
                       decoration-danger="push_state == 'failed'"
                       decoration-info="push_state == 'pushing'"
                       decoration-warning="push_state in ('to_push', 'draft')"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_eip_raw_inventory_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.raw.inventory.form</field>
        <field name="model">sn.wsd.eip.raw.inventory</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_eip_push" type="object"
                            string="Push" class="btn-primary"/>
                    <button name="action_eip_retry" type="object"
                            string="Retry" invisible="push_state != 'failed'"/>
                    <button name="action_eip_preview" type="object"
                            string="Preview Payload"/>
                    <field name="push_state" widget="statusbar"
                           statusbar_visible="draft,to_push,pushed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_eip_logs" icon="fa-list"
                                invisible="eip_log_count == 0">
                            <field name="eip_log_count" widget="statinfo" string="Push Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="mat_code" readonly="eip_synced"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mat_name"/>
                            <field name="mat_num"/>
                            <field name="mat_unit"/>
                        </group>
                        <group>
                            <field name="mat_description"/>
                            <field name="mat_prod_addr"/>
                            <field name="remark"/>
                        </group>
                    </group>
                    <group string="Push">
                        <group>
                            <field name="eip_missing"/>
                            <field name="eip_last_error" invisible="not eip_last_error"/>
                            <field name="eip_last_push_at"/>
                        </group>
                        <group>
                            <field name="owner_code"/>
                            <field name="open_code"/>
                            <field name="eip_synced" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Incoming Batches" name="batches">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="batch_code"/>
                                    <field name="product_amount"/>
                                    <field name="remark" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eip_raw_inventory_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.raw.inventory.search</field>
        <field name="model">sn.wsd.eip.raw.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="mat_code"/>
                <field name="mat_name"/>
                <filter string="With Missing Fields" name="filter_missing"
                        domain="[('eip_missing', '!=', False)]"/>
                <group>
                    <filter name="group_by_push_state" string="Push Status"
                            context="{'group_by': 'push_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eip_raw_inventory" model="ir.actions.act_window">
        <field name="name">Key Raw Materials</field>
        <field name="res_model">sn.wsd.eip.raw.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No raw material inventory yet
            </p>
            <p>
                One row per key raw material, with its incoming batches
                below.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_raw_inventory"
              name="Key Raw Materials"
              parent="menu_eip_inventory"
              action="action_eip_raw_inventory"
              sequence="10"/>

    <record id="action_eip_raw_inventory_queue" model="ir.actions.server">
        <field name="name">Queue Push</field>
        <field name="model_id" ref="model_sn_wsd_eip_raw_inventory"/>
        <field name="binding_model_id" ref="model_sn_wsd_eip_raw_inventory"/>
        <field name="state">code</field>
        <field name="code">records.action_eip_queue_push()</field>
    </record>

