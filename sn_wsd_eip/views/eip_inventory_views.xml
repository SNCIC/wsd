                            <field name="product_amount"/>
                            <field name="product_unit"/>
                            <field name="remark"/>
                        </group>
                        <group>
                            <field name="eip_missing"/>
                            <field name="eip_last_error" invisible="not eip_last_error"/>
                            <field name="eip_last_push_at"/>
                            <field name="owner_code"/>
                            <field name="open_code"/>
                            <field name="eip_synced" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batches" name="batches">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_lot"/>
                                    <field name="product_amount"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eip_spare_inventory_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.spare.inventory.search</field>
        <field name="model">sn.wsd.eip.spare.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="spare_product_code"/>
                <field name="product_dec"/>
                <filter string="With Missing Fields" name="filter_missing"
                        domain="[('eip_missing', '!=', False)]"/>
                <group>
                    <filter name="group_by_push_state" string="Push Status"
                            context="{'group_by': 'push_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eip_spare_inventory" model="ir.actions.act_window">
        <field name="name">Spare Parts</field>
        <field name="res_model">sn.wsd.eip.spare.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No spare parts inventory yet
            </p>
            <p>
                Spare parts of the finished products, refreshed on the
                platform every 24 hours.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_spare_inventory"
              name="Spare Parts"
              parent="menu_eip_inventory"
              action="action_eip_spare_inventory"
              sequence="20"/>

    <record id="action_eip_spare_inventory_queue" model="ir.actions.server">
        <field name="name">Queue Push</field>
        <field name="model_id" ref="model_sn_wsd_eip_spare_inventory"/>
        <field name="binding_model_id" ref="model_sn_wsd_eip_spare_inventory"/>
        <field name="state">code</field>
        <field name="code">records.action_eip_queue_push()</field>
    </record>

    <!-- Finished goods inventory -->
    <record id="view_eip_finished_inventory_list" model="ir.ui.view">
        <field name="name">sn.wsd.eip.finished.inventory.list</field>
        <field name="model">sn.wsd.eip.finished.inventory</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_code"/>
                <field name="product_name" optional="show"/>
                <field name="product_amount"/>
                <field name="product_unit" optional="hide"/>
                <field name="push_state" widget="badge"
                       decoration-success="push_state == 'pushed'"
                       decoration-danger="push_state == 'failed'"
                       decoration-info="push_state == 'pushing'"
                       decoration-warning="push_state in ('to_push', 'draft')"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_eip_finished_inventory_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.finished.inventory.form</field>
        <field name="model">sn.wsd.eip.finished.inventory</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_eip_push" type="object"
                            string="Push" class="btn-primary"/>
                    <button name="action_eip_retry" type="object"
                            string="Retry" invisible="push_state != 'failed'"/>
                    <button name="action_eip_preview" type="object"
                            string="Preview Payload"/>
                    <field name="push_state" widget="statusbar"
                           statusbar_visible="draft,to_push,pushed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_eip_logs" icon="fa-list"
                                invisible="eip_log_count == 0">
                            <field name="eip_log_count" widget="statinfo" string="Push Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="product_code" readonly="eip_synced"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subclass_id"/>
                            <field name="product_name"/>
                            <field name="product_amount"/>
                            <field name="product_unit"/>
                            <field name="remark"/>
                        </group>
                        <group>
                            <field name="eip_missing"/>
                            <field name="eip_last_error" invisible="not eip_last_error"/>
                            <field name="eip_last_push_at"/>
                            <field name="owner_code"/>
                            <field name="open_code"/>
                            <field name="eip_synced" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batches" name="batches">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="po_no" optional="hide"/>
                                    <field name="batch_code"/>
                                    <field name="product_amount"/>
                                    <field name="purchase_name" optional="hide"/>
                                    <field name="data_source"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eip_finished_inventory_search" model="ir.ui.view">
        <field name="name">sn.wsd.eip.finished.inventory.search</field>
        <field name="model">sn.wsd.eip.finished.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_code"/>
                <field name="product_name"/>
                <filter string="With Missing Fields" name="filter_missing"
                        domain="[('eip_missing', '!=', False)]"/>
                <group>
                    <filter name="group_by_push_state" string="Push Status"
                            context="{'group_by': 'push_state'}"/>
                    <filter name="group_by_subclass" string="Subclass"
                            context="{'group_by': 'subclass_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eip_finished_inventory" model="ir.actions.act_window">
        <field name="name">Finished Goods</field>
        <field name="res_model">sn.wsd.eip.finished.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No finished goods inventory yet
            </p>
            <p>
                One row per product (the platform treats the subclass as
                the product code), with its batches below.
            </p>
        </field>
    </record>

    <menuitem id="menu_eip_finished_inventory"
              name="Finished Goods"
              parent="menu_eip_inventory"
              action="action_eip_finished_inventory"
              sequence="30"/>

    <record id="action_eip_finished_inventory_queue" model="ir.actions.server">
        <field name="name">Queue Push</field>
        <field name="model_id" ref="model_sn_wsd_eip_finished_inventory"/>
        <field name="binding_model_id" ref="model_sn_wsd_eip_finished_inventory"/>
        <field name="state">code</field>
