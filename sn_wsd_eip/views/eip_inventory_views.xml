    <record id="view_eip_spare_inventory_form" model="ir.ui.view">
        <field name="name">sn.wsd.eip.spare.inventory.form</field>
        <field name="model">sn.wsd.eip.spare.inventory</field>
        <field name="arch" type="xml">
            <form>
                <header>
