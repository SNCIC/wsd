# Keep source diffs consistent across Windows and Linux.
* text=auto

# Odoo translation files require CRLF working-tree line endings.
*.po text eol=crlf
*.pot text eol=crlf

# Source files use LF in the repository and working tree.
*.py text eol=lf
*.xml text eol=lf
*.js text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
