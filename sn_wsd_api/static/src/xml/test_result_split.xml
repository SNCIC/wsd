<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sn_wsd_api.TestResultSplit">
        <div class="o_sn_wsd_split d-flex flex-column h-100 overflow-hidden">
            <div class="o_sn_wsd_split_top flex-shrink-0 overflow-hidden" style="height: 55%;">
                <View type="'list'"
                      resModel="'sn.wsd.mes.test.result'"
                      viewId="listViewId"
                      searchViewId="searchViewId"
                      context="topContext"
                      selectRecord="onSelectRecord"/>
            </div>
            <div class="o_sn_wsd_split_bottom flex-grow-1 d-flex flex-column overflow-hidden border-top">
                <t t-if="state.selectedId">
                    <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom bg-view">
                        <span class="fw-bold" t-esc="state.summary ? state.summary.sn : '...'"/>
                        <span t-if="state.summary" class="text-muted" t-esc="state.summary.operation"/>
                        <span t-if="state.summary"
                              t-attf_class="badge {{state.summary.result === 'ok' ? 'text-bg-success' : state.summary.result === 'ng' ? 'text-bg-danger' : 'text-bg-warning'}}"
                              t-esc="state.summary.result and state.summary.result.toUpperCase()"/>
                        <span t-if="state.summary" class="text-muted" t-esc="state.summary.testTime"/>
                        <div class="ms-auto">
                            <button type="button" class="btn btn-sm btn-secondary" t-on-click="openForm">
                                <t t-out="labels.openForm"/>
                            </button>
                        </div>
                    </div>
                    <div class="flex-grow-1 overflow-auto">
                        <View type="'list'"
                              resModel="'sn.wsd.mes.test.result.detail'"
                              viewId="detailViewId"
                              domain="detailDomain"
                              display="{controlPanel: false}"/>
                    </div>
                </t>
                <t t-else="">
                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                        <t t-out="labels.hint"/>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
