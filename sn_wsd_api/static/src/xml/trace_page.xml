<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sn_wsd_api.TracePage">
        <div class="o_sn_wsd_trace_page">
            <!-- ============ top-left: query + product structure ============ -->
            <section class="o_trace_panel">
                <div class="d-flex align-items-center gap-2 p-2 border-bottom">
                    <input type="text" class="form-control form-control-sm" autofocus="1"
                           style="max-width:220px"
                           t-att-placeholder="labels.snPlaceholder"
                           t-model="state.snInput"
                           t-on-keydown="onKeydownInput"/>
                    <button type="button" class="btn btn-sm btn-primary"
                            t-on-click="onTrace" t-esc="labels.query"/>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            t-on-click="exportCsv" t-esc="labels.export"/>
                </div>
                <div class="o_trace_panel_hd" t-esc="labels.productStructure"/>
                <div class="o_trace_panel_bd">
                    <t t-if="state.notFound">
                        <div class="d-flex h-100 align-items-center justify-content-center text-danger"
                             t-esc="labels.notFound"/>
                    </t>
                    <t t-elif="state.treeChildren.length">
                        <ul class="o_trace_tree">
                            <li t-attf-class="{{state.treeOpen ? 'o_tree_open' : ''}}">
                                <span class="o_tree_switch" t-on-click="toggleTree"/>
                                <a class="o_tree_selected" t-esc="state.committedSn"/>
                                <ul t-if="state.treeOpen">
                                    <li t-foreach="state.treeChildren" t-as="child" t-key="child.id">
                                        <span class="o_tree_leafdot">•</span>
                                        <span t-att-title="child.type" t-esc="child.sn"/>
                                        <span class="text-muted ms-1" t-esc="'[' + child.type + ']'"/>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </t>
                    <t t-else="">
                        <div class="d-flex h-100 align-items-center justify-content-center text-muted"
                             t-esc="labels.noData"/>
                    </t>
                </div>
            </section>

            <!-- ============ top-right: product information ============ -->
            <section class="o_trace_panel">
                <div class="o_trace_panel_hd" t-esc="labels.productInfo"/>
                <div class="o_trace_panel_bd overflow-auto">
                    <div class="o_trace_form" t-if="state.productInfo">
                        <table>
                            <tbody>
                                <tr>
                                    <td class="o_form_label">SN</td>
                                    <td class="o_form_value" t-esc="state.productInfo.sn"/>
                                    <td class="o_form_label">Production</td>
                                    <td class="o_form_value" t-esc="state.productInfo.productionName"/>
                                    <td class="o_form_label">MES Order</td>
                                    <td class="o_form_value" t-esc="state.productInfo.orderName"/>
                                    <td class="o_form_label">Product</td>
                                    <td class="o_form_value" t-esc="state.productInfo.productCode"/>
                                </tr>
                                <tr>
                                    <td class="o_form_label">Line</td>
                                    <td class="o_form_value" t-esc="state.productInfo.line"/>
                                    <td class="o_form_label">Side</td>
                                    <td class="o_form_value" t-esc="state.productInfo.side"/>
                                    <td class="o_form_label">Route</td>
                                    <td class="o_form_value" t-esc="state.productInfo.route"/>
                                    <td class="o_form_label">Finished</td>
                                    <td class="o_form_value">
                                        <span t-attf_class="badge {{state.productInfo.finished ? 'text-bg-success' : 'text-bg-secondary'}}"
                                              t-esc="state.productInfo.finished ? labels.finished : labels.unfinished"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div t-else="" class="d-flex h-100 align-items-center justify-content-center text-muted"
                         t-esc="labels.noData"/>
                </div>
            </section>

            <!-- ============ bottom-right: tabs ============ -->
            <section class="o_trace_panel">
                <div class="d-flex align-items-center o_trace_tabs">
                    <ul class="nav nav-tabs flex-grow-1">
                        <li class="nav-item" t-foreach="tabDefs" t-as="tab" t-key="tab.key">
                            <a href="#"
                               t-attf-class="nav-link {{state.activeTab === tab.key ? 'active' : ''}}"
                               t-on-click.prevent="() => this.setActiveTab(tab.key)"
                               t-esc="tab.label"/>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 pb-1 px-2" style="font-size:12px"
                         t-if="rowsFor(state.activeTab).length">
                        <button class="btn btn-sm btn-outline-secondary py-0" type="button"
                                t-att-disabled="activePager().page &lt;= 1"
                                t-on-click="() => this.pagerMove(state.activeTab, -1)">‹</button>
                        <span t-esc="activePager().page"/> / <span t-esc="pageCount(state.activeTab)"/>
                        <button class="btn btn-sm btn-outline-secondary py-0" type="button"
                                t-att-disabled="activePager().page &gt;= pageCount(state.activeTab)"
                                t-on-click="() => this.pagerMove(state.activeTab, 1)">›</button>
                        <span class="text-muted">共计 <b t-esc="rowsFor(state.activeTab).length"/> 条</span>
                    </div>
                </div>
                <div class="o_trace_tab_body">
                    <!-- process -->
                    <div t-attf-class="o_trace_tab_pane {{state.activeTab === 'process' ? 'active' : ''}}">
                        <div class="o_trace_table_wrap">
                            <table class="o_trace_grid">
                                <thead>
                                    <tr>
                                        <th style="width:30px">#</th>
                                        <th>Operation</th>
                                        <th>Operation Name</th>
                                        <th>Work Center</th>
                                        <th>Line</th>
                                        <th>Flag</th>
                                        <th>MES Order</th>
                                        <th>Production</th>
                                        <th>Product</th>
                                        <th>Operator</th>
                                        <th>Device SN</th>
                                        <th>Tooling</th>
                                        <th>Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="getPagedRows('process')" t-as="r" t-key="r.seq"
                                        t-attf-class="{{r.isNg ? 'o_trace_row_ng' : ''}}">
                                        <td t-esc="r.seq"/>
                                        <td t-esc="r.opCode"/>
                                        <td t-esc="r.opName"/>
                                        <td t-esc="r.workcenter"/>
                                        <td t-esc="r.line"/>
                                        <td>
                                            <span t-attf-class="badge {{r.flag === 'NG' ? 'text-bg-danger' : r.flag === 'OK' ? 'text-bg-success' : 'text-bg-secondary'}}"
                                                  t-esc="r.flag"/>
                                        </td>
                                        <td t-esc="r.orderName"/>
                                        <td t-esc="r.productionName"/>
                                        <td t-esc="r.productCode"/>
                                        <td t-esc="r.operator"/>
                                        <td t-esc="r.equipment"/>
                                        <td t-esc="r.tooling"/>
                                        <td t-esc="r.time"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- material -->
                    <div t-attf-class="o_trace_tab_pane {{state.activeTab === 'material' ? 'active' : ''}}">
                        <div class="o_trace_table_wrap">
                            <table class="o_trace_grid">
                                <thead>
                                    <tr>
                                        <th style="width:30px">#</th>
                                        <th>Material SN</th>
                                        <th>Item Code</th>
                                        <th>Name</th>
                                        <th>Spec</th>
                                        <th>Lot</th>
                                        <th>Loadpoint</th>
                                        <th>Qty</th>
                                        <th>Station</th>
                                        <th>Operator</th>
                                        <th>Time</th>
                                        <th>MES Order</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="getPagedRows('material')" t-as="r" t-key="r.materialSn + '_' + r_index">
                                        <td t-esc="r_index + 1"/>
                                        <td t-esc="r.materialSn"/>
                                        <td t-esc="r.itemCode"/>
                                        <td t-esc="r.name"/>
                                        <td t-esc="r.spec"/>
                                        <td t-esc="r.lotDate"/>
                                        <td t-esc="r.loadpoint"/>
                                        <td t-esc="r.qty"/>
                                        <td t-esc="r.station"/>
                                        <td t-esc="r.operator"/>
                                        <td t-esc="r.time"/>
                                        <td t-esc="r.orderName"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- quality -->
                    <div t-attf-class="o_trace_tab_pane {{state.activeTab === 'quality' ? 'active' : ''}}">
                        <div class="o_trace_table_wrap">
                            <table class="o_trace_grid">
                                <thead>
                                    <tr>
                                        <th style="width:30px">#</th>
                                        <th>Inspection</th>
                                        <th>Type</th>
                                        <th>Result</th>
                                        <th>State</th>
                                        <th>MES Order</th>
                                        <th>Submit Time</th>
                                        <th>Submitter</th>
                                        <th>Inspector</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="getPagedRows('quality')" t-as="r" t-key="r.id">
                                        <td t-esc="r_index + 1"/>
                                        <td t-esc="r.name"/>
                                        <td t-esc="r.type"/>
                                        <td>
                                            <span t-if="r.result"
                                                  t-attf-class="badge {{r.result === 'pass' || r.result === 'ok' ? 'text-bg-success' : 'text-bg-warning'}}"
                                                  t-esc="r.result"/>
                                        </td>
                                        <td t-esc="r.state"/>
                                        <td t-esc="r.orderName"/>
                                        <td t-esc="r.submitTime"/>
                                        <td t-esc="r.submitter"/>
                                        <td t-esc="r.inspector"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- repair -->
                    <div t-attf-class="o_trace_tab_pane {{state.activeTab === 'repair' ? 'active' : ''}}">
                        <div class="o_trace_table_wrap">
                            <table class="o_trace_grid">
                                <thead>
                                    <tr>
                                        <th style="width:30px">#</th>
                                        <th>Repair Order</th>
                                        <th>State</th>
                                        <th>Operation</th>
                                        <th>Defects</th>
                                        <th>Method</th>
                                        <th>Repairer</th>
                                        <th>Report Time</th>
                                        <th>Done Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="getPagedRows('repair')" t-as="r" t-key="r.id">
                                        <td t-esc="r_index + 1"/>
                                        <td t-esc="r.name"/>
                                        <td t-esc="r.state"/>
                                        <td t-esc="r.operation"/>
                                        <td t-esc="r.defects"/>
                                        <td t-esc="r.method"/>
                                        <td t-esc="r.repairer"/>
                                        <td t-esc="r.reportTime"/>
                                        <td t-esc="r.doneTime"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </t>

</templates>
