<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sn_wsd_api" model="ir.module.category">
        <field name="name">WSD API</field>
        <field name="sequence">90</field>
    </record>

    <record id="res_groups_privilege_sn_wsd_api" model="res.groups.privilege">
        <field name="name">WSD API</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="module_category_sn_wsd_api"/>
    </record>

    <record id="group_sn_wsd_api_tester" model="res.groups">
        <field name="name">API Tester</field>
        <field name="privilege_id" ref="res_groups_privilege_sn_wsd_api"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_sn_wsd_api_manager" model="res.groups">
        <field name="name">API Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_sn_wsd_api"/>
        <field name="implied_ids" eval="[Command.link(ref('group_sn_wsd_api_tester'))]"/>
    </record>

    <record id="rule_sn_wsd_api_test_case_user" model="ir.rule">
        <field name="name">API test case owner access</field>
        <field name="model_id" ref="model_sn_wsd_api_test_case"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('sn_wsd_api.group_sn_wsd_api_tester'))]"/>
    </record>

    <record id="rule_sn_wsd_api_test_case_manager" model="ir.rule">
        <field name="name">API test case manager access</field>
        <field name="model_id" ref="model_sn_wsd_api_test_case"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('sn_wsd_api.group_sn_wsd_api_manager'))]"/>
    </record>

    <record id="rule_sn_wsd_api_test_run_user" model="ir.rule">
        <field name="name">API test run owner access</field>
        <field name="model_id" ref="model_sn_wsd_api_test_run"/>
        <field name="domain_force">[('run_by_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('sn_wsd_api.group_sn_wsd_api_tester'))]"/>
    </record>

    <record id="rule_sn_wsd_api_test_run_manager" model="ir.rule">
        <field name="name">API test run manager access</field>
        <field name="model_id" ref="model_sn_wsd_api_test_run"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('sn_wsd_api.group_sn_wsd_api_manager'))]"/>
    </record>
</odoo>
