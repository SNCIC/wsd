<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Test Result Detail Views -->
    <record id="view_sn_wsd_mes_test_result_detail_list" model="ir.ui.view">
        <field name="name">sn.wsd.mes.test.result.detail.list</field>
        <field name="model">sn.wsd.mes.test.result.detail</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="project_name"/>
                <field name="lower_limit"/>
                <field name="upper_limit"/>
                <field name="actual_value"/>
                <field name="result"/>
                <field name="test_result_id"/>
                <field name="test_time"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_mes_test_result_detail_form" model="ir.ui.view">
        <field name="name">sn.wsd.mes.test.result.detail.form</field>
        <field name="model">sn.wsd.mes.test.result.detail</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="test_result_id" readonly="1"/>
                            <field name="project_name"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Measurement Values">
                        <group>
                            <field name="lower_limit"/>
                            <field name="upper_limit"/>
                            <field name="actual_value"/>
                        </group>
                    </group>
                    <field name="raw_line"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_mes_test_result_detail" model="ir.actions.act_window">
        <field name="name">Test Result Details</field>
        <field name="res_model">sn.wsd.mes.test.result.detail</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Nameplate Binding Views -->
    <record id="view_sn_wsd_mes_nameplate_binding_list" model="ir.ui.view">
        <field name="name">sn.wsd.mes.nameplate.binding.list</field>
        <field name="model">sn.wsd.mes.nameplate.binding</field>
        <field name="arch" type="xml">
            <list>
                <field name="binding_time"/>
                <field name="internal_serial_id"/>
                <field name="nameplate_code"/>
                <field name="production_id"/>
                <field name="workcenter_id"/>
                <field name="operator_code"/>
                <field name="binding_mode"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_mes_nameplate_binding_form" model="ir.ui.view">
        <field name="name">sn.wsd.mes.nameplate.binding.form</field>
        <field name="model">sn.wsd.mes.nameplate.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="internal_serial_id" readonly="1"/>
                            <field name="nameplate_code"/>
                            <field name="binding_mode"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="production_id"/>
                            <field name="workcenter_id"/>
                            <field name="binding_time"/>
                        </group>
                    </group>
                    <group string="Audit">
                        <group>
                            <field name="operator_code"/>
                            <field name="previous_nameplate_id"/>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_mes_nameplate_binding" model="ir.actions.act_window">
        <field name="name">Nameplate Bindings</field>
        <field name="res_model">sn.wsd.mes.nameplate.binding</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Packaging Record Views -->
