        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sn_wsd_mes_packaging_record_form" model="ir.ui.view">
        <field name="name">sn.wsd.mes.packaging.record.form</field>
        <field name="model">sn.wsd.mes.packaging.record</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="internal_serial_id" readonly="1"/>
                            <field name="nameplate_code" readonly="1"/>
                            <field name="box_sn" readonly="1"/>
                            <field name="pallet_sn" readonly="1"/>
                        </group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="mes_order_id" readonly="1"/>
                            <field name="route_operation_id" readonly="1"/>
                            <field name="workcenter_id" readonly="1"/>
                            <field name="packaging_time" readonly="1"/>
                            <field name="active" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="operator_code" readonly="1"/>
                            <field name="operator_id" readonly="1"/>
                            <field name="project_code" readonly="1"/>
                            <field name="crc_value" readonly="1"/>
                        </group>
                    </group>
                    <field name="payload" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

