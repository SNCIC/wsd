<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_api_endpoint_kanban" model="ir.ui.view">
        <field name="name">sn.wsd.api.endpoint.kanban</field>
        <field name="model">sn.wsd.api.endpoint</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <field name="name"/>
                <field name="method"/>
                <field name="path"/>
                <field name="category"/>
                <field name="is_mutating"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="fw-bold fs-5">
                                    <field name="name"/>
                                </div>
                                <span class="badge text-bg-secondary">
                                    <field name="method"/>
                                </span>
                            </div>
                            <div class="text-muted text-break">
                                <field name="path"/>
                            </div>
                            <div invisible="not is_mutating">
                                <span class="badge text-bg-warning">May Change Data</span>
                            </div>
                            <footer class="pt-2">
                                <button name="action_open_default_test_case"
                                        type="object"
                                        string="Open Tester"
                                        class="btn-primary"/>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sn_wsd_api_endpoint_list" model="ir.ui.view">
        <field name="name">sn.wsd.api.endpoint.list</field>
        <field name="model">sn.wsd.api.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="method"/>
                <field name="path"/>
                <field name="is_mutating"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_api_endpoint_form" model="ir.ui.view">
        <field name="name">sn.wsd.api.endpoint.form</field>
        <field name="model">sn.wsd.api.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_default_test_case" type="object" string="Open Tester" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_test_cases" type="object" class="oe_stat_button" icon="fa-flask">
                            <field name="test_case_count" widget="statinfo" string="Test Cases"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="path"/>
                            <field name="is_mutating"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Default Request">
                            <field name="default_body" nolabel="1" placeholder="{}" rows="12"/>
                        </page>
                        <page string="Other">
                            <group>
                                <field name="default_headers" placeholder='{"Content-Type": "application/json"}' rows="8"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_api_endpoint_search" model="ir.ui.view">
        <field name="name">sn.wsd.api.endpoint.search</field>
        <field name="model">sn.wsd.api.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="path"/>
                <filter string="May Change Data" name="mutating" domain="[('is_mutating', '=', True)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_api_endpoint" model="ir.actions.act_window">
        <field name="name">API Tester</field>
        <field name="res_model">sn.wsd.api.endpoint</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_api_endpoint_search"/>
    </record>

    <record id="view_sn_wsd_api_test_case_list" model="ir.ui.view">
        <field name="name">sn.wsd.api.test.case.list</field>
        <field name="model">sn.wsd.api.test.case</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="endpoint_id"/>
                <field name="category"/>
                <field name="method"/>
                <field name="path"/>
                <field name="last_status_code"/>
                <field name="last_elapsed_ms"/>
                <field name="last_run_at"/>
                <field name="last_run_by_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_api_test_case_form" model="ir.ui.view">
        <field name="name">sn.wsd.api.test.case.form</field>
        <field name="model">sn.wsd.api.test.case</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_request" type="object" string="Send" class="btn-primary"/>
                    <button name="action_pretty_format_json" type="object" string="Format JSON" class="btn-secondary"/>
                    <button name="action_reset_from_endpoint" type="object" string="Reset Defaults" class="btn-secondary"/>
                    <button name="action_use_scan_pass_alias_rejection_body"
                            type="object"
                            string="Use Alias Rejection Body"
                            class="btn-secondary"
                            invisible="endpoint_id.code != 'workorder_scan_pass'"/>
                    <button name="action_duplicate_case" type="object" string="Duplicate" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_runs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="run_count" widget="statinfo" string="Runs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_id"/>
                            <field name="category" readonly="1"/>
                            <field name="is_default_case" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="path"/>
                            <field name="base_url"/>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_body" nolabel="1" placeholder="{}" rows="16"/>
                        </page>
                        <page string="Response">
                            <group>
                                <group>
                                    <field name="last_status_code" readonly="1"/>
                                    <field name="last_elapsed_ms" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_run_at" readonly="1"/>
                                    <field name="last_run_by_id" readonly="1"/>
                                </group>
                            </group>
                            <group string="Error" invisible="not last_error_message">
                                <field name="last_error_message" nolabel="1" readonly="1"/>
                            </group>
                            <separator string="Response Body"/>
                            <field name="last_response_body" nolabel="1" readonly="1" rows="16"/>
                        </page>
                        <page string="History">
                            <field name="run_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="run_at"/>
                                    <field name="status_code"/>
                                    <field name="elapsed_ms"/>
                                    <field name="run_by_id"/>
                                    <field name="error_message" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other">
                            <group>
                                <field name="headers_json" placeholder='{"Content-Type": "application/json"}' rows="8"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_api_test_case_search" model="ir.ui.view">
        <field name="name">sn.wsd.api.test.case.search</field>
        <field name="model">sn.wsd.api.test.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="endpoint_id"/>
                <field name="path"/>
                <filter string="My Cases" name="my_cases" domain="[('user_id', '=', uid)]"/>
                <filter string="Default Cases" name="default_cases" domain="[('is_default_case', '=', True)]"/>
                <group>
                    <filter string="Endpoint" name="group_endpoint" context="{'group_by': 'endpoint_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Owner" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_api_test_case" model="ir.actions.act_window">
        <field name="name">API Test Cases</field>
        <field name="res_model">sn.wsd.api.test.case</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_api_test_case_search"/>
        <field name="context">{'search_default_my_cases': 1}</field>
    </record>

    <record id="view_sn_wsd_api_test_run_list" model="ir.ui.view">
        <field name="name">sn.wsd.api.test.run.list</field>
        <field name="model">sn.wsd.api.test.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="run_at"/>
                <field name="case_id"/>
                <field name="endpoint_id"/>
                <field name="method"/>
                <field name="status_code"/>
                <field name="elapsed_ms"/>
                <field name="run_by_id"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_api_test_run_form" model="ir.ui.view">
        <field name="name">sn.wsd.api.test.run.form</field>
        <field name="model">sn.wsd.api.test.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="endpoint_id"/>
                            <field name="method"/>
                            <field name="url"/>
                        </group>
                        <group>
                            <field name="status_code"/>
                            <field name="elapsed_ms"/>
                            <field name="run_at"/>
                            <field name="run_by_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_body" nolabel="1" rows="16"/>
                        </page>
                        <page string="Response">
                            <group string="Error" invisible="not error_message">
                                <field name="error_message" nolabel="1"/>
                            </group>
                            <separator string="Response Body"/>
                            <field name="response_body" nolabel="1" rows="16"/>
                        </page>
                        <page string="Other">
                            <group>
                                <field name="headers_json" rows="8"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_api_test_run_search" model="ir.ui.view">
        <field name="name">sn.wsd.api.test.run.search</field>
        <field name="model">sn.wsd.api.test.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="case_id"/>
                <field name="endpoint_id"/>
                <field name="url"/>
                <filter string="Errors" name="errors" domain="['|', ('status_code', '&gt;=', 400), ('error_message', '!=', False)]"/>
                <group>
                    <filter string="Endpoint" name="group_endpoint" context="{'group_by': 'endpoint_id'}"/>
                    <filter string="Case" name="group_case" context="{'group_by': 'case_id'}"/>
                    <filter string="Runner" name="group_runner" context="{'group_by': 'run_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_api_test_run" model="ir.actions.act_window">
        <field name="name">API Test Runs</field>
        <field name="res_model">sn.wsd.api.test.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_api_test_run_search"/>
    </record>

    <menuitem id="menu_sn_wsd_api_tester"
              name="API Tester"
              parent="menu_sn_wsd_mes_api_records"
              action="action_sn_wsd_api_endpoint"
              sequence="1"/>
    <menuitem id="menu_sn_wsd_api_test_case"
              name="API Test Cases"
              parent="menu_sn_wsd_mes_api_records"
              action="action_sn_wsd_api_test_case"
              sequence="2"/>
    <menuitem id="menu_sn_wsd_api_test_run"
              name="API Test Runs"
              parent="menu_sn_wsd_mes_api_records"
              action="action_sn_wsd_api_test_run"
              sequence="3"/>
</odoo>
