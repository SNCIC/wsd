<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_api_request_log_list" model="ir.ui.view">
        <field name="name">sn.wsd.api.request.log.list</field>
        <field name="model">sn.wsd.api.request.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_time"/>
                <field name="endpoint"/>
                <field name="sn"/>
                <field name="workcenter_code"/>
                <field name="employee_code"/>
                <field name="test_result" widget="badge"
                       decoration-success="test_result == 'ok'"
                       decoration-danger="test_result == 'ng'"/>
                <field name="result_code" widget="badge"
                       decoration-success="result_code == '200'"
                       decoration-danger="result_code != '200'"/>
                <field name="result_message" optional="show"/>
                <field name="duration_ms" optional="hide"/>
                <button name="action_open_test_results" type="object"
                        icon="fa-flask" string="Test Results"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_api_request_log_form" model="ir.ui.view">
        <field name="name">sn.wsd.api.request.log.form</field>
        <field name="model">sn.wsd.api.request.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="request_time"/>
                            <field name="endpoint"/>
                            <field name="sn"/>
                            <field name="test_result"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <field name="workcenter_code"/>
                            <field name="employee_code"/>
                            <field name="result_code"/>
                            <field name="result_message"/>
                        </group>
                    </group>
                    <group string="Uploaded Payload">
                        <field name="payload"/>
                    </group>
                    <group string="Response">
                        <field name="response"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_api_request_log" model="ir.actions.act_window">
        <field name="name">Device API Logs</field>
        <field name="res_model">sn.wsd.api.request.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sn_wsd_api_request_log" name="Device API Logs"
              parent="sn_wsd_mrp.menu_sn_wsd_traceability"
              action="action_sn_wsd_api_request_log" sequence="90"/>
</odoo>
