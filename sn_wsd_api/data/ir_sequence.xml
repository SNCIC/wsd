<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sn_wsd_laser_print_record" model="ir.sequence">
            <field name="name">WSD Laser Print Record</field>
            <field name="code">sn.wsd.laser.print.record</field>
            <field name="prefix">LPR%(y)s%(month)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sn_wsd_laser_product_sn" model="ir.sequence">
            <field name="name">WSD Laser Product SN</field>
            <field name="code">sn.wsd.laser.product.sn</field>
            <field name="prefix">SN%(y)s%(month)s%(day)s</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
