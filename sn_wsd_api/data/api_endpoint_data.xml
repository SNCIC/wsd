<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <function model="ir.model.data" name="write">
            <value model="ir.model.data" search="[('module', '=', 'sn_wsd_api'), ('model', '=', 'sn.wsd.api.endpoint'), ('name', 'like', 'endpoint_%')]"/>
            <value eval="{'noupdate': False}"/>
        </function>
        <function model="sn.wsd.api.endpoint" name="_sync_strict_endpoint_defaults"/>

        <record id="endpoint_auth_check" model="sn.wsd.api.endpoint">
            <field name="name">Login Check</field>
            <field name="code">auth_check</field>
            <field name="category">auth</field>
            <field name="sequence">10</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/auth/check</field>
            <field name="default_body">{
  "userName": "operator",
  "password": "password",
  "organization": "1"
}</field>
            <field name="description">Check external user credentials and optional organization membership.</field>
        </record>

        <record id="endpoint_panels_add" model="sn.wsd.api.endpoint">
            <field name="name">Add Panel</field>
            <field name="code">panels_add</field>
            <field name="category">panel</field>
            <field name="sequence">20</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/panels/add</field>
            <field name="is_mutating">1</field>
            <field name="default_body">{
  "productNo": "MO20260525123589",
  "quantity": 4,
  "pcbItemSn": "3111001398",
  "bindings": [
    {
      "boardNo": "1",
      "proSn": "W23350859A01S012624553250"
    },
    {
      "boardNo": "2",
      "proSn": "W23350859A01S012624553252"
    },
    {
      "boardNo": "3",
      "proSn": "W23350859A01S012624553253"
    },
    {
      "boardNo": "4",
      "proSn": "W23350859A01S012624553251"
    }
  ]
}</field>
            <field name="description">Create a panel and bind PCB board serials.</field>
        </record>

        <record id="endpoint_panels_query" model="sn.wsd.api.endpoint">
            <field name="name">Query Panels</field>
            <field name="code">panels_query</field>
            <field name="category">panel</field>
            <field name="sequence">30</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/panels/query</field>
            <field name="default_body">{
  "proSn": "W23350859A01S012624553252"
}</field>
            <field name="description">Query board serials in the same panel by product serial.</field>
        </record>

        <record id="endpoint_panels_delete" model="sn.wsd.api.endpoint">
            <field name="name">Delete Panel</field>
            <field name="code">panels_delete</field>
            <field name="category">panel</field>
            <field name="sequence">40</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/panels/delete</field>
            <field name="is_mutating">1</field>
            <field name="default_body">{
  "panel_no": "PANEL-TEST-001",
  "operator_code": "OP001"
}</field>
            <field name="description">Delete or deactivate a panel binding.</field>
        </record>

        <record id="endpoint_manufacturing_orders_by_work_order" model="sn.wsd.api.endpoint">
            <field name="name">Search MES Orders</field>
            <field name="code">manufacturing_orders_by_work_order</field>
            <field name="category">manufacturing</field>
            <field name="sequence">50</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/manufacturing-orders/by-work-order</field>
            <field name="default_body">{
  "keyword": "MO"
}</field>
            <field name="description">Search MES order numbers by keyword.</field>
        </record>

        <record id="endpoint_work_centers_search" model="sn.wsd.api.endpoint">
            <field name="name">Search Work Centers</field>
            <field name="code">work_centers_search</field>
            <field name="category">manufacturing</field>
            <field name="sequence">60</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/work-centers/search</field>
            <field name="default_body">{
  "work_station": "SMT"
}</field>
            <field name="description">Search work centers by code or name.</field>
        </record>

        <record id="endpoint_defect_codes_search" model="sn.wsd.api.endpoint">
            <field name="name">Search Defect Codes</field>
            <field name="code">defect_codes_search</field>
            <field name="category">manufacturing</field>
            <field name="sequence">70</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/defect-codes/search</field>
            <field name="default_body">{
  "err_name": "NG"
}</field>
            <field name="description">Search quality defect codes by code or name.</field>
        </record>

        <record id="endpoint_laser_print_requests" model="sn.wsd.api.endpoint">
            <field name="name">Submit Laser Print Request</field>
            <field name="code">laser_print_requests</field>
            <field name="category">laser</field>
            <field name="sequence">80</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/laser/print-requests</field>
            <field name="is_mutating">1</field>
            <field name="default_body">{
  "workOrderNo": "MES-ORDER-TEST-001",
  "quantity": 10,
  "drawingNo": "DWG-2026-A01",
  "operator": "OP001"
}</field>
            <field name="description">Submit a laser print request and generate printable serial data.</field>
        </record>

