        <record id="endpoint_test_results" model="sn.wsd.api.endpoint">
            <field name="name">Submit Test Result</field>
            <field name="code">test_results</field>
            <field name="category">execution</field>
            <field name="sequence">130</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/test-results</field>
            <field name="is_mutating">1</field>
            <field name="default_body">{
  "workorder_id": 1,
  "serial_number": "SN0001",
  "result": "pass",
  "operator_code": "OP001",
  "cycle_time_sec": 10,
  "source_system": "ODOO_API_TESTER",
  "payload": {}
}</field>
            <field name="description">Submit functional, aging, or station test result data.</field>
        </record>

        <record id="endpoint_finished_serials" model="sn.wsd.api.endpoint">
            <field name="name">Upload Finished Serials</field>
            <field name="code">finished_serials</field>
            <field name="category">execution</field>
            <field name="sequence">140</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/finished-serials</field>
            <field name="is_mutating">1</field>
            <field name="default_body">{
  "mes_order_id": 1,
  "serials": [
    "SN0001"
  ],
  "source_system": "ODOO_API_TESTER"
}</field>
            <field name="description">Upload finished serial numbers for an MES order. The mes_order_id field contains the MES order ID.</field>
        </record>

        <record id="endpoint_serial_trace" model="sn.wsd.api.endpoint">
            <field name="name">Serial Trace</field>
            <field name="code">serial_trace</field>
            <field name="category">traceability</field>
            <field name="sequence">150</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/serials/trace</field>
            <field name="default_body">{
  "serial_number": "SN0001",
  "include_test_results": true,
  "travel_limit": 50,
  "test_result_limit": 50
}</field>
            <field name="description">Query serial traceability records and optional test results.</field>
        </record>
    </data>
</odoo>
