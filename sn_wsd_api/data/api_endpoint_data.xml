        <record id="endpoint_online_context" model="sn.wsd.api.endpoint">
            <field name="name">Get Online Context</field>
            <field name="code">online_context</field>
            <field name="category">manufacturing</field>
            <field name="sequence">100</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/online-context</field>
            <field name="default_body">{
  "workcenter_id": 1
}</field>
            <field name="description">Get current online manufacturing context by work center, line, or workshop.</field>
        </record>

        <record id="endpoint_workorder_events" model="sn.wsd.api.endpoint">
            <field name="name">Submit Workorder Event</field>
            <field name="code">workorder_events</field>
            <field name="category">execution</field>
            <field name="sequence">110</field>
            <field name="method">POST</field>
            <field name="path">/api/v1/workorders/events</field>
            <field name="is_mutating">1</field>
            <field name="default_body">{
  "workorder_id": 1,
  "event_type": "scan",
  "serial_number": "SN0001",
  "operator_code": "OP001",
  "source_system": "ODOO_API_TESTER",
  "payload": {}
}</field>
            <field name="description">Submit a workorder event for MES traceability.</field>
        </record>

