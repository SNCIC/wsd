<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aging_record_list" model="ir.ui.view">
        <field name="name">sn.wsd.device.aging.record.list</field>
        <field name="model">sn.wsd.device.aging.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="device_sn"/>
                <field name="temperature"/>
                <field name="collect_time"/>
                <field name="create_date" string="Created on" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_aging_record_form" model="ir.ui.view">
        <field name="name">sn.wsd.device.aging.record.form</field>
        <field name="model">sn.wsd.device.aging.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="device_sn"/>
                            <field name="temperature"/>
                        </group>
                        <group>
                            <field name="collect_time"/>
                            <field name="create_date" string="Created on" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aging_record_search" model="ir.ui.view">
        <field name="name">sn.wsd.device.aging.record.search</field>
        <field name="model">sn.wsd.device.aging.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="device_sn"/>
                <field name="collect_time"/>
                <filter string="Today" name="filter_today"
                        domain="[('collect_time', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)))]"/>
            </search>
        </field>
    </record>

    <record id="action_aging_data" model="ir.actions.act_window">
        <field name="name">Aging Data Collection</field>
        <field name="res_model">sn.wsd.device.aging.record</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No aging data yet
            </p>
            <p>
                Records appear automatically when aging-room devices push
                temperature points to POST /api/device/aging.
            </p>
        </field>
    </record>

</odoo>
