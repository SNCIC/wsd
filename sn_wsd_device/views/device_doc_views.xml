<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Document Type dictionary ===== -->

    <record id="view_doc_type_list" model="ir.ui.view">
        <field name="name">sn.wsd.device.doc.type.list</field>
        <field name="model">sn.wsd.device.doc.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_doc_type_form" model="ir.ui.view">
        <field name="name">sn.wsd.device.doc.type.form</field>
        <field name="model">sn.wsd.device.doc.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doc_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">sn.wsd.device.doc.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No document type yet
            </p>
            <p>
                Maintain the list of device document types here. They show up
                as dropdown options on documents that reference them.
            </p>
        </field>
    </record>

</odoo>
