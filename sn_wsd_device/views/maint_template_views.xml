<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maint_template_list" model="ir.ui.view">
        <field name="name">sn.wsd.device.maint.template.list</field>
        <field name="model">sn.wsd.device.maint.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="equipment_type_id"/>
                <field name="maintenance_count" string="Maintenance Item Count"
                       sum="1"/>
                <field name="spot_check_count" string="Spot Check Item Count"
                       sum="1"/>
                <button name="action_duplicate" type="object"
                        icon="fa-clone" title="Duplicate"
                        string="Duplicate"/>
            </list>
        </field>
    </record>

    <record id="view_maint_template_form" model="ir.ui.view">
        <field name="name">sn.wsd.device.maint.template.form</field>
        <field name="model">sn.wsd.device.maint.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="equipment_type_id"
                                   required="1"
                                   options="{'no_create': True}"
                                   placeholder="Select an equipment type..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="maintenance_count"/>
                            <field name="spot_check_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Maintenance Items">
                            <field name="maintenance_item_ids"
                                   context="{'default_item_type': 'maintenance'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="e.g. Lubrication system check"/>
                                    <field name="method"/>
                                    <field name="planned_hours"/>
                                    <field name="value_type"/>
                                    <field name="lower_limit"
                                           invisible="value_type != 'range'"
                                           required="value_type == 'range'"/>
                                    <field name="upper_limit"
                                           invisible="value_type == 'status'"
                                           required="value_type in ['range', 'fixed']"/>
                                    <field name="unit"/>
                                    <field name="guide_file" filename="guide_filename"
                                           widget="binary"/>
                                    <field name="guide_filename" column_invisible="1"/>
                                    <field name="item_type" column_invisible="1"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Spot Check Items">
                            <field name="spot_check_item_ids"
                                   context="{'default_item_type': 'spot_check'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="e.g. Temperature check"/>
                                    <field name="method"/>
                                    <field name="planned_hours"/>
                                    <field name="value_type"/>
                                    <field name="lower_limit"
                                           invisible="value_type != 'range'"
                                           required="value_type == 'range'"/>
                                    <field name="upper_limit"
                                           invisible="value_type == 'status'"
                                           required="value_type in ['range', 'fixed']"/>
                                    <field name="unit"/>
                                    <field name="guide_file" filename="guide_filename"
                                           widget="binary"/>
                                    <field name="guide_filename" column_invisible="1"/>
                                    <field name="item_type" column_invisible="1"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_maint_template_search" model="ir.ui.view">
        <field name="name">sn.wsd.device.maint.template.search</field>
        <field name="model">sn.wsd.device.maint.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_type_id"/>
                <group>
                    <filter string="Equipment Type" name="group_type"
                            context="{'group_by': 'equipment_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_maint_template" model="ir.actions.act_window">
        <field name="name">Spot Check / Maintenance Items</field>
        <field name="res_model">sn.wsd.device.maint.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No template configured yet
            </p>
            <p>
                Configure the standard maintenance and spot check items of
                each equipment type. Tasks generated later reuse these
                templates automatically.
            </p>
        </field>
    </record>

</odoo>
