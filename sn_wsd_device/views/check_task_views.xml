<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_check_task_list" model="ir.ui.view">
        <field name="name">sn.wsd.device.check.task.list</field>
        <field name="model">sn.wsd.device.check.task</field>
        <field name="arch" type="xml">
            <list decoration-info="task_status == 'pending'"
                  decoration-warning="task_status == 'in_progress'"
                  decoration-danger="task_status == 'overdue'"
                  decoration-muted="task_status == 'completed'">
                <field name="name"/>
                <field name="task_date"/>
                <field name="equipment_code"/>
                <field name="equipment_name"/>
                <field name="equipment_type_code" optional="show"/>
                <field name="task_status"/>
                <field name="overall_result" optional="show"/>
                <field name="responsible_user_id" optional="show"/>
                <field name="executor_id" optional="hide"/>
                <field name="executed_time" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_check_task_form" model="ir.ui.view">
        <field name="name">sn.wsd.device.check.task.form</field>
        <field name="model">sn.wsd.device.check.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object"
                            string="Start Execution" class="btn-primary"
                            invisible="task_status not in ['pending', 'overdue']"/>
                    <button name="action_submit" type="object"
                            string="Submit Task" class="btn-primary"
                            invisible="task_status == 'completed'"
                            confirm="Submit this task? Results cannot be edited afterwards."/>
                    <field name="task_status" widget="statusbar"
                           statusbar_visible="pending,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id" readonly="1"/>
                            <field name="equipment_id" readonly="1"/>
                            <field name="equipment_code" readonly="1"/>
                            <field name="equipment_name" readonly="1"/>
                            <field name="equipment_type_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="task_date" readonly="1"/>
                            <field name="responsible_user_id" readonly="1"/>
                            <field name="overall_result" readonly="1"/>
                            <field name="executor_id" readonly="1"/>
                            <field name="executed_time" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Check Lines">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="line_result == 'pass'"
                                      decoration-danger="line_result == 'fail'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" readonly="1"/>
                                    <field name="method" readonly="1"/>
                                    <field name="guide_file_type" optional="show"/>
                                    <button name="action_download_guide" type="object"
                                            icon="fa-download" title="Download Guide"
                                            invisible="not guide_file"/>
                                    <field name="value_type" readonly="1"/>
                                    <field name="lower_limit" readonly="1"/>
                                    <field name="upper_limit" readonly="1"/>
                                    <field name="unit" readonly="1"/>
                                    <field name="measured_value"
                                           readonly="value_type == 'status'"/>
                                    <field name="line_result"
                                           readonly="parent.task_status == 'completed' or value_type == 'range'"/>
                                    <field name="line_note"/>
                                    <field name="check_photo" widget="binary"/>
                                    <field name="guide_file" column_invisible="1"/>
                                    <field name="guide_filename" column_invisible="1"/>
                                    <field name="task_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_check_task_search" model="ir.ui.view">
        <field name="name">sn.wsd.device.check.task.search</field>
        <field name="model">sn.wsd.device.check.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_code"/>
                <field name="equipment_name"/>
                <field name="responsible_user_id"/>
                <filter string="My Tasks" name="filter_my_tasks"
                        domain="[('responsible_user_id', '=', uid)]"/>
                <separator/>
                <filter string="Pending" name="filter_pending"
                        domain="[('task_status', '=', 'pending')]"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('task_status', '=', 'in_progress')]"/>
                <filter string="Overdue" name="filter_overdue"
                        domain="[('task_status', '=', 'overdue')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('task_status', '=', 'completed')]"/>
                <separator/>
                <filter string="Pass" name="filter_pass"
                        domain="[('overall_result', '=', 'pass')]"/>
                <filter string="Fail" name="filter_fail"
                        domain="[('overall_result', '=', 'fail')]"/>
                <group>
                    <filter string="Task Status" name="group_status"
                            context="{'group_by': 'task_status'}"/>
                    <filter string="Equipment" name="group_equipment"
                            context="{'group_by': 'equipment_id'}"/>
                    <filter string="Task Date" name="group_date"
                            context="{'group_by': 'task_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_check_task" model="ir.actions.act_window">
        <field name="name">Spot Check Tasks</field>
        <field name="res_model">sn.wsd.device.check.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_check_task_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No spot check task yet
            </p>
            <p>
                Tasks are generated automatically by the spot check plans.
                Open one, start it, fill in the measured values and submit.
            </p>
        </field>
    </record>

</odoo>
