<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_check_task" model="ir.sequence">
            <field name="name">Equipment Spot Check Task</field>
            <field name="code">sn.wsd.device.check.task</field>
            <field name="prefix">CKT%(y)s%(month)s%(day)s</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="check_trigger_time_param" model="ir.config_parameter">
            <field name="key">equipment_inspection_trigger_time</field>
            <field name="value">08:00</field>
        </record>

        <!-- ONE shared generation cron for all plans (hourly wake-up,
             acts once the global trigger time is reached). -->
        <record id="ir_cron_check_task_generation" model="ir.cron">
            <field name="name">Equipment Check: Generate Tasks</field>
            <field name="model_id" ref="model_sn_wsd_device_check_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_check_tasks()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
