<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_maint_task" model="ir.sequence">
            <field name="name">Equipment Maintenance Task</field>
            <field name="code">sn.wsd.device.maint.task</field>
            <field name="prefix">MT%(y)s%(month)s%(day)s</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="maint_trigger_time_param" model="ir.config_parameter">
            <field name="key">equipment_maintenance_trigger_time</field>
            <field name="value">08:30</field>
        </record>

        <!-- ONE shared maintenance generation cron (independent of the
             spot check cron and its trigger time). -->
        <record id="ir_cron_maint_task_generation" model="ir.cron">
            <field name="name">Equipment Maintenance: Generate Tasks</field>
            <field name="model_id" ref="model_sn_wsd_device_maint_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_maintenance_tasks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
