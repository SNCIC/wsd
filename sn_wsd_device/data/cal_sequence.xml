<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_cal_task" model="ir.sequence">
            <field name="name">Equipment Calibration Task</field>
            <field name="code">sn.wsd.device.cal.task</field>
            <field name="prefix">CAL%(y)s%(month)s%(day)s</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="cal_trigger_time_param" model="ir.config_parameter">
            <field name="key">equipment_cal_trigger_time</field>
            <field name="value">08:00</field>
        </record>

        <!-- ONE shared calibration generation cron. -->
        <record id="ir_cron_cal_task_generation" model="ir.cron">
            <field name="name">Equipment Calibration: Generate Tasks</field>
            <field name="model_id" ref="model_sn_wsd_device_cal_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_calibration_tasks()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
