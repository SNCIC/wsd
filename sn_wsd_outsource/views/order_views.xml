<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_out_order_list" model="ir.ui.view">
        <field name="name">sn.out.order.list</field>
        <field name="model">sn.out.order</field>
        <field name="arch" type="xml">
            <list string="代工单" decoration-muted="state in ('done', 'closed', 'cancel')"
                  decoration-danger="risk_level in ('high', 'overdue')">
                <field name="name"/>
                <field name="factory_id"/>
                <field name="sale_order_id" optional="show"/>
                <field name="product_id"/>
                <field name="mode" widget="badge" decoration-info="mode == 'turnkey'" decoration-warning="mode == 'consign'"
                       decoration-primary="mode == 'mold_loan'"/>
                <field name="qty"/>
                <field name="unit_price" optional="show"/>
                <field name="date_promised"/>
                <field name="produce_rate" widget="progressbar" string="生产进度"/>
                <field name="accepted_qty"/>
                <field name="achieve_rate" widget="progressbar"/>
                <field name="risk_level" widget="badge" decoration-success="risk_level == 'normal'"
                       decoration-warning="risk_level == 'watch'" decoration-danger="risk_level in ('high', 'overdue')"/>
                <field name="balance_state" optional="show" widget="badge" decoration-success="balance_state == 'balanced'"
                       decoration-warning="balance_state == 'open'" decoration-muted="balance_state == 'na'"/>
                <field name="state" widget="badge" decoration-info="state == 'released'" decoration-primary="state == 'producing'"
                       decoration-warning="state == 'partial'" decoration-success="state == 'done'" decoration-muted="state in ('closed', 'cancel')"/>
            </list>
        </field>
    </record>

    <record id="view_sn_out_order_form" model="ir.ui.view">
        <field name="name">sn.out.order.form</field>
        <field name="model">sn.out.order</field>
        <field name="arch" type="xml">
            <form string="代工单">
                <header>
                    <button name="action_release" type="object" string="下达" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_issue" type="object" string="发料" class="btn-primary"
                            invisible="mode != 'consign' or state not in ('released', 'producing', 'partial')"/>
                    <button name="action_loan_mold" type="object" string="借出模具" class="btn-primary"
                            invisible="mode != 'mold_loan' or state not in ('released', 'producing') or loan_state != 'none'"/>
                    <button name="action_new_receipt" type="object" string="登记回货"
                            invisible="state not in ('released', 'producing', 'partial')"/>
                    <button name="action_create_return" type="object" string="退料"
                            invisible="mode != 'consign' or state not in ('producing', 'partial')"/>
                    <button name="action_compute_balance" type="object" string="物料平衡"
                            invisible="balance_state == 'na' or state not in ('producing', 'partial')"/>
                    <button name="action_create_statement" type="object" string="生成对账单"
                            invisible="state not in ('partial',) or statement_id"/>
                    <button name="action_done" type="object" string="结案完成" class="btn-primary"
                            invisible="state != 'partial' or not statement_id"/>
                    <button name="action_close" type="object" string="关闭" invisible="state not in ('producing', 'partial')"
                            confirm="关闭后剩余数量不再交货，确定关闭？"/>
                    <button name="action_cancel" type="object" string="取消" invisible="state not in ('draft', 'released')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,released,producing,partial,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not purchase_id">
                            <field name="purchase_id" widget="statinfo" string="采购单"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="高风险" bg_color="text-bg-danger" invisible="risk_level != 'high'"/>
                    <widget name="web_ribbon" title="已逾期" bg_color="text-bg-danger" invisible="risk_level != 'overdue'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="订单与产品">
                            <field name="sale_order_id" readonly="state != 'draft'"/>
                            <field name="customer_id" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="qty" readonly="state != 'draft'"/>
                            <field name="date_deadline" readonly="state != 'draft'"/>
                            <field name="request_id" invisible="not request_id"/>
                            <field name="plan_id" invisible="not plan_id"/>
                        </group>
                        <group string="代工厂与外发模式">
                            <field name="factory_id" readonly="state != 'draft'"/>
                            <field name="mode" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="mold_id" invisible="mode != 'mold_loan'" readonly="state != 'draft'"/>
                            <field name="loan_state" invisible="mode != 'mold_loan'" widget="badge"
                                   decoration-warning="loan_state == 'loaned'" decoration-success="loan_state == 'returned'"/>
                            <field name="bom_id" invisible="mode != 'consign'" readonly="state != 'draft'"/>
                            <field name="date_promised" readonly="state not in ('draft', 'released')"/>
                            <field name="unit_price" readonly="state != 'draft'"/>
                            <field name="amount_planned"/>
                            <field name="loss_rate_max" invisible="mode != 'consign'" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="进度与风险">
                        <group>
                            <field name="produced_qty"/>
                            <field name="produce_rate" widget="progressbar"/>
                            <field name="delivered_qty"/>
                            <field name="pending_qty"/>
                        </group>
                        <group>
                            <field name="accepted_qty"/>
                            <field name="achieve_rate" widget="progressbar"/>
                            <field name="risk_level" widget="badge" decoration-success="risk_level == 'normal'"
                                   decoration-warning="risk_level == 'watch'" decoration-danger="risk_level in ('high', 'overdue')"/>
                            <field name="risk_text" invisible="not risk_text" class="text-danger"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="进度回报" name="progress">
                            <field name="progress_ids">
                                <list editable="top" default_order="date desc">
                                    <field name="date"/>
                                    <field name="stage"/>
                                    <field name="produced_qty"/>
                                    <field name="good_qty" optional="show"/>
                                    <field name="shots" optional="show"/>
                                    <field name="progress_pct" widget="progressbar"/>
                                    <field name="source" widget="badge" decoration-info="source == 'api'"/>
                                    <field name="reporter" optional="show"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="发料/退料" name="issue" invisible="mode != 'consign'">
                            <field name="issue_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="kind" widget="badge" decoration-info="kind == 'issue'" decoration-warning="kind == 'return'"/>
                                    <field name="date"/>
                                    <field name="total_qty" sum="合计"/>
                                    <field name="picking_id"/>
                                    <field name="handler"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                        <page string="模具外借" name="loan" invisible="mode != 'mold_loan'">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="mold_id"/>
                                    <field name="date_out"/>
                                    <field name="date_expect_back"/>
                                    <field name="date_back"/>
                                    <field name="shots_out"/>
                                    <field name="shots_at_factory"/>
                                    <field name="shots_back"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'loaned'" decoration-success="state == 'returned'"/>
                                </list>
                            </field>
                        </page>
                        <page string="回货与检验" name="receipt">
                            <field name="receipt_ids" readonly="1">
                                <list decoration-danger="iqc_result == 'fail'">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="delivery_no" optional="show"/>
                                    <field name="factory_lot" optional="show"/>
                                    <field name="qty" sum="合计"/>
                                    <field name="on_time" widget="boolean"/>
                                    <field name="iqc_id"/>
                                    <field name="iqc_result" widget="badge" decoration-success="iqc_result == 'pass'" decoration-danger="iqc_result == 'fail'"/>
                                    <field name="disposition"/>
                                    <field name="accepted_qty" sum="合计"/>
                                    <field name="rejected_qty" sum="合计"/>
                                    <field name="lot_name"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state in ('inspecting', 'inspected')"
                                           decoration-danger="state == 'returned'"/>
                                </list>
                            </field>
                        </page>
                        <page string="物料平衡" name="balance" invisible="balance_state == 'na'">
                            <field name="balance_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="issued_qty"/>
                                    <field name="std_use_qty"/>
                                    <field name="reasonable_loss_qty"/>
                                    <field name="returned_qty"/>
                                    <field name="excess_qty"/>
                                    <field name="remaining_qty"/>
                                    <field name="excess_rate"/>
                                    <field name="deduct_amount" sum="合计"/>
                                    <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                                </list>
                            </field>
                            <group>
                                <field name="balance_state" widget="badge" decoration-success="balance_state == 'balanced'"
                                       decoration-warning="balance_state == 'open'"/>
                                <field name="deduct_amount"/>
                            </group>
                        </page>
                        <page string="质量要求" name="quality">
                            <group>
                                <group>
                                    <field name="card_id"/>
                                    <field name="sample_no"/>
                                    <field name="sample_date"/>
                                    <field name="aql"/>
                                    <field name="qty_tolerance"/>
                                </group>
                                <group>
                                    <field name="penalty_factor" invisible="mode != 'consign'"/>
                                    <field name="user_id"/>
                                    <field name="date_order"/>
                                </group>
                            </group>
                            <field name="quality_req" placeholder="外观、尺寸、材质、包装标识等要求"/>
                        </page>
                        <page string="结算" name="settle">
                            <group>
                                <group>
                                    <field name="statement_id"/>
                                    <field name="deduct_amount"/>
                                    <field name="date_done"/>
                                </group>
                                <group>
                                    <field name="close_reason" readonly="state in ('done', 'closed', 'cancel')"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            <field name="note" placeholder="备注"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_out_order_search" model="ir.ui.view">
        <field name="name">sn.out.order.search</field>
        <field name="model">sn.out.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="factory_id"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <filter name="open" string="执行中" domain="[('state', 'in', ('released', 'producing', 'partial'))]"/>
                <filter name="risk" string="交期风险" domain="[('risk_level', 'in', ('watch', 'high', 'overdue'))]"/>
                <filter name="unbalanced" string="物料未平衡" domain="[('balance_state', '=', 'open')]"/>
                <separator/>
                <filter name="turnkey" string="包工包料" domain="[('mode', '=', 'turnkey')]"/>
                <filter name="consign" string="来料加工" domain="[('mode', '=', 'consign')]"/>
                <filter name="mold_loan" string="带模外发" domain="[('mode', '=', 'mold_loan')]"/>
                <group>
                    <filter name="g_factory" string="代工厂" context="{'group_by': 'factory_id'}"/>
                    <filter name="g_mode" string="外发模式" context="{'group_by': 'mode'}"/>
                    <filter name="g_state" string="状态" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_out_order_pivot" model="ir.ui.view">
        <field name="name">sn.out.order.pivot</field>
        <field name="model">sn.out.order</field>
        <field name="arch" type="xml">
            <pivot string="代工单分析">
                <field name="factory_id" type="row"/>
                <field name="mode" type="col"/>
                <field name="qty" type="measure"/>
                <field name="accepted_qty" type="measure"/>
                <field name="amount_planned" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sn_out_order" model="ir.actions.act_window">
        <field name="name">代工单</field>
        <field name="res_model">sn.out.order</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

    <!-- 进度回报 -->
    <record id="view_sn_out_progress_list" model="ir.ui.view">
        <field name="name">sn.out.progress.list</field>
        <field name="model">sn.out.progress</field>
        <field name="arch" type="xml">
            <list string="进度回报" editable="top" default_order="date desc">
                <field name="date"/>
                <field name="order_id"/>
                <field name="factory_id"/>
                <field name="product_id"/>
                <field name="order_qty"/>
                <field name="stage"/>
                <field name="produced_qty"/>
                <field name="shots" optional="show"/>
                <field name="progress_pct" widget="progressbar"/>
                <field name="source" widget="badge" decoration-info="source == 'api'"/>
                <field name="reporter" optional="show"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_sn_out_progress" model="ir.actions.act_window">
        <field name="name">进度回报</field>
        <field name="res_model">sn.out.progress</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
