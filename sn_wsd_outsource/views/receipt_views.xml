<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_out_receipt_list" model="ir.ui.view">
        <field name="name">sn.out.receipt.list</field>
        <field name="model">sn.out.receipt</field>
        <field name="arch" type="xml">
            <list string="代工回货" decoration-danger="iqc_result == 'fail'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="order_id"/>
                <field name="factory_id"/>
                <field name="product_id"/>
                <field name="delivery_no" optional="show"/>
                <field name="qty" sum="合计"/>
                <field name="on_time" widget="boolean"/>
                <field name="iqc_result" widget="badge" decoration-success="iqc_result == 'pass'" decoration-danger="iqc_result == 'fail'"/>
                <field name="disposition"/>
                <field name="accepted_qty" sum="合计"/>
                <field name="rejected_qty" sum="合计"/>
                <field name="lot_name"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state in ('inspecting', 'inspected')"
                       decoration-danger="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="view_sn_out_receipt_form" model="ir.ui.view">
        <field name="name">sn.out.receipt.form</field>
        <field name="model">sn.out.receipt</field>
        <field name="arch" type="xml">
            <form string="代工回货">
                <header>
                    <button name="action_confirm" type="object" string="到货送检" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_stock_in" type="object" string="入库" class="btn-primary" invisible="state not in ('inspecting', 'inspected') or disposition == 'return'"/>
                    <button name="action_return_goods" type="object" string="退回代工厂" invisible="state != 'inspected' or disposition != 'return'"/>
                    <button name="action_cancel" type="object" string="取消" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,inspecting,inspected,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="order_id" readonly="state != 'draft'"/>
                            <field name="factory_id"/>
                            <field name="product_id"/>
                            <field name="mode"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="date_promised"/>
                            <field name="on_time"/>
                        </group>
                        <group>
                            <field name="qty" readonly="state != 'draft'"/>
                            <field name="box_qty" readonly="state != 'draft'"/>
                            <field name="delivery_no" readonly="state != 'draft'"/>
                            <field name="factory_lot" readonly="state != 'draft'"/>
                            <field name="lot_name"/>
                            <field name="iqc_id"/>
                            <field name="iqc_result"/>
                            <field name="disposition"/>
                            <field name="accepted_qty"/>
                            <field name="rejected_qty"/>
                            <field name="picking_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_out_receipt_search" model="ir.ui.view">
        <field name="name">sn.out.receipt.search</field>
        <field name="model">sn.out.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="order_id"/>
                <field name="factory_id"/>
                <filter name="todo" string="待检验" domain="[('state', '=', 'inspecting')]"/>
                <filter name="fail" string="不合格" domain="[('iqc_result', '=', 'fail')]"/>
                <group>
                    <filter name="g_factory" string="代工厂" context="{'group_by': 'factory_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_out_receipt" model="ir.actions.act_window">
        <field name="name">代工回货</field>
        <field name="res_model">sn.out.receipt</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 回货检验 -->
    <record id="view_sn_out_iqc_list" model="ir.ui.view">
        <field name="name">sn.out.iqc.list</field>
        <field name="model">sn.out.iqc</field>
        <field name="arch" type="xml">
            <list string="回货检验" decoration-danger="result == 'fail'" decoration-warning="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="receipt_id"/>
                <field name="order_id"/>
                <field name="factory_id"/>
                <field name="product_id"/>
                <field name="lot_qty"/>
                <field name="aql"/>
                <field name="sample_qty"/>
                <field name="ac"/>
                <field name="re_qty"/>
                <field name="defect_qty"/>
                <field name="defect_text"/>
                <field name="result" widget="badge" decoration-success="result == 'pass'" decoration-danger="result == 'fail'"/>
                <field name="disposition" widget="badge" decoration-success="disposition == 'accept'" decoration-warning="disposition in ('concession', 'sort')"
                       decoration-danger="disposition == 'return'"/>
                <field name="accepted_qty"/>
                <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_sn_out_iqc_form" model="ir.ui.view">
        <field name="name">sn.out.iqc.form</field>
        <field name="model">sn.out.iqc</field>
        <field name="arch" type="xml">
            <form string="回货检验">
                <header>
                    <button name="action_pass_all_items" type="object" string="项目全部合格" invisible="state != 'draft'"/>
                    <button name="action_judge" type="object" string="判定" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="合格" bg_color="text-bg-success" invisible="result != 'pass'"/>
                    <widget name="web_ribbon" title="不合格" bg_color="text-bg-danger" invisible="result != 'fail'"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="来源">
                            <field name="receipt_id" readonly="1"/>
                            <field name="order_id"/>
                            <field name="factory_id"/>
                            <field name="product_id"/>
                            <field name="card_id"/>
                            <field name="sample_no"/>
                            <field name="inspector" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group string="抽样方案（GB/T 2828.1 一般检验水平 II）">
                            <field name="lot_qty"/>
                            <field name="aql"/>
                            <field name="sample_code"/>
                            <field name="sample_qty"/>
                            <field name="acre_text"/>
                            <field name="defect_qty"/>
                            <field name="result"/>
                            <field name="disposition" readonly="state != 'draft'"/>
                            <field name="sort_bad_qty" invisible="disposition != 'sort'" readonly="state != 'draft'"/>
                            <field name="concession_pct" invisible="disposition != 'concession'" readonly="state != 'draft'"/>
                            <field name="accepted_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="检验项目" name="items">
                            <field name="item_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-danger="result == 'ng'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="standard"/>
                                    <field name="measured"/>
                                    <field name="result" widget="badge" decoration-success="result == 'ok'" decoration-danger="result == 'ng'"/>
                                </list>
                            </field>
                        </page>
                        <page string="不良明细" name="defects">
                            <field name="defect_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="defect_id"/>
                                    <field name="severity"/>
                                    <field name="qty" sum="合计"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="note" placeholder="检验结论" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_out_iqc_search" model="ir.ui.view">
        <field name="name">sn.out.iqc.search</field>
        <field name="model">sn.out.iqc</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="factory_id"/>
                <field name="order_id"/>
                <filter name="todo" string="待检验" domain="[('state', '=', 'draft')]"/>
                <filter name="fail" string="不合格" domain="[('result', '=', 'fail')]"/>
            </search>
        </field>
    </record>

    <record id="action_sn_out_iqc" model="ir.actions.act_window">
        <field name="name">回货检验</field>
        <field name="res_model">sn.out.iqc</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sn_out_iqc_defect_pivot" model="ir.ui.view">
        <field name="name">sn.out.iqc.defect.pivot</field>
        <field name="model">sn.out.iqc.defect</field>
        <field name="arch" type="xml">
            <pivot string="回货不良分析">
                <field name="defect_id" type="row"/>
                <field name="factory_id" type="col"/>
                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_sn_out_iqc_defect" model="ir.actions.act_window">
        <field name="name">回货不良分析</field>
        <field name="res_model">sn.out.iqc.defect</field>
        <field name="view_mode">pivot,list</field>
    </record>
    <record id="view_sn_out_iqc_defect_list" model="ir.ui.view">
        <field name="name">sn.out.iqc.defect.list</field>
        <field name="model">sn.out.iqc.defect</field>
        <field name="arch" type="xml">
            <list>
                <field name="iqc_id"/>
                <field name="factory_id"/>
                <field name="product_id"/>
                <field name="defect_id"/>
                <field name="severity"/>
                <field name="qty" sum="合计"/>
                <field name="note"/>
            </list>
        </field>
    </record>
</odoo>
