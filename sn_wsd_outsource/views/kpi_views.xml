<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_out_kpi_list" model="ir.ui.view">
        <field name="name">sn.out.kpi.list</field>
        <field name="model">sn.out.kpi</field>
        <field name="arch" type="xml">
            <list string="代工厂绩效" decoration-danger="rating == 'D'">
                <field name="period"/>
                <field name="factory_id"/>
                <field name="order_count"/>
                <field name="batch_count"/>
                <field name="ontime_rate"/>
                <field name="inspect_count"/>
                <field name="pass_rate"/>
                <field name="issued_qty" optional="show"/>
                <field name="excess_qty" optional="show"/>
                <field name="excess_rate"/>
                <field name="deduct_amount"/>
                <field name="score"/>
                <field name="rating" widget="badge" decoration-success="rating == 'A'" decoration-info="rating == 'B'"
                       decoration-warning="rating == 'C'" decoration-danger="rating == 'D'"/>
            </list>
        </field>
    </record>

    <record id="view_sn_out_kpi_graph" model="ir.ui.view">
        <field name="name">sn.out.kpi.graph</field>
        <field name="model">sn.out.kpi</field>
        <field name="arch" type="xml">
            <graph string="代工厂绩效" type="bar" stacked="0">
                <field name="period" type="row"/>
                <field name="factory_id" type="col"/>
                <field name="score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sn_out_kpi_pivot" model="ir.ui.view">
        <field name="name">sn.out.kpi.pivot</field>
        <field name="model">sn.out.kpi</field>
        <field name="arch" type="xml">
            <pivot string="代工厂绩效">
                <field name="factory_id" type="row"/>
                <field name="period" type="col"/>
                <field name="ontime_rate" type="measure"/>
                <field name="pass_rate" type="measure"/>
                <field name="excess_rate" type="measure"/>
                <field name="score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sn_out_kpi_search" model="ir.ui.view">
        <field name="name">sn.out.kpi.search</field>
        <field name="model">sn.out.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="factory_id"/>
                <field name="period"/>
                <group>
                    <filter name="g_factory" string="代工厂" context="{'group_by': 'factory_id'}"/>
                    <filter name="g_period" string="期间" context="{'group_by': 'period'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_out_kpi" model="ir.actions.act_window">
        <field name="name">代工厂绩效</field>
        <field name="res_model">sn.out.kpi</field>
        <field name="view_mode">graph,list,pivot</field>
    </record>

    <record id="action_sn_out_kpi_board" model="ir.actions.client">
        <field name="name">代工厂绩效看板</field>
        <field name="tag">sn_out_kpi_board</field>
    </record>

    <record id="view_sn_out_kpi_wizard_form" model="ir.ui.view">
        <field name="name">sn.out.kpi.wizard.form</field>
        <field name="model">sn.out.kpi.wizard</field>
        <field name="arch" type="xml">
            <form string="绩效统计">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="period" placeholder="如 2026-11"/>
                    <field name="writeback"/>
                </group>
                <div class="text-muted small">综合得分 = 准交率×40% + 合格率×40% + 物料分 20（超耗率每 1% 扣 4 分）；A≥90，B≥80，C≥70，D&lt;70，D 级自动暂停合作。</div>
                <footer>
                    <button name="action_compute" type="object" string="统计" class="btn-primary"/>
                    <button special="cancel" string="取消"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sn_out_kpi_wizard" model="ir.actions.act_window">
        <field name="name">绩效统计</field>
        <field name="res_model">sn.out.kpi.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
