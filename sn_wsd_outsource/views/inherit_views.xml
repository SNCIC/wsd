<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 模具台账：外借状态、当前位置 -->
    <record id="view_sn_inj_mold_list_out" model="ir.ui.view">
        <field name="name">sn.inj.mold.list.outsource</field>
        <field name="model">sn.inj.mold</field>
        <field name="inherit_id" ref="sn_wsd_injection.view_sn_inj_mold_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mold_state']" position="attributes">
                <attribute name="decoration-primary">mold_state == 'loaned'</attribute>
            </xpath>
            <xpath expr="//field[@name='machine_id']" position="replace">
                <field name="position_text"/>
            </xpath>
        </field>
    </record>

    <record id="view_sn_inj_mold_form_out" model="ir.ui.view">
        <field name="name">sn.inj.mold.form.outsource</field>
        <field name="model">sn.inj.mold</field>
        <field name="inherit_id" ref="sn_wsd_injection.view_sn_inj_mold_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='mold_state']" position="attributes">
                <attribute name="statusbar_visible">in_stock,on_machine,maintaining,loaned</attribute>
            </xpath>
            <xpath expr="//field[@name='machine_id']" position="after">
                <field name="position_text"/>
                <field name="loan_id" invisible="not loan_id"/>
            </xpath>
            <xpath expr="//sheet/widget[1]" position="before">
                <widget name="web_ribbon" title="外借中" bg_color="text-bg-primary" invisible="mold_state != 'loaned'"/>
            </xpath>
        </field>
    </record>

    <record id="view_sn_inj_mold_search_out" model="ir.ui.view">
        <field name="name">sn.inj.mold.search.outsource</field>
        <field name="model">sn.inj.mold</field>
        <field name="inherit_id" ref="sn_wsd_injection.view_sn_inj_mold_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='in_stock']" position="after">
                <filter name="loaned" string="外借" domain="[('mold_state', '=', 'loaned')]"/>
            </xpath>
        </field>
    </record>

    <!-- 注塑排产：转外发 -->
    <record id="view_sn_inj_plan_form_out" model="ir.ui.view">
        <field name="name">sn.inj.plan.form.outsource</field>
        <field name="model">sn.inj.plan</field>
        <field name="inherit_id" ref="sn_wsd_injection.view_sn_inj_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_cancel']" position="before">
                <button name="action_to_outsource" type="object" string="转外发" invisible="state not in ('draft', 'confirmed')"/>
            </xpath>
        </field>
    </record>

    <!-- 客户订单：整单外发 -->
    <record id="view_sale_order_form_out" model="ir.ui.view">
        <field name="name">sale.order.form.outsource</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_to_outsource" type="object" string="整单外发" invisible="state != 'sale'"
                        groups="mrp.group_mrp_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_out_orders" type="object" class="oe_stat_button" icon="fa-industry"
                        invisible="out_order_count == 0" groups="mrp.group_mrp_user">
                    <field name="out_order_count" widget="statinfo" string="代工单"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
