<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_out_risk" model="ir.cron">
        <field name="name">代工单交期风险预警</field>
        <field name="model_id" ref="model_sn_out_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_risk()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_out_kpi" model="ir.cron">
        <field name="name">代工厂月度绩效统计与评级回写</field>
        <field name="model_id" ref="model_sn_out_kpi"/>
        <field name="state">code</field>
        <field name="code">model._cron_monthly()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
