<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_piece_settlement_generate_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.piece.settlement.generate.wizard.form</field>
        <field name="model">sn.wsd.piece.settlement.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate From Reports">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="mes_order_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <field name="report_ids">
                    <list create="false" edit="false" delete="false">
                        <field name="reported_at"/>
                        <field name="mes_order_id"/>
                        <field name="route_operation_id"/>
                        <field name="qty_ok"/>
                        <field name="qty_ng"/>
                        <field name="qty_scrap"/>
                    </list>
                </field>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate Drafts" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_piece_settlement_generate" model="ir.actions.act_window">
        <field name="name">Generate From Reports</field>
        <field name="res_model">sn.wsd.piece.settlement.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
