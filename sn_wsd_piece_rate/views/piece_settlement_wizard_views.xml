<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- report-daily-workbench: the former "Generate From Reports" wizard
         upgraded in place into the Daily Reporting workbench.
         report-daily-price-inline: single tab, price typed on the spot
         when unconfigured (created into the rate table at submit); the
         former To Allocate tab moved to the Operation Reports list.
         2026-11-01 master/detail, readonly selector edition (user pick):
         the list is a pure selector (readonly + no_open, the operation
         name is the link that picks the line); EVERYTHING is recorded in
         the detail panel below (quantities, price, team, participants
         with EXPLICIT ratio locks: locked rows keep their ratio, the
         rest equally splits the remainder; only the lock toggle / Equal
         Split / Fill From Team actions re-split). -->
    <record id="view_sn_wsd_piece_settlement_generate_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.piece.settlement.generate.wizard.form</field>
        <field name="model">sn.wsd.piece.settlement.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Reporting">
                <!-- statusbar buttons: a form <footer> only renders inside
                     dialogs, and a full page has no auto footer, so there
                     is exactly one submit affordance at the top -->
                <div class="o_form_statusbar_buttons">
                    <button name="action_submit_reports" type="object"
                            string="Submit Reports" class="btn-primary"/>
                </div>
                <group>
                    <group>
                        <field name="workshop_id" options="{'no_create': True}"/>
                        <field name="production_line_id" options="{'no_create': True}"
                               domain="[('workshop_id', '=', workshop_id)]"/>
                        <field name="mes_order_id" options="{'no_create': True}"
                               domain="[('x_manage_mode', '=', 'report'),
                                        ('state', 'in', ('released', 'picked', 'in_progress')),
                                        ('x_workshop_id', '=?', workshop_id),
                                        ('production_line_id', '=?', production_line_id)]"/>
                    </group>
                </group>
                <field name="report_line_ids">
                    <list create="false" edit="false" delete="false"
                          no_open="true">
                        <field name="sequence" widget="handle" column_invisible="1"/>
                        <field name="mes_order_id" readonly="1"
                               options="{'no_create': True}"/>
                        <!-- row selector: picks the line recorded in the
                             panel below (Odoo 19 cannot render a field as
                             button text in any list mode, so the pencil is
                             the shape it gives us) -->
                        <button name="action_select_line" type="object"
                                icon="oi-pencil" string="Edit Line"/>
                        <field name="route_operation_id" readonly="1"
                               options="{'no_create': True}"/>
                        <field name="planned_qty" optional="hide"/>
                        <field name="reported_qty"/>
                        <field name="remaining_qty"/>
                        <field name="sequence_locked" readonly="1"/>
                        <field name="piece_price" readonly="1"/>
                        <field name="participant_summary"/>
                        <field name="production_line_id" column_invisible="1"/>
                        <field name="workshop_id" column_invisible="1"/>
                        <field name="company_id" column_invisible="1"/>
                    </list>
                </field>
                <div invisible="active_line_id" class="text-muted p-2">
                    Click an operation above to record its batch below.
                </div>
                <!-- recording panel of the selected line -->
                <group name="line_editor" string="Editing Line"
                       invisible="not active_line_id">
                    <group>
                        <field name="active_line_id" readonly="1"
                               options="{'no_create': True}"/>
                        <field name="active_line_qty_ok"/>
                        <field name="active_line_qty_ng"/>
                        <field name="active_line_qty_scrap"/>
                        <field name="active_line_scrap_reason_id"
                               options="{'no_create': True}"
                               required="active_line_qty_scrap &gt; 0"/>
                    </group>
                    <group>
                        <field name="active_line_team_id"
                               options="{'no_create': True}"/>
                        <button name="action_active_fill_from_team"
                                type="object" string="Fill From Team"
                                class="btn-secondary"/>
                        <button name="action_active_equal_split"
                                type="object" string="Equal Split"
                                class="btn-secondary"/>
                        <field name="active_line_piece_price"
                               invisible="active_line_piece_price &lt;= 0"/>
                        <field name="active_line_new_price"
                               invisible="active_line_piece_price &gt; 0"
                               required="active_line_piece_price == 0"/>
                        <field name="active_line_ratio_total" readonly="1"/>
                    </group>
                    <field name="active_line_participant_ids"
                           widget="sn_wsd_x2many_multi_add"
                           options="{'multi_add_model': 'hr.employee',
                                     'multi_add_field': 'employee_id',
                                     'multi_add_domain': '[(&quot;company_id&quot;, &quot;=&quot;, company_id)]'}">
                        <list editable="bottom" create="true">
                            <field name="sequence" widget="handle"/>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="employee_code"/>
                            <field name="performance_ratio"/>
                            <field name="x_ratio_locked" widget="boolean_toggle"/>
                            <field name="line_id" column_invisible="1"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                </group>
                <!-- second submit affordance at the very bottom, next to
                     where the clerk finishes recording -->
                <div>
                    <button name="action_submit_reports" type="object"
                            string="Submit Reports" class="btn-primary"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_piece_settlement_generate" model="ir.actions.act_window">
        <field name="name">Daily Reporting</field>
        <field name="res_model">sn.wsd.piece.settlement.generate.wizard</field>
        <field name="view_mode">form</field>
    </record>

    <!-- Menu entry: create + preload the wizard server-side (target
         current, full page) so the lines are real records before the
         page renders. -->
    <record id="action_sn_wsd_daily_reporting_server" model="ir.actions.server">
        <field name="name">Daily Reporting</field>
        <field name="model_id"
               ref="sn_wsd_piece_rate.model_sn_wsd_piece_settlement_generate_wizard"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
wizard = env['sn.wsd.piece.settlement.generate.wizard'].create({})
wizard.action_reload_lines()
action_rec = env.ref('sn_wsd_piece_rate.action_sn_wsd_piece_settlement_generate')
action = {
    'type': 'ir.actions.act_window',
    'name': action_rec.name,
    'res_model': 'sn.wsd.piece.settlement.generate.wizard',
    'res_id': wizard.id,
    'view_mode': 'form',
    'target': 'current',
}
        ]]></field>
    </record>
</odoo>
