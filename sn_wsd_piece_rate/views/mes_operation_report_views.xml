<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 报工行列表：追加计件占用列 + 人员分配摘要（report-daily-workbench） -->
    <record id="view_sn_wsd_mes_operation_report_list_piece" model="ir.ui.view">
        <field name="name">sn.wsd.mes.operation.report.list.piece</field>
        <field name="model">sn.wsd.mes.operation.report</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_mes_operation_report_list"/>
        <field name="arch" type="xml">
            <field name="reported_by" position="before">
                <field name="x_piece_settled_label" widget="badge"
                       decoration-success="x_piece_settled"
                       decoration-muted="not x_piece_settled"
                       optional="show"/>
                <field name="x_piece_settled" column_invisible="1"/>
                <field name="participant_summary" optional="show"/>
                <field name="participant_count" string="Participants" optional="hide"/>
                <field name="team_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- 报工行搜索：未结算/已结算 + 待分配（未录参与人）过滤器 -->
    <record id="view_sn_wsd_mes_operation_report_search_piece" model="ir.ui.view">
        <field name="name">sn.wsd.mes.operation.report.search.piece</field>
        <field name="model">sn.wsd.mes.operation.report</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_mes_operation_report_search"/>
        <field name="arch" type="xml">
            <filter name="f_today" position="after">
                <filter name="f_piece_unsettled" string="Unsettled"
                        domain="[('x_piece_settled', '=', False)]"/>
                <filter name="f_piece_settled" string="Settled"
                        domain="[('x_piece_settled', '=', True)]"/>
                <separator string="Allocation"/>
                <filter name="f_pending_allocation" string="To Allocate"
                        domain="[('participant_ids', '=', False)]"/>
            </filter>
        </field>
    </record>

    <!-- 报工行表单：数量只读，人员分配可编辑（受确认冻结守卫约束）。
         行本身由 report_operation_qty 落库，表单仅承载分配的查看与修改。 -->
    <record id="view_sn_wsd_mes_operation_report_form_piece" model="ir.ui.view">
        <field name="name">sn.wsd.mes.operation.report.form.piece</field>
        <field name="model">sn.wsd.mes.operation.report</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_fill_from_team" type="object"
                            string="Fill From Team" class="btn-secondary"/>
                    <button name="action_equal_split" type="object"
                            string="Split Equally" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group name="source">
                            <field name="mes_order_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="route_operation_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="reported_by" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="counters">
                            <field name="reported_at" readonly="1"/>
                            <field name="qty_ok" readonly="1"/>
                            <field name="qty_ng" readonly="1"/>
                            <field name="qty_scrap" readonly="1"/>
                            <field name="x_piece_settled_label" readonly="1"/>
                            <field name="production_line_id" readonly="1" invisible="1"/>
                            <field name="team_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Participants" name="participants">
                            <field name="participant_ids"
                                   widget="sn_wsd_x2many_multi_add"
                                   options="{'multi_add_model': 'hr.employee',
                                             'multi_add_field': 'employee_id',
                                             'multi_add_domain': '[(&quot;company_id&quot;, &quot;=&quot;, company_id)]'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="employee_id"
                                           options="{'no_create': True}"/>
                                    <field name="employee_code"/>
                                    <field name="performance_ratio"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="participant_count"/>
                            </group>
                        </page>
                        <page string="Piece Settlements" name="settlements">
                            <field name="piece_settlement_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="qty_ok"/>
                                    <field name="amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 台账 action 追加表单视图（原 list-only） -->
    <record id="sn_wsd_mrp.action_sn_wsd_mes_operation_report" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>

    <!-- 残留批量补生成（report-daily-price-inline：原日报工「待分配」页签
         搬到台账列表，Action 菜单触发；关账月重开/终端行/作废重走同通道） -->
    <record id="action_sn_wsd_report_generate_settlement" model="ir.actions.server">
        <field name="name">Generate Piece Settlements</field>
        <field name="model_id"
               ref="sn_wsd_mrp.model_sn_wsd_mes_operation_report"/>
        <field name="binding_model_id"
               ref="sn_wsd_mrp.model_sn_wsd_mes_operation_report"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action = records.action_generate_piece_settlement()
        ]]></field>
    </record>
</odoo>
