<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 工资数字敏感：两组均需显式授予，不给 base.group_user 默认挂载。 -->
    <data noupdate="1">
        <record id="group_piece_rate_user" model="res.groups">
            <field name="name">Piece-rate User</field>
            <field name="implied_ids" eval="[Command.link(ref('mrp.group_mrp_user'))]"/>
        </record>

        <record id="group_piece_rate_manager" model="res.groups">
            <field name="name">Piece-rate Manager</field>
            <field name="implied_ids" eval="[Command.link(ref('sn_wsd_piece_rate.group_piece_rate_user'))]"/>
        </record>

        <record id="rule_sn_wsd_piece_rate_company" model="ir.rule">
            <field name="name">Piece rate company rule</field>
            <field name="model_id" ref="model_sn_wsd_piece_rate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_sn_wsd_piece_settlement_company" model="ir.rule">
            <field name="name">Piece settlement company rule</field>
            <field name="model_id" ref="model_sn_wsd_piece_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_sn_wsd_piece_settlement_participant_company" model="ir.rule">
            <field name="name">Piece settlement participant company rule</field>
            <field name="model_id" ref="model_sn_wsd_piece_settlement_participant"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_sn_wsd_piece_close_log_company" model="ir.rule">
            <field name="name">Piece close log company rule</field>
            <field name="model_id" ref="model_sn_wsd_piece_close_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
