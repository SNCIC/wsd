<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="defect_d01" model="sn.inj.defect">
            <field name="sequence">10</field>
            <field name="code">D01</field>
            <field name="name">缩水</field>
            <field name="category">appearance</field>
            <field name="cause">保压不足/冷却不够/壁厚不均</field>
            <field name="action">提高保压压力或时间、降低模温</field>
        </record>
        <record id="defect_d02" model="sn.inj.defect">
            <field name="sequence">20</field>
            <field name="code">D02</field>
            <field name="name">飞边（披锋）</field>
            <field name="category">appearance</field>
            <field name="cause">锁模力不足/分型面磨损/注射压力过高</field>
            <field name="action">降低注射压力、检查分型面、提高锁模力</field>
        </record>
        <record id="defect_d03" model="sn.inj.defect">
            <field name="sequence">30</field>
            <field name="code">D03</field>
            <field name="name">缺料（短射）</field>
            <field name="category">function</field>
            <field name="cause">料量不足/排气不良/料温偏低</field>
            <field name="action">增加计量、清理排气槽、提高料温</field>
        </record>
        <record id="defect_d04" model="sn.inj.defect">
            <field name="sequence">40</field>
            <field name="code">D04</field>
            <field name="name">银纹（料花）</field>
            <field name="category">appearance</field>
            <field name="cause">原料含水率高/料温过高</field>
            <field name="action">确认烘干批次、降低料温</field>
        </record>
        <record id="defect_d05" model="sn.inj.defect">
            <field name="sequence">50</field>
            <field name="code">D05</field>
            <field name="name">熔接线</field>
            <field name="category">appearance</field>
            <field name="cause">料流汇合温度低/排气不良</field>
            <field name="action">提高模温与射速、增加排气</field>
        </record>
        <record id="defect_d06" model="sn.inj.defect">
            <field name="sequence">60</field>
            <field name="code">D06</field>
            <field name="name">翘曲变形</field>
            <field name="category">dimension</field>
            <field name="cause">冷却不均/残余应力</field>
            <field name="action">调整动定模温差、延长冷却</field>
        </record>
        <record id="defect_d07" model="sn.inj.defect">
            <field name="sequence">70</field>
            <field name="code">D07</field>
            <field name="name">气泡</field>
            <field name="category">appearance</field>
            <field name="cause">保压不足/原料含水</field>
            <field name="action">提高保压、背压，确认烘干</field>
        </record>
        <record id="defect_d08" model="sn.inj.defect">
            <field name="sequence">80</field>
            <field name="code">D08</field>
            <field name="name">黑点（杂质）</field>
            <field name="category">appearance</field>
            <field name="cause">料筒积碳/水口料污染</field>
            <field name="action">清洗料筒、检查碎料批次</field>
        </record>
        <record id="defect_d09" model="sn.inj.defect">
            <field name="sequence">90</field>
            <field name="code">D09</field>
            <field name="name">烧焦</field>
            <field name="category">appearance</field>
            <field name="cause">排气不良/射速过快</field>
            <field name="action">降低末段射速、清理排气</field>
        </record>
        <record id="defect_d10" model="sn.inj.defect">
            <field name="sequence">100</field>
            <field name="code">D10</field>
            <field name="name">顶白（顶伤）</field>
            <field name="category">appearance</field>
            <field name="cause">顶出过快/脱模力大</field>
            <field name="action">降低顶出速度、抛光型腔</field>
        </record>
        <record id="defect_d11" model="sn.inj.defect">
            <field name="sequence">110</field>
            <field name="code">D11</field>
            <field name="name">拉伤（拖花）</field>
            <field name="category">appearance</field>
            <field name="cause">脱模斜度小/型腔磨损</field>
            <field name="action">模具保养抛光</field>
        </record>
        <record id="defect_d12" model="sn.inj.defect">
            <field name="sequence">120</field>
            <field name="code">D12</field>
            <field name="name">色差</field>
            <field name="category">appearance</field>
            <field name="cause">色母比例/混料不均</field>
            <field name="action">核对配色批次、延长混料</field>
        </record>
        <record id="defect_d13" model="sn.inj.defect">
            <field name="sequence">130</field>
            <field name="code">D13</field>
            <field name="name">尺寸超差</field>
            <field name="category">dimension</field>
            <field name="cause">保压/模温波动</field>
            <field name="action">按工艺卡复核参数、首件复测</field>
        </record>
        <record id="exception_category_inj_param" model="sn.wsd.exception.category">
            <field name="name">工艺参数超限</field>
            <field name="code">INJ-PARAM</field>
            <field name="sequence">60</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="default_team_id" ref="sn_wsd_exception.exception_team_quality"/>
            <field name="default_level">urgent</field>
            <field name="description">注塑逐模次参数超出标准工艺卡上下限，由数采接口自动生成。</field>
        </record>
    </data>
</odoo>
