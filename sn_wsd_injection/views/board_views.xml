<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sn_inj_board" model="ir.actions.client">
        <field name="name">注塑车间看板</field>
        <field name="tag">sn_inj_board</field>
        <field name="path">injection-board</field>
        <field name="target">fullscreen</field>
    </record>

    <template id="terminal_page" name="注塑机台工位屏">
        <html lang="zh-CN">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>工位屏 - <t t-esc="machine.code"/></title>
                <style>
                    body { margin:0; background:#0b1730; color:#dbe8ff; font-family: "PingFang SC","Microsoft YaHei","Noto Sans CJK SC",sans-serif; }
                    .top { display:flex; justify-content:space-between; align-items:center; padding:14px 24px; background:#0f2147; border-bottom:2px solid #00e5ff; }
                    .top h1 { margin:0; font-size:28px; color:#00e5ff; }
                    .tabs a { color:#9fb4d8; text-decoration:none; margin-left:12px; padding:4px 10px; border:1px solid #29456f; border-radius:4px; }
                    .tabs a.on { color:#0b1730; background:#00e5ff; }
                    .info { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; padding:16px 24px; }
                    .info div { background:#12284f; border-radius:6px; padding:10px 14px; }
                    .info b { display:block; color:#7f97bf; font-size:13px; font-weight:normal; }
                    .info span { font-size:20px; color:#fff; }
                    .grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; padding:0 24px 24px; }
                    table { width:100%; border-collapse:collapse; background:#10234a; border-radius:6px; overflow:hidden; }
                    th { background:#173262; color:#00e5ff; text-align:left; padding:7px 10px; font-size:15px; }
                    td { padding:6px 10px; border-top:1px solid #1d3766; font-size:15px; }
                    td.v { color:#fff; font-weight:bold; font-size:17px; text-align:right; }
                    td.w { color:#ffb020; text-align:right; }
                    .mon { color:#4dff9f; font-size:12px; margin-left:6px; }
                    .empty { padding:40px; text-align:center; color:#7f97bf; font-size:20px; }
                </style>
            </head>
            <body>
                <div class="top">
                    <h1><t t-esc="machine.code"/> <t t-esc="machine.name"/> · 标准工艺卡</h1>
                    <div class="tabs">
                        <t t-foreach="machines" t-as="m">
                            <a t-att-href="'/injection/terminal/%s' % m.code" t-att-class="'on' if m == machine else ''"><t t-esc="m.code"/></a>
                        </t>
                    </div>
                </div>
                <div class="info">
                    <div><b>在机模具</b><span><t t-esc="mold.sn or '—'"/> <t t-esc="mold.name or ''"/></span></div>
                    <div><b>当前工单 / 产品</b><span><t t-esc="plan.name or '—'"/> <t t-esc="plan.product_id.name or ''"/></span></div>
                    <div><b>工艺卡 / 版本</b><span><t t-esc="card.name if card else '—'"/> <t t-esc="card.version_label if card else ''"/></span></div>
                    <div><b>标准周期 / 有效穴数</b><span><t t-esc="card.std_cycle if card else '—'"/> s / <t t-esc="card.cavity if card else '—'"/></span></div>
                </div>
                <t t-if="card">
                    <div class="grid">
                        <t t-foreach="groups" t-as="g">
                            <table>
                                <tr><th colspan="4"><t t-esc="g['label']"/></th></tr>
                                <t t-foreach="g['lines']" t-as="l">
                                    <tr>
                                        <td><t t-esc="l.name"/><span t-if="l.monitored" class="mon">● 逐模监控</span></td>
                                        <td class="v"><t t-esc="'%g' % l.std_value"/> <t t-esc="l.unit"/></td>
                                        <td class="w"><t t-esc="l.window_text"/></td>
                                    </tr>
                                </t>
                            </table>
                        </t>
                    </div>
                </t>
                <div t-else="" class="empty">该机台当前没有生效的工艺卡</div>
            </body>
        </html>
    </template>
</odoo>
