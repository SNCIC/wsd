<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_inj_mold_list" model="ir.ui.view">
        <field name="name">sn.inj.mold.list</field>
        <field name="model">sn.inj.mold</field>
        <field name="arch" type="xml">
            <list string="模具台账" decoration-danger="warn_level == 'danger'" decoration-warning="warn_level == 'warn'"
                  decoration-muted="mold_state in ('sealed', 'scrapped')">
                <field name="sn" string="模具编号"/>
                <field name="name"/>
                <field name="product_names" string="产品"/>
                <field name="cavity_text" string="穴数"/>
                <field name="effective_cavity" string="有效穴" optional="hide"/>
                <field name="mold_state" widget="badge"
                       decoration-success="mold_state == 'on_machine'" decoration-info="mold_state == 'in_stock'"
                       decoration-warning="mold_state in ('maintaining', 'repairing')" decoration-muted="mold_state in ('sealed', 'scrapped')"/>
                <field name="machine_id"/>
                <field name="location_id" string="存放库位" optional="hide"/>
                <field name="total_usage_count" string="累计模次"/>
                <field name="maint_cycle" string="保养周期" optional="show"/>
                <field name="maint_remaining" string="距保养"/>
                <field name="maint_progress" widget="progressbar" string="保养进度"/>
                <field name="design_life" string="设计寿命" optional="show"/>
                <field name="life_progress" widget="progressbar" string="寿命进度"/>
                <field name="warn_text" string="预警" optional="show"/>
                <field name="warn_level" column_invisible="1"/>
                <field name="tonnage_min" optional="hide"/>
                <field name="tonnage_max" optional="hide"/>
                <field name="mold_supplier_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sn_inj_mold_form" model="ir.ui.view">
        <field name="name">sn.inj.mold.form</field>
        <field name="model">sn.inj.mold</field>
        <field name="arch" type="xml">
            <form string="模具">
                <header>
                    <button name="action_create_maint" type="object" string="发起保养" class="btn-primary"
                            invisible="mold_state in ('scrapped',)"/>
                    <button name="action_seal_mold" type="object" string="封存" invisible="mold_state != 'in_stock'"/>
                    <button name="action_unseal_mold" type="object" string="解除封存" invisible="mold_state != 'sealed'"/>
                    <field name="mold_state" widget="statusbar" statusbar_visible="in_stock,on_machine,maintaining"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_maint" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maint_task_count" widget="statinfo" string="保养任务"/>
                        </button>
                        <button name="action_view_changes" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="change_count" widget="statinfo" string="换模记录"/>
                        </button>
                        <button name="action_view_tooling_records" type="object" class="oe_stat_button" icon="fa-history"
                                string="工装履历"/>
                    </div>
                    <widget name="web_ribbon" title="接近寿命" bg_color="text-bg-danger" invisible="warn_level != 'danger'"/>
                    <widget name="web_ribbon" title="保养预警" bg_color="text-bg-warning" invisible="warn_level != 'warn'"/>
                    <field name="first_article_image" widget="image" class="oe_avatar" options="{'size': [180, 135]}"/>
                    <div class="oe_title">
                        <label for="sn" string="模具编号"/>
                        <h1><field name="sn" placeholder="MJ-..."/></h1>
                        <h3><field name="name" placeholder="模具名称"/></h3>
                    </div>
                    <group>
                        <group string="穴数与上机">
                            <field name="cavity_text" string="穴数结构"/>
                            <field name="effective_cavity"/>
                            <field name="machine_id" readonly="1"/>
                            <field name="location_id" string="存放库位"/>
                            <label for="tonnage_min" string="适用吨位(T)"/>
                            <div class="o_row">
                                <field name="tonnage_min" nolabel="1"/> <span>–</span> <field name="tonnage_max" nolabel="1"/>
                            </div>
                            <field name="std_cycle"/>
                            <field name="runner_weight"/>
                            <field name="template_id" invisible="1"/>
                        </group>
                        <group string="保养与寿命（按模次）">
                            <field name="cycle_usage_count" string="本周期模次" readonly="1"/>
                            <field name="maint_cycle"/>
                            <field name="maint_remaining"/>
                            <field name="maint_progress" widget="progressbar" string="保养进度"/>
                            <field name="total_usage_count" string="累计模次" readonly="1"/>
                            <field name="design_life"/>
                            <field name="life_progress" widget="progressbar" string="寿命进度"/>
                            <field name="warn_level" widget="badge" decoration-danger="warn_level == 'danger'"
                                   decoration-warning="warn_level == 'warn'" decoration-success="warn_level == 'normal'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="产品与穴数" name="products">
                            <field name="product_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="cavity_qty"/>
                                    <field name="sealed_qty"/>
                                    <field name="effective_qty"/>
                                    <field name="part_weight"/>
                                </list>
                            </field>
                        </page>
                        <page string="封穴记录" name="seals">
                            <field name="seal_ids">
                                <list editable="bottom" decoration-danger="is_active">
                                    <field name="cavity_no" width="60px"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="reason" width="300px"/>
                                    <field name="date_seal"/>
                                    <field name="date_unseal"/>
                                    <field name="user_id" width="110px"/>
                                    <field name="is_active" widget="boolean" width="70px"/>
                                    <button name="action_unseal" type="object" string="解封" icon="fa-unlock" invisible="not is_active"/>
                                </list>
                            </field>
                        </page>
                        <page string="保养任务" name="maint">
                            <field name="maint_task_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="level"/>
                                    <field name="trigger"/>
                                    <field name="shots_at_trigger"/>
                                    <field name="plan_date"/>
                                    <field name="date_done"/>
                                    <field name="user_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="模具档案" name="archive">
                            <group>
                                <group>
                                    <field name="mold_kind"/>
                                    <field name="design_cavity"/>
                                    <field name="sealed_cavity"/>
                                    <field name="grade_id"/>
                                    <field name="mold_supplier_id"/>
                                </group>
                                <group>
                                    <field name="steel"/>
                                    <field name="gate_type"/>
                                    <field name="mold_size"/>
                                    <field name="mold_weight"/>
                                    <field name="maint_remind"/>
                                    <field name="last_maintenance_date" string="上次保养" readonly="1"/>
                                    <field name="life_remaining"/>
                                </group>
                            </group>
                            <field name="note" placeholder="备注"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_inj_mold_search" model="ir.ui.view">
        <field name="name">sn.inj.mold.search</field>
        <field name="model">sn.inj.mold</field>
        <field name="arch" type="xml">
            <search>
                <field name="sn" string="模具编号"/>
                <field name="name"/>
                <field name="product_ids" string="产品"/>
                <field name="machine_id"/>
                <filter name="on_machine" string="在机" domain="[('mold_state', '=', 'on_machine')]"/>
                <filter name="in_stock" string="在库" domain="[('mold_state', '=', 'in_stock')]"/>
                <filter name="maint" string="保养/维修中" domain="[('mold_state', 'in', ('maintaining', 'repairing'))]"/>
                <separator/>
                <filter name="warn" string="预警" domain="[('warn_level', '!=', 'normal')]"/>
                <filter name="sealed_cav" string="有封穴" domain="[('sealed_cavity', '>', 0)]"/>
                <group>
                    <filter name="g_state" string="模具状态" context="{'group_by': 'mold_state'}"/>
                    <filter name="g_machine" string="机台" context="{'group_by': 'machine_id'}"/>
                    <filter name="g_warn" string="预警等级" context="{'group_by': 'warn_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_inj_mold_kanban" model="ir.ui.view">
        <field name="name">sn.inj.mold.kanban</field>
        <field name="model">sn.inj.mold</field>
        <field name="arch" type="xml">
            <kanban default_group_by="mold_state" class="o_kanban_small_column">
                <field name="warn_level"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="sn" class="fw-bold"/>
                            <field name="warn_level" widget="badge" decoration-danger="warn_level == 'danger'" decoration-warning="warn_level == 'warn'"/>
                        </div>
                        <field name="name"/>
                        <div class="text-muted"><field name="product_names"/></div>
                        <div>穴数 <field name="cavity_text"/> · <field name="machine_id"/></div>
                        <field name="maint_progress" widget="progressbar"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_sn_inj_mold" model="ir.actions.act_window">
        <field name="name">模具台账</field>
        <field name="res_model">sn.inj.mold</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- 保养任务 -->
    <record id="view_sn_inj_mold_maint_list" model="ir.ui.view">
        <field name="name">sn.inj.mold.maint.list</field>
        <field name="model">sn.inj.mold.maint</field>
        <field name="arch" type="xml">
            <list string="模具保养任务" decoration-info="state == 'todo'" decoration-warning="state == 'doing'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="mold_id"/>
                <field name="machine_id"/>
                <field name="level"/>
                <field name="trigger"/>
                <field name="shots_at_trigger"/>
                <field name="maint_cycle"/>
                <field name="plan_date"/>
                <field name="date_start"/>
                <field name="date_done"/>
                <field name="hours" sum="合计"/>
                <field name="user_id"/>
                <field name="state" widget="badge" decoration-info="state == 'todo'" decoration-warning="state == 'doing'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_sn_inj_mold_maint_kanban" model="ir.ui.view">
        <field name="name">sn.inj.mold.maint.kanban</field>
        <field name="model">sn.inj.mold.maint</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="level" widget="badge"/>
                        </div>
                        <field name="mold_id" class="fw-bold text-primary"/>
                        <div class="text-muted small">触发：<field name="trigger"/> · 周期模次 <field name="shots_at_trigger"/> / <field name="maint_cycle"/></div>
                        <div class="small">计划 <field name="plan_date"/> · <field name="user_id"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sn_inj_mold_maint_form" model="ir.ui.view">
        <field name="name">sn.inj.mold.maint.form</field>
        <field name="model">sn.inj.mold.maint</field>
        <field name="arch" type="xml">
            <form string="模具保养任务">
                <header>
                    <button name="action_start" type="object" string="开始保养" class="btn-primary" invisible="state != 'todo'"/>
                    <button name="action_done" type="object" string="保养完成" class="btn-primary" invisible="state != 'doing'"/>
                    <button name="action_cancel" type="object" string="取消" invisible="state != 'todo'"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,doing,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="mold_id"/>
                            <field name="machine_id"/>
                            <field name="level"/>
                            <field name="trigger"/>
                            <field name="shots_at_trigger"/>
                            <field name="maint_cycle"/>
                        </group>
                        <group>
                            <field name="plan_date"/>
                            <field name="user_id"/>
                            <field name="date_start"/>
                            <field name="date_done"/>
                            <field name="hours"/>
                            <field name="cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="保养项目">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="result"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="保养记录"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sn_inj_mold_maint" model="ir.actions.act_window">
        <field name="name">模具保养任务</field>
        <field name="res_model">sn.inj.mold.maint</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
