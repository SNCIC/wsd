<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_inj_report_list" model="ir.ui.view">
        <field name="name">sn.inj.report.list</field>
        <field name="model">sn.inj.report</field>
        <field name="arch" type="xml">
            <list string="模次报工">
                <field name="name"/>
                <field name="date"/>
                <field name="shift"/>
                <field name="machine_id"/>
                <field name="mold_id"/>
                <field name="product_id"/>
                <field name="operator_id" optional="show"/>
                <field name="counter_start" optional="hide"/>
                <field name="counter_end" optional="hide"/>
                <field name="shots" sum="合计"/>
                <field name="total_qty" sum="合计"/>
                <field name="defect_qty" sum="合计"/>
                <field name="good_qty" sum="合计"/>
                <field name="yield_rate"/>
                <field name="actual_cycle" optional="show"/>
                <field name="std_cycle" optional="show"/>
                <field name="oee" widget="progressbar"/>
                <field name="regrind_kg" sum="合计" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_sn_inj_report_form" model="ir.ui.view">
        <field name="name">sn.inj.report.form</field>
        <field name="model">sn.inj.report</field>
        <field name="arch" type="xml">
            <form string="模次报工">
                <header>
                    <button name="action_done" type="object" string="确认报工" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="班次与机台">
                            <field name="date"/>
                            <field name="shift"/>
                            <field name="machine_id"/>
                            <field name="mold_id"/>
                            <field name="plan_id" context="{'inj_plan_short': 1}"/>
                            <field name="product_id"/>
                            <field name="operator_id"/>
                            <field name="report_time"/>
                        </group>
                        <group string="模次与产出">
                            <field name="counter_start"/>
                            <field name="counter_end"/>
                            <field name="shots"/>
                            <field name="total_qty"/>
                            <field name="defect_qty"/>
                            <field name="good_qty"/>
                            <field name="yield_rate"/>
                            <field name="regrind_kg"/>
                        </group>
                    </group>
                    <group string="OEE（时间开动率 × 性能开动率 × 合格品率）">
                        <group>
                            <field name="planned_minutes"/>
                            <field name="downtime_minutes"/>
                            <field name="run_minutes"/>
                            <field name="std_cycle"/>
                            <field name="actual_cycle"/>
                        </group>
                        <group>
                            <field name="availability" widget="progressbar"/>
                            <field name="performance" widget="progressbar"/>
                            <field name="quality_rate" widget="progressbar"/>
                            <field name="oee" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="产品明细（模次 × 有效穴数）">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="plan_id" context="{'inj_plan_short': 1}"/>
                                    <field name="cavity"/>
                                    <field name="total_qty"/>
                                    <field name="defect_qty"/>
                                    <field name="good_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="不良明细（缺陷代码）">
                            <field name="defect_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="defect_id"/>
                                    <field name="category"/>
                                    <field name="qty" sum="合计"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="note" placeholder="备注"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_inj_report_pivot" model="ir.ui.view">
        <field name="name">sn.inj.report.pivot</field>
        <field name="model">sn.inj.report</field>
        <field name="arch" type="xml">
            <pivot string="模次按班次统计">
                <field name="machine_id" type="row"/>
                <field name="date" type="col" interval="day"/>
                <field name="shift" type="col"/>
                <field name="shots" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_sn_inj_report_graph" model="ir.ui.view">
        <field name="name">sn.inj.report.graph</field>
        <field name="model">sn.inj.report</field>
        <field name="arch" type="xml">
            <graph string="产出趋势" type="bar" stacked="1">
                <field name="date" interval="day"/>
                <field name="shift"/>
                <field name="good_qty" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_sn_inj_report_search" model="ir.ui.view">
        <field name="name">sn.inj.report.search</field>
        <field name="model">sn.inj.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="machine_id"/>
                <field name="mold_id"/>
                <field name="product_id"/>
                <filter name="day" string="白班" domain="[('shift', '=', 'day')]"/>
                <filter name="night" string="夜班" domain="[('shift', '=', 'night')]"/>
                <group>
                    <filter name="g_machine" string="机台" context="{'group_by': 'machine_id'}"/>
                    <filter name="g_date" string="日期" context="{'group_by': 'date'}"/>
                    <filter name="g_shift" string="班次" context="{'group_by': 'shift'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sn_inj_report" model="ir.actions.act_window">
        <field name="name">模次报工</field>
        <field name="res_model">sn.inj.report</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
    <record id="action_sn_inj_report_shift" model="ir.actions.act_window">
        <field name="name">模次按班次统计</field>
        <field name="res_model">sn.inj.report</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
    </record>

    <record id="view_sn_inj_report_defect_graph" model="ir.ui.view">
        <field name="name">sn.inj.report.defect.graph</field>
        <field name="model">sn.inj.report.defect</field>
        <field name="arch" type="xml">
            <graph string="缺陷排列" type="bar" order="desc">
                <field name="defect_id"/>
                <field name="qty" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_sn_inj_report_defect_list" model="ir.ui.view">
        <field name="name">sn.inj.report.defect.list</field>
        <field name="model">sn.inj.report.defect</field>
        <field name="arch" type="xml">
            <list string="不良明细">
                <field name="date"/>
                <field name="report_id"/>
                <field name="machine_id"/>
                <field name="mold_id"/>
                <field name="product_id"/>
                <field name="defect_id"/>
                <field name="category"/>
                <field name="qty" sum="合计"/>
            </list>
        </field>
    </record>
    <record id="action_sn_inj_defect_analysis" model="ir.actions.act_window">
        <field name="name">缺陷分析</field>
        <field name="res_model">sn.inj.report.defect</field>
        <field name="view_mode">graph,list</field>
    </record>

    <record id="view_sn_inj_defect_list" model="ir.ui.view">
        <field name="name">sn.inj.defect.list</field>
        <field name="model">sn.inj.defect</field>
        <field name="arch" type="xml">
            <list string="缺陷代码" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="cause"/>
                <field name="action"/>
            </list>
        </field>
    </record>
    <record id="action_sn_inj_defect" model="ir.actions.act_window">
        <field name="name">缺陷代码</field>
        <field name="res_model">sn.inj.defect</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
