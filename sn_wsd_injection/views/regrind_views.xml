<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_inj_regrind_list" model="ir.ui.view">
        <field name="name">sn.inj.regrind.list</field>
        <field name="model">sn.inj.regrind</field>
        <field name="arch" type="xml">
            <list string="水口料台账">
                <field name="name"/>
                <field name="move_time"/>
                <field name="move_type" widget="badge" decoration-info="move_type == 'generate'" decoration-success="move_type == 'crush'"
                       decoration-warning="move_type == 'reuse'" decoration-muted="move_type == 'scrap'"/>
                <field name="grade_id"/>
                <field name="color_no" optional="show"/>
                <field name="machine_id"/>
                <field name="report_id" optional="show"/>
                <field name="mix_id" optional="show"/>
                <field name="lot_no"/>
                <field name="qty_kg" sum="合计"/>
                <field name="pending_delta" sum="合计" optional="show"/>
                <field name="stock_delta" sum="合计" optional="show"/>
                <field name="operator_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_sn_inj_regrind_form" model="ir.ui.view">
        <field name="name">sn.inj.regrind.form</field>
        <field name="model">sn.inj.regrind</field>
        <field name="arch" type="xml">
            <form string="水口料">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="move_type"/>
                            <field name="move_time"/>
                            <field name="grade_id"/>
                            <field name="color_no"/>
                        </group>
                        <group>
                            <field name="machine_id"/>
                            <field name="lot_no"/>
                            <field name="qty_kg"/>
                            <field name="report_id"/>
                            <field name="mix_id"/>
                            <field name="operator_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sn_inj_regrind_pivot" model="ir.ui.view">
        <field name="name">sn.inj.regrind.pivot</field>
        <field name="model">sn.inj.regrind</field>
        <field name="arch" type="xml">
            <pivot string="水口料平衡">
                <field name="grade_id" type="row"/>
                <field name="move_type" type="col"/>
                <field name="qty_kg" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_sn_inj_regrind_search" model="ir.ui.view">
        <field name="name">sn.inj.regrind.search</field>
        <field name="model">sn.inj.regrind</field>
        <field name="arch" type="xml">
            <search>
                <field name="grade_id"/>
                <field name="lot_no"/>
                <filter name="gen" string="产生" domain="[('move_type', '=', 'generate')]"/>
                <filter name="crush" string="粉碎入库" domain="[('move_type', '=', 'crush')]"/>
                <filter name="reuse" string="回用投料" domain="[('move_type', '=', 'reuse')]"/>
                <group>
                    <filter name="g_grade" string="料种" context="{'group_by': 'grade_id'}"/>
                    <filter name="g_type" string="业务类型" context="{'group_by': 'move_type'}"/>
                    <filter name="g_date" string="日期" context="{'group_by': 'move_date'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sn_inj_regrind" model="ir.actions.act_window">
        <field name="name">水口料台账</field>
        <field name="res_model">sn.inj.regrind</field>
        <field name="view_mode">list,pivot,form</field>
    </record>

    <record id="view_sn_inj_mix_list" model="ir.ui.view">
        <field name="name">sn.inj.mix.list</field>
        <field name="model">sn.inj.mix</field>
        <field name="arch" type="xml">
            <list string="投料配料单" decoration-danger="over_limit or state == 'blocked'">
                <field name="name" width="110px"/>
                <field name="mix_time"/>
                <field name="machine_id" width="105px"/>
                <field name="plan_id" context="{'inj_plan_short': 1}" optional="hide"/>
                <field name="product_id" width="140px"/>
                <field name="grade_id" width="120px"/>
                <field name="drying_id" width="110px"/>
                <field name="virgin_kg" sum="合计"/>
                <field name="regrind_kg" sum="合计"/>
                <field name="regrind_pct"/>
                <field name="limit_pct"/>
                <field name="over_limit" string="超限" widget="boolean" width="50px"/>
                <field name="block_reason" optional="show" width="260px"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'blocked'"/>
            </list>
        </field>
    </record>
    <record id="view_sn_inj_mix_form" model="ir.ui.view">
        <field name="name">sn.inj.mix.form</field>
        <field name="model">sn.inj.mix</field>
        <field name="arch" type="xml">
            <form string="投料配料单">
                <header>
                    <button name="action_confirm" type="object" string="确认投料" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="mix_time"/>
                            <field name="machine_id"/>
                            <field name="plan_id"/>
                            <field name="product_id"/>
                            <field name="grade_id"/>
                            <field name="drying_id"/>
                            <field name="color_batch_id"/>
                            <field name="operator_id"/>
                        </group>
                        <group>
                            <field name="virgin_kg"/>
                            <field name="regrind_kg"/>
                            <field name="regrind_lot"/>
                            <field name="total_kg"/>
                            <field name="regrind_pct"/>
                            <field name="limit_pct"/>
                            <field name="over_limit"/>
                            <field name="block_reason"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_sn_inj_mix" model="ir.actions.act_window">
        <field name="name">投料配料单</field>
        <field name="res_model">sn.inj.mix</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
