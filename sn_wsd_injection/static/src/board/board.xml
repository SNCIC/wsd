<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sn_wsd_injection.InjBoard">
        <div class="o_inj_board">
            <div class="o_inj_head">
                <div class="o_inj_title">注塑车间机台看板</div>
                <div class="o_inj_sub">烟台东方威思顿 · 注塑车间　|　<t t-esc="d.shift"/>　|　<t t-esc="d.now"/></div>
            </div>
            <div class="o_inj_kpis">
                <div class="o_inj_kpi"><span>开机率</span><b><t t-esc="d.summary.running"/>/<t t-esc="d.summary.machines"/></b><i>运行机台</i></div>
                <div class="o_inj_kpi"><span>近 24h 产出</span><b><t t-esc="fmt(d.summary.total)"/></b><i>良品 <t t-esc="fmt(d.summary.good)"/></i></div>
                <div class="o_inj_kpi"><span>良率</span><b><t t-esc="d.summary.yield"/>%</b><i>模次 × 有效穴数口径</i></div>
                <div class="o_inj_kpi"><span>综合 OEE</span><b t-att-class="oeeClass(d.summary.oee)"><t t-esc="d.summary.oee"/>%</b><i>近 24h 加权</i></div>
                <div class="o_inj_kpi"><span>近 7 天换模</span><b><t t-esc="d.summary.changes_7d"/> 次</b><i>平均 <t t-esc="d.summary.avg_change"/> 分钟</i></div>
                <div class="o_inj_kpi"><span>模具预警</span><b class="o_inj_warn"><t t-esc="d.summary.mold_warn"/> 套</b><i>保养/寿命</i></div>
                <div class="o_inj_kpi"><span>参数超限</span><b class="o_inj_bad"><t t-esc="d.summary.out_24h"/></b><i>近 24h 模次</i></div>
            </div>
            <div class="o_inj_body">
                <div class="o_inj_grid">
                    <t t-foreach="d.machines" t-as="m" t-key="m.id">
                        <div t-attf-class="o_inj_card #{stateClass(m)}" t-on-click="() => this.openMachine(m)">
                            <div class="o_inj_card_top">
                                <div><b class="o_inj_code"><t t-esc="m.code"/></b> <span class="o_inj_ton"><t t-esc="m.brand"/> <t t-esc="m.tonnage"/>T</span></div>
                                <div class="o_inj_badge"><t t-esc="m.state_label"/><small t-if="m.state_minutes"> <t t-esc="dur(m.state_minutes)"/></small></div>
                            </div>
                            <div class="o_inj_mold">
                                <span class="o_inj_lbl">模具</span> <t t-esc="m.mold or '—'"/> <small>(<t t-esc="m.cavity"/>)</small>
                                <span t-if="m.mold_warn != 'normal'" t-attf-class="o_inj_mw o_inj_mw_#{m.mold_warn}"><t t-esc="m.mold_warn_text"/></span>
                            </div>
                            <div class="o_inj_prod"><span class="o_inj_lbl">产品</span> <t t-esc="m.product or '—'"/></div>
                            <div class="o_inj_prod"><span class="o_inj_lbl"><t t-esc="m.next_plan ? '待产' : '工单'"/></span> <t t-esc="m.plan or '—'"/>
                                <span class="o_inj_op" t-if="m.operator">· <t t-esc="m.operator"/></span></div>
                            <div class="o_inj_note" t-if="m.state_note"><t t-esc="m.state_note"/></div>
                            <div class="o_inj_metrics">
                                <div><span>周期 s</span><b t-att-class="devClass(m)"><t t-esc="m.cycle"/></b><i>标 <t t-esc="m.std_cycle"/> / <t t-esc="m.cycle_dev &gt; 0 ? '+' : ''"/><t t-esc="m.cycle_dev"/>%</i></div>
                                <div><span>达成率</span><b><t t-esc="m.progress"/>%</b><i><t t-esc="fmt(m.good)"/>/<t t-esc="fmt(m.plan_qty)"/></i></div>
                                <div><span>OEE</span><b t-att-class="oeeClass(m.oee)"><t t-esc="m.oee"/>%</b><i>超限 <t t-esc="m.out_24h"/></i></div>
                            </div>
                            <div class="o_inj_bar"><div t-attf-style="width:#{m.progress}%"/></div>
                            <div class="o_inj_spark">
                                <div class="o_inj_spark_t"><span>近 30 模周期趋势</span><span>本班良品 <b><t t-esc="fmt(m.shift_good)"/></b></span></div>
                                <t t-set="sp" t-value="spark(m)"/>
                                <svg viewBox="0 -4 260 46" preserveAspectRatio="none">
                                    <line x1="0" x2="260" t-att-y1="sp.std" t-att-y2="sp.std" class="o_inj_spark_std"/>
                                    <polyline t-att-points="sp.line" class="o_inj_spark_line"/>
                                    <t t-foreach="sp.dots" t-as="dt" t-key="dt_index">
                                        <circle t-att-cx="dt.x" t-att-cy="dt.y" r="3" class="o_inj_spark_out"/>
                                    </t>
                                </svg>
                            </div>
                            <div class="o_inj_maint">
                                <span>模具保养</span><div class="o_inj_mbar"><div t-attf-class="#{m.maint_pct &gt;= 90 ? 'o_inj_mbar_w' : ''}" t-attf-style="width:#{m.maint_pct}%"/></div><b><t t-esc="m.maint_pct"/>%</b>
                                <span>寿命</span><div class="o_inj_mbar"><div t-attf-class="#{m.life_pct &gt;= 95 ? 'o_inj_mbar_d' : ''}" t-attf-style="width:#{m.life_pct}%"/></div><b><t t-esc="m.life_pct"/>%</b>
                            </div>
                        </div>
                    </t>
                </div>
                <div class="o_inj_side">
                    <div class="o_inj_panel">
                        <div class="o_inj_ptitle">机台状态分布</div>
                        <div class="o_inj_states">
                            <t t-foreach="d.states" t-as="s" t-key="s.key">
                                <div t-attf-class="o_inj_sdot o_inj_st_#{s.key}"><i/><t t-esc="s.label"/> <b><t t-esc="s.count"/></b></div>
                            </t>
                        </div>
                    </div>
                    <div class="o_inj_panel">
                        <div class="o_inj_ptitle">近 7 天缺陷 TOP</div>
                        <t t-foreach="d.defects" t-as="x" t-key="x_index">
                            <div class="o_inj_drow"><span><t t-esc="x.name"/></span><div class="o_inj_dbar"><div t-att-style="defectWidth(x.qty)"/></div><b><t t-esc="fmt(x.qty)"/></b></div>
                        </t>
                    </div>
                    <div class="o_inj_panel o_inj_alerts">
                        <div class="o_inj_ptitle">实时告警</div>
                        <t t-foreach="d.alerts" t-as="a" t-key="a_index">
                            <div t-attf-class="o_inj_alert o_inj_al_#{a.level}"><small t-if="a.time"><t t-esc="a.time"/></small> <t t-esc="a.text"/></div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
