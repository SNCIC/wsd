<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sn_wsd_injection.InjSpc">
        <div class="o_inj_spc h-100 overflow-auto bg-view">
            <div class="o_inj_spc_bar d-flex align-items-center gap-3 px-4 py-2 border-bottom">
                <h4 class="m-0 me-3">SPC 控制图（X̄-R）</h4>
                <label class="m-0">机台</label>
                <select class="form-select form-select-sm w-auto" t-on-change="(ev) => this.onChange(ev, 'machine')">
                    <t t-foreach="state.options.machines" t-as="m" t-key="m.id">
                        <option t-att-value="m.id" t-att-selected="m.id === state.machine"><t t-esc="m.name"/></option>
                    </t>
                </select>
                <label class="m-0">参数</label>
                <select class="form-select form-select-sm w-auto" t-on-change="(ev) => this.onChange(ev, 'param')">
                    <t t-foreach="state.options.params" t-as="p" t-key="p.key">
                        <option t-att-value="p.key" t-att-selected="p.key === state.param"><t t-esc="p.label"/></option>
                    </t>
                </select>
                <label class="m-0">子组容量</label>
                <select class="form-select form-select-sm w-auto" t-on-change="(ev) => this.onChange(ev, 'n')">
                    <t t-foreach="[3,4,5,6]" t-as="k" t-key="k">
                        <option t-att-value="k" t-att-selected="k === state.n"><t t-esc="k"/></option>
                    </t>
                </select>
            </div>
            <t t-set="d" t-value="state.data"/>
            <div t-if="d" class="px-4 pt-3">
                <div class="d-flex flex-wrap gap-2 mb-2 small text-muted">
                    <span>模具：<b class="text-body"><t t-esc="d.mold"/></b></span>
                    <span>｜产品：<b class="text-body"><t t-esc="d.product"/></b></span>
                    <span>｜工艺卡：<b class="text-body"><t t-esc="d.card"/></b></span>
                    <span>｜样本：<b class="text-body"><t t-esc="d.count"/></b> 模（<t t-esc="d.means.length"/> 组 × <t t-esc="d.n"/>）</span>
                </div>
                <div class="o_inj_spc_stats d-grid gap-2 mb-3">
                    <div class="card p-2"><small class="text-muted">标准值 / 工艺窗口</small><b><t t-esc="d.target"/></b><small><t t-esc="d.lsl"/> ~ <t t-esc="d.usl"/> <t t-esc="d.unit"/></small></div>
                    <div class="card p-2"><small class="text-muted">过程均值 X̄̄</small><b><t t-esc="d.cl"/></b><small>σ(R̄/d₂) = <t t-esc="d.sigma"/></small></div>
                    <div class="card p-2"><small class="text-muted">控制限 UCL / LCL</small><b><t t-esc="d.ucl"/> / <t t-esc="d.lcl"/></b><small>R̄ = <t t-esc="d.rbar"/></small></div>
                    <div class="card p-2"><small class="text-muted">Cp</small><b t-att-class="capClass(d.cp)"><t t-esc="d.cp ?? '—'"/></b><small>潜在能力</small></div>
                    <div class="card p-2"><small class="text-muted">Cpk</small><b t-att-class="capClass(d.cpk)"><t t-esc="d.cpk ?? '—'"/></b><small>≥1.33 充足</small></div>
                    <div class="card p-2"><small class="text-muted">Ppk</small><b t-att-class="capClass(d.ppk)"><t t-esc="d.ppk ?? '—'"/></b><small>整体性能</small></div>
                    <div class="card p-2"><small class="text-muted">失控子组 / 超规格模次</small><b class="text-danger"><t t-esc="(d.ooc || []).length"/> / <t t-esc="d.out_spec"/></b><small>判异：超出控制限</small></div>
                </div>
                <div class="card p-2 mb-3" style="height:380px"><canvas t-ref="xchart"/></div>
                <div class="card p-2 mb-3" style="height:290px"><canvas t-ref="rchart"/></div>
            </div>
        </div>
    </t>
</templates>
