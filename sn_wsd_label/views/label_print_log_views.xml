<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_label_print_log_list" model="ir.ui.view">
        <field name="name">sn.label.print.log.list</field>
        <field name="model">sn.label.print.log</field>
        <field name="arch" type="xml">
            <list string="Print Logs">
                <field name="create_date"/>
                <field name="template_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="copies"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sn_label_print_log_form" model="ir.ui.view">
        <field name="name">sn.label.print.log.form</field>
        <field name="model">sn.label.print.log</field>
        <field name="arch" type="xml">
            <form string="Print Log">
                <group>
                    <group>
                        <field name="template_id" readonly="1"/>
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="copies" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sn_label_print_log_search" model="ir.ui.view">
        <field name="name">sn.label.print.log.search</field>
        <field name="model">sn.label.print.log</field>
        <field name="arch" type="xml">
            <search string="Print Logs">
                <field name="template_id"/>
                <field name="res_model"/>
                <field name="user_id"/>
                <filter string="Today" name="filter_today"
                        domain="[('create_date', '&gt;=', 'today'), ('create_date', '&lt;', 'tomorrow')]"/>
                <group>
                    <filter string="Template" name="group_template"
                            context="{'group_by': 'template_id'}"/>
                    <filter string="Model" name="group_model"
                            context="{'group_by': 'res_model'}"/>
                    <filter string="User" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Printed on" name="group_print_date"
                            context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_label_print_log" model="ir.actions.act_window">
        <field name="name">Print Logs</field>
        <field name="res_model">sn.label.print.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_label_print_logs" name="Print Logs" sequence="20"
              parent="menu_label_center" action="action_sn_label_print_log"/>
</odoo>
