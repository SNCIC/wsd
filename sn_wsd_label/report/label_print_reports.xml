<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_label_zpl" model="ir.actions.report">
        <field name="name">Label ZPL</field>
        <field name="model">sn.label.print.wizard</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">sn_wsd_label.report_label_zpl</field>
        <field name="print_report_name">'Label ZPL'</field>
    </record>

    <!-- QWeb shell only: the wizard rendered the ZPL server-side, the
         report outputs it verbatim (ZPL '^' needs no XML escaping). -->
    <template id="report_label_zpl">
        <t t-foreach="docs" t-as="doc"><t t-translation="off"><t t-out="doc.zpl_data"/></t></t>
    </template>
</odoo>
