<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_form_sn_wsd_skip" model="ir.ui.view">
        <field name="name">mrp.workorder.form.sn.wsd.skip</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_mrp_workorder_form_sn_wsd_mrp"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_skip_requests" icon="fa-random">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="x_skip_request_count"/></span>
                        <span class="o_stat_text">Skip Requests</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='x_meter_qty_pass']" position="after">
                <field name="x_skip_effective" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
