<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_dingding_user" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sn.wsd.ding.user</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="DingTalk" string="DingTalk" name="sn_wsd_ding" groups="base.group_system">
                        <block title="DingTalk" name="sn_wsd_ding_block">
                            <setting id="sn_wsd_ding_setting" string="User ID Lookup" help="Fetch DingTalk userid by mobile/phone.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="dingding_app_key" class="col-lg-3 o_light_label"/>
                                        <field name="dingding_app_key" placeholder="dingxxxx"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dingding_app_secret" class="col-lg-3 o_light_label"/>
                                        <field name="dingding_app_secret" password="True" placeholder="xxxx"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dingding_app_uuid" class="col-lg-3 o_light_label"/>
                                        <field name="dingding_app_uuid" placeholder="appUuid"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dingding_agent_id" class="col-lg-3 o_light_label"/>
                                        <field name="dingding_agent_id" placeholder="123456"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dingding_callback_token" class="col-lg-3 o_light_label"/>
                                        <field name="dingding_callback_token" placeholder="token"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="dingding_callback_aes_key" class="col-lg-3 o_light_label"/>
                                        <field name="dingding_callback_aes_key" placeholder="aes_key"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
