<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_purchase_detail_list" model="ir.ui.view">
        <field name="name">purchase.request.line.purchase.detail.list</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <list string="Purchase Details" create="false" delete="false">
                <field name="request_id"/>
                <field name="create_user_id"/>
                <field name="request_state" widget="badge"
                       decoration-success="request_state in ('approved', 'in_progress', 'done')"
                       decoration-warning="request_state == 'to_approve'"
                       decoration-danger="request_state == 'rejected'"/>
                <field name="date_required"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="material_specification"/>
                <field name="requested_qty"/>
                <field name="approved_qty" readonly="request_state not in ['draft', 'to_approve']"/>
                <field name="purchased_qty"/>
                <field name="received_qty"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="purchase_order_ids" widget="many2many_tags"/>
                <field name="expected_arrival_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sn_purchase_detail_form" model="ir.ui.view">
        <field name="name">purchase.request.line.purchase.detail.form</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <form string="Purchase Detail" create="false" duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="create_user_id"/>
                            <field name="date_required"/>
                            <field name="request_state"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_code"/>
                            <field name="product_name"/>
                            <field name="material_specification"/>
                        </group>
                    </group>
                    <group string="Quantities">
                        <field name="product_uom_id"/>
                        <field name="requested_qty"/>
                        <field name="approved_qty" readonly="request_state not in ['draft', 'to_approve']"/>
                        <field name="purchased_qty"/>
                        <field name="received_qty"/>
                    </group>
                    <group string="Purchasing">
                        <field name="purchase_order_ids" widget="many2many_tags"/>
                        <field name="purchase_state"/>
                        <field name="expected_arrival_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_purchase_detail_search" model="ir.ui.view">
        <field name="name">purchase.request.line.purchase.detail.search</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <search string="Purchase Details">
                <field name="request_id"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="material_specification"/>
                <field name="date_required"/>
                <field name="request_state"/>
                <field name="purchase_state"/>
                <separator/>
                <filter name="receipt_status_not_received"
                        string="Not Received"
                        domain="[('receipt_status', '=', 'not_received')]"/>
                <filter name="receipt_status_partially_received"
                        string="Partially Received"
                        domain="[('receipt_status', '=', 'partially_received')]"/>
                <filter name="receipt_status_fully_received"
                        string="Fully Received"
                        domain="[('receipt_status', '=', 'fully_received')]"/>
                <group>
                    <filter name="group_request" string="Request" context="{'group_by': 'request_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_request_state" string="Data Status" context="{'group_by': 'request_state'}"/>
                    <filter name="group_purchase_state" string="Purchase Status" context="{'group_by': 'purchase_state'}"/>
                    <filter name="group_purchase_order" string="Purchase Order" context="{'group_by': 'purchase_order_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_purchase_detail" model="ir.actions.act_window">
        <field name="name">Purchase Details</field>
        <field name="res_model">purchase.request.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sn_purchase_detail_list"/>
        <field name="search_view_id" ref="view_sn_purchase_detail_search"/>
    </record>

    <menuitem id="menu_sn_purchase_detail"
              name="Purchase Details"
              parent="purchase.menu_procurement_management"
              action="action_sn_purchase_detail"
              sequence="7"/>
</odoo>
