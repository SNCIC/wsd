<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchase_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sn_wsd_purchase.report_purchase_contract_document"/>
            </t>
        </t>
    </template>

    <template id="report_purchase_contract_document">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="buyer" t-value="company.partner_id"/>
        <t t-set="supplier" t-value="o.partner_id"/>
        <t t-set="buyer_bank" t-value="buyer.bank_ids[:1]"/>
        <t t-set="supplier_bank" t-value="supplier.bank_ids[:1]"/>
        <t t-set="buyer_address" t-value="o._get_contract_address(buyer)"/>
        <t t-set="supplier_address" t-value="o._get_contract_address(supplier)"/>
        <t t-set="signing_date" t-value="o.signing_date or o.date_order"/>
        <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
            <div class="page sn-purchase-contract"
                 style="font-family: SimSun, serif; color: #111; font-size: 11px;">
                <style>
                    .sn-purchase-contract h1 { margin: 0 0 8px; text-align: center; font-size: 27px; }
                    .sn-purchase-contract table { width: 100%; border-collapse: collapse; }
                    .sn-purchase-contract td, .sn-purchase-contract th { padding: 4px 5px; vertical-align: middle; }
                    .sn-purchase-contract .plain td, .sn-purchase-contract .party td { border: 0; }
                    .sn-purchase-contract .product-table td, .sn-purchase-contract .product-table th {
                        border: 1px solid #111;
                    }
                    .sn-purchase-contract .label { font-weight: 700; white-space: nowrap; }
                    .sn-purchase-contract .center { text-align: center; }
                    .sn-purchase-contract .amount { text-align: right; white-space: nowrap; }
                </style>

                <table class="plain table-borderless">
                    <tr>
                        <td style="width: 26%;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                 style="max-width: 150px; max-height: 48px;"/>
                            <span t-else="" style="font-size: 20px; font-weight: 700;" t-out="company.name"/>
                        </td>
                        <td><h1>采购合同</h1></td>
                        <td style="width: 26%;"/>
                    </tr>
                </table>

                <table class="party table-borderless">
                    <tr>
                        <td style="width: 30%;">
                            <span class="label">签订日期：</span>
                            <span t-out="o._format_contract_date(signing_date)"/>
                        </td>
                        <td style="width: 35%;">
                            <span class="label">签订地点：</span>
                            <span t-out="o.signing_location or ''"/>
                        </td>
                        <td style="width: 35%;">
                            <span class="label">合同号：</span>
                            <span t-out="o.contract_number or o.name"/>
                        </td>
                    </tr>
                    <tr>
                        <td><span class="label">需方：</span><span t-out="buyer.name"/></td>
                        <td colspan="2"><span class="label">供方：</span><span t-out="supplier.name"/></td>
                    </tr>
                    <tr>
                        <td><span class="label">地址：</span><span t-out="buyer_address"/></td>
                        <td colspan="2"><span class="label">地址：</span><span t-out="supplier_address"/></td>
                    </tr>
                    <tr>
                        <td><span class="label">电话：</span><span t-out="buyer.phone or ''"/></td>
                        <td colspan="2"><span class="label">电话：</span><span t-out="supplier.phone or ''"/></td>
                    </tr>
                    <tr>
                        <td><span class="label">开户行：</span><span t-out="buyer_bank.bank_id.name if buyer_bank and buyer_bank.bank_id else ''"/></td>
                        <td colspan="2"><span class="label">开户行：</span><span t-out="supplier_bank.bank_id.name if supplier_bank and supplier_bank.bank_id else ''"/></td>
                    </tr>
                    <tr>
                        <td><span class="label">账号：</span><span t-out="buyer_bank.acc_number if buyer_bank else ''"/></td>
                        <td colspan="2"><span class="label">账号：</span><span t-out="supplier_bank.acc_number if supplier_bank else ''"/></td>
                    </tr>
                </table>

                <table class="product-table">
                    <thead>
                        <tr class="center">
                            <th>序号</th>
                            <th>物料编码</th>
                            <th>产品名称</th>
                            <th>产品规格</th>
                            <th>单位</th>
                            <th>数量</th>
                            <th>含税单价</th>
                            <th>含税金额</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.order_line.filtered(lambda line: not line.display_type and line.product_qty != 0)"
                           t-as="line">
                            <tr>
                                <td class="center"><span t-out="line_index + 1"/></td>
                                <td><span t-out="line.product_id.default_code or ''"/></td>
                                <td><span t-out="line.product_id.name or line.name"/></td>
                                <td><span t-out="line.product_id.material_specification or ''"/></td>
                                <td class="center"><span t-out="line.product_uom_id.name or ''"/></td>
                                <td class="amount"><span t-out="o._format_contract_quantity(line.product_qty)"/></td>
                                <td class="amount"><span t-out="o._format_contract_unit_price(line.price_unit_tax_included)"/></td>
                                <td class="amount"><span t-out="o._format_contract_amount(line.price_total)"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="6"><b>合计金额（含税）：</b><span t-out="o.amount_total_chinese"/></td>
                            <td colspan="2" class="amount"><span t-out="o._format_contract_total(o.amount_total)"/></td>
                        </tr>
                        <tr>
                            <td colspan="6"><b>不含税金额：</b><span t-out="o.amount_untaxed_chinese"/></td>
                            <td colspan="2" class="amount"><span t-out="o._format_contract_total(o.amount_untaxed)"/></td>
                        </tr>
                    </tfoot>
                </table>

                <table class="party table-borderless" style="margin-top: 20px;">
                    <tr>
                        <td style="width: 50%;"><b>需方：</b><span t-out="buyer.name"/>（盖章）</td>
                        <td style="width: 50%;"><b>供方：</b><span t-out="supplier.name"/>（盖章）</td>
                    </tr>
                    <tr>
                        <td>日期：</td>
                        <td>日期：</td>
                    </tr>
                </table>
            </div>
        </div>
    </template>
</odoo>
