<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_form_sn_wsd_wip" model="ir.ui.view">
        <field name="name">mrp.workorder.form.sn.wsd.wip</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="WIP Snapshot">
                    <group>
                        <group>
                            <field name="x_wip_data_source" readonly="1"/>
                            <field name="x_wip_snapshot_time" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_refresh_wip_qty_snapshot" type="object" string="Refresh WIP Snapshot" class="btn-secondary"/>
                        </group>
                    </group>
                    <group string="Snapshot Quantities">
                        <group>
                            <field name="x_wip_qty_start_snapshot" readonly="1"/>
                            <field name="x_wip_qty_pass_snapshot" readonly="1"/>
                            <field name="x_wip_qty_pending_snapshot" readonly="1"/>
                        </group>
                        <group>
                            <field name="x_wip_qty_fail_snapshot" readonly="1"/>
                            <field name="x_wip_qty_scrap_snapshot" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
