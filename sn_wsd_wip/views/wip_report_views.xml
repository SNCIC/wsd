<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_wip_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.wip.report.list</field>
        <field name="model">sn.wsd.wip.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="step_sequence asc, route_operation_id asc">
                <field name="mes_order_id" optional="show"/>
                <field name="production_id"/>
                <field name="step_sequence"/>
                <field name="route_step_id"/>
                <field name="route_operation_id"/>
                <field name="workcenter_id"/>
                <field name="data_source"/>
                <field name="input_qty" sum="Total"/>
                <field name="start_qty" sum="Total"/>
                <field name="pass_qty" sum="Total"/>
                <field name="fail_qty" sum="Total"/>
                <field name="scrap_qty" sum="Total"/>
                <field name="pending_qty" sum="Total"/>
                <field name="wip_qty" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_wip_report_graph" model="ir.ui.view">
        <field name="name">sn.wsd.wip.report.graph</field>
        <field name="model">sn.wsd.wip.report</field>
        <field name="arch" type="xml">
            <graph string="WIP Visualization" type="bar" stacked="1">
                <field name="route_step_id" type="row"/>
                <field name="wip_qty" type="measure"/>
                <field name="pending_qty" type="measure"/>
                <field name="pass_qty" type="measure"/>
                <field name="fail_qty" type="measure"/>
                <field name="scrap_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sn_wsd_wip_report_pivot" model="ir.ui.view">
        <field name="name">sn.wsd.wip.report.pivot</field>
        <field name="model">sn.wsd.wip.report</field>
        <field name="arch" type="xml">
            <pivot string="WIP Analysis">
                <field name="mes_order_id" type="row"/>
                <field name="production_id" type="row"/>
                <field name="route_step_id" type="col"/>
                <field name="wip_qty" type="measure"/>
                <field name="pass_qty" type="measure"/>
                <field name="fail_qty" type="measure"/>
                <field name="scrap_qty" type="measure"/>
                <field name="pending_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sn_wsd_wip_report_search" model="ir.ui.view">
        <field name="name">sn.wsd.wip.report.search</field>
        <field name="model">sn.wsd.wip.report</field>
        <field name="arch" type="xml">
            <search string="WIP Report">
                <field name="production_id"/>
                <field name="mes_order_id"/>
                <field name="route_id"/>
                <field name="route_step_id"/>
                <field name="route_operation_id"/>
                <field name="workcenter_id"/>
                <field name="data_source"/>
                <group>
                    <filter string="MES Order" name="group_by_mes_order" context="{'group_by': 'mes_order_id'}"/>
                    <filter string="Manufacturing Order" name="group_by_production" context="{'group_by': 'production_id'}"/>
                    <filter string="Process Step" name="group_by_step" context="{'group_by': 'route_step_id'}"/>
                    <filter string="Work Center" name="group_by_workcenter" context="{'group_by': 'workcenter_id'}"/>
                    <filter string="Data Source" name="group_by_data_source" context="{'group_by': 'data_source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_wip_report" model="ir.actions.act_window">
        <field name="name">WIP Report</field>
        <field name="res_model">sn.wsd.wip.report</field>
        <field name="view_mode">graph,list,pivot</field>
        <field name="search_view_id" ref="view_sn_wsd_wip_report_search"/>
    </record>

    <menuitem id="menu_sn_wsd_wip_report"
              name="WIP Report"
              parent="mrp.menu_mrp_reporting"
              action="action_sn_wsd_wip_report"
              groups="mrp.group_mrp_user"
              sequence="35"/>

    <record id="view_sn_wsd_wip_mes_order_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.wip.mes.order.report.list</field>
        <field name="model">sn.wsd.wip.mes.order.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="step_sequence asc, route_step_id asc">
                <field name="mes_order_id"/>
                <field name="step_sequence"/>
                <field name="route_step_id"/>
                <field name="product_id" optional="hide"/>
                <field name="route_id" optional="hide"/>
                <field name="route_operation_count" sum="Total"/>
                <field name="production_count" sum="Total"/>
                <field name="input_qty" sum="Total"/>
                <field name="start_qty" sum="Total"/>
                <field name="pass_qty" sum="Total"/>
                <field name="fail_qty" sum="Total"/>
                <field name="scrap_qty" sum="Total"/>
                <field name="pending_qty" sum="Total"/>
                <field name="wip_qty" sum="Total"/>
                <field name="snapshot_time" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_wip_mes_order_report_graph" model="ir.ui.view">
        <field name="name">sn.wsd.wip.mes.order.report.graph</field>
        <field name="model">sn.wsd.wip.mes.order.report</field>
        <field name="arch" type="xml">
            <graph string="MES Order WIP Visualization" type="bar" stacked="1">
                <field name="route_step_id" type="row"/>
                <field name="wip_qty" type="measure"/>
                <field name="pending_qty" type="measure"/>
                <field name="pass_qty" type="measure"/>
                <field name="fail_qty" type="measure"/>
                <field name="scrap_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sn_wsd_wip_mes_order_report_pivot" model="ir.ui.view">
        <field name="name">sn.wsd.wip.mes.order.report.pivot</field>
        <field name="model">sn.wsd.wip.mes.order.report</field>
        <field name="arch" type="xml">
            <pivot string="MES Order WIP Analysis">
                <field name="mes_order_id" type="row"/>
                <field name="route_step_id" type="col"/>
                <field name="wip_qty" type="measure"/>
                <field name="pass_qty" type="measure"/>
                <field name="fail_qty" type="measure"/>
                <field name="scrap_qty" type="measure"/>
                <field name="pending_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sn_wsd_wip_mes_order_report_search" model="ir.ui.view">
        <field name="name">sn.wsd.wip.mes.order.report.search</field>
        <field name="model">sn.wsd.wip.mes.order.report</field>
        <field name="arch" type="xml">
            <search string="MES Order WIP Report">
                <field name="mes_order_id"/>
                <field name="route_id"/>
                <field name="route_step_id"/>
                <group>
                    <filter string="MES Order" name="group_by_mes_order" context="{'group_by': 'mes_order_id'}"/>
                    <filter string="Process Step" name="group_by_step" context="{'group_by': 'route_step_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_wip_mes_order_report" model="ir.actions.act_window">
        <field name="name">MES Order WIP Report</field>
        <field name="res_model">sn.wsd.wip.mes.order.report</field>
        <field name="view_mode">graph,list,pivot</field>
        <field name="search_view_id" ref="view_sn_wsd_wip_mes_order_report_search"/>
    </record>

    <menuitem id="menu_sn_wsd_wip_mes_order_report"
              name="MES Order WIP Report"
              parent="mrp.menu_mrp_reporting"
              action="action_sn_wsd_wip_mes_order_report"
              groups="mrp.group_mrp_user"
              sequence="36"/>

    <record id="view_sn_wsd_wip_production_overview_list" model="ir.ui.view">
        <field name="name">sn.wsd.wip.production.overview.list</field>
        <field name="model">sn.wsd.wip.production.overview</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="production_name asc">
                <field name="mes_order_id" optional="show"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="route_id"/>
                <field name="step_count" sum="Total"/>
                <field name="total_input_qty" sum="Total"/>
                <field name="total_pass_qty" sum="Total"/>
                <field name="total_fail_qty" sum="Total"/>
                <field name="total_scrap_qty" sum="Total"/>
                <field name="total_pending_qty" sum="Total"/>
                <field name="total_wip_qty" sum="Total"/>
                <field name="max_step_wip_qty" sum="Max WIP"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_wip_production_overview_form" model="ir.ui.view">
        <field name="name">sn.wsd.wip.production.overview.form</field>
        <field name="model">sn.wsd.wip.production.overview</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="route_id"/>
                        </group>
                        <group>
                            <field name="step_count"/>
                            <field name="total_input_qty"/>
                            <field name="total_wip_qty"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <group>
                            <field name="total_start_qty"/>
                            <field name="total_pass_qty"/>
                            <field name="total_pending_qty"/>
                        </group>
                        <group>
                            <field name="total_fail_qty"/>
                            <field name="total_scrap_qty"/>
                            <field name="max_step_wip_qty"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_wip_production_overview_graph" model="ir.ui.view">
        <field name="name">sn.wsd.wip.production.overview.graph</field>
        <field name="model">sn.wsd.wip.production.overview</field>
        <field name="arch" type="xml">
            <graph string="WIP Overview Dashboard" type="bar" stacked="1">
                <field name="production_id" type="row"/>
                <field name="total_wip_qty" type="measure"/>
                <field name="total_pending_qty" type="measure"/>
                <field name="total_pass_qty" type="measure"/>
                <field name="total_fail_qty" type="measure"/>
                <field name="total_scrap_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sn_wsd_wip_production_overview_pivot" model="ir.ui.view">
        <field name="name">sn.wsd.wip.production.overview.pivot</field>
        <field name="model">sn.wsd.wip.production.overview</field>
        <field name="arch" type="xml">
            <pivot string="WIP Production Overview">
                <field name="product_id" type="row"/>
                <field name="production_id" type="col"/>
                <field name="total_wip_qty" type="measure"/>
                <field name="total_pending_qty" type="measure"/>
                <field name="total_pass_qty" type="measure"/>
                <field name="total_fail_qty" type="measure"/>
                <field name="total_scrap_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sn_wsd_wip_production_overview_search" model="ir.ui.view">
        <field name="name">sn.wsd.wip.production.overview.search</field>
        <field name="model">sn.wsd.wip.production.overview</field>
        <field name="arch" type="xml">
            <search string="WIP Overview">
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="route_id"/>
                <group>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Route" name="group_by_route" context="{'group_by': 'route_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_wip_production_overview" model="ir.actions.act_window">
        <field name="name">WIP Overview</field>
        <field name="res_model">sn.wsd.wip.production.overview</field>
        <field name="view_mode">graph,list,pivot,form</field>
        <field name="search_view_id" ref="view_sn_wsd_wip_production_overview_search"/>
    </record>

    <menuitem id="menu_sn_wsd_wip_overview"
              name="WIP Overview"
              parent="mrp.menu_mrp_reporting"
              action="action_sn_wsd_wip_production_overview"
              groups="mrp.group_mrp_user"
              sequence="34"/>
</odoo>
