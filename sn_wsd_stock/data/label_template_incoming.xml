<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Incoming material label seed template (label-center batch 5).
    Every element is a 1:1 translation of the former hardcoded ZPL in
    report/incoming_material_label_templates.xml + .py:
      ^FO20,20^GB669,669,3          -> box 20,20 669x669 t3
      ^FO20,128^GB669,3,3 etc.      -> horizontal/vertical lines t3
      titles / values / QR / SN     -> text (fixed/field) + qrcode elements
    noupdate so designers can adjust the layout without upgrades
    overwriting their changes.
    -->
    <data noupdate="1">
        <record id="label_template_incoming_material" model="sn.label.template">
            <field name="name">Incoming Material Label</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="width_dots">709</field>
            <field name="height_dots">709</field>
            <field name="dpi">203</field>
            <field name="sn_field">name</field>
        </record>

        <!-- Frame and grid lines (^GB, thickness 3) -->
        <record id="label_element_incoming_box_outer" model="sn.label.element">
            <field name="template_id" ref="label_template_incoming_material"/>
            <field name="sequence">10</field>
            <field name="element_type">box</field>
            <field name="x">20</field>
            <field name="y">20</field>
            <field name="width">669</field>
            <field name="height">669</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_incoming_line_row_1" model="sn.label.element">
            <field name="template_id" ref="label_template_incoming_material"/>
            <field name="sequence">20</field>
