<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Issue material label seed template (领料标签).

    Same layout as the incoming material label (data/label_template_incoming.xml,
    every element is a 1:1 copy of its geometry and titles), but bound to
    stock.move.line: the quantity printed is the quantity actually issued by the
    operation (stock.move.line.quantity), which is why the incoming template
    (bound to stock.lot, reading initial_quantity) cannot be reused as is.
    Non-reel materials only; electronic reels leave the warehouse as the whole
    reel and keep their receipt label.

    noupdate so designers can adjust the layout without upgrades overwriting
    their changes.
    -->
    <data noupdate="1">
        <record id="label_template_issue_material" model="sn.label.template">
            <field name="name">Issue Material Label</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="width_dots">709</field>
            <field name="height_dots">709</field>
            <field name="dpi">203</field>
            <field name="sn_field">lot_name</field>
        </record>

        <!-- Frame and grid lines (^GB, thickness 3) -->
        <record id="label_element_issue_box_outer" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">10</field>
            <field name="element_type">box</field>
            <field name="x">20</field>
            <field name="y">20</field>
            <field name="width">669</field>
            <field name="height">669</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_row_1" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">20</field>
            <field name="element_type">line</field>
            <field name="x">20</field>
            <field name="y">128</field>
            <field name="width">669</field>
            <field name="height">0</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_row_2_left" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">30</field>
            <field name="element_type">line</field>
            <field name="x">20</field>
            <field name="y">236</field>
            <field name="width">414</field>
            <field name="height">0</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_row_3_left" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">40</field>
            <field name="element_type">line</field>
            <field name="x">20</field>
            <field name="y">344</field>
            <field name="width">414</field>
            <field name="height">0</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_row_4" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">50</field>
            <field name="element_type">line</field>
            <field name="x">20</field>
            <field name="y">452</field>
            <field name="width">669</field>
            <field name="height">0</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_row_5" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">55</field>
            <field name="element_type">line</field>
            <field name="x">20</field>
            <field name="y">560</field>
            <field name="width">669</field>
            <field name="height">0</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_col_1" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">60</field>
            <field name="element_type">line</field>
            <field name="x">146</field>
            <field name="y">20</field>
            <field name="width">0</field>
            <field name="height">432</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_col_2" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">70</field>
            <field name="element_type">line</field>
            <field name="x">434</field>
            <field name="y">20</field>
            <field name="width">0</field>
            <field name="height">432</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_col_3" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">80</field>
            <field name="element_type">line</field>
            <field name="x">508</field>
            <field name="y">20</field>
            <field name="width">0</field>
            <field name="height">216</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_qr_top" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">90</field>
            <field name="element_type">line</field>
            <field name="x">434</field>
            <field name="y">236</field>
            <field name="width">255</field>
            <field name="height">0</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_qr_left" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">100</field>
            <field name="element_type">line</field>
            <field name="x">434</field>
            <field name="y">236</field>
            <field name="width">0</field>
            <field name="height">216</field>
            <field name="thickness">3</field>
        </record>
        <record id="label_element_issue_line_location_col" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">105</field>
            <field name="element_type">line</field>
            <field name="x">146</field>
            <field name="y">452</field>
            <field name="width">0</field>
            <field name="height">108</field>
            <field name="thickness">3</field>
        </record>

        <!-- Column titles, identical to the incoming material label -->
        <record id="label_element_issue_title_material_code" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">110</field>
            <field name="element_type">text</field>
            <field name="content">fixed</field>
            <field name="fixed_text">Material Code</field>
            <field name="x">35</field>
            <field name="y">20</field>
            <field name="width">100</field>
            <field name="height">108</field>
            <field name="font_size">34</field>
            <field name="max_lines">1</field>
        </record>
        <record id="label_element_issue_title_batch" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">120</field>
            <field name="element_type">text</field>
            <field name="content">fixed</field>
            <field name="fixed_text">Batch</field>
            <field name="x">445</field>
            <field name="y">20</field>
            <field name="width">55</field>
            <field name="height">108</field>
            <field name="font_size">34</field>
            <field name="max_lines">1</field>
        </record>
        <record id="label_element_issue_title_material_name" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">130</field>
            <field name="element_type">text</field>
            <field name="content">fixed</field>
            <field name="fixed_text">Material Name</field>
            <field name="x">35</field>
            <field name="y">128</field>
            <field name="width">100</field>
            <field name="height">108</field>
            <field name="font_size">34</field>
            <field name="max_lines">1</field>
        </record>
        <record id="label_element_issue_title_quantity" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">140</field>
            <field name="element_type">text</field>
            <field name="content">fixed</field>
            <field name="fixed_text">Quantity Label</field>
            <field name="x">445</field>
            <field name="y">128</field>
            <field name="width">55</field>
            <field name="height">108</field>
            <field name="font_size">34</field>
            <field name="max_lines">1</field>
        </record>
        <record id="label_element_issue_title_specification" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">150</field>
            <field name="element_type">text</field>
            <field name="content">fixed</field>
            <field name="fixed_text">Specification</field>
            <field name="x">35</field>
            <field name="y">236</field>
            <field name="width">100</field>
            <field name="height">108</field>
            <field name="font_size">34</field>
            <field name="max_lines">1</field>
        </record>
        <record id="label_element_issue_title_supplier" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">160</field>
            <field name="element_type">text</field>
            <field name="content">fixed</field>
            <field name="fixed_text">Supplier Label</field>
            <field name="x">35</field>
            <field name="y">344</field>
            <field name="width">100</field>
            <field name="height">108</field>
            <field name="font_size">34</field>
            <field name="max_lines">1</field>
        </record>

        <!-- Field values: issued quantity and the lot attributes reached
             through the single many2one hop (lot_*). -->
        <record id="label_element_issue_value_material_code" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">170</field>
            <field name="element_type">text</field>
            <field name="content">field</field>
            <field name="field_path">product_id.default_code</field>
            <field name="x">157</field>
            <field name="y">20</field>
            <field name="width">270</field>
            <field name="height">108</field>
            <field name="font_size">38</field>
            <field name="max_lines">2</field>
        </record>
        <record id="label_element_issue_value_supplier_batch" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">180</field>
            <field name="element_type">text</field>
            <field name="content">field</field>
            <field name="field_path">lot_id.supplier_batch_no</field>
            <field name="x">515</field>
            <field name="y">20</field>
            <field name="width">166</field>
            <field name="height">108</field>
            <field name="font_size">32</field>
            <field name="max_lines">2</field>
        </record>
        <record id="label_element_issue_value_material_name" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">190</field>
            <field name="element_type">text</field>
            <field name="content">field</field>
            <field name="field_path">product_id.name</field>
            <field name="x">157</field>
            <field name="y">128</field>
            <field name="width">270</field>
            <field name="height">108</field>
            <field name="font_size">32</field>
            <field name="max_lines">2</field>
        </record>
        <record id="label_element_issue_value_quantity" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">200</field>
            <field name="element_type">text</field>
            <field name="content">field</field>
            <field name="field_path">quantity</field>
            <field name="x">515</field>
            <field name="y">128</field>
            <field name="width">166</field>
            <field name="height">108</field>
            <field name="font_size">36</field>
            <field name="max_lines">2</field>
        </record>
        <record id="label_element_issue_value_specification" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">210</field>
            <field name="element_type">text</field>
            <field name="content">field</field>
            <field name="field_path">product_id.material_specification</field>
            <field name="x">157</field>
            <field name="y">236</field>
            <field name="width">270</field>
            <field name="height">108</field>
            <field name="font_size">30</field>
            <field name="max_lines">2</field>
        </record>
        <record id="label_element_issue_value_supplier_name" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">220</field>
            <field name="element_type">text</field>
            <field name="content">field</field>
            <field name="field_path">lot_id.supplier_name</field>
            <field name="x">157</field>
            <field name="y">344</field>
            <field name="width">270</field>
            <field name="height">108</field>
            <field name="font_size">30</field>
            <field name="max_lines">2</field>
        </record>

        <!-- Full-width location row: the line side the material is issued to -->
        <record id="label_element_issue_title_location" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">225</field>
            <field name="element_type">text</field>
            <field name="content">fixed</field>
            <field name="fixed_text">Location</field>
            <field name="x">35</field>
            <field name="y">452</field>
            <field name="width">100</field>
            <field name="height">108</field>
            <field name="font_size">34</field>
            <field name="max_lines">1</field>
        </record>
        <record id="label_element_issue_value_location" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">226</field>
            <field name="element_type">text</field>
            <field name="content">field</field>
            <field name="field_path">material_label_location</field>
            <field name="x">157</field>
            <field name="y">452</field>
            <field name="width">532</field>
            <field name="height">108</field>
            <field name="font_size">28</field>
            <field name="max_lines">2</field>
        </record>

        <!-- Material SN QR code: the lot name, so the label keeps matching the
             material online loading scan (stock.lot.name) -->
        <record id="label_element_issue_qr_sn" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">230</field>
            <field name="element_type">qrcode</field>
            <field name="content">field</field>
            <field name="field_path">lot_id.name</field>
            <field name="x">453</field>
            <field name="y">245</field>
            <field name="width">205</field>
            <field name="height">205</field>
            <field name="rendering">bitmap</field>
        </record>

        <!-- Bottom material SN text -->
        <record id="label_element_issue_sn_text" model="sn.label.element">
            <field name="template_id" ref="label_template_issue_material"/>
            <field name="sequence">240</field>
            <field name="element_type">text</field>
            <field name="content">field</field>
            <field name="field_path">lot_id.name</field>
            <field name="x">35</field>
            <field name="y">560</field>
            <field name="width">654</field>
            <field name="height">129</field>
            <field name="font_size">30</field>
            <field name="max_lines">2</field>
        </record>
    </data>
</odoo>
