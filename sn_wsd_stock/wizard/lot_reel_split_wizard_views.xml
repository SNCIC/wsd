<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lot_reel_split_wizard_form" model="ir.ui.view">
        <field name="name">sn.lot.reel.split.wizard.form</field>
        <field name="model">sn.lot.reel.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Reel Lots">
                <group>
                    <group string="Source">
                        <field name="picking_id"/>
                        <field name="source_move_id" options="{'no_create': True}"/>
                        <field name="available_source_lot_ids" invisible="1"/>
                        <field name="source_lot_id" options="{'no_create': True}"/>
                        <field name="product_id"/>
                        <field name="split_quantity"/>
                        <field name="product_uom_id" groups="uom.group_uom"/>
                    </group>
                    <group string="Reel Rule">
                        <field name="quantity_per_reel"/>
                        <field name="lot_prefix"/>
                        <field name="sequence_start"/>
                        <field name="sequence_padding"/>
                        <field name="default_location_dest_id" options="{'no_create': True}"/>
                        <field name="picking_location_dest_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sequence" readonly="1"/>
                        <field name="lot_name"/>
                        <field name="quantity"/>
                        <field name="location_dest_id" options="{'no_create': True}"/>
                        <field name="is_remainder" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_generate_lines" string="Generate Lines" type="object" class="btn-secondary"/>
                    <button name="action_apply" string="Apply Reel Split" type="object" class="btn-primary" invisible="not line_ids"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
