<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_lot_reel_split_company" model="ir.rule">
        <field name="name">Reel splits by company</field>
        <field name="model_id" ref="model_sn_lot_reel_split"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('stock.group_stock_user'))]"/>
    </record>

    <record id="rule_lot_reel_split_line_company" model="ir.rule">
        <field name="name">Reel split lines by company</field>
        <field name="model_id" ref="model_sn_lot_reel_split_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('stock.group_stock_user'))]"/>
    </record>
</odoo>
