<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 补货规则：暴露 Odoo 19 自带的有效路线（route_id 为空时按产品路线解析，
         空值分组显示"无"易误读为没有补货方式），加可选列与预置分组。 -->
    <record id="view_warehouse_orderpoint_tree_effective_route" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.effective.route</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <field name="route_id" position="after">
                <field name="effective_route_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_tree_show_trigger_effective_route" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.show.trigger.effective.route</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable_show_trigger"/>
        <field name="arch" type="xml">
            <field name="route_id" position="after">
                <field name="effective_route_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="warehouse_orderpoint_search_effective_route" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.search.effective.route</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.warehouse_orderpoint_search"/>
        <field name="arch" type="xml">
            <filter name="product" position="after">
                <filter string="Route" name="route" domain="[]"
                        context="{'group_by': 'route_id'}"/>
                <filter string="Effective Route" name="effective_route" domain="[]"
                        context="{'group_by': 'effective_route_id'}"/>
            </filter>
        </field>
    </record>

    <!-- 补货（Replenishment）菜单用的是 reorder report search 视图，单独继承 -->
    <record id="reorder_report_search_effective_route" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.reorder.search.effective.route</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.stock_reorder_report_search"/>
        <field name="arch" type="xml">
            <filter name="groupby_category" position="after">
                <filter string="Route" name="groupby_route" domain="[]"
                        context="{'group_by': 'route_id'}"/>
                <filter string="Effective Route" name="groupby_effective_route" domain="[]"
                        context="{'group_by': 'effective_route_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
