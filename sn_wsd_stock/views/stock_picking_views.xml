<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_operations_material_labels" model="ir.ui.view">
        <field name="name">stock.move.operations.material.labels</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='generate_serials']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//widget[@name='import_lots']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//widget[@name='import_lots']" position="after">
                <button name="action_generate_material_labels"
                        string="Generate Internal Batches"
                        type="object"
                        class="btn btn-link"
                        invisible="picking_code != 'incoming' or has_tracking != 'lot' or state in ['done', 'cancel']"/>
                <button name="action_print_material_labels"
                        string="Print Material Labels"
                        type="object"
                        class="btn btn-link"
                        invisible="picking_code != 'incoming' or has_tracking != 'lot' or state in ['done', 'cancel']"/>
            </xpath>
        </field>
    </record>

    <!-- 完工收货单：表单头部"打印物料标签"（成品库待验证一键挂码 /
         已完成补打，finished-goods-material-sn 定稿口径）。挂在表单上
     而非 move 行内——view_picking_form 的内嵌 move 列表不带
         import_lots 挂载点，行内按钮在收货表单上不渲染。 -->
    <record id="view_picking_form_finished_labels" model="ir.ui.view">
        <field name="name">stock.picking.form.finished.labels</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_material_label_wizard" type="object"
                        string="Print Material Labels" class="btn-secondary"
                        invisible="not is_mes_receipt or state == 'cancel' or not can_print_material_labels"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_material_labels" model="ir.ui.view">
        <field name="name">stock.move.line.operations.material.labels</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">internal_lot_name asc, id asc</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="before">
                <field name="internal_lot_name" column_invisible="1"/>
                <field name="supplier_batch_no"
                       column_invisible="parent.has_tracking != 'lot'"
                       readonly="lot_id or (state == 'done' and is_locked)"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="quantity_per_label"
                       column_invisible="parent.has_tracking != 'lot'"
                       readonly="lot_id or (state == 'done' and is_locked)"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_material_labels" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.material.labels</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">internal_lot_name asc, id asc</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="before">
                <field name="internal_lot_name" column_invisible="1"/>
                <field name="supplier_batch_no"
                       column_invisible="tracking != 'lot'"
                       readonly="lot_id or (state == 'done' and is_locked)"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="quantity_per_label"
                       column_invisible="tracking != 'lot'"
                       readonly="lot_id or (state == 'done' and is_locked)"/>
            </xpath>
        </field>
    </record>
</odoo>
