<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lot_reel_split_list" model="ir.ui.view">
        <field name="name">sn.lot.reel.split.list</field>
        <field name="model">sn.lot.reel.split</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="date"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="source_lot_id"/>
                <field name="quantity"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_lot_reel_split_form" model="ir.ui.view">
        <field name="name">sn.lot.reel.split.form</field>
        <field name="model">sn.lot.reel.split</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_conversion_moves" type="object" class="oe_stat_button" icon="fa-exchange">
                            <div class="o_stat_info"><span class="o_stat_text">Conversion Moves</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="picking_id"/>
                            <field name="source_move_id"/>
                            <field name="product_id"/>
                            <field name="source_lot_id"/>
                            <field name="source_location_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="quantity"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                            <field name="quantity_per_reel"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reel Lots">
                            <field name="line_ids">
                                <list create="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="lot_id"/>
                                    <field name="quantity"/>
                                    <field name="location_dest_id"/>
                                    <field name="is_remainder"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lot_reel_split" model="ir.actions.act_window">
        <field name="name">Reel Splits</field>
        <field name="res_model">sn.lot.reel.split</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_lot_reel_split" name="Reel Splits" parent="stock.menu_stock_inventory_control" action="action_lot_reel_split" sequence="103" groups="stock.group_stock_user"/>
</odoo>
