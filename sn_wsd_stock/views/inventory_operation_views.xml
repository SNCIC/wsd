<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Historical inventory losses and gains.

         The inventory losses and gains are no longer transfers of their own
         operation type: the difference of a physical inventory is booked on the
         stock moves of the stock module, and the inventory loss and gain detail
         reports list them (see operation_detail_views.xml). The transfers the
         former feature created are kept, archived with their operation types,
         and carry the marker their detail lines are read on.

         The transfers menus of Odoo read the code of the operation type, and
         these historical transfers share the delivery and receipt codes: this
         filter keeps them out of the standard deliveries and receipts lists,
         where they would look like sales and purchase documents, and leaves
         them to the inventory loss and gain detail reports. The other
         operations keep their behaviour. -->
    <record id="view_picking_internal_search_inventory_operation"
            model="ir.ui.view">
        <field name="name">stock.picking.internal.search.inventory.operation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <filter name="reception" position="attributes">
                <attribute name="domain">[('picking_type_code', '=', 'incoming'), ('sn_inventory_operation', '=', False)]</attribute>
            </filter>
            <filter name="delivery" position="attributes">
                <attribute name="domain">[('picking_type_code', '=', 'outgoing'), ('sn_inventory_operation', '=', False)]</attribute>
            </filter>
        </field>
    </record>
</odoo>
