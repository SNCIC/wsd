<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Operation detail reports (Inventory > Details).

         Every operation type of a warehouse has its own detail list: the
         receipt, the quality control and the storage transfer live in
         reception_detail_views.xml, the other operation types are listed
         here. Each list is filtered on sn_operation_kind, the kind of
         operation read on the operation type of the transfer: the operation
         types carry no xmlid (they are created with the warehouse or lazily
         by the MES module), so a report cannot filter on a fixed record.

         The lists are not inherited from each other: Odoo applies every view
         inheriting a view to that view too, so adding or removing a column in
         a child view would change the other reports as well. The operations
         sharing the same columns share one list instead, and each action
         selects it explicitly. -->
    <menuitem id="menu_sn_wsd_stock_detail"
              name="Details"
              parent="stock.menu_stock_root"
              sequence="3"
              groups="stock.group_stock_user"/>

    <record id="view_sn_wsd_operation_detail_search" model="ir.ui.view">
        <field name="name">stock.move.operation.detail.search</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <search string="Operation Details">
                <field name="reference" string="Document No."/>
                <field name="sn_picking_origin" string="Transfer Source"/>
                <field name="sn_picking_partner_id" string="Contact"/>
                <field name="product_code" string="Material Code"/>
                <field name="product_name" string="Material Name"/>
                <field name="material_specification" string="Material Specification"/>
                <field name="sn_picking_date" string="Scheduled Date"/>
                <field name="sn_validation_date" string="Validation Date"/>
                <field name="picking_id"/>
                <field name="picking_type_id" string="Operation Type"/>
                <field name="sn_warehouse_id" string="Warehouse"/>
                <field name="sn_issue_type_id" string="Issue Type"/>
                <field name="sn_receive_type_id" string="Receipt Type"/>
                <field name="sn_mes_order_id" string="MES Order"/>
                <field name="product_id"/>
                <separator/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('picking_id.state', 'not in', ('done', 'cancel'))]"/>
                <filter name="filter_done" string="Done"
                        domain="[('picking_id.state', '=', 'done')]"/>
                <separator/>
                <group>
                    <filter name="group_document" string="Document No."
                            context="{'group_by': 'picking_id'}"/>
                    <filter name="group_operation_type" string="Operation Type"
                            context="{'group_by': 'picking_type_id'}"/>
                    <filter name="group_warehouse" string="Warehouse"
                            context="{'group_by': 'sn_warehouse_id'}"/>
                    <filter name="group_mes_order" string="MES Order"
                            context="{'group_by': 'sn_mes_order_id'}"/>
                    <filter name="group_product" string="Material"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_date" string="Scheduled Date"
                            context="{'group_by': 'sn_picking_date:day'}"/>
                    <filter name="group_validation_date" string="Validation Date"
                            context="{'group_by': 'sn_validation_date:day'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_other_receipt_detail_list" model="ir.ui.view">
        <field name="name">stock.move.other.receipt.detail.list</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list string="Other Receipt Details" create="false" delete="false"
                  js_class="sn_wsd_merged_cells_list"
                  default_order="sn_validation_date desc, sn_picking_date desc, picking_id, id">
                <field name="picking_id" column_invisible="1"/>
                <field name="reference" string="Document No."/>
                <field name="picking_type_id" string="Operation Type"
                       optional="hide"/>
                <field name="sn_warehouse_id" string="Warehouse" optional="hide"/>
                <field name="sn_picking_date" options="{'show_time': False}"/>
                <field name="sn_validation_date" options="{'show_time': False}"/>
                <field name="sn_picking_partner_id" string="Contact"/>
                <field name="sn_picking_origin"/>
                <field name="sn_picking_state" widget="badge"
                       decoration-success="sn_picking_state == 'done'"
                       decoration-info="sn_picking_state in ('confirmed', 'assigned')"
                       decoration-warning="sn_picking_state == 'waiting'"
                       decoration-danger="sn_picking_state == 'cancel'"/>
                <field name="sn_picking_user_id" optional="hide"
                       widget="many2one_avatar_user"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="material_specification"/>
                <field name="product_uom_qty"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="product_uom" groups="uom.group_uom"/>
                <field name="sn_lot_names" optional="show"/>
                <field name="sn_supplier_batch_no" optional="hide"/>
                <field name="sn_receive_type_id" optional="show"/>
                <field name="sn_receive_department_id" optional="show"/>
                <field name="sn_receive_employee_id" optional="show"
                       widget="many2one_avatar_employee"/>
                <field name="location_id" optional="hide"/>
                <field name="location_dest_id" string="Destination Location"
                       optional="hide"/>
                <field name="state" optional="hide" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

