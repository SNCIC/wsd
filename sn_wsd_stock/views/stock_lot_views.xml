<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_reel_split" model="ir.ui.view">
        <field name="name">stock.lot.form.material.fields</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="supplier_batch_no" readonly="1"/>
                <field name="arrival_batch_no" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_list_editable_supplier_batch" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.supplier.batch</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="supplier_batch_no" readonly="1"/>
                <field name="arrival_batch_no" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_list_reel_split" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
</odoo>
