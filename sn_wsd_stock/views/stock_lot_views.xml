<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_reel_split" model="ir.ui.view">
        <field name="name">stock.lot.form.material.fields</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="supplier_batch_no" readonly="1"/>
                <field name="arrival_batch_no" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_list_editable_supplier_batch" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.supplier.batch</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="supplier_batch_no" readonly="1"/>
                <field name="arrival_batch_no" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_form_quality_hold" model="ir.ui.view">
        <field name="name">stock.lot.form.quality.hold</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="quality_hold" string="Quality Hold">
                    <group>
                        <field name="sn_hold_state" widget="badge"
                               decoration-success="sn_hold_state == 'none'"
                               decoration-warning="sn_hold_state == 'sealed'"
                               decoration-danger="sn_hold_state == 'blocked'"/>
                        <field name="sn_hold_id"/>
                        <field name="sn_hold_date"/>
                    </group>
                    <group>
                        <field name="sn_hold_reason"/>
                        <div colspan="2">
                            <button name="action_sn_open_hold" type="object"
                                    string="Hold for Quality" class="btn-secondary"
                                    groups="stock.group_stock_user"
                                    invisible="sn_hold_state != 'none'"/>
                            <button name="action_sn_release_hold" type="object"
                                    string="Release Hold" class="btn-primary"
                                    groups="stock.group_stock_user"
                                    invisible="sn_hold_state == 'none'"/>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_list_quality_hold" model="ir.ui.view">
        <field name="name">stock.lot.list.quality.hold</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sn_hold_state" widget="badge" optional="show"
                       decoration-success="sn_hold_state == 'none'"
                       decoration-warning="sn_hold_state == 'sealed'"
                       decoration-danger="sn_hold_state == 'blocked'"/>
            </xpath>
        </field>
    </record>
</odoo>
