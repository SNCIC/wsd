<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_request" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.request</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting
                    id="purchase_request_default_approver"
                    string="Purchase Request Default Approver"
                    help="Automatically assign this user as the approver of new purchase requests."
                    company_dependent="1"
                >
                    <field name="purchase_request_default_approver_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
