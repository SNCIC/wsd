<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_sn_wsd_exception" model="ir.module.category">
            <field name="name">SN WSD Exception</field>
            <field name="sequence">65</field>
        </record>

        <record id="res_groups_privilege_sn_wsd_exception" model="res.groups.privilege">
            <field name="name">MES Exception</field>
            <field name="sequence">65</field>
            <field name="category_id" ref="module_category_sn_wsd_exception"/>
        </record>

        <record id="group_sn_wsd_exception_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sn_wsd_exception"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sn_wsd_exception_handler" model="res.groups">
            <field name="name">Handler</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sn_wsd_exception"/>
            <field name="implied_ids" eval="[(4, ref('group_sn_wsd_exception_user'))]"/>
        </record>

        <record id="group_sn_wsd_exception_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_sn_wsd_exception"/>
            <field name="implied_ids" eval="[(4, ref('group_sn_wsd_exception_handler'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="rule_sn_wsd_exception_ticket_company" model="ir.rule">
            <field name="name">Exception ticket company rule</field>
            <field name="model_id" ref="model_sn_wsd_exception_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_sn_wsd_exception_category_company" model="ir.rule">
            <field name="name">Exception category company rule</field>
            <field name="model_id" ref="model_sn_wsd_exception_category"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_sn_wsd_exception_team_company" model="ir.rule">
            <field name="name">Exception team company rule</field>
            <field name="model_id" ref="model_sn_wsd_exception_team"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_sn_wsd_exception_reason_company" model="ir.rule">
            <field name="name">Exception reason company rule</field>
            <field name="model_id" ref="model_sn_wsd_exception_reason"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
