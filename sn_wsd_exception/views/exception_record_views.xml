<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_exception_record_list" model="ir.ui.view">
        <field name="name">sn.wsd.exception.record.list</field>
        <field name="model">sn.wsd.exception.record</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ['closed', 'cancelled']">
                <field name="name"/>
                <field name="exception_type_id"/>
                <field name="category"/>
                <field name="state"/>
                <field name="occurred_at"/>
                <field name="mes_order_id"/>
                <field name="route_operation_id"/>
                <field name="workcenter_id"/>
                <field name="equipment_id" optional="hide"/>
                <field name="internal_serial_id" optional="hide"/>
                <field name="material_product_id" optional="hide"/>
                <field name="responsible_user_id"/>
                <field name="handler_user_id"/>
                <field name="verifier_user_id"/>
                <field name="is_overdue" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_exception_record_form" model="ir.ui.view">
        <field name="name">sn.wsd.exception.record.form</field>
        <field name="model">sn.wsd.exception.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_processing" type="object" string="Start Processing" class="btn-primary" invisible="state not in ['pending', 'suspended']"/>
                    <button name="action_submit_to_verify" type="object" string="Submit to Verify" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_verify_ok" type="object" string="Verify OK" class="btn-primary" invisible="state != 'to_verify'"/>
                    <button name="action_verify_ng" type="object" string="Verify NG" class="btn-secondary" invisible="state != 'to_verify'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="not can_close"/>
                    <button name="action_suspend" type="object" string="Suspend" class="btn-secondary" invisible="state in ['closed', 'cancelled', 'suspended']"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ['closed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,to_verify,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="exception_type_id" readonly="state not in ['pending']"/>
                            <field name="category" readonly="1"/>
                            <field name="occurred_at" readonly="state not in ['pending']"/>
                            <field name="reported_by_id" readonly="state not in ['pending']"/>
                            <field name="responsible_user_id" readonly="state in ['closed', 'cancelled']"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state not in ['pending']"/>
                            <field name="handler_user_id" readonly="state in ['closed', 'cancelled']"/>
                            <field name="verifier_user_id" readonly="state in ['closed', 'cancelled']"/>
                            <field name="escalation_user_id" readonly="1"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="registration" string="Registration">
                            <group>
                                <group>
                                    <field name="production_id" readonly="state not in ['pending']"/>
                                    <field name="mes_order_id" readonly="1"/>
                                    <field name="route_operation_id" readonly="state not in ['pending']"/>
                                    <field name="workcenter_id" readonly="state not in ['pending']"/>
                                    <field name="route_step_id" readonly="state not in ['pending']"/>
                                </group>
                                <group>
                                    <field name="equipment_id" readonly="state not in ['pending']" invisible="category not in ['equipment']"/>
                                    <field name="internal_serial_id" readonly="state not in ['pending']" invisible="category not in ['quality']"/>
                                    <field name="serial_lot_id" readonly="state not in ['pending']" invisible="category not in ['quality', 'material']"/>
                                    <field name="material_product_id" readonly="state not in ['pending']" invisible="category not in ['material']"/>
                                </group>
                            </group>
                            <group>
                                <field name="description" nolabel="1" readonly="state not in ['pending', 'in_progress']"/>
                            </group>
                            <group string="Site Photos">
                                <field name="attachment_ids" widget="many2many_binary" nolabel="1" readonly="state in ['closed', 'cancelled']"/>
                            </group>
                        </page>
                        <page name="handling" string="Handling">
                            <group>
                                <field name="root_cause" readonly="state not in ['in_progress']"/>
                                <field name="handling_plan" readonly="state not in ['in_progress']"/>
                                <field name="handled_result" readonly="state not in ['in_progress']"/>
                            </group>
                            <group>
                                <field name="processing_started_at" readonly="1"/>
                                <field name="handled_at" readonly="1"/>
                            </group>
                        </page>
                        <page name="verification" string="Verification">
                            <group>
                                <field name="verification_result" readonly="1"/>
                                <field name="verification_note" readonly="state != 'to_verify'"/>
                            </group>
                            <group>
                                <field name="verified_at" readonly="1"/>
                                <field name="closed_by_id" readonly="1"/>
                                <field name="closed_at" readonly="1"/>
                            </group>
                        </page>
                        <page name="escalation" string="Escalation">
                            <group>
                                <field name="escalated_at" readonly="1"/>
                                <field name="suspended_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_exception_record_search" model="ir.ui.view">
        <field name="name">sn.wsd.exception.record.search</field>
        <field name="model">sn.wsd.exception.record</field>
        <field name="arch" type="xml">
            <search string="Exception Records">
                <field name="name"/>
                <field name="exception_type_id"/>
                <field name="mes_order_id"/>
                <field name="route_operation_id"/>
                <field name="workcenter_id"/>
                <field name="equipment_id"/>
                <field name="internal_serial_id"/>
                <field name="serial_lot_id"/>
                <field name="material_product_id"/>
                <field name="responsible_user_id"/>
                <filter string="Open" name="filter_open" domain="[('state', 'in', ['pending', 'in_progress', 'to_verify', 'suspended'])]"/>
                <filter string="Overdue" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Pending" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="To Verify" name="filter_to_verify" domain="[('state', '=', 'to_verify')]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Suspended" name="filter_suspended" domain="[('state', '=', 'suspended')]"/>
                <separator/>
                <filter string="Type" name="group_by_type" context="{'group_by': 'exception_type_id'}"/>
                <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Work Center" name="group_by_workcenter" context="{'group_by': 'workcenter_id'}"/>
                <filter string="Responsible" name="group_by_responsible" context="{'group_by': 'responsible_user_id'}"/>
                <filter string="Occurred Date" name="group_by_occurred_at" context="{'group_by': 'occurred_at:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_exception_record" model="ir.actions.act_window">
        <field name="name">Exception Records</field>
        <field name="res_model">sn.wsd.exception.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_exception_record_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>

    <record id="action_sn_wsd_exception_ledger" model="ir.actions.act_window">
        <field name="name">Exception Ledger</field>
        <field name="res_model">sn.wsd.exception.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_exception_record_search"/>
    </record>
</odoo>
