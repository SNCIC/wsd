<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_exception_type_list" model="ir.ui.view">
        <field name="name">sn.wsd.exception.type.list</field>
        <field name="model">sn.wsd.exception.type</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="timeout_minutes"/>
                <field name="suspend_after_escalation_minutes"/>
                <field name="active" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_exception_type_form" model="ir.ui.view">
        <field name="name">sn.wsd.exception.type.form</field>
        <field name="model">sn.wsd.exception.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="timeout_minutes"/>
                            <field name="suspend_after_escalation_minutes"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="notification" string="Notification">
                            <group>
                                <field name="notify_group_ids" widget="many2many_tags"/>
                                <field name="escalation_group_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page name="description" string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_exception_type_search" model="ir.ui.view">
        <field name="name">sn.wsd.exception.type.search</field>
        <field name="model">sn.wsd.exception.type</field>
        <field name="arch" type="xml">
            <search string="Exception Types">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_exception_type" model="ir.actions.act_window">
        <field name="name">Exception Types</field>
        <field name="res_model">sn.wsd.exception.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_exception_type_search"/>
    </record>
</odoo>
