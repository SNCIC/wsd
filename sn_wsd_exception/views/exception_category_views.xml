<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_exception_category_list" model="ir.ui.view">
        <field name="name">sn.wsd.exception.category.list</field>
        <field name="model">sn.wsd.exception.category</field>
        <field name="arch" type="xml">
            <list string="Exception Categories">
                <field name="sequence" widget="handle"/>
                <field name="display_name"/>
                <field name="code" optional="show"/>
                <field name="default_team_id" optional="show"/>
                <field name="default_level" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_exception_category_form" model="ir.ui.view">
        <field name="name">sn.wsd.exception.category.form</field>
        <field name="model">sn.wsd.exception.category</field>
        <field name="arch" type="xml">
            <form string="Exception Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Equipment"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="default_team_id"
                                   invisible="parent_id"
                                   groups="sn_wsd_exception.group_sn_wsd_exception_manager"/>
                            <field name="default_level" invisible="parent_id"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Subcategories" invisible="parent_id">
                        <field name="child_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="active" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_exception_category_search" model="ir.ui.view">
        <field name="name">sn.wsd.exception.category.search</field>
        <field name="model">sn.wsd.exception.category</field>
        <field name="arch" type="xml">
            <search string="Exception Categories">
                <field name="name"/>
                <field name="default_team_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_exception_category" model="ir.actions.act_window">
        <field name="name">Exception Categories</field>
        <field name="res_model">sn.wsd.exception.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first exception category
            </p>
            <p>
                Root categories (Equipment / Material / Quality / Other) carry the default
                responsible team and level used for routing. Subcategories refine the
                Pareto statistics and are filled in by the claimer after the fact.
            </p>
        </field>
    </record>
</odoo>
