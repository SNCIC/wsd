<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_form_sn_wsd_exception" model="ir.ui.view">
        <field name="name">mrp.workorder.form.sn.wsd.exception</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_exception_records" icon="fa-exclamation-triangle">
                    <field name="x_exception_record_count" widget="statinfo" string="Exceptions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
