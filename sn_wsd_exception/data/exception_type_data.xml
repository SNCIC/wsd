<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="exception_type_equipment" model="sn.wsd.exception.type">
            <field name="name">Equipment Failure</field>
            <field name="code">EQUIPMENT</field>
            <field name="sequence">10</field>
            <field name="category">equipment</field>
            <field name="timeout_minutes">60</field>
            <field name="suspend_after_escalation_minutes">120</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="notify_group_ids" eval="[Command.link(ref('mrp.group_mrp_user'))]"/>
            <field name="escalation_group_ids" eval="[Command.link(ref('mrp.group_mrp_manager'))]"/>
            <field name="description">Production equipment or tooling failure.</field>
        </record>

        <record id="exception_type_quality" model="sn.wsd.exception.type">
            <field name="name">Quality Exception</field>
            <field name="code">QUALITY</field>
            <field name="sequence">20</field>
            <field name="category">quality</field>
            <field name="timeout_minutes">120</field>
            <field name="suspend_after_escalation_minutes">120</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="notify_group_ids" eval="[Command.link(ref('mrp.group_mrp_user'))]"/>
            <field name="escalation_group_ids" eval="[Command.link(ref('mrp.group_mrp_manager'))]"/>
            <field name="description">Product quality or process exception.</field>
        </record>

        <record id="exception_type_material" model="sn.wsd.exception.type">
            <field name="name">Material Exception</field>
            <field name="code">MATERIAL</field>
            <field name="sequence">30</field>
            <field name="category">material</field>
            <field name="timeout_minutes">60</field>
            <field name="suspend_after_escalation_minutes">120</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="notify_group_ids" eval="[Command.link(ref('mrp.group_mrp_user'))]"/>
            <field name="escalation_group_ids" eval="[Command.link(ref('mrp.group_mrp_manager'))]"/>
            <field name="description">Material shortage, wrong material, or defective material.</field>
        </record>

        <record id="exception_type_personnel" model="sn.wsd.exception.type">
            <field name="name">Personnel Exception</field>
            <field name="code">PERSONNEL</field>
            <field name="sequence">40</field>
            <field name="category">personnel</field>
            <field name="timeout_minutes">120</field>
            <field name="suspend_after_escalation_minutes">120</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="notify_group_ids" eval="[Command.link(ref('mrp.group_mrp_user'))]"/>
            <field name="escalation_group_ids" eval="[Command.link(ref('mrp.group_mrp_manager'))]"/>
            <field name="description">Absence, staffing issue, or operation exception.</field>
        </record>
    </data>
</odoo>
