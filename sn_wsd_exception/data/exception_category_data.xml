<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="exception_category_equipment" model="sn.wsd.exception.category">
            <field name="name">Equipment</field>
            <field name="code">EQUIPMENT</field>
            <field name="sequence">10</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="default_team_id" ref="exception_team_equipment"/>
            <field name="default_level">urgent</field>
            <field name="description">Equipment failure, feeder trouble, oven or printer issues.</field>
        </record>

        <record id="exception_category_material" model="sn.wsd.exception.category">
            <field name="name">Material</field>
            <field name="code">MATERIAL</field>
            <field name="sequence">20</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="default_team_id" ref="exception_team_material"/>
            <field name="default_level">normal</field>
            <field name="description">Material shortage, wrong material, expired or exposed material.</field>
        </record>

        <record id="exception_category_quality" model="sn.wsd.exception.category">
            <field name="name">Quality</field>
            <field name="code">QUALITY</field>
            <field name="sequence">30</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="default_team_id" ref="exception_team_quality"/>
            <field name="default_level">urgent</field>
            <field name="description">Batch defects, yield drop, AOI/ICT anomalies.</field>
        </record>

        <record id="exception_category_other" model="sn.wsd.exception.category">
            <field name="name">Other</field>
            <field name="code">OTHER</field>
            <field name="sequence">40</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="default_level">normal</field>
            <field name="description">Fallback category handled by the line team leader.</field>
        </record>
    </data>
</odoo>
