<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Manufacturing users get create/write on stock.picking for the MES
             material issue and return flows, but they must not modify transfers
             that do not belong to a MES order. Reading stays unrestricted. -->
        <record id="rule_stock_picking_mes_user_write" model="ir.rule">
            <field name="name">MES: manufacturing users only modify MES transfers</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('x_mes_order_id', '!=', False)]</field>
            <field name="groups" eval="[Command.link(ref('mrp.group_mrp_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
