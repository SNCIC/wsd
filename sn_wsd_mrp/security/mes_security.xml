<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mes" model="ir.module.category">
        <field name="name">MES Scheduling</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_mes" model="res.groups.privilege">
        <field name="name">MES Scheduling</field>
        <field name="category_id" ref="module_category_mes"/>
    </record>

    <record id="group_mes_planner" model="res.groups">
        <field name="name">Planner</field>
        <field name="privilege_id" ref="res_groups_privilege_mes"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="group_mes_shop" model="res.groups">
        <field name="name">Shop / Material</field>
        <field name="privilege_id" ref="res_groups_privilege_mes"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="group_mes_warehouse" model="res.groups">
        <field name="name">Warehouse</field>
        <field name="privilege_id" ref="res_groups_privilege_mes"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_mes_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="privilege_id" ref="res_groups_privilege_mes"/>
        <field name="implied_ids" eval="[(4, ref('group_mes_planner'))]"/>
    </record>
</odoo>
