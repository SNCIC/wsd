<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_mes_online_confirm_form" model="ir.ui.view">
        <field name="name">sn.wsd.mes.online.confirm.form</field>
        <field name="model">sn.wsd.mes.online.confirm</field>
        <field name="arch" type="xml">
            <form string="Go Online">
                <field name="mes_order_id" invisible="1"/>
                <field name="occupying_ids" invisible="1"/>
                <field name="message" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_confirm_replace" string="Replace and Go Online"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
