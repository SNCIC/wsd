<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_serial_identity_list" model="ir.ui.view">
        <field name="name">sn.wsd.serial.identity.list</field>
        <field name="model">sn.wsd.serial.identity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="origin_type"/>
                <field name="origin_production_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_serial_identity_form" model="ir.ui.view">
        <field name="name">sn.wsd.serial.identity.form</field>
        <field name="model">sn.wsd.serial.identity</field>
        <field name="priority">16</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="origin_type"/>
                            <field name="origin_production_id"/>
                            <field name="origin_lot_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="bindings" string="Bindings">
                            <field name="binding_ids">
                                <list editable="bottom">
                                    <field name="binding_type"/>
                                    <field name="serial_identity_id"/>
                                    <field name="bound_serial_identity_id"/>
                                    <field name="binding_date"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_serial_identity_form_basic" model="ir.ui.view">
        <field name="name">sn.wsd.serial.identity.form.basic</field>
        <field name="model">sn.wsd.serial.identity</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="origin_type" readonly="1"/>
                            <field name="origin_production_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_serial_identity_search" model="ir.ui.view">
        <field name="name">sn.wsd.serial.identity.search</field>
        <field name="model">sn.wsd.serial.identity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="origin_laser" string="Laser"
                        domain="[('origin_type', '=', 'laser')]"/>
                <filter name="origin_external" string="External"
                        domain="[('origin_type', '=', 'external')]"/>
                <filter name="origin_manual" string="Manual"
                        domain="[('origin_type', '=', 'manual')]"/>
                <filter name="origin_migration" string="Migration"
                        domain="[('origin_type', '=', 'migration')]"/>
                <separator/>
                <filter name="created_today" string="Created Today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="created_this_week" string="Created This Week"
                        domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter name="machine_binding" string="Machine Binding"
                        domain="[('binding_ids', '!=', False)]"/>
                <filter name="no_binding" string="No Binding"
                        domain="[('binding_ids', '=', False)]"/>
                <group>
                    <filter name="group_origin_type" string="Origin Type"
                            context="{'group_by': 'origin_type'}"/>
                    <filter name="group_origin_mo" string="Origin Manufacturing Order"
                            context="{'group_by': 'origin_production_id'}"/>
                    <filter name="group_create_date" string="Creation Date"
                            context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_serial_identity" model="ir.actions.act_window">
        <field name="name">Serial Identities</field>
        <field name="res_model">sn.wsd.serial.identity</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
