<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_internal_serial_tree" model="ir.ui.view">
        <field name="name">sn.wsd.internal.serial.list</field>
        <field name="model">sn.wsd.internal.serial</field>
        <field name="arch" type="xml">
            <list>
                <field name="serial_no"/>
                <field name="serial_identity_id" optional="hide"/>
                <field name="serial_type"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="final_result"/>
                <field name="current_workorder_id"/>
                <field name="current_workcenter_id"/>
                <field name="firmware_version"/>
                <field name="seal_no"/>
                <field name="carton_no"/>
                <field name="pack_date"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_internal_serial_form" model="ir.ui.view">
        <field name="name">sn.wsd.internal.serial.form</field>
        <field name="model">sn.wsd.internal.serial</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <group>
                        <group>
                            <field name="serial_no"/>
                            <field name="serial_identity_id" readonly="1"/>
                            <field name="x_panel_no"/>
                            <field name="barcode"/>
                            <field name="product_id"/>
                            <field name="production_id"/>
                            <field name="current_workorder_id"/>
                            <field name="current_operation_id"/>
                            <field name="current_workcenter_id"/>
                            <field name="parent_id"/>
                            <field name="source_lot_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="entry_workorder_id" readonly="1"/>
                            <field name="entry_time" readonly="1"/>
                            <field name="replaces_serial_id" readonly="1"/>
                            <field name="current_aging_batch_id"/>
                        </group>
                        <group>
                            <field name="final_result"/>
                            <field name="final_verification_result"/>
                            <field name="communication_result"/>
                            <field name="hipot_result"/>
                            <field name="aging_result"/>
                            <field name="production_date"/>
                            <field name="verification_date"/>
                            <field name="pack_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="versions" string="Versions">
                            <group>
                                <group>
                                    <field name="firmware_version"/>
                                    <field name="parameter_version"/>
                                    <field name="protocol_version"/>
                                    <field name="hardware_version"/>
                                </group>
                                <group>
                                    <field name="main_pcb_sn"/>
                                    <field name="comm_module_sn"/>
                                    <field name="display_module_sn"/>
                                    <field name="customer_batch_no"/>
                                </group>
                            </group>
                        </page>
                        <page name="packaging" string="Packaging">
                            <group>
                                <group>
                                    <field name="seal_no"/>
                                    <field name="carton_no"/>
                                    <field name="pallet_no"/>
                                </group>
                            </group>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_internal_serial" model="ir.actions.act_window">
        <field name="name">Internal Serials</field>
        <field name="res_model">sn.wsd.internal.serial</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

