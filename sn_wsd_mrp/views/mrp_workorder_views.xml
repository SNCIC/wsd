<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_list_sn_wsd_mrp" model="ir.ui.view">
        <field name="name">mrp.workorder.list.sn.wsd.mrp</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='qty_remaining']" position="attributes">
                <attribute name="string">Quantity To Produce</attribute>
            </xpath>
            <xpath expr="//list/field[@name='qty_ready']" position="attributes">
                <attribute name="string">WIP Quantity</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="groups"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_workorder_form_sn_wsd_mrp" model="ir.ui.view">
        <field name="name">mrp.workorder.form.sn.wsd.mrp</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_remaining']" position="attributes">
                <attribute name="string">Quantity To Produce</attribute>
            </xpath>
            <xpath expr="//form" position="inside">
                <field name="x_is_meter_operation" invisible="1"/>
                <field name="x_is_smt_operation" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="MES Execution" invisible="not x_is_meter_operation">
                    <group>
                        <group>
                            <field name="x_meter_operation_type"/>
                            <field name="x_meter_equipment_id"/>
                            <field name="x_meter_workshop_id"/>
                            <field name="x_meter_production_line_id"/>
                            <field name="x_meter_workcenter_code"/>
                            <field name="x_meter_fixture_id"/>
                            <field name="x_meter_operator_code"/>
                            <field name="x_meter_shift_code"/>
                        </group>
                        <group>
                            <field name="x_program_version"/>
                            <field name="x_parameter_version"/>
                            <field name="x_calibration_recipe"/>
                            <field name="x_aging_hours_planned"/>
                            <field name="x_aging_hours_actual"/>
                            <field name="x_test_profile"/>
                        </group>
                    </group>
                    <group string="Quantity">
                        <group>
                            <field name="x_meter_qty_input"/>
                            <field name="x_meter_qty_pass"/>
                            <field name="x_meter_qty_fail"/>
                            <field name="qty_produced" string="Cumulative Output Qty"/>
                        </group>
                        <group>
                            <field name="x_meter_qty_rework"/>
                            <field name="x_meter_qty_scrap"/>
                        </group>
                    </group>
                    <group string="Exceptions">
                        <group>
                            <field name="x_exception_flag"/>
                            <field name="x_exception_type"/>
                        </group>
                        <group>
                            <field name="x_exception_note"/>
                        </group>
                    </group>
                    <group string="Current Internal Serials">
                        <field name="x_internal_serial_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="serial_no"/>
                                <field name="final_result"/>
                                <field name="current_aging_batch_id"/>
                                <field name="seal_no"/>
                                <field name="carton_no"/>
                                <field name="pack_date"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

