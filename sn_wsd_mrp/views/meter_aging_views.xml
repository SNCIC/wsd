<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_meter_aging_batch_tree" model="ir.ui.view">
        <field name="name">sn.wsd.meter.aging.batch.list</field>
        <field name="model">sn.wsd.meter.aging.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="production_id"/>
                <field name="route_operation_id"/>
                <field name="equipment_id"/>
                <field name="aging_cart_no"/>
                <field name="status"/>
                <field name="planned_hours"/>
                <field name="actual_hours"/>
                <field name="start_time"/>
                <field name="end_time"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_meter_aging_batch_form" model="ir.ui.view">
        <field name="name">sn.wsd.meter.aging.batch.form</field>
        <field name="model">sn.wsd.meter.aging.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start Aging" class="btn-primary" invisible="status not in ('draft', 'loaded')"/>
                    <button name="action_finish" type="object" string="Finish Aging" class="btn-secondary" invisible="status != 'aging'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,loaded,aging,done,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="production_id"/>
                            <field name="route_operation_id"/>
                            <field name="equipment_id"/>
                            <field name="aging_cart_no"/>
                        </group>
                        <group>
                            <field name="planned_hours"/>
                            <field name="actual_hours" readonly="1"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="operator_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Serials">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="serial_id"/>
                                    <field name="slot_no"/>
                                    <field name="load_time"/>
                                    <field name="unload_time"/>
                                    <field name="result"/>
                                    <field name="exception_code"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_meter_aging_batch" model="ir.actions.act_window">
        <field name="name">Aging Batches</field>
        <field name="res_model">sn.wsd.meter.aging.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
