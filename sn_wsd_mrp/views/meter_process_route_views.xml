<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_form_sn_wsd_process_route" model="ir.ui.view">
        <field name="name">mrp.bom.form.sn.wsd.process.route</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="x_process_route_id" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='operations']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_routing_workcenter_form_sn_wsd_process_route" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.sn.wsd.process.route</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_product_template_attribute_value_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="x_process_route_id" readonly="1"/>
                <field name="x_route_operation_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='blocked_by_operation_ids']" position="after">
                <field name="x_step_code"/>
                <field name="x_allow_entry" readonly="1"/>
                <field name="x_allow_serial_creation" readonly="1"/>
                <field name="x_allow_reentry" readonly="1"/>
                <field name="x_allow_repair_return" readonly="1"/>
                <field name="x_allow_skip_with_override" readonly="1"/>
                <field name="x_ng_retry_limit" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_routing_workcenter_list_sn_wsd_process_route" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.list.sn.wsd.process.route</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_product_template_attribute_value_ids']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="x_process_route_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_route_operation_id" column_invisible="True"/>
                <field name="x_step_code" optional="show"/>
                <field name="x_station_type" optional="show"/>
                <field name="x_allow_entry" optional="show"/>
                <field name="x_allow_serial_creation" optional="show"/>
                <field name="x_allow_reentry" optional="hide"/>
                <field name="x_allow_repair_return" optional="hide"/>
                <field name="x_allow_skip_with_override" optional="hide"/>
                <field name="x_ng_retry_limit" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_routing_workcenter_search_sn_wsd_process_route" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.search.sn.wsd.process.route</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="replace"/>
            <xpath expr="//filter[@name='bom']" position="replace"/>
        </field>
    </record>

    <record id="view_sn_wsd_process_route_list" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.list</field>
        <field name="model">sn.wsd.process.route</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="code"/>
                <field name="active"/>
                <field name="name"/>
                <field name="x_production_side"/>
                <field name="x_workshop_id"/>
                <field name="x_is_default"/>
                <field name="create_uid" optional="hide"/>
                <field name="route_flow_text"/>
                <field name="state" optional="show"/>
                <field name="version" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_process_route_form" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.form</field>
        <field name="model">sn.wsd.process.route</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- 保存/取消 button bar in the standard form header (edit mode
                         only): 保存 = standard record save (flow change => new version
                         server-side), 取消 = discard everything, canvas reverts with
                         the record. -->
                    <widget name="route_form_actions" nolabel="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(sn_wsd_mrp.action_sn_wsd_process_route_drawing)d" icon="fa-file-text-o"
                                context="{'search_default_route_id': id, 'default_route_id': id}">
                            <field name="x_drawing_count" widget="statinfo" string="Drawing No."/>
                        </button>
                        <button class="oe_stat_button" type="action" name="%(sn_wsd_mrp.action_route_version_compare)d" icon="fa-columns"
                                context="{'default_route_id': id}" invisible="x_version_count &lt; 1">
                            <field name="x_version_count" widget="statinfo" string="Compare"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="version > 0"/>
                            <field name="name"/>
                            <field name="version" readonly="1"/>
                            <!-- state/route_flow_json invisible: the canvas edits are
                                 pushed into route_flow_json and saved/versioned by the
                                 standard form save; on Discard the record reverts them
                                 and the canvas follows. -->
                            <field name="state" invisible="1"/>
                            <field name="route_flow_json" invisible="1"/>
                            <field name="x_production_side"/>
                            <field name="x_is_default"/>
                        </group>
                        <group>
                            <field name="x_workshop_id"/>
                            <field name="operation_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="version > 0"/>
                            <field name="confirmed_by" readonly="1" invisible="state != 'confirmed'"/>
                        </group>
                    </group>
                    <div style="margin-top: 16px;">
                        <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">工艺流程图</div>
                        <widget name="route_flow_editor" nolabel="1"/>
                    </div>
                    <div style="margin-top: 16px;">
                        <group string="工序统计">
                            <group>
                                <field name="x_daily_input_operation_id" required="route_flow_json" domain="[('id', 'in', x_flow_operation_ids)]"/>
                                <field name="x_daily_output_operation_id" required="route_flow_json" domain="[('id', 'in', x_flow_operation_ids)]"/>
                                <field name="x_material_operation_id" domain="[('id', 'in', x_flow_operation_ids)]"/>
                            </group>
                            <group>
                                <field name="x_workorder_input_operation_id" required="route_flow_json" domain="[('id', 'in', x_flow_operation_ids)]"/>
                                <field name="x_aging_start_operation_id" domain="[('id', 'in', x_flow_operation_ids)]"/>
                                <field name="x_aging_end_operation_id" domain="[('id', 'in', x_flow_operation_ids)]"/>
                            </group>
                        </group>
                        <field name="x_flow_operation_ids" invisible="1"/>
                        <separator string="工段统计"/>
                        <field name="x_section_stat_ids" nolabel="1">
                            <list editable="bottom" placeholder="按统计段别配置区间：开始工序 → 结束工序">
                                <field name="x_process_section"/>
                                <field name="start_operation_id" domain="[('id', 'in', parent.x_flow_operation_ids)]"/>
                                <field name="end_operation_id" domain="[('id', 'in', parent.x_flow_operation_ids)]"/>
                            </list>
                        </field>
                    </div>
                    <div style="margin-top: 16px;">
                        <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">备注</div>
                        <field name="note" nolabel="1"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_process_route_search" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.search</field>
        <field name="model">sn.wsd.process.route</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="x_workshop_id"/>
                <filter string="Active" name="active_only" domain="[('active', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group name="group_by">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Workshop" name="group_workshop" context="{'group_by': 'x_workshop_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_process_route" model="ir.actions.act_window">
        <field name="name">Process Routes</field>
        <field name="res_model">sn.wsd.process.route</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_process_route_search"/>
    </record>

    <record id="view_sn_wsd_process_route_operation_list" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.operation.list</field>
        <field name="model">sn.wsd.process.route.operation</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="route_id"/>
                <field name="sequence" widget="handle"/>
                <field name="x_step_code"/>
                <field name="operation_id"/>
                <field name="workcenter_id" optional="hide"/>
                <field name="x_station_type"/>
                <field name="time_mode"/>
                <field name="time_cycle_manual"/>
                <field name="x_allow_entry"/>
                <field name="x_allow_serial_creation"/>
                <field name="x_allow_reentry"/>
                <field name="x_allow_repair_return"/>
                <field name="x_allow_skip_with_override"/>
                <field name="x_ng_retry_limit"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_process_route_operation_form" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.operation.form</field>
        <field name="model">sn.wsd.process.route.operation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="route_id"/>
                            <field name="sequence"/>
                            <field name="operation_id"/>
                            <field name="available_operation_ids" invisible="1"/>
                            <field name="x_step_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="route_workshop_id" readonly="1"/>
                            <field name="available_workcenter_ids" invisible="1"/>
                            <field name="x_station_type" readonly="1"/>
                            <field name="time_mode" widget="radio" options="{'horizontal': true}"/>
                            <field name="time_mode_batch" invisible="time_mode == 'manual'"/>
                            <field name="time_cycle_manual"/>
                            <field name="cost_mode" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                    <group>
                        <field name="blocked_by_route_operation_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Route Control">
                        <field name="x_allow_entry"/>
                        <field name="x_allow_serial_creation"/>
                        <field name="x_allow_reentry"/>
                        <field name="x_allow_repair_return"/>
                        <field name="x_allow_skip_with_override"/>
                        <field name="x_ng_retry_limit"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_process_route_operation_search" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.operation.search</field>
        <field name="model">sn.wsd.process.route.operation</field>
        <field name="arch" type="xml">
            <search>
                <field name="operation_id"/>
                <field name="x_step_code"/>
                <field name="route_id"/>
                <field name="workcenter_id"/>
                <group>
                    <filter string="Process Route" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Work Center" name="group_workcenter" context="{'group_by': 'workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_operation_list" model="ir.ui.view">
        <field name="name">sn.wsd.operation.list</field>
        <field name="model">sn.wsd.operation</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="x_station_type"/>
                <field name="x_process_section"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_operation_form" model="ir.ui.view">
        <field name="name">sn.wsd.operation.form</field>
        <field name="model">sn.wsd.operation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="x_station_type"/>
                            <field name="x_process_section"/>
                        </group>
                        <group>
                            <field name="x_max_test_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_operation_search" model="ir.ui.view">
        <field name="name">sn.wsd.operation.search</field>
        <field name="model">sn.wsd.operation</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="x_station_type"/>
                <field name="x_process_section"/>
                <filter string="Active" name="active_only" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive_only" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Station Type" name="group_station_type" context="{'group_by': 'x_station_type'}"/>
                    <filter string="Process Section" name="group_process_section" context="{'group_by': 'x_process_section'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_process_route_operation" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">sn.wsd.operation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_operation_search"/>
        <field name="context">{'search_default_active_only': 1}</field>
    </record>
</odoo>
