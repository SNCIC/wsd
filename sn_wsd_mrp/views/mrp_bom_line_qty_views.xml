<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BoM components: separate the code from the name and edit the usage
         through the numerator / denominator pair of the ERP. -->
    <record id="view_mrp_bom_form_qty_fraction" model="ir.ui.view">
        <field name="name">mrp.bom.form.qty.fraction</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_id']" position="before">
                <field name="product_code" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="context">{'default_is_storable': True, 'display_default_code': False}</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_qty']" position="before">
                <field name="qty_numerator" optional="show" options="{'hide_trailing_zeros': True}"/>
                <field name="qty_denominator" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_qty']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Read only BoM line form opened from the component attachments button. -->
    <record id="view_mrp_bom_line_form_qty_fraction" model="ir.ui.view">
        <field name="name">mrp.bom.line.form.qty.fraction</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="mrp.mrp_bom_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="context">{'display_default_code': False}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_code"/>
                <field name="qty_numerator" options="{'hide_trailing_zeros': True}"/>
                <field name="qty_denominator"/>
            </xpath>
        </field>
    </record>
</odoo>
