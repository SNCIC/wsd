<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sn_wsd_process_route_drawing_list" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.drawing.list</field>
        <field name="model">sn.wsd.process.route.drawing</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="route_id" string="Route Name"/>
                <field name="route_code" readonly="1" string="Route Code"/>
                <field name="x_side" readonly="1" widget="badge"
                       decoration-info="x_side in ('top', 'bottom')"
                       decoration-success="x_side == 'single'"/>
                <field name="x_drawing_no"/>
                <field name="product_name" readonly="1"/>
                <field name="product_board_side" readonly="1" widget="badge"
                       decoration-success="product_board_side == 'single'"
                       decoration-info="product_board_side == 'double'"/>
                <field name="product_specification" readonly="1"/>
                <field name="create_uid" readonly="1" optional="hide"/>
                <field name="create_date" readonly="1" optional="hide"/>
                <field name="write_uid" readonly="1" optional="hide"/>
                <field name="write_date" readonly="1" optional="hide"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_process_route_drawing_form" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.drawing.form</field>
        <field name="model">sn.wsd.process.route.drawing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Binding">
                            <field name="route_id"/>
                            <field name="x_side" readonly="1"/>
                            <field name="x_drawing_no"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Brought Out Information">
                            <field name="product_name" readonly="1"/>
                            <field name="product_board_side" readonly="1"/>
                            <field name="product_specification" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_process_route_drawing_search" model="ir.ui.view">
        <field name="name">sn.wsd.process.route.drawing.search</field>
        <field name="model">sn.wsd.process.route.drawing</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_drawing_no" string="Drawing No."/>
                <field name="route_id" string="Process Route"/>
                <field name="x_side" string="Production Side"/>
                <field name="product_name"/>
                <field name="product_specification"/>
                <field name="create_uid" string="Created by"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_route" string="Process Route" domain="[]" context="{'group_by': 'route_id'}"/>
                    <filter name="group_side" string="Production Side" domain="[]" context="{'group_by': 'x_side'}"/>
                    <filter name="group_create_uid" string="Created by" domain="[]" context="{'group_by': 'create_uid'}"/>
                    <filter name="group_create_date" string="Creation Date" domain="[]" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_process_route_drawing" model="ir.actions.act_window">
        <field name="name">Drawing Number Binding</field>
        <field name="res_model">sn.wsd.process.route.drawing</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_process_route_drawing_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a drawing number binding</p>
            <p>Bind a common process route to one or more drawing numbers (物料编号/图号). Work orders resolve their route by drawing number through these bindings.</p>
        </field>
    </record>

</odoo>
