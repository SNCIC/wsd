<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_brand_search" model="ir.ui.view">
        <field name="name">sn.wsd.brand.search</field>
        <field name="model">sn.wsd.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Active" name="active_only" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive_only" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_brand_list" model="ir.ui.view">
        <field name="name">sn.wsd.brand.list</field>
        <field name="model">sn.wsd.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
                <field name="create_uid" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="write_uid" optional="hide"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_brand_form" model="ir.ui.view">
        <field name="name">sn.wsd.brand.form</field>
        <field name="model">sn.wsd.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">sn.wsd.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sn_wsd_brand_search"/>
        <field name="context">{'search_default_active_only': 1}</field>
    </record>

    <!-- Brands are maintained by the purchasing team: they are the brand
         names the purchase contracts refer to. -->
    <menuitem id="menu_sn_wsd_brand"
              name="Brands"
              parent="purchase.menu_purchase_config"
              action="action_sn_wsd_brand"
              groups="purchase.group_purchase_manager"
              sequence="30"/>
</odoo>
