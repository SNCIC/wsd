<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_quality_issue_list_sn_wsd_scrap" model="ir.ui.view">
        <field name="name">sn.wsd.quality.issue.list.sn.wsd.scrap</field>
        <field name="model">sn.wsd.quality.issue</field>
        <field name="inherit_id" ref="sn_wsd_quality.view_sn_wsd_quality_issue_list"/>
        <field name="arch" type="xml">
            <field name="disposition" position="after">
                <field name="scrap_record_count" optional="show"/>
                <field name="restored_scrap_record_count" optional="show"/>
                <field name="active_scrap_record_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_sn_wsd_quality_issue_form_sn_wsd_scrap" model="ir.ui.view">
        <field name="name">sn.wsd.quality.issue.form.sn.wsd.scrap</field>
        <field name="model">sn.wsd.quality.issue</field>
        <field name="inherit_id" ref="sn_wsd_quality.view_sn_wsd_quality_issue_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[2]/group[2]" position="inside">
                <field name="scrap_record_id" readonly="1"/>
                <field name="active_scrap_record_id" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Scrap Records">
                    <group>
                        <group>
                            <field name="scrap_record_count" readonly="1"/>
                            <field name="restored_scrap_record_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="active_scrap_record_id" readonly="1"/>
                            <button name="action_open_scrap_records" type="object" string="Open Scrap Records" class="btn-secondary"/>
                        </group>
                    </group>
                    <group string="Related Scrap Records">
                        <field name="scrap_record_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="serial_id"/>
                                <field name="scrap_reason_id"/>
                                <field name="workorder_id"/>
                                <field name="process_step_id"/>
                                <field name="scrap_time"/>
                                <field name="scrap_user_id"/>
                                <field name="scrap_qty"/>
                                <field name="state"/>
                                <field name="stock_scrap_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Restored Scrap Records">
                        <field name="restored_scrap_record_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="serial_id"/>
                                <field name="resume_workorder_id"/>
                                <field name="restore_time"/>
                                <field name="restore_user_id"/>
                                <field name="restore_move_id"/>
                                <field name="previous_meter_state"/>
                                <field name="previous_issue_state"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
