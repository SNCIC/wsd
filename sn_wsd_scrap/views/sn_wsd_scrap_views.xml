<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_scrap_reason_list" model="ir.ui.view">
        <field name="name">sn.wsd.scrap.reason.list</field>
        <field name="model">sn.wsd.scrap.reason</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_scrap_reason_form" model="ir.ui.view">
        <field name="name">sn.wsd.scrap.reason.form</field>
        <field name="model">sn.wsd.scrap.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sn_wsd_scrap_reason" model="ir.actions.act_window">
        <field name="name">Scrap Reason Codes</field>
        <field name="res_model">sn.wsd.scrap.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sn_wsd_scrap_record_search" model="ir.ui.view">
        <field name="name">sn.wsd.scrap.record.search</field>
        <field name="model">sn.wsd.scrap.record</field>
        <field name="arch" type="xml">
            <search string="Scrap Records">
                <field name="name"/>
                <field name="production_id"/>
                <field name="mes_order_id"/>
                <field name="serial_id"/>
                <field name="serial_no"/>
                <field name="route_operation_id"/>
                <field name="process_step_id"/>
                <field name="scrap_reason_id"/>
                <field name="scrap_time"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Scrapped" name="filter_scrapped" domain="[('state', '=', 'scrapped')]"/>
                <filter string="Restored" name="filter_restored" domain="[('state', '=', 'restored')]"/>
                <group>
                    <filter string="Manufacturing Order" name="group_by_production" context="{'group_by': 'production_id'}"/>
                    <filter string="MES Order" name="group_by_mes_order" context="{'group_by': 'mes_order_id'}"/>
                    <filter string="Process" name="group_by_process" context="{'group_by': 'process_step_id'}"/>
                    <filter string="Reason Code" name="group_by_reason" context="{'group_by': 'scrap_reason_id'}"/>
                    <filter string="Scrap User" name="group_by_user" context="{'group_by': 'scrap_user_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Scrap Time" name="group_by_time" context="{'group_by': 'scrap_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_wsd_scrap_record_list" model="ir.ui.view">
        <field name="name">sn.wsd.scrap.record.list</field>
        <field name="model">sn.wsd.scrap.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="serial_id"/>
                <field name="process_step_id"/>
                <field name="scrap_reason_id"/>
                <field name="production_id"/>
                <field name="mes_order_id"/>
                <field name="route_operation_id"/>
                <field name="scrap_time"/>
                <field name="scrap_user_id"/>
                <field name="scrap_qty"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_scrap_record_form" model="ir.ui.view">
        <field name="name">sn.wsd.scrap.record.form</field>
        <field name="model">sn.wsd.scrap.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_scrap" type="object" string="Confirm Scrap" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_restore" type="object" string="Restore" class="btn-secondary" invisible="state != 'scrapped'"/>
                    <button name="action_restore_and_resume_flow" type="object" string="Restore And Resume" class="btn-primary" invisible="state == 'draft'"/>
                    <button name="action_open_stock_scrap" type="object" string="Open Stock Scrap" invisible="not stock_scrap_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scrapped,restored"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="serial_id" readonly="state != 'draft'"/>
                            <field name="serial_no" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="production_id" readonly="state != 'draft'"/>
                            <field name="mes_order_id" readonly="1"/>
                            <field name="route_operation_id" readonly="state != 'draft'"/>
                            <field name="process_step_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="scrap_reason_id" readonly="state != 'draft'"/>
                            <field name="quality_issue_id" readonly="state != 'draft'"/>
                            <field name="scrap_qty" readonly="state != 'draft'"/>
                            <field name="scrap_time" readonly="state != 'draft'"/>
                            <field name="scrap_user_id" readonly="state != 'draft'"/>
                            <field name="stock_scrap_id" readonly="1"/>
                            <field name="restore_move_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Quantity Equation">
                        <group>
                            <field name="production_qty" readonly="1"/>
                            <field name="output_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="scrap_rate" readonly="1"/>
                            <field name="balance_qty" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" nolabel="1" readonly="state != 'draft'"/>
                        </page>
                        <page string="Restore Info" invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="previous_meter_state" readonly="1"/>
                                    <field name="previous_final_result" readonly="1"/>
                                    <field name="previous_route_operation_id" readonly="1"/>
                                    <field name="previous_quality_hold_state" readonly="1"/>
                                </group>
                                <group>
                                    <field name="resume_route_operation_id" readonly="1"/>
                                    <field name="previous_issue_state" readonly="1"/>
                                    <field name="previous_issue_disposition" readonly="1"/>
                                    <field name="restore_time" readonly="1"/>
                                    <field name="restore_user_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_scrap_record_graph" model="ir.ui.view">
        <field name="name">sn.wsd.scrap.record.graph</field>
        <field name="model">sn.wsd.scrap.record</field>
        <field name="arch" type="xml">
            <graph string="Scrap Analysis" type="bar">
                <field name="scrap_reason_id"/>
                <field name="scrap_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sn_wsd_scrap_record_pivot" model="ir.ui.view">
        <field name="name">sn.wsd.scrap.record.pivot</field>
        <field name="model">sn.wsd.scrap.record</field>
        <field name="arch" type="xml">
            <pivot string="Scrap Statistics">
                <field name="production_id" type="row"/>
                <field name="mes_order_id" type="row"/>
                <field name="process_step_id" type="row"/>
                <field name="scrap_reason_id" type="col"/>
                <field name="scrap_qty" type="measure"/>
                <field name="scrap_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sn_wsd_scrap_record" model="ir.actions.act_window">
        <field name="name">Scrap Records</field>
        <field name="res_model">sn.wsd.scrap.record</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_filter_scrapped': 1}</field>
    </record>
</odoo>
