<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_internal_serial_form_sn_wsd_scrap" model="ir.ui.view">
        <field name="name">sn.wsd.internal.serial.form.sn.wsd.scrap</field>
        <field name="model">sn.wsd.internal.serial</field>
        <field name="inherit_id" ref="sn_wsd_mrp.view_sn_wsd_internal_serial_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_scrap_record" type="object" string="Scrap" class="btn-danger" invisible="final_result == 'scrap'"/>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="Scrap">
                    <group>
                        <field name="scrap_record_count" readonly="1"/>
                    </group>
                    <group>
                        <button name="action_open_scrap_records" type="object" string="Open Scrap Records" class="btn-secondary"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Scrap Records">
                    <field name="scrap_record_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="process_step_id"/>
                            <field name="scrap_reason_id"/>
                            <field name="route_operation_id"/>
                            <field name="scrap_time"/>
                            <field name="scrap_qty"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
