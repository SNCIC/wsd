<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_form_sn_wsd_scrap" model="ir.ui.view">
        <field name="name">mrp.workorder.form.sn.wsd.scrap</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Scrap">
                    <group>
                        <group>
                            <field name="x_scrap_record_count" readonly="1"/>
                            <field name="x_scrap_qty_total" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_create_scrap_record" type="object" string="New Scrap Record" class="btn-primary"/>
                            <button name="action_open_scrap_records" type="object" string="Open Scrap Records" class="btn-secondary"/>
                        </group>
                    </group>
                    <field name="x_scrap_record_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="serial_id"/>
                            <field name="scrap_reason_id"/>
                            <field name="scrap_time"/>
                            <field name="scrap_user_id"/>
                            <field name="scrap_qty"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
