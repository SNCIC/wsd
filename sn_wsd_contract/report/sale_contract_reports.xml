<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A4 portrait with the margins of the purchase contract: the sales
         contract is the same paper form, printed on a standard sheet. -->
    <record id="paperformat_sale_contract" model="report.paperformat">
        <field name="name">A4 Sales Contract</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="action_report_sale_contract" model="ir.actions.report">
        <field name="name">Sales Contract</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sn_wsd_contract.report_sale_contract</field>
        <field name="report_file">sn_wsd_contract.report_sale_contract</field>
        <field name="paperformat_id" ref="sn_wsd_contract.paperformat_sale_contract"/>
        <field name="print_report_name">'Sales Contract - %s' % (object.contract_number or object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Same document, rendered in the browser only: the contract is read and
         checked before a PDF is produced, and the client print button of the
         preview turns it into the PDF of the action above. -->
    <record id="action_report_sale_contract_preview" model="ir.actions.report">
        <field name="name">Sales Contract Preview</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">sn_wsd_contract.report_sale_contract</field>
        <field name="report_file">sn_wsd_contract.report_sale_contract</field>
        <field name="paperformat_id" ref="sn_wsd_contract.paperformat_sale_contract"/>
        <field name="print_report_name">'Sales Contract - %s' % (object.contract_number or object.name)</field>
    </record>
</odoo>
