<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Editing the vendor payment terms and the vendor bank accounts is a
             finance decision: the purchase managers and the invoicing people
             hold it, the other users only read it. -->
        <record id="group_supplier_finance_editor" model="res.groups">
            <field name="name">Supplier Finance Editor</field>
            <field name="implied_by_ids"
                   eval="[Command.link(ref('purchase.group_purchase_manager')),
                          Command.link(ref('account.group_account_invoice'))]"/>
        </record>
    </data>
</odoo>
