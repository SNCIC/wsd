<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_supplier_code" model="ir.ui.view">
        <field name="name">res.partner.form.supplier.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='purchase']" position="inside">
                <field name="supplier_categ_id"
                       options="{'no_create': True}"
                       placeholder="Pick a group to get a code"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_supplier_code" model="ir.ui.view">
        <field name="name">res.partner.search.supplier.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="supplier_categ_id" string="Supplier Group"/>
            </xpath>
        </field>
    </record>

    <!-- Vendor finance data: the payment terms and the bank accounts of a
         vendor are read by everybody and written by the finance editors only.
         The bank accounts get their own entry point next to the vendor name so
         that a purchase manager reaches them without the accounting page. -->
    <record id="action_sn_partner_bank_accounts" model="ir.actions.act_window">
        <field name="name">Bank Accounts</field>
        <field name="res_model">res.partner.bank</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_id', '=', active_id)]</field>
        <field name="context">{'default_partner_id': active_id,
            'search_default_partner_id': active_id}</field>
    </record>

    <record id="view_partner_form_supplier_finance_rights" model="ir.ui.view">
        <field name="name">res.partner.form.supplier.finance.rights</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="sn_can_edit_supplier_finance" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_sn_partner_bank_accounts)d" type="action"
                        class="oe_stat_button" icon="fa-bank"
                        groups="sn_wsd_partner.group_supplier_finance_editor"
                        invisible="supplier_rank == 0 and commercial_partner_id.supplier_rank == 0">
                    <field name="bank_account_count" widget="statinfo" string="Bank Accounts"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='property_supplier_payment_term_id']" position="attributes">
                <attribute name="groups">account.group_account_invoice,account.group_account_readonly,sn_wsd_partner.group_supplier_finance_editor</attribute>
                <attribute name="readonly">not sn_can_edit_supplier_finance</attribute>
            </xpath>
            <xpath expr="//field[@name='bank_ids']" position="attributes">
                <attribute name="readonly">not sn_can_edit_supplier_finance</attribute>
            </xpath>
        </field>
    </record>
</odoo>
