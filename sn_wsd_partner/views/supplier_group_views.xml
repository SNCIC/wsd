<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_supplier_group_list" model="ir.ui.view">
        <field name="name">sn.wsd.supplier.group.list</field>
        <field name="model">sn.wsd.supplier.group</field>
        <field name="arch" type="xml">
            <list string="Supplier Groups" editable="bottom">
                <field name="code" placeholder="01"/>
                <field name="name" placeholder="Electronic Components"/>
                <field name="parent_id" optional="show"/>
                <field name="supplier_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_supplier_group_form" model="ir.ui.view">
        <field name="name">sn.wsd.supplier.group.form</field>
        <field name="model">sn.wsd.supplier.group</field>
        <field name="arch" type="xml">
            <form string="Supplier Group">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Electronic Components"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="01"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="supplier_count"/>
                        </group>
                    </group>
                    <group string="Sub-groups" invisible="not child_ids">
                        <field name="child_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="code"/>
                                <field name="name"/>
                                <field name="supplier_count"/>
                                <field name="active" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </group>
                    <div class="text-muted">
                        A supplier is numbered with the full number of its group
                        followed by a serial, and every group counts its own:
                        the fees group issues 10.xxx, its other-fees sub-group
                        10.002.xxx.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sn_wsd_supplier_group_search" model="ir.ui.view">
        <field name="name">sn.wsd.supplier.group.search</field>
        <field name="model">sn.wsd.supplier.group</field>
        <field name="arch" type="xml">
            <search string="Supplier Groups">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Parent Group" name="group_parent_id"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sn_wsd_supplier_group" model="ir.actions.act_window">
        <field name="name">Supplier Groups</field>
        <field name="res_model">sn.wsd.supplier.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first supplier group</p>
            <p>A group carries the number that prefixes the supplier code of the
               suppliers numbered in it.</p>
        </field>
    </record>

    <!-- The configuration menu is limited to system administrators by
         default: open it to contact managers so they can maintain the
         supplier groups themselves. Linking adds the group, it never drops
         the administrator one. -->
    <record id="contacts.res_partner_menu_config" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.link(ref('base.group_partner_manager'))]"/>
    </record>

    <!-- Under Contacts > Configuration, alongside the other contact master
         data. No groups attribute of its own: the menu inherits the
         visibility of that configuration menu. -->
    <menuitem id="menu_sn_wsd_supplier_group" name="Supplier Groups"
              action="action_sn_wsd_supplier_group"
              parent="contacts.res_partner_menu_config" sequence="2"/>
</odoo>
