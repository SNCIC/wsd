<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Safety net: the price is written when a purchase order is
             confirmed, this job catches the lines changed afterwards (price
             edited on a confirmed order, order cancelled from the back end). -->
        <record id="ir_cron_sn_refresh_latest_purchase_price" model="ir.cron">
            <field name="name">SN WSD Cost: refresh latest purchase prices</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_sn_refresh_latest_purchase_price()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
