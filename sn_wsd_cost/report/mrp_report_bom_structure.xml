<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Unit price and purchase date of every purchased component of the BoM
         overview PDF export. The screen report is rendered by the OWL
         components instead. -->
    <template id="report_mrp_bom_inherit_sn_wsd_cost" inherit_id="mrp.report_mrp_bom">
        <xpath expr="//th[@name='th_mrp_bom_h']" position="after">
            <th class="text-end" t-if="data['has_cost_info']">Unit Price</th>
            <th class="text-center" t-if="data['has_cost_info']">Purchase Date</th>
        </xpath>

        <xpath expr="//td[@name='td_mrp_bom']" position="after">
            <td t-if="data['has_cost_info']"/>
            <td t-if="data['has_cost_info']"/>
        </xpath>

        <xpath expr="//td[@name='td_mrp_bom_f']" position="after">
            <td t-if="data['has_cost_info']"/>
            <td t-if="data['has_cost_info']"/>
        </xpath>

        <xpath expr="//td[@name='td_mrp_bom_byproducts_f']" position="after">
            <td t-if="data['has_cost_info']"/>
            <td t-if="data['has_cost_info']"/>
        </xpath>
    </template>

    <template id="report_mrp_bom_pdf_line_inherit_sn_wsd_cost" inherit_id="mrp.report_mrp_bom_pdf_line">
        <xpath expr="//td[@name='td_mrp_code']" position="after">
            <td class="text-end" t-if="data['has_cost_info']" t-esc="l.get('sn_unit_cost_display', '')"/>
            <td class="text-center" t-if="data['has_cost_info']" t-esc="l.get('sn_cost_date', '')"/>
        </xpath>
    </template>
</odoo>
