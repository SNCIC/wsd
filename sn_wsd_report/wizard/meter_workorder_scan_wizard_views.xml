<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_workorder_scan_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.workorder.scan.wizard.form</field>
        <field name="model">sn.wsd.workorder.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan Meter Serial">
                <group>
                    <group>
                        <field name="workcenter_id" readonly="1"/>
                        <field name="workorder_id" readonly="1"/>
                        <field name="mode"/>
                        <field name="serial_no"/>
                        <field name="operator_code"/>
                        <field name="note"/>
                        <field name="override_route"/>
                    </group>
                    <group>
                        <field name="aging_batch_id" invisible="workorder_id and workorder_id.x_meter_operation_type not in ('aging_load', 'aging_unload')"/>
                        <field name="aging_slot_no" invisible="workorder_id and workorder_id.x_meter_operation_type != 'aging_load'"/>
                        <field name="seal_no" invisible="workorder_id and workorder_id.x_meter_operation_type != 'packing'"/>
                        <field name="carton_no" invisible="workorder_id and workorder_id.x_meter_operation_type != 'packing'"/>
                        <field name="pallet_no" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
