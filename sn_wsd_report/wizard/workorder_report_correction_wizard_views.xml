<odoo>
    <record id="view_workorder_report_correction_wizard_form" model="ir.ui.view">
        <field name="name">mrp.workorder.report.correction.wizard.form</field>
        <field name="model">mrp.workorder.report.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct Workorder Report">
                <group>
                    <field name="report_id"/>
                    <field name="reason"/>
                </group>
                <group string="Corrected Quantities">
                    <field name="qty_ok"/>
                    <field name="qty_ng"/>
                    <field name="qty_scrap"/>
                    <field name="qty_repair"/>
                    <field name="qty_rework"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Correction" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
