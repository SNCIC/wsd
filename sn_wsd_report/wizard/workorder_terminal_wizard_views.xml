<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wsd_workorder_terminal_wizard_form" model="ir.ui.view">
        <field name="name">sn.wsd.workorder.terminal.wizard.form</field>
        <field name="model">sn.wsd.workorder.terminal.wizard</field>
        <field name="arch" type="xml">
            <form string="Terminal Report">
                <sheet class="o_sn_wsd_terminal_form">
                    <div class="o_sn_wsd_terminal_shell">
                        <div class="o_sn_wsd_terminal_panel">
                            <h2 class="o_sn_wsd_terminal_panel_title">Station Control</h2>
                            <div class="o_sn_wsd_terminal_kpis">
                                <div class="o_sn_wsd_terminal_kpi">
                                    <div class="o_sn_wsd_terminal_kpi_label">Available Qty</div>
                                    <div class="o_sn_wsd_terminal_kpi_value"><field name="available_qty" readonly="1" nolabel="1"/></div>
                                </div>
                                <div class="o_sn_wsd_terminal_kpi">
                                    <div class="o_sn_wsd_terminal_kpi_label">Previous Output</div>
                                    <div class="o_sn_wsd_terminal_kpi_value"><field name="previous_output_qty" readonly="1" nolabel="1"/></div>
                                </div>
                                <div class="o_sn_wsd_terminal_kpi">
                                    <div class="o_sn_wsd_terminal_kpi_label">Current Output</div>
                                    <div class="o_sn_wsd_terminal_kpi_value"><field name="report_output_qty" readonly="1" nolabel="1"/></div>
                                </div>
                                <div class="o_sn_wsd_terminal_kpi">
                                    <div class="o_sn_wsd_terminal_kpi_label">Balance</div>
                                    <div class="o_sn_wsd_terminal_kpi_value"><field name="report_balance_qty" readonly="1" nolabel="1"/></div>
                                </div>
                            </div>
                            <group class="o_sn_wsd_terminal_compact_group">
                                <group>
                                    <field name="workcenter_id"/>
                                    <field name="station_code" readonly="1"/>
                                    <field name="workorder_id"/>
                                    <field name="production_id"/>
                                    <field name="operation_type" readonly="1"/>
                                </group>
                                <group>
                                    <field name="mode"/>
                                    <field name="report_type"/>
                                    <field name="operator_code"/>
                                    <field name="device_id"/>
                                    <field name="event_time"/>
                                </group>
                            </group>
                            <div class="o_sn_wsd_terminal_hint" invisible="serial_no and mode == 'manual'">
                                Quantity mode: output is posted by totals and aggregated into workorder report summary.
                            </div>
                            <div class="o_sn_wsd_terminal_hint" invisible="not serial_no or mode != 'manual'">
                                Serial mode: the terminal will continue the meter flow, including traceability, station travel, aging, and packing actions.
                            </div>
                        </div>
                        <div class="o_sn_wsd_terminal_panel">
                            <h2 class="o_sn_wsd_terminal_panel_title">Report Entry</h2>
                            <group class="o_sn_wsd_terminal_compact_group">
                                <group>
                                    <field name="serial_no"/>
                                    <field name="qty_in"/>
                                    <field name="qty_ok" readonly="serial_no and mode == 'manual' and report_type == 'complete'"/>
                                    <field name="qty_ng" readonly="serial_no and mode == 'manual'"/>
                                    <field name="qty_scrap" readonly="serial_no and mode == 'manual'"/>
                                    <field name="qty_repair" readonly="serial_no and mode == 'manual'"/>
                                    <field name="qty_rework"/>
                                </group>
                                <group>
                                    <field name="loss_reason_id"/>
                                    <field name="external_event_id" invisible="mode != 'machine'"/>
                                    <field name="override_route" invisible="not serial_no or mode != 'manual'"/>
                                    <field name="aging_batch_id" invisible="not serial_no or workorder_id and workorder_id.x_meter_operation_type not in ('aging_load', 'aging_unload')"/>
                                    <field name="aging_slot_no" invisible="not serial_no or workorder_id and workorder_id.x_meter_operation_type != 'aging_load'"/>
                                    <field name="seal_no" invisible="not serial_no or workorder_id and workorder_id.x_meter_operation_type != 'packing'"/>
                                    <field name="carton_no" invisible="not serial_no or workorder_id and workorder_id.x_meter_operation_type != 'packing'"/>
                                    <field name="pallet_no" invisible="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="remark"/>
                                <field name="payload_json" placeholder='{"key": "value"}' invisible="mode != 'machine'"/>
                            </group>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <div class="o_sn_wsd_terminal_footer">
                        <span class="o_sn_wsd_terminal_footer_note">Use serial mode for station flow, and quantity mode for counted output posting.</span>
                        <div>
                            <button name="action_submit" type="object" string="Submit" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </div>
                    </div>
                </footer>
            </form>
        </field>
    </record>
</odoo>
