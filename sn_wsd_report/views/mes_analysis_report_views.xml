<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sn_wsd_mes_big_screen_server" model="ir.actions.server">
        <field name="name">MES Big Screen</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="path">sn-wsd-mes-big-screen</field>
        <field name="state">code</field>
        <field name="code">action = env['sn.wsd.mes.dashboard.service'].action_open_big_screen()</field>
    </record>

    <record id="action_sn_wsd_mes_big_screen_client" model="ir.actions.client">
        <field name="name">MES Big Screen</field>
        <field name="tag">sn_wsd_mes_big_screen_action</field>
        <field name="path">sn-wsd-mes-big-screen-display</field>
        <field name="target">fullscreen</field>
        <field name="context">{}</field>
    </record>

    <record id="view_sn_wsd_production_progress_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.production.progress.report.list</field>
        <field name="model">sn.wsd.production.progress.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="product_qty" sum="Total"/>
                <field name="qty_output_total" sum="Total"/>
                <field name="qty_pass" sum="Total"/>
                <field name="qty_fail" sum="Total"/>
                <field name="qty_scrap" sum="Total"/>
                <field name="progress_rate"/>
                <field name="pass_rate"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_production_progress_report" model="ir.actions.act_window">
        <field name="name">Production Progress</field>
        <field name="res_model">sn.wsd.production.progress.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_sn_wsd_operation_daily_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.operation.daily.report.list</field>
        <field name="model">sn.wsd.operation.daily.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="report_date"/>
                <field name="workcenter_code"/>
                <field name="workorder_id"/>
                <field name="qty_in" sum="Total"/>
                <field name="qty_ok" sum="Total"/>
                <field name="qty_ng" sum="Total"/>
                <field name="qty_scrap" sum="Total"/>
                <field name="qty_out" sum="Total"/>
                <field name="pass_rate"/>
                <field name="ng_rate"/>
            </list>
        </field>
    </record>

    <record id="view_sn_wsd_operation_daily_report_pivot" model="ir.ui.view">
        <field name="name">sn.wsd.operation.daily.report.pivot</field>
        <field name="model">sn.wsd.operation.daily.report</field>
        <field name="arch" type="xml">
            <pivot string="Operation Daily">
                <field name="report_date" type="row"/>
                <field name="workcenter_code" type="col"/>
                <field name="qty_ok" type="measure"/>
                <field name="qty_ng" type="measure"/>
                <field name="qty_scrap" type="measure"/>
                <field name="qty_out" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sn_wsd_operation_daily_report" model="ir.actions.act_window">
        <field name="name">Operation Daily</field>
        <field name="res_model">sn.wsd.operation.daily.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_sn_wsd_test_pass_rate_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.test.pass.rate.report.list</field>
        <field name="model">sn.wsd.test.pass.rate.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="report_date"/>
                <field name="test_type"/>
                <field name="workcenter_code"/>
                <field name="total_count" sum="Total"/>
                <field name="pass_count" sum="Total"/>
                <field name="fail_count" sum="Total"/>
                <field name="hold_count" sum="Total"/>
                <field name="pass_rate"/>
                <field name="avg_cycle_time_sec"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_test_pass_rate_report" model="ir.actions.act_window">
        <field name="name">Test Pass Rates</field>
        <field name="res_model">sn.wsd.test.pass.rate.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_sn_wsd_aging_loss_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.aging.loss.report.list</field>
        <field name="model">sn.wsd.aging.loss.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="batch_id"/>
                <field name="start_date"/>
                <field name="equipment_id"/>
                <field name="load_qty" sum="Total"/>
                <field name="pass_qty" sum="Total"/>
                <field name="loss_qty" sum="Total"/>
                <field name="loss_rate"/>
                <field name="planned_hours"/>
                <field name="actual_hours"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_aging_loss_report" model="ir.actions.act_window">
        <field name="name">Aging Loss</field>
        <field name="res_model">sn.wsd.aging.loss.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_sn_wsd_repair_closure_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.repair.closure.report.list</field>
        <field name="model">sn.wsd.repair.closure.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="report_date"/>
                <field name="workorder_id"/>
                <field name="defect_code_id"/>
                <field name="repair_mode"/>
                <field name="reported_count" sum="Total"/>
                <field name="closed_ok_count" sum="Total"/>
                <field name="scrapped_count" sum="Total"/>
                <field name="open_count" sum="Total"/>
                <field name="closure_rate"/>
                <field name="repair_qty_total" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_repair_closure_report" model="ir.actions.act_window">
        <field name="name">Repair Closure</field>
        <field name="res_model">sn.wsd.repair.closure.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_sn_wsd_serial_trace_summary_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.serial.trace.summary.report.list</field>
        <field name="model">sn.wsd.serial.trace.summary.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="serial_no"/>
                <field name="production_id"/>
                <field name="current_workorder_id"/>
                <field name="final_result"/>
                <field name="travel_count"/>
                <field name="test_result_count"/>
                <field name="quality_issue_count"/>
                <field name="repair_order_count"/>
                <field name="latest_workcenter_code"/>
                <field name="latest_event_type"/>
                <field name="latest_event_time"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_serial_trace_summary_report" model="ir.actions.act_window">
        <field name="name">Serial Trace Summary</field>
        <field name="res_model">sn.wsd.serial.trace.summary.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_sn_wsd_serial_trace_detail_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.serial.trace.detail.report.list</field>
        <field name="model">sn.wsd.serial.trace.detail.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="event_time"/>
                <field name="serial_no"/>
                <field name="event_source"/>
                <field name="event_type"/>
                <field name="result"/>
                <field name="workcenter_code"/>
                <field name="workorder_id"/>
                <field name="quantity" sum="Total"/>
                <field name="reference_name"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_serial_trace_detail_report" model="ir.actions.act_window">
        <field name="name">Serial Trace Detail</field>
        <field name="res_model">sn.wsd.serial.trace.detail.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_sn_wsd_test_history_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.test.history.report.list</field>
        <field name="model">sn.wsd.test.history.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="test_time"/>
                <field name="serial_no"/>
                <field name="test_type"/>
                <field name="result"/>
                <field name="workcenter_code"/>
                <field name="workorder_id"/>
                <field name="operator_code"/>
                <field name="cycle_time_sec"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_test_history_report" model="ir.actions.act_window">
        <field name="name">SN Test History</field>
        <field name="res_model">sn.wsd.test.history.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_sn_wsd_station_efficiency_report_list" model="ir.ui.view">
        <field name="name">sn.wsd.station.efficiency.report.list</field>
        <field name="model">sn.wsd.station.efficiency.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="report_date"/>
                <field name="workcenter_code"/>
                <field name="workorder_id"/>
                <field name="output_qty" sum="Total"/>
                <field name="pass_qty" sum="Total"/>
                <field name="avg_cycle_time_sec"/>
                <field name="theoretical_cycle_time_min"/>
                <field name="efficiency_rate"/>
                <field name="travel_event_count" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_sn_wsd_station_efficiency_report" model="ir.actions.act_window">
        <field name="name">Station Efficiency</field>
        <field name="res_model">sn.wsd.station.efficiency.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>
</odoo>

