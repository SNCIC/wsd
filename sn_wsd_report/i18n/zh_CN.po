msgstr "只有已提交的报工才能进行纠正。"

#. module: sn_wsd_report
#: code:addons/sn_wsd_report/models/workorder_report.py:0
msgid ""
"A completed or cancelled work order cannot be corrected from this screen."
msgstr "已完成或已取消的工单不能在此页面纠正。"

#. module: sn_wsd_report
#: code:addons/sn_wsd_report/wizard/workorder_report_correction_wizard.py:0
msgid ""
"Serial-number reports must be corrected through the serial or quality flow."
msgstr "包含序列号的报工必须通过序列号或质量流程纠正。"

#. module: sn_wsd_report
#: code:addons/sn_wsd_report/wizard/workorder_report_correction_wizard.py:0
msgid "Machine and API reports require an external correction event."
msgstr "机台和 API 报工必须通过外部纠正事件处理。"

#. module: sn_wsd_report
#: code:addons/sn_wsd_report/wizard/workorder_report_correction_wizard.py:0
msgid "Corrected output cannot exceed the original input quantity."
msgstr "纠正后的产出数量不能超过原投入数量。"

#. module: sn_wsd_report
#: code:addons/sn_wsd_report/wizard/workorder_report_correction_wizard.py:0
msgid "Corrected quantities cannot be negative."
msgstr "纠正后的数量不能为负数。"

#. module: sn_wsd_report
#: code:addons/sn_wsd_report/models/workorder_report.py:0
#: code:addons/sn_wsd_report/wizard/workorder_report_correction_wizard.py:0
msgid "Only Manufacturing Managers can correct reports."
msgstr "只有制造管理者可以纠正报工。"

